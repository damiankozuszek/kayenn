def field_range(f):
    """Allowed range of a field as text, e.g. „0…75”, „−20…30”."""
    fm = lambda v: (f"{v:.0f}" if abs(v - round(v)) < 1e-9 else f"{v:g}").replace("-", "−")
    return f"{fm(f[3])}…{fm(f[4])}"


