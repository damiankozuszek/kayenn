# --- automatic installation of a new version (O programie → Instaluj, the start notice, UPDATES INSTALL)
def install_kind():
    """How this copy can update itself: "win-setup" (installed by the Windows installer), "mac-app" (KAYENN.app),
    "linux-deb" (/opt/kayenn from the .deb), "linux-tar" (an unpacked .tar.gz); None – from source or a portable
    Windows copy (then only the download page)."""
    if not FROZEN:
        return None
    exe = os.path.abspath(sys.executable)
    d = os.path.dirname(exe)
    if sys.platform == "win32":
        try:
            return "win-setup" if any(re.fullmatch(r"unins\d+\.exe", f, re.I) for f in os.listdir(d)) else None
        except OSError:
            return None
    if sys.platform == "darwin":
        return "mac-app" if ".app/Contents/MacOS/" in exe else None
    return "linux-deb" if exe.startswith("/opt/kayenn/") else "linux-tar"


def mac_arm():
    """Apple Silicon (also when the Intel build runs through Rosetta 2)."""
    import platform
    import subprocess
    try:
        return subprocess.run(["sysctl", "-n", "hw.optional.arm64"], capture_output=True, text=True,
                              timeout=5).stdout.strip() == "1"
    except (OSError, subprocess.SubprocessError):
        return platform.machine() == "arm64"


def pick_asset(assets, kind, arm=None):
    """The file of the release for this copy of the program (None – none fits)."""
    if kind == "mac-app":
        arm = mac_arm() if arm is None else arm
        endings = ["-macos-arm64.dmg", "-macos-x64.dmg"] if arm else ["-macos-x64.dmg"]
    else:
        endings = {"win-setup": ["-windows-x64-setup.exe"], "linux-deb": ["_amd64.deb"],
                   "linux-tar": ["-linux-x86_64.tar.gz"]}.get(kind, [])
    for e in endings:
        for a in assets or []:
            if a.get("name", "").endswith(e) and a.get("url"):
                return a
    return None


def _sh(s):
    """A word of a shell script in single quotes."""
    q = chr(39)
    return q + str(s).replace(q, q + '"' + q + '"' + q) + q


def install_command(kind, path, pid, workdir, exe=None):
    """The command started after the program closes: waits for the process, installs, starts the new version.
    Returns (argv, script text – written to workdir/update.sh – or None)."""
    log = os.path.join(workdir, "install.log")
    exe = exe or os.path.abspath(sys.executable)
    if kind == "win-setup":
        q = chr(39)
        e = lambda x: str(x).replace(q, q + q)                     # noqa: E731 – PowerShell single quotes
        ps = (f"Wait-Process -Id {pid} -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500; "
              f"Start-Process -FilePath {q}{e(path)}{q} -ArgumentList {q}/SILENT{q},{q}/SUPPRESSMSGBOXES{q},"
              f"{q}/NORESTART{q},{q}/CLOSEAPPLICATIONS{q},{q}/relaunch=1{q},{q}/LOG=\"{e(log)}\"{q}")
        return ["powershell", "-NoProfile", "-NonInteractive", "-WindowStyle", "Hidden", "-Command", ps], None
    head = (f"#!/bin/sh\n# KAYENN update\nwhile kill -0 {pid} 2>/dev/null; do sleep 0.5; done\n"
            f"exec >>{_sh(log)} 2>&1\n")
    if kind == "mac-app":
        app = exe[:exe.index(".app/") + 4]
        body = (f"APP={_sh(app)}\nDMG={_sh(path)}\nMNT=$(mktemp -d)\n"
                'if hdiutil attach -nobrowse -quiet -mountpoint "$MNT" "$DMG" && [ -d "$MNT/KAYENN.app" ]; then\n'
                '  rm -rf "$APP.old"\n'
                '  if mv "$APP" "$APP.old" && ditto "$MNT/KAYENN.app" "$APP"; then rm -rf "$APP.old"\n'
                '  else rm -rf "$APP"; mv "$APP.old" "$APP"; hdiutil detach -quiet "$MNT"; open "$DMG"; exit 1; fi\n'
                '  hdiutil detach -quiet "$MNT"\n'
                '  xattr -dr com.apple.quarantine "$APP" 2>/dev/null\n'
                '  open "$APP"\n'
                'else open "$DMG"; fi\n')
    elif kind == "linux-deb":
        body = (f"DEB={_sh(path)}\n"
                'if command -v pkexec >/dev/null && pkexec apt-get install -y "$DEB"; then /opt/kayenn/KAYENN &\n'
                'else xdg-open "$DEB"; fi\n')
    else:                                                          # linux-tar: the folder of the program replaced
        body = (f"DIR={_sh(os.path.dirname(exe))}\nTGZ={_sh(path)}\nTMP=$(mktemp -d)\n"
                'if tar -xzf "$TGZ" -C "$TMP" && [ -x "$TMP/KAYENN/KAYENN" ]; then\n'
                '  rm -rf "$DIR.old"\n'
                '  if mv "$DIR" "$DIR.old" && mv "$TMP/KAYENN" "$DIR"; then rm -rf "$DIR.old"\n'
                '  else rm -rf "$DIR"; mv "$DIR.old" "$DIR"; exit 1; fi\n'
                '  "$DIR/KAYENN" &\n'
                'else xdg-open "$(dirname "$TGZ")"; fi\n')
    return ["/bin/sh", os.path.join(workdir, "update.sh")], head + body


def install_writable(kind):
    """Can the files of this copy be replaced without administrator rights (macOS app, .tar.gz folder)?"""
    exe = os.path.abspath(sys.executable)
    if kind == "mac-app":
        return os.access(os.path.dirname(exe[:exe.index(".app/") + 4]), os.W_OK)
    if kind == "linux-tar":
        return os.access(os.path.dirname(os.path.dirname(exe)), os.W_OK)
    return True


class UpdateInstaller(QDialog):
    """Instaluj: downloads the file of the new version for this system (with a progress bar), checks its SHA-256,
    closes the program (the save question as at Zakończ), installs and starts the new version. A copy that
    cannot update itself (portable, from source, no write access) – the download page."""

    def __init__(self, app, parent, r):
        super().__init__(parent)
        from PySide6.QtWidgets import QProgressBar
        self.app, self.r = app, r
        self.setWindowTitle("Aktualizacja KAYENN")
        self.setWindowFlag(Qt.WindowType.WindowContextHelpButtonHint, False)
        self.setModal(False)
        self.setMinimumWidth(460)
        v = QVBoxLayout(self)
        self.msg = QLabel(f"Pobieranie wersji {r.get('version', '')}…")
        self.msg.setWordWrap(True)
        v.addWidget(self.msg)
        self.bar = QProgressBar()
        self.bar.setRange(0, 0)
        v.addWidget(self.bar)
        hb = QHBoxLayout()
        hb.addStretch(1)
        self.b_go = QPushButton("Instaluj teraz")
        self.b_go.clicked.connect(lambda checked=False: self.install())
        self.b_go.hide()
        hb.addWidget(self.b_go)
        self.b_cancel = QPushButton("Anuluj")
        self.b_cancel.clicked.connect(lambda checked=False: self.cancel())
        hb.addWidget(self.b_cancel)
        v.addLayout(hb)
        self.kind = install_kind()
        self.asset = pick_asset(r.get("assets"), self.kind) if self.kind else None
        self.path, self._reply, self._file = None, None, None
        self.workdir = os.path.join(user_data_dir(), "update")

    def start(self):
        """False – this copy cannot update itself; the download page is opened instead."""
        from PySide6.QtCore import QUrl
        from PySide6.QtGui import QDesktopServices
        if self.asset is None or not install_writable(self.kind):
            QDesktopServices.openUrl(QUrl(self.r.get("url") or RELEASES_URL))
            return False
        from PySide6.QtNetwork import QNetworkAccessManager, QNetworkRequest
        os.makedirs(self.workdir, exist_ok=True)
        self.path = os.path.join(self.workdir, os.path.basename(self.asset["name"]))
        self._file = open(self.path + ".part", "wb")
        self._nam = QNetworkAccessManager(self)
        req = QNetworkRequest(QUrl(self.asset["url"]))
        req.setRawHeader(b"User-Agent", ("KAYENN/" + APP_VERSION).encode())
        self._reply = self._nam.get(req)
        self._reply.readyRead.connect(lambda: self._file.write(bytes(self._reply.readAll())))
        self._reply.downloadProgress.connect(self._progress)
        self._reply.finished.connect(self._done)
        self.show()
        return True

    def _progress(self, got, total):
        if total > 0:
            self.bar.setRange(0, 1000)
            self.bar.setValue(int(got * 1000 / total))
            self.msg.setText(f"Pobieranie wersji {self.r.get('version', '')}… {got / 1e6:.1f} / {total / 1e6:.1f} MB")

    def _fail(self, text):
        self.bar.setRange(0, 1)
        self.bar.setValue(0)
        self.msg.setText(text)
        self.b_cancel.setText("Zamknij")

    def _done(self):
        import hashlib
        from PySide6.QtNetwork import QNetworkReply
        rep, self._reply = self._reply, None
        if self._file is not None:
            self._file.write(bytes(rep.readAll()))
            self._file.close()
            self._file = None
        part = self.path + ".part"
        if rep.error() != QNetworkReply.NetworkError.NoError:
            self._fail("Nie udało się pobrać nowej wersji: " + rep.errorString())
            return
        dg = (self.asset.get("digest") or "").lower()
        if dg.startswith("sha256:"):
            h = hashlib.sha256()
            with open(part, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 20), b""):
                    h.update(chunk)
            if h.hexdigest() != dg[7:]:
                self._fail("Pobrany plik jest uszkodzony (niezgodna suma kontrolna) – spróbuj ponownie.")
                return
        os.replace(part, self.path)
        self.bar.setRange(0, 1)
        self.bar.setValue(1)
        self.install()

    def install(self):
        """The program closes (the questions as at Zakończ), the installer finishes the job and starts it again."""
        import subprocess
        self.msg.setText("Instalowanie – program zamknie się i uruchomi ponownie w nowej wersji.")
        argv, script = install_command(self.kind, self.path, os.getpid(), self.workdir)
        dry = os.environ.get("KAYENN_UPDATE_DRYRUN")
        if dry:                                     # tests: the command instead of installing, the program stays
            with open(dry, "w", encoding="utf-8") as f:
                json.dump(dict(argv=argv, script=script, path=self.path), f)
            return True
        if not self.app.quit_app():
            self.msg.setText("Instalacja wstrzymana – program nie został zamknięty.")
            self.b_go.show()
            return False
        if script is not None:
            with open(argv[-1], "w", encoding="utf-8", newline="\n") as f:
                f.write(script)
        kw = dict(close_fds=True)
        if sys.platform == "win32":
            kw["creationflags"] = 0x00000008 | 0x08000000 | 0x00000200   # detached, no window, new group
        else:
            kw["start_new_session"] = True
        subprocess.Popen(argv, **kw)
        return True

    def cancel(self):
        if self._reply is not None:
            self._reply.abort()
        self.close()


def start_update_install(app, r):
    """Instaluj (O programie, the start notice, UPDATES INSTALL). Returns the window or None (download page)."""
    host = app.host
    d = getattr(host, "_upd_inst", None)
    if d is not None and d.isVisible():
        d.raise_()
        return d
    d = UpdateInstaller(host, host.pw, r)
    host._upd_inst = d
    return d if d.start() else None


def odt_fix_frames(path):
    """Images in the .odt written by Qt: the frame sits inside a text:span without a wrap setting, so OnlyOffice
    wraps the text around it (the report ends up in a narrow column). The frame goes directly into the paragraph
    with a graphic style without wrapping (as LibreOffice writes it)."""
    import zipfile
    with zipfile.ZipFile(path) as z:
        items = [(i, z.read(i.filename)) for i in z.infolist()]
    out = []
    for i, data in items:
        if i.filename == "content.xml":
            c = data.decode("utf-8")
            c = re.sub(r"<text:span[^>]*>\s*(<draw:frame\b.*?</draw:frame>)\s*</text:span>", r"\1", c, flags=re.S)
            c = c.replace("<draw:frame ", '<draw:frame draw:style-name="kfr" ')
            st = ('<style:style style:name="kfr" style:family="graphic"><style:graphic-properties style:wrap="none" '
                  'style:vertical-pos="top" style:vertical-rel="baseline" style:horizontal-pos="center" '
                  'style:horizontal-rel="paragraph"/></style:style>')
            c = c.replace("<office:automatic-styles>", "<office:automatic-styles>" + st, 1)
            data = c.encode("utf-8")
        out.append((i, data))
    with zipfile.ZipFile(path, "w") as z:
        for i, data in out:
            z.writestr(i, data, compress_type=i.compress_type)


def page_header_doc(project, bw, dev):
    """Page header of the printout (every page): the project name. Returns (QTextDocument laid out for the width
    bw at the device dev, height)."""
    from PySide6.QtGui import QTextDocument
    d = QTextDocument()
    d.setDefaultFont(QFont(FONT, 9))
    d.documentLayout().setPaintDevice(dev)
    d.setHtml(f'<p style="margin:0; color:{TEXT};">Projekt: <b>{html.escape(project)}</b></p>')
    d.setTextWidth(bw)
    return d, d.size().height()


def mat_legacy_file():
    """The first user database: materials_pl.txt in the user data folder (tests: MAT_USER_OVERRIDE)."""
    if MAT_USER_OVERRIDE:
        return MAT_USER_OVERRIDE
    d = user_data_dir()
    return migrate_user_file(os.path.join(d, "materials_pl.txt"), os.path.join(d, "materialy.txt"))


MAT_BASE_NAME = "Baza użytkownika"


def mat_bases():
    """User material databases (the one bundled with the program is read-only and not on the list; a user
    database is its editable copy): ([{id, name, file}, …], id of the default one). The list is kept in
    materials_index.json next to the first database; without it – one database „Baza użytkownika”."""
    legacy = mat_legacy_file()
    d = os.path.dirname(legacy)
    bases, default = [], None
    try:
        with open(os.path.join(d, "materials_index.json"), encoding="utf-8") as f:
            data = json.load(f)
        for b in data["bases"]:
            bases.append(dict(id=str(b["id"]), name=str(b["name"]), file=os.path.join(d, str(b["file"]))))
        default = data.get("default")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        bases = []
    if not bases:
        bases = [dict(id="user", name=MAT_BASE_NAME, file=legacy)]
    if default not in [b["id"] for b in bases]:
        default = bases[0]["id"]
    return bases, default


def mat_bases_save(bases, default):
    d = os.path.dirname(mat_legacy_file())
    data = dict(default=default, bases=[dict(id=b["id"], name=b["name"], file=os.path.basename(b["file"]))
                                        for b in bases])
    try:
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "materials_index.json"), "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
        return True
    except OSError:
        return False


def mat_user_file():
    """File of the default user database (where changes are saved)."""
    bases, default = mat_bases()
    return next(b["file"] for b in bases if b["id"] == default)


def mat_active_file():
    """Database file used by the program: the user copy, or the bundled database when there is none."""
    u = mat_user_file()
    return u if os.path.exists(u) else MAT_DEFAULT


def mat_sync():
    """Bundled database newer than the user copy (program update): new bundled items (different category
    or name) are appended to the copy; user changes stay. Returns the number of appended items."""
    u = mat_legacy_file()                            # (only the first user database follows the bundled one)
    try:
        if not os.path.exists(u) or os.path.getmtime(MAT_DEFAULT) <= os.path.getmtime(u):
            return 0
        mine, _ = mat_load(u)
        new, _ = mat_load(MAT_DEFAULT)
    except (OSError, UnicodeDecodeError):
        return 0
    have = {(it["cat"], it["name"]) for it in mine}
    add = [it for it in new if (it["cat"], it["name"]) not in have]
    try:
        mat_save(u, mine + add)                      # saving also refreshes the date – the next start skips the comparison
    except OSError:
        return 0
    return len(add)


def mat_load(path):
    """Reads the material database: [Category], lines „name ; value ; unit ; source”.
    Returns (items, number of skipped lines)."""
    items, bad, catg = [], 0, "Bez kategorii"
    with open(path, encoding="utf-8-sig") as f:
        for raw in f:
            ln = raw.strip()
            if ln.startswith(MAT_EMPTY_MARK):            # group without items (created in the program)
                e = unit_exp(ln[len(MAT_EMPTY_MARK):])
                if e is not None:
                    items.append(dict(name="", value="", unit=LAB_UNITS[e], cat=catg, src="", empty=True))
                continue
            if not ln or ln.startswith("#"):
                continue
            if ln.startswith("[") and ln.endswith("]"):
                catg = ln[1:-1].strip() or "Bez kategorii"
                continue
            p = [x.strip() for x in ln.split(";")]
            if len(p) < 3 or not p[0] or mat_range(p[1]) is None or unit_exp(p[2]) is None:
                bad += 1
                continue
            items.append(dict(name=p[0], value=p[1], unit=LAB_UNITS[unit_exp(p[2])], cat=catg,
                              src=";".join(p[3:]).strip()))
    return mat_migrate(items), bad


MAT_OLD_SRC = (" – sprawdź dane producenta",)
MAT_EMPTY_MARK = "# pusta grupa ;"                      # file line of a group without items


def mat_migrate(items):
    """Databases saved by older versions: categories with the „(własne)” suffix – without it; source without
    „sprawdź dane producenta”; category „Własne” (user items) – items moved to their own categories."""
    for it in items:
        if it["cat"].endswith(" (własne)"):
            it["cat"] = it["cat"][:-len(" (własne)")]
        for old in MAT_OLD_SRC:
            it["src"] = it["src"].replace(old, "")
    legacy = [it for it in items if it["cat"] == "Własne"]
    if legacy:
        rest = [it for it in items if it["cat"] != "Własne"]
        for it in legacy:
            it["cat"] = mat_guess_category(it["name"], it["unit"], rest)
            if it["src"] in ("", "dodano z panelu obciążeń własnych"):
                it["src"] = MAT_USER_SRC
            idx = max((i for i, x in enumerate(rest) if x["cat"] == it["cat"]), default=len(rest) - 1)
            rest.insert(idx + 1, it)
        items = rest
    return items


def mat_save(path, items):
    """Saves the database in the order of the list (the order of groups and items is kept; a category header
    is written whenever the category changes). Empty groups (items with empty=True) – the „# pusta grupa”
    line, only while the group (with its subgroups) has no items of that unit."""
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    full = set()
    for it in items:
        if not it.get("empty"):
            parts = it["cat"].split(CAT_SEP)
            for i in range(len(parts)):
                full.add((CAT_SEP.join(parts[:i + 1]), it["unit"]))
    out = [MAT_HEADER]
    clean = lambda s: str(s or "").replace(";", ",").replace("\n", " ").strip()
    cur = None
    for it in items:
        if it.get("empty") and (it["cat"], it["unit"]) in full:
            continue
        if it["cat"] != cur:
            cur = it["cat"]
            out.append(f"\n[{clean(cur).replace('[', '(').replace(']', ')')}]")
        if it.get("empty"):
            out.append(f"{MAT_EMPTY_MARK} {it['unit']}")
        else:
            out.append(f"{clean(it['name'])} ; {clean(it['value'])} ; {it['unit']} ; {clean(it.get('src'))}")
    with open(path, "w", encoding="utf-8", newline="\r\n") as f:
        f.write("\n".join(out) + "\n")


def lab_item_calc(it):
    """Item result: base value × defined dimensions × multiplier (optional).
    dict(ok, val, exp, unit, formula, err)."""
    v = parse_num(str(it.get("wartosc", "")))
    exp = unit_exp(it.get("jedn"))
    if exp is None:
        return dict(ok=False, err="nieznana jednostka", val=None, exp=None, unit="", formula="")
    if v is None:
        return dict(ok=False, err="niepoprawna wartość obciążenia", val=None, exp=exp, unit=LAB_UNITS[exp],
                    formula="")
    parts, val, e = [f"{lab_fmt(v)} {LAB_UNITS[exp]}"], v, exp
    for k, nm in lab_dims(exp):
        on, txt = (it.get("wym") or {}).get(k, (False, ""))
        if not on:
            continue
        dv = parse_num(str(txt))
        if dv is None or dv <= 0:
            return dict(ok=False, err=f"niepoprawna {nm} (podaj wartość dodatnią w metrach)", val=None, exp=exp,
                        unit=LAB_UNITS[exp], formula="")
        parts.append(f"{lab_fmt(dv)} m ({nm})")
        val *= dv
        e -= 1
    mt = str(it.get("mnoznik") or "").strip()
    if mt:                                           # optional multiplier, e.g. 12 beams on a pallet
        n = parse_num(mt)
        if n is None or n <= 0:
            return dict(ok=False, err="niepoprawny mnożnik (podaj liczbę dodatnią)", val=None, exp=exp,
                        unit=LAB_UNITS[exp], formula="")
        if abs(n - 1) > 1e-12:
            parts.append(f"{lab_fmt(n, 3 if abs(n - round(n)) > 1e-9 else 0)} (mnożnik)")
            val *= n
    expr = " · ".join(parts) if len(parts) > 1 else ""
    formula = expr + (f" = {lab_fmt(val)} {LAB_UNITS[e]}" if expr else "")
    return dict(ok=True, err="", val=val, exp=e, unit=LAB_UNITS[e], formula=formula, expr=expr)


def lab_summary(items):
    """List summary: total and common unit; ok=False – empty list, invalid item or different units."""
    rows = [lab_item_calc(it) for it in items]
    if not items:
        return dict(ok=False, rows=rows, total=None, unit="", err="Brak obciążeń – dodaj je ręcznie lub z bazy.")
    bad = [i for i, r in enumerate(rows) if not r["ok"]]
    if bad:
        i = bad[0]
        return dict(ok=False, rows=rows, total=None, unit="",
                    err=f"Pozycja {i + 1} („{items[i].get('nazwa', '')}”): {rows[i]['err']}.")
    units = []
    for r in rows:
        if r["unit"] not in units:
            units.append(r["unit"])
    if len(units) > 1:
        return dict(ok=False, rows=rows, total=None, unit="",
                    err="Pozycje mają różne jednostki (" + ", ".join(units) + ") – ujednolić je (zdefiniuj wymiary), "
                        "inaczej przypadku nie można dodać do projektu.")
    return dict(ok=True, rows=rows, total=sum(r["val"] for r in rows), unit=units[0], err="")


def mat_value_text(value, unit, long=True):
    """Database value for display: a number or a clearly described range."""
    r = mat_range(value)
    if r is None:
        return f"{value} {unit}"
    lo, hi = r
    f = lambda v: f"{v:g}".replace(".", ",")
    if abs(hi - lo) < 1e-12:
        return f"{str(value).strip()} {unit}"
    return (f"zakres od {f(lo)} do {f(hi)} {unit}" + (" – do obliczeń przyjmowana górna granica" if long else ""))


def lab_sources(items):
    """Sources of item values (no duplicates, in order of first use)."""
    out = []
    for it in items:
        s = (it.get("zrodlo") or "").strip() if it.get("z_bazy") else ""
        if s and s not in out:
            out.append(s)
    return out


def lab_report(data):
    """Report of an own-loads case (case card, printout): table of items, total and value sources."""
    esc = html.escape
    items = (data or {}).get("pozycje") or []
    s = lab_summary(items)
    srcs = lab_sources(items)
    th = "style='text-align:left; padding:2px 8px 2px 0; border-bottom:1px solid #c9ced6;'"
    td = "style='padding:2px 8px 2px 0; vertical-align:top;'"
    rows = [f"<tr><th {th}>Nr</th><th {th}>Pozycja</th><th {th}>Obliczenie</th><th {th}>Wartość</th></tr>"]
    for i, (it, r) in enumerate(zip(items, s["rows"])):
        info = []
        if it.get("z_bazy"):
            src = (it.get("zrodlo") or "").strip()
            if src:
                info.append(f"źródło [{srcs.index(src) + 1}]")
        else:
            info.append("wartość wpisana ręcznie")
        if it.get("przedzial"):
            info.append(mat_value_text(it["przedzial"], it.get("jedn", ""), long=False) + " – przyjęto górną granicę")
        sub = f"<br><span style='color:{MUTED};'>{esc('; '.join(info))}</span>" if info else ""
        val = f"<b>{lab_fmt(r['val'])} {r['unit']}</b>" if r["ok"] else f"<span style='color:#b91c1c;'>{esc(r['err'])}</span>"
        rows.append(f"<tr><td {td}>{i + 1}.</td><td {td}>{esc(it.get('nazwa', ''))}{sub}</td>"
                    f"<td {td}>{esc(r['formula'])}</td><td {td}>{val}</td></tr>")
    if s["ok"]:
        tot = f"<p style='margin:6px 0 0 0;'><b>Razem: {lab_fmt(s['total'])} {s['unit']}</b></p>"
    else:
        tot = f"<p style='margin:6px 0 0 0; color:#b91c1c;'>{esc(s['err'])}</p>"
    src_html = ""
    if srcs:
        src_html = ("<p style='margin:6px 0 0 0;'><b>Źródła wartości</b><br>"
                    + "<br>".join(f"[{k + 1}] {esc(x)}" for k, x in enumerate(srcs)) + "</p>")
    return (f"<p style='margin:0 0 4px 0;'><b>Obciążenia własne</b> – zestawienie pozycji</p>"
            f"<table cellspacing='0' cellpadding='0'>{''.join(rows)}</table>{tot}{src_html}" + char_note_html())


def lab_info(data):
    """Short case description for the card header."""
    items = (data or {}).get("pozycje") or []
    s = lab_summary(items)
    n = len(items)
    poz = "pozycja" if n == 1 else ("pozycje" if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else "pozycji")
    return f"{n} {poz}" + (f" · razem {lab_fmt(s['total'])} {s['unit']}" if s["ok"] else " · niekompletne")


def _fold(s):
    """Text for searching: lower case, without Polish diacritics."""
    import unicodedata
    s = str(s or "").lower().replace("ł", "l")
    return "".join(c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c))


MAT_USER_SRC = "obciążenie zdefiniowane przez użytkownika"


def mat_db_items():
    try:
        return mat_load(mat_active_file())[0]
    except (OSError, UnicodeDecodeError):
        return []


def mat_categories(unit=None, items=None):
    """Database categories (file order); unit – only categories with items in that unit."""
    out = []
    for it in mat_db_items() if items is None else items:
        if (unit is None or it["unit"] == unit) and it["cat"] not in out:
            out.append(it["cat"])
    return out


def mat_guess_category(name, unit, items=None):
    """Category for a new item: the one whose items of the same unit share the most words with the name."""
    items = mat_db_items() if items is None else items
    words = {w for w in _fold(name).replace(",", " ").split() if len(w) >= 3}
    best, score = None, 0
    for c in mat_categories(unit, items):
        hay = _fold(c + " " + " ".join(it["name"] for it in items if it["cat"] == c and it["unit"] == unit))
        sc = sum(1 for w in words if w in hay)
        if sc > score:
            best, score = c, sc
    cats = mat_categories(unit, items)
    return best or (cats[0] if cats else "Bez kategorii")


def mat_add_to_user_db(mat):
    """New item in the user material database – in its category, after the category's last item (as if
    it had always been there); a new category – at the end of the database."""
    items = mat_db_items()
    idx = max((i for i, it in enumerate(items) if it["cat"] == mat["cat"]), default=len(items) - 1)
    items.insert(idx + 1, mat)
    mat_save(mat_user_file(), items)


class MatAddDialog(QDialog):
    """Dodaj do bazy (from the own-loads panel): name, value, category (suggested from the name), source
    (default „obciążenie zdefiniowane przez użytkownika”, editable). Does not block other windows."""

    def __init__(self, parent, item):
        super().__init__(parent)
        self.setWindowTitle("Dodaj do bazy materiałów")
        self.setModal(False)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        self.resize(560, 220)
        self.unit = item.get("jedn", "kN/m²")
        items = mat_db_items()
        g = QGridLayout(self)
        g.setHorizontalSpacing(8)
        self.e_name = QLineEdit(item.get("nazwa", "").strip())
        self.e_val = QLineEdit(str(item.get("wartosc", "")).strip())
        self.e_val.setFixedWidth(110)
        self.e_val.setAlignment(AL_R)
        self.e_cat = QComboBox()
        self.e_cat.setEditable(True)
        self.e_cat.addItems(mat_categories(self.unit, items) or mat_categories(None, items))
        self.e_cat.setCurrentText(mat_guess_category(self.e_name.text(), self.unit, items))
        self.e_cat.setToolTip("Kategoria w bazie (podkategorie oddziel „ / ”); można wpisać nową")
        self.e_src = QLineEdit(MAT_USER_SRC)
