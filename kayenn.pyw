ZONE_BORDER_TOL_KM = 1.0         # point just outside the outline of Poland (outline accuracy) – still in Poland
ZONE_NEAR_KM = 10.0              # NB1.7: 10 km band on both sides of a snow zone boundary


def _xy_km(lon, lat):
    return lon * 111.32 * math.cos(math.radians(52.0)), lat * 110.57


def _pip(x, y, poly):
    ins = False
    for i in range(len(poly)):
        x1, y1 = poly[i]
        x2, y2 = poly[i - 1]
        if (y1 > y) != (y2 > y) and x < (x2 - x1) * (y - y1) / (y2 - y1) + x1:
            ins = not ins
    return ins


def _line_dist_km(lon, lat, pts, closed=True):
    px, py = _xy_km(lon, lat)
    best = 1e9
    rng = range(len(pts)) if closed else range(1, len(pts))
    for i in rng:
        ax, ay = _xy_km(*pts[i - 1])
        bx, by = _xy_km(*pts[i])
        dx, dy = bx - ax, by - ay
        L = dx * dx + dy * dy
        t = 0.0 if L == 0 else clamp(((px - ax) * dx + (py - ay) * dy) / L, 0.0, 1.0)
        best = min(best, math.hypot(px - ax - t * dx, py - ay - t * dy))
    return best


def in_poland(lon, lat):
    rings = ZONE_DATA["poland"]
    if sum(_pip(lon, lat, r) for r in rings) % 2:
        return True
    return min(_line_dist_km(lon, lat, r) for r in rings) <= ZONE_BORDER_TOL_KM


def zone_lookup(kind, lon, lat):
    """Zone ('snow' / 'wind') for a point; returns dict(zone, near=[(km, zone)]) – zone=None outside Poland."""
    if not in_poland(lon, lat):
        return dict(zone=None, near=[])
    zone = None
    for z, rings in ZONE_DATA["zones"][kind].items():
        if sum(_pip(lon, lat, r) for r in rings) % 2:
            zone = int(z)
            break
    if zone is None:        # just outside the state border (within tolerance) – zone of the nearest area
        zone = int(min(ZONE_DATA["zones"][kind].items(),
                       key=lambda zr: min(_line_dist_km(lon, lat, r) for r in zr[1]))[0])
    near = []
    for z, lines in ZONE_DATA["bnd"][kind].items():
        if int(z) == zone or not lines:
            continue
        d = min(_line_dist_km(lon, lat, ln, closed=False) for ln in lines)
        if d <= ZONE_NEAR_KM:
            near.append((round(d, 1), int(z)))
    return dict(zone=zone, near=sorted(near))


# Cadastral parcels – ULDK service (Parcel Location Service, GUGiK)
ULDK_URL = "https://uldk.gugik.gov.pl/"
ULDK_FIELDS = ("geom_wkt", "id", "voivodeship", "county", "commune", "region", "parcel")


def uldk_url(query):
    """GetParcelByIdOrNr query: „Precinct number” (e.g. „Kaleń Pierwszy 123/4”) or a full parcel identifier."""
    from urllib.parse import quote, urlencode
    return ULDK_URL + "?" + urlencode(dict(request="GetParcelByIdOrNr", id=query, result=",".join(ULDK_FIELDS),
                                           srid="4326"), quote_via=quote, safe=",/")


def uldk_parse(text):
    """ULDK response -> list of parcels: dict(id, parcel, region, commune, county, voivodeship,
    polys=[[outline, holes...], ...] in [lon, lat], bbox, lon, lat, area [m²]). LookupError when the service reports no results."""
    import re
    lines = [ln.strip() for ln in text.strip().splitlines() if ln.strip()]
    if not lines:
        raise LookupError("usługa zwróciła pustą odpowiedź")
    if lines[0].startswith("-1"):
        raise LookupError(lines[0][2:].strip(" :") or "nie znaleziono działki")
    counted = re.fullmatch(r"\d+", lines[0]) is not None
    recs = lines[1:] if counted else lines
    if not counted and not any("|" in r for r in recs):
        raise RuntimeError("usługa zgłosiła błąd: " + lines[0][:160])
    out = []
    for rec in recs:
        parts = rec.split("|")
        if len(parts) < len(ULDK_FIELDS):
            continue
        d = dict(zip(ULDK_FIELDS, (x.strip() for x in parts)))
        geom = d.pop("geom_wkt").split(";")[-1]
        rings = []
        for grp in re.findall(r"\(([^()]+)\)", geom):
            pts = [tuple(float(v) for v in xy.split()[:2]) for xy in grp.split(",") if xy.strip()]
            if pts and 45.0 < pts[0][0] < 56.0 and 13.0 < pts[0][1] < 25.0:     # axis order lat, lon
                pts = [(b, a) for a, b in pts]
            if len(pts) >= 3:
                rings.append([[round(x, 7), round(y, 7)] for x, y in pts])
        if not rings:
            continue
        lat0 = rings[0][0][1]
        kx, ky = 111320.0 * math.cos(math.radians(lat0)), 110574.0

        def shoelace(r):
            return sum(r[i - 1][0] * r[i][1] - r[i][0] * r[i - 1][1] for i in range(len(r))) / 2.0
        a0 = shoelace(rings[0])
        cx = sum((rings[0][i - 1][0] + rings[0][i][0]) * (rings[0][i - 1][0] * rings[0][i][1] - rings[0][i][0] * rings[0][i - 1][1])
                 for i in range(len(rings[0]))) / (6 * a0) if a0 else rings[0][0][0]
        cy = sum((rings[0][i - 1][1] + rings[0][i][1]) * (rings[0][i - 1][0] * rings[0][i][1] - rings[0][i][0] * rings[0][i - 1][1])
                 for i in range(len(rings[0]))) / (6 * a0) if a0 else rings[0][0][1]
        if not _pip(cx, cy, rings[0]):          # concave parcel – centre point outside it: nearest vertex
            cx, cy = min(rings[0], key=lambda q: (q[0] - cx) ** 2 + (q[1] - cy) ** 2)
        polys = [[rings[0]]]                    # ring inside the first one = hole, outside it = another part
        for r in rings[1:]:
            if _pip(r[0][0], r[0][1], rings[0]):
                polys[0].append(r)
            else:
                polys.append([r])
        area = sum(abs(shoelace(P[0])) - sum(abs(shoelace(h)) for h in P[1:]) for P in polys) * kx * ky
        xs = [q[0] for P in polys for q in P[0]]
        ys = [q[1] for P in polys for q in P[0]]
        d.update(polys=polys, bbox=[min(xs), min(ys), max(xs), max(ys)], lon=cx, lat=cy, area=round(area, 1))
        out.append(d)
    return out


def uldk_search(query, timeout=30):
    """Query to the ULDK service; returns dict(ok, items | msg) ready to pass to the map."""
    import urllib.request
    try:
        req = urllib.request.Request(uldk_url(query), headers={"User-Agent": "KAYENN/1.0"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            text = r.read().decode("utf-8", "replace")
        items = uldk_parse(text)
        if not items:
            raise LookupError("brak wyników")
        return dict(ok=True, items=items)
    except LookupError as e:
        msg = str(e)
        return dict(ok=False, msg="Nie znaleziono działki (" + html.escape(msg) + "). Nazwa obrębu w ewidencji może "
                    "różnić się od nazwy miejscowości – sprawdź ją w wypisie lub podaj pełny identyfikator działki.")
    except Exception as e:      # no network, timeout, service error
        return dict(ok=False, msg="Usługa wyszukiwania działek (ULDK, GUGiK) nie odpowiada: " + html.escape(str(e)))


