class Var:
    """Value with change notification (counterpart of tkinter variables)."""

    def __init__(self, value):
        self._v = value
        self._cb = []

    def get(self):
        return self._v

    def set(self, v):
        if v == self._v:
            return
        self._v = v
        for cb in list(self._cb):
            cb()

    def trace(self, cb):
        self._cb.append(cb)


class LabelX(QLabel):
    def configure(self, text=None, **kw):
        if text is not None and text != self.text():
            self.setText(text)

    def cget(self, what):
