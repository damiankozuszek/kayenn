            self._status(f"dołączono nowe pozycje z bazy programu: {n_new}")
        self.search.setFocus()

    # --- data
    def load(self, path, reset=True):
        try:
            items, bad = mat_load(path)
        except (OSError, UnicodeDecodeError) as e:
            items, bad = [], 0
            QMessageBox.warning(self, "Baza materiałów", f"Nie można odczytać bazy:\n{path}\n{e}")
        self.mats, self.order = {}, []
        for it in items:
            self._put(it)
        self.path = path
        self.sel_key = self.sel_group = None
        self.msel, self._anchor = set(), None
        if reset:
            self.hist.reset(self._snap())
        else:
            self.hist.push(self._snap())
        self._dirty_changed()
        self.rebuild()
        n = sum(1 for it in items if not it.get("empty"))
        self._status(f"{n} pozycji" + (f" (pominięto błędne wiersze: {bad})" if bad else ""))
        return n, bad

    def _put(self, it, after=None):
        self._key += 1
        self.mats[self._key] = it
        if after in self.order:
            self.order.insert(self.order.index(after) + 1, self._key)
        else:
            self.order.append(self._key)
        return self._key

    def categories(self):
        out = []
        for k in self.order:
            c = self.mats[k]["cat"]
            if c not in out:
                out.append(c)
        return out

    def _snap(self):
        return [dict(self.mats[k]) for k in self.order]

    def dirty(self):
        return not self.hist.at_saved()

    def base_name(self):
        bases, default = mat_bases()
        return next(b["name"] for b in bases if b["id"] == default)

    def _dirty_changed(self):
        """Title with an asterisk and the Zapisz do bazy item while there are unsaved changes."""
        d = self.dirty()
        if hasattr(self, "act_save"):
            self.act_save.setEnabled(d)
        self.setWindowTitle("Baza materiałów – " + self.base_name() + (" *" if d else ""))

    def save(self):
        """A change of the database: a Cofnij step. NOT written to the file – only Zapisz do bazy writes it."""
        self.hist.push(self._snap())
        self._status("zmiany niezapisane (Plik bazy → Zapisz do bazy)")

    def commit(self):
        """Plik bazy → Zapisz do bazy: the default user database file is written."""
        p = mat_user_file()
        try:
            mat_save(p, [self.mats[k] for k in self.order])
        except OSError as e:
            QMessageBox.warning(self, "Baza materiałów", f"Nie można zapisać bazy:\n{p}\n{e}")
            return False
        self.path = p
        self.hist.mark_saved()
        self._dirty_changed()
        self._status("zapisano do bazy")
        return True

    def confirm_close(self):
        """Unsaved changes – question „Zapisać do bazy?” (Cancel – stay). True – may close."""
        if not self.dirty():
            return True
        B = QMessageBox.StandardButton
        r = QMessageBox.question(self, "Baza materiałów", f"Zapisać zmiany w bazie „{self.base_name()}”?",
                                 B.Yes | B.No | B.Cancel, B.Yes)
        if r == B.Cancel:
            return False
        if r == B.Yes:
            return self.commit()
        return True

    def closeEvent(self, e):
        if self._force or self.confirm_close():
            e.accept()
        else:
            e.ignore()

    def reject(self):
        self.close()

    def keyPressEvent(self, e):
        """Enter on a selected item (focus in the list) – Dodaj (the item goes to the own-loads panel)."""
        if e.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter) and \
                not isinstance(self.focusWidget(), (QLineEdit, QPushButton, MatHeader)):
            if self.current_key() is not None and len(self.msel) == 1:
                self.add()
            elif self.sel_group and self.sel_group[1] and len(self.msel) == 1 and self.sel_group in self.heads:
                hd = self.heads[self.sel_group]
                self.header_clicked(hd)
                hd = self.heads.get(self.sel_group)
                if hd is not None:
                    hd.setFocus()
            e.accept()
            return
        super().keyPressEvent(e)

    def undo(self, redo=False):
        """Cofnij / Ponów – the previous / next state of the database (not written to the file)."""
        if not (self.hist.can_redo() if redo else self.hist.can_undo()):
            return
        st = self.hist.redo() if redo else self.hist.undo()
        sel = self.mats.get(self.sel_key)
        self.mats, self.order = {}, []
        for it in st:
            self._put(dict(it))
        self.sel_key = next((k for k in self.order if sel and self.mats[k]["name"] == sel["name"]
                             and self.mats[k]["unit"] == sel["unit"]), None)
        self._dirty_changed()
        self.rebuild()
        self._status("przywrócono następny stan" if redo else "cofnięto zmianę")

    def redo(self):
        self.undo(redo=True)

    def switch_base(self):
        """The default database changed (Zarządzaj bazami materiałów): the new one is loaded."""
        self.load(mat_active_file())

    def open_bases(self):
        if self._mgr is not None:
            self._mgr.raise_()
            self._mgr.activateWindow()
            return self._mgr
        d = MatBasesDialog(self)
        d.destroyed.connect(lambda *a: setattr(self, "_mgr", None))
        self._mgr = d
        d.show()
        return d

    def add_loaded(self, mat):
        """An item added to the database file from outside (Dodaj do bazy) while this window has unsaved changes."""
        idx = max((i for i, k in enumerate(self.order) if self.mats[k]["cat"] == mat["cat"]),
                  default=len(self.order) - 1)
        self._put(dict(mat), after=self.order[idx] if self.order else None)
        self.hist.push(self._snap())
        self.rebuild()

    def _status(self, extra=""):
        self.status.setText(f"Baza: {self.base_name()} · plik: {self.path}"
                            + (" · zmiany niezapisane" if self.dirty() else "") + (f" – {extra}" if extra else ""))

    # --- view
    def matches(self):
        words = _fold(self.search.text()).split()
        if not words:
            return None
        out = set()
        for k in self.order:
            it = self.mats[k]
            if it.get("empty"):
                continue
            hay = _fold(" ".join((it["name"], it["value"], it["unit"], it["cat"], it.get("src", ""),
                                  mat_value_text(it["value"], it["unit"]))))
            if all(w in hay for w in words):
                out.add(k)
        return out

    def searching(self):
        return bool(self.search.text().strip())

    def rebuild(self, select=None, rename=None, keep=True):
        """Rebuilds the list. select – item key to select (its groups expanded); rename – (e, path) of a group
        header to rename at once (a new group); keep – the list stays where it was (False – new search)."""
        if select is not None:
            self.sel_key, self.sel_group = select, None
            self.msel = {("i", select)}
        self._end_drag(apply=False)
        sb = self.scroll.verticalScrollBar()
        pos = sb.value() if keep else 0
        while self.vl.count():
            w = self.vl.takeAt(0).widget()
            if w is not None:
                w.hide()
                w.deleteLater()
        self.tiles, self.heads, self.rows = {}, {}, []
        hit = self.matches()
        auto = hit is not None and len(hit) <= MAT_AUTO_OPEN
        keys = [k for k in self.order if hit is None or k in hit]
        if self.sel_key is not None and select is not None:      # selected item – its group and category visible
            it = self.mats.get(self.sel_key)
            if it:
                self._open_path(unit_exp(it["unit"]), tuple(it["cat"].split(CAT_SEP)))
        roots, groups, items = self._tree(keys)
        count = lambda n: sum(1 if c["kind"] == "item" else count(c) for c in n["ch"])
        for e in (3, 2, 1, 0):
            r = roots[e]
            if hit is not None and not r["ch"]:
                continue
            g_open = auto or e in self.open_groups
            self._add_row(MatHeader(self, "unit", e, (), LAB_GROUPS[e], count(r), 0, g_open),
                          "unit", e, (), None, 0, g_open)
            if g_open:
                self._add_children(r, (), 1, auto)
        if not any(not self.mats[k].get("empty") for k in keys):
            lb = QLabel("Brak pozycji pasujących do wyszukiwania." if hit is not None else "Baza jest pusta.")
            lb.setObjectName("muted")
            self.vl.addWidget(lb)
        elif hit is not None and not auto:
            lb = QLabel(f"Pasujących pozycji: {len(hit)} – zawęź wyszukiwanie albo rozwiń kategorię.")
            lb.setObjectName("muted")
            self.vl.insertWidget(0, lb)
        self.vl.addStretch(1)
        # the list stays in place (does not jump to the top): the position is held while the rebuilt list
        # settles its height (like keep_view in the main window)
        self._hold = (pos, time.monotonic() + 1.0)
        self.vl.activate()
        self._apply_hold()
        for ms in (0, 50, 200, 500, 900):
            QTimer.singleShot(ms, self._apply_hold)
        if self.sel_key not in self.mats:
            self.sel_key = None
        t = self.tiles.get(self.sel_key)
        valid = {("i", k) for k in self.tiles} | {("g", e_, p_) for (e_, p_) in self.heads if p_}
        self.msel &= valid                               # selection only among visible rows
        if not self.msel:
            if t is not None:
                self.msel = {("i", self.sel_key)}
            elif self.sel_group in self.heads and self.sel_group[1]:
                self.msel = {("g",) + tuple(self.sel_group)}
        self._paint_sel()
        if t is not None and select is not None:
            self._reveal(t)
        if rename is not None and rename in self.heads:
            h = self.heads[rename]
            self._reveal(h)
            QTimer.singleShot(0, h.start_rename)

    def _reveal(self, w):
        """Scrolls the list to w only when it is really outside the view – and after the list has settled (a widget
        not yet laid out sits at y = 0, scrolling to it threw the list to the top)."""
        def go():
            try:
                sb, vh = self.scroll.verticalScrollBar(), self.scroll.viewport().height()
                want = self._hold[0] if self._hold else sb.value()      # (the bar itself may be clamped for a moment)
                if not w.isVisible() or w.height() <= 1 or sb.maximum() < want:
                    return                                    # list not settled yet – the next timer
                y = w.mapTo(self.inner, QPoint(0, 0)).y()
                nv = want
                if y < want:
                    nv = max(y - 20, 0)
                elif y + w.height() > want + vh:
                    nv = y + w.height() - vh + 20
                if nv != want:
                    if self._hold:
                        self._hold = (nv, self._hold[1])
                    sb.setValue(nv)
            except RuntimeError:                              # widget replaced in the meantime
                pass
        for ms in (60, 250, 600):
            QTimer.singleShot(ms, go)

    def _apply_hold(self, *args):
        h = getattr(self, "_hold", None)
        if not h:
            return
        if time.monotonic() > h[1]:
            self._hold = None
            return
        self.scroll.verticalScrollBar().setValue(h[0])

    def _add_row(self, w, kind, e, path, key, level, opened=False):
        self.vl.addWidget(w)
        self.rows.append(dict(w=w, kind=kind, e=e, path=path, key=key, level=level, open=opened))
        if kind == "item":
            self.tiles[key] = w
        else:
            self.heads[(e, path)] = w

    def _add_children(self, node, path, level, auto):
        count = lambda n: sum(1 if c["kind"] == "item" else count(c) for c in n["ch"])
        for c in node["ch"]:
            if c["kind"] == "group":
                p = path + (c["name"],)
                opened = auto or CAT_SEP.join(p) in self.open_cats
                self._add_row(MatHeader(self, "group", c["e"], p, c["name"], count(c), level, opened),
                              "group", c["e"], p, None, level, opened)
                if opened:
                    self._add_children(c, p, level + 1, auto)
            else:
                t = MaterialTile(self, c["key"])
                t.setStyleSheet(f"QFrame#tile {{ margin-left: {level * MAT_INDENT}px; }}")
                self._add_row(t, "item", c["e"], path, c["key"], level)

    def _open_path(self, e, path):
        self.open_groups.add(e)
        for i in range(len(path)):
            self.open_cats.add(CAT_SEP.join(path[:i + 1]))

    # --- selection (click; Ctrl – add / remove; Shift – range from the last clicked row)
    def _entry(self, r):
        return ("i", r["key"]) if r["kind"] == "item" else ("g", r["e"], r["path"])

    def click_entry(self, entry, mods):
        ctrl = bool(mods & (Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.MetaModifier))
        order = [self._entry(r) for r in self.rows if r["kind"] != "unit"]
        if mods & Qt.KeyboardModifier.ShiftModifier and self._anchor in order and entry in order:
            a, b = sorted((order.index(self._anchor), order.index(entry)))
            rng = set(order[a:b + 1])
            self.msel = (self.msel | rng) if ctrl else rng
        elif ctrl:
            self.msel ^= {entry}
            self._anchor = entry
        else:
            self.msel = {entry}
            self._anchor = entry
        if entry in self.msel:
            if entry[0] == "i":
                self.sel_key, self.sel_group = entry[1], None
            else:
                self.sel_key, self.sel_group = None, tuple(entry[1:])
        else:
            if entry[0] == "i" and self.sel_key == entry[1]:
                self.sel_key = None
            if entry[0] == "g" and self.sel_group == tuple(entry[1:]):
                self.sel_group = None
        hd = self.heads.get((entry[1], entry[2])) if entry[0] == "g" else None
        (hd or self.inner).setFocus()                    # a group keeps the focus – Enter expands / collapses it
        self._paint_sel()

    def clear_msel(self):
        if self.msel:
            self.msel = set()
            self.sel_key = self.sel_group = None
            self._paint_sel()

    def _paint_sel(self):
        for k, t in self.tiles.items():
            t.set_selected(("i", k) in self.msel)
        for (e, path), h in self.heads.items():
            if path:
                h.set_flag("sel", ("g", e, path) in self.msel)
        self.btn_add.setEnabled(self.current_key() is not None and len(self.msel) == 1)
        self.btn_del_sel.setVisible(bool(self.msel))

    def set_all_open(self, opened):
        """Rozwiń wszystko / Zwiń wszystko – all groups of the database."""
        if opened:
            self.open_groups = {3, 2, 1, 0}
            self.open_cats = {CAT_SEP.join(p) for (e, p) in self._tree()[1]}
        else:
            self.open_groups, self.open_cats = set(), set()
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            self.rebuild()
        finally:
            QApplication.restoreOverrideCursor()

    def _sel_nodes(self, tree, e=None):
        """Selected rows as nodes of the tree (list order); a node inside another selected group is dropped;
        e – only nodes of that unit group."""
        roots, groups, items = tree
        nodes = []
        for en in self.msel:
            nd = items.get(en[1]) if en[0] == "i" else groups.get((en[1], en[2]))
            if nd is not None and (e is None or nd["e"] == e):
                nodes.append(nd)
        ids = {id(n) for n in nodes}

        def inside(n):
            par = n["parent"]
            while par is not None:
                if id(par) in ids:
                    return True
                par = par["parent"]
            return False
        nodes = [n for n in nodes if not inside(n)]
        order = {}

        def walk(n):
            for c in n["ch"]:
                order[id(c)] = len(order)
                walk(c)
        for r_ in roots.values():
            walk(r_)
        return sorted(nodes, key=lambda n: order.get(id(n), 0))

    def group_selected(self):
        """Utwórz podgrupę z zaznaczonych: a new subgroup at the place of the first selected row, the selected
        items / groups move into it (one unit group only); its name is edited at once."""
        tree = self._tree()
        roots = tree[0]
        nodes = self._sel_nodes(tree)
        if not nodes:
            return None
        es = {n["e"] for n in nodes}
        if len(es) > 1:
            QMessageBox.warning(self, "Baza materiałów", "Zaznaczone pozycje należą do różnych grup obciążeń "
                                "(jednostek) – nie można ich połączyć w jedną podgrupę.")
            return None
        par = nodes[0]["parent"]
        moved = {id(n) for n in nodes}
        pos = sum(1 for c in par["ch"][:par["ch"].index(nodes[0])] if id(c) not in moved)
        for n in nodes:
            n["parent"]["ch"].remove(n)
        g = self._new_group_node(par, "Nowa podgrupa", nodes)
        par["ch"].insert(pos, g)
        self._unique(g)
        self._open_path(g["e"], self._path(g))
        self._finish(roots, g, rename=g)
        return (g["e"], self._path(g))

    def delete_selected(self):
        """Usuń zaznaczone: items and whole groups (with their contents); question."""
        tree = self._tree()
        roots = tree[0]
        nodes = self._sel_nodes(tree)
        if not nodes:
            return False

        def count(n):
            return 1 if n["kind"] == "item" else sum(count(c) for c in n["ch"])
        n_items = sum(count(n) for n in nodes)
        n_groups = sum(1 for n in nodes if n["kind"] == "group")
        B = QMessageBox.StandardButton
        txt = f"Usunąć zaznaczone z bazy: pozycje – {n_items}" + (f", w tym grupy – {n_groups} (razem z zawartością)"
                                                                if n_groups else "") + "?"
        if QMessageBox.question(self, "Baza materiałów", txt, B.Yes | B.No, B.No) != B.Yes:
            return False
        for n in nodes:
            n["parent"]["ch"].remove(n)
        self.msel, self.sel_key, self.sel_group = set(), None, None
        self._apply_tree(roots)
        self.rebuild()
        return True

    def tile_menu(self, tile, gpos):
        """Right click on a tile: Utwórz podgrupę (from the selection), Usuń zaznaczone."""
        from PySide6.QtWidgets import QMenu
        if ("i", tile.key) not in self.msel:
            self.click_entry(("i", tile.key), Qt.KeyboardModifier.NoModifier)
        n = len(self.msel)
        m = QMenu(self)
        m.addAction("Utwórz podgrupę" if n == 1 else f"Utwórz podgrupę z zaznaczonych ({n})").triggered.connect(
            lambda checked=False: self.group_selected())
        if n > 1:
            m.addAction(f"Usuń zaznaczone ({n})").triggered.connect(lambda checked=False: self.delete_selected())
        m.exec(gpos)

    def select(self, key):
        self.msel, self._anchor = {("i", key)}, ("i", key)
        self.sel_key, self.sel_group = key, None
        if key in self.tiles:
            self.inner.setFocus()
        self._paint_sel()

    def header_clicked(self, hd):
        """Chevron button of a header: selects it and expands / collapses (the only way to expand)."""
        self.sel_group, self.sel_key = (hd.e, hd.path), None
        self.msel = {("g", hd.e, hd.path)} if hd.kind == "group" else set()
        if hd.kind == "unit":
            self.open_groups ^= {hd.e}
        else:
            self.open_cats ^= {CAT_SEP.join(hd.path)}
        self.inner.setFocus()
        self.rebuild()

    def current_key(self):
        return self.sel_key if self.sel_key in self.tiles else None

    # --- structure: the flat list as a tree (units → groups → items)
    def _tree(self, keys=None):
        roots = {e: dict(kind="unit", e=e, name=LAB_GROUPS[e], ch=[], parent=None) for e in (3, 2, 1, 0)}
        groups, items = {}, {}
        for k in self.order if keys is None else keys:
            it = self.mats[k]
            e = unit_exp(it["unit"])
            par, path = roots[e], ()
            for p in it["cat"].split(CAT_SEP):
                path += (p,)
                if (e, path) not in groups:
                    g = dict(kind="group", e=e, name=p, ch=[], parent=par)
                    par["ch"].append(g)
                    groups[(e, path)] = g
                par = groups[(e, path)]
            if not it.get("empty"):
                n = dict(kind="item", e=e, key=k, ch=[], parent=par)
                par["ch"].append(n)
                items[k] = n
        return roots, groups, items

    @staticmethod
    def _path(node):
        out = []
        while node is not None and node["kind"] == "group":
            out.append(node["name"])
            node = node["parent"]
        return tuple(reversed(out))

    @classmethod
    def _level(cls, node):
        if node["kind"] == "unit":
            return 0
        return len(cls._path(node)) if node["kind"] == "group" else len(cls._path(node["parent"])) + 1

    @staticmethod
    def _unique(node):
        """Group name unique among its sibling groups (otherwise they would merge in the file)."""
        base = node["name"]
        names = {c["name"] for c in node["parent"]["ch"] if c is not node and c["kind"] == "group"}
        name, n = base, 2
        while name in names:
            name, n = f"{base} ({n})", n + 1
        node["name"] = name

    def _apply_tree(self, roots):
        """The tree back to the flat list (the tree order; empty groups – empty=True items) and saved."""
        mats, order = {}, []

        def walk(n, path):
            for c in n["ch"]:
                if c["kind"] == "group":
                    p = path + (c["name"],)
                    if not c["ch"]:
                        self._key += 1
                        mats[self._key] = dict(name="", value="", unit=LAB_UNITS[c["e"]], cat=CAT_SEP.join(p),
                                               src="", empty=True)
                        order.append(self._key)
                    walk(c, p)
                else:
                    it = self.mats[c["key"]]
                    it["cat"] = CAT_SEP.join(path) or "Bez kategorii"
                    mats[c["key"]] = it
                    order.append(c["key"])
        for e in (3, 2, 1, 0):
            walk(roots[e], ())
        self.mats, self.order = mats, order
        self.save()

    def _finish(self, roots, node, old_open=None, rename=None):
        """After a change of the structure: saved, the moved node visible (and selected), its expansion kept."""
        self.msel = set()
        if node["kind"] == "group":
            new = CAT_SEP.join(self._path(node))
            if old_open is not None:
                for c in list(self.open_cats):
                    if c == old_open or c.startswith(old_open + CAT_SEP):
                        self.open_cats.add(new + c[len(old_open):])
        self._apply_tree(roots)
        e = node["e"]
        if node["kind"] == "item":
            self._open_path(e, self._path(node["parent"]))
            self.rebuild(select=node["key"], rename=(e, self._path(rename)) if rename is not None else None)
        else:
            self._open_path(e, self._path(node["parent"]) if node["parent"]["kind"] == "group" else ())
            self.sel_key, self.sel_group = None, (e, self._path(node))
            if rename is not None:
                self._open_path(e, self._path(rename))
            self.rebuild(rename=(e, self._path(rename)) if rename is not None else None)
            hd = self.heads.get(self.sel_group)
            for ms in (0, 150, 500):                     # again after the layout settles
                QTimer.singleShot(ms, lambda key=self.sel_group: self._show_head(key))

    def _show_head(self, key):
        hd = self.heads.get(key)
        if hd is not None:
            try:
                self.scroll.ensureWidgetVisible(hd, 50, 80)
            except RuntimeError:
                pass

    def _node_of(self, row, tree):
        roots, groups, items = tree
        if row["kind"] == "item":
            return items.get(row["key"])
        return groups.get((row["e"], row["path"])) if row["kind"] == "group" else roots[row["e"]]

    def _new_group_node(self, parent, name, children=()):
        g = dict(kind="group", e=parent["e"], name=name, ch=list(children), parent=parent)
        for c in g["ch"]:
            c["parent"] = g
        return g

    def new_group(self, hd):
        """Nowa grupa (unit header) / Nowa podgrupa (group header) – at the end, name edited at once."""
        roots, groups, items = self._tree()
        par = roots[hd.e] if hd.kind == "unit" else groups[(hd.e, hd.path)]
        g = self._new_group_node(par, "Nowa grupa" if hd.kind == "unit" else "Nowa podgrupa")
        par["ch"].insert(0, g)                           # a new group goes to the start
        self._unique(g)
        self._open_path(hd.e, self._path(g))
        self._finish(roots, g, rename=g)
        return (hd.e, self._path(g))

    def rename_group(self, e, path, name, focus=False):
        """Zmień nazwę grupy / podgrupy (with its subgroups); False – invalid name. focus – the group keeps the
        keyboard focus (Enter in the name field)."""
        name = mat_clean_group(name)
        roots, groups, items = self._tree()
        g = groups.get((e, tuple(path)))
        if not name or g is None:
            return False
        old = CAT_SEP.join(path)
        g["name"] = name
        self._unique(g)
        self._finish(roots, g, old)
        hd = self.heads.get(self.sel_group)
        if focus and hd is not None:
            hd.setFocus()
        return True

    def delete_group(self, hd):
        roots, groups, items = self._tree()
        g = groups.get((hd.e, hd.path))
        if g is None:
            return False
        n = sum(1 for k, it in items.items() if self._path(it["parent"])[:len(hd.path)] == hd.path)
        if n:
            B = QMessageBox.StandardButton
            if QMessageBox.question(self, "Baza materiałów", f"Usunąć grupę „{hd.path[-1]}” razem z jej pozycjami "
                                    f"({n})?", B.Yes | B.No, B.No) != B.Yes:
                return False
        g["parent"]["ch"].remove(g)
        self.sel_group = None
        self._apply_tree(roots)
        self.rebuild()
        return True

    # --- right-click menu (only what dragging cannot do)
    def row_menu(self, w, gpos):
        from PySide6.QtWidgets import QMenu
        if w.kind == "group":
            if ("g", w.e, w.path) not in self.msel:
                self.click_entry(("g", w.e, w.path), Qt.KeyboardModifier.NoModifier)
        else:
            self.sel_group, self.sel_key, self.msel = (w.e, w.path), None, set()
            self._paint_sel()
        n = len(self.msel)
        m = QMenu(self)
        if w.kind == "unit":
            acts = [("Nowa grupa", lambda: self.new_group(w))]
        else:
            acts = [("Zmień nazwę", w.start_rename), ("Nowa podgrupa", lambda: self.new_group(w))]
            if n > 1:
                acts.append((f"Utwórz podgrupę z zaznaczonych ({n})", self.group_selected))
                acts.append((f"Usuń zaznaczone ({n})", self.delete_selected))
            else:
                acts.append(("Usuń grupę", lambda: self.delete_group(w)))
        for txt, fn in acts:
            m.addAction(txt).triggered.connect(lambda checked=False, fn=fn: fn())
        m.exec(gpos)

    # --- dragging (⠿ handle): vertically – order, to the right – indent, to the left – outdent
    def wire_handle(self, handle, w):
        handle.setCursor(Qt.CursorShape.OpenHandCursor)
        handle.setToolTip("Przeciągnij: w górę / w dół – kolejność, w prawo – wcięcie (podgrupa), w lewo – poziom wyżej")
        handle.mousePressEvent = lambda e: self._drag_press(w, e)
        handle.mouseMoveEvent = lambda e: self._drag_move(w, e)
        handle.mouseReleaseEvent = lambda e: self._drag_release(w, e)

    def _row_of(self, w):
        return next((r for r in self.rows if r["w"] is w), None)

    def _drag_press(self, w, e):
        if e.button() == Qt.MouseButton.LeftButton and not self.searching():
            self._drag = dict(w=w, start=e.globalPosition().toPoint(), on=False, opt=None)

    def _drag_move(self, w, e):
        d = self._drag
        if d is None or d["w"] is not w:
            return
        gp = e.globalPosition().toPoint()
        if not d["on"]:
            if (gp - d["start"]).manhattanLength() < 5:
                return
            row = self._row_of(w)
            if row is None:
                return
            i = self.rows.index(row)
            j = i + 1
            if row["kind"] == "group":                   # the group with its contents moves
                while j < len(self.rows) and self.rows[j]["level"] > row["level"]:
                    j += 1
            d.update(on=True, row=row, cand=self.rows[:i] + self.rows[j:], tree=self._tree())
            d["x"] = self._node_of(row, d["tree"])
            w.setProperty("lifted", True)
            w.style().unpolish(w)
            w.style().polish(w)
            QApplication.setOverrideCursor(Qt.CursorShape.ClosedHandCursor)
        vp = self.scroll.viewport()
        vy = vp.mapFromGlobal(gp).y()
        sb = self.scroll.verticalScrollBar()
        if vy < 30:
            sb.setValue(sb.value() - 20)
        elif vy > vp.height() - 30:
            sb.setValue(sb.value() + 20)
        self._drag_place(gp)

    def _drop_options(self, x, a_row, b_row):
        """Places for the dragged node x after the row a_row (b_row – the next row): (level, action, node)."""
        if a_row is None or a_row["e"] != x["e"]:
            return []
        tree = self._drag["tree"]
        a = self._node_of(a_row, tree)
        if a is None:
            return []
        lv = self._level
        b_lvl = None
        if b_row is not None and b_row["e"] == x["e"]:
            b = self._node_of(b_row, tree)
            b_lvl = lv(b) if b is not None else None
        opts = []
        if a["kind"] in ("unit", "group") and a_row["open"]:
            opts.append((lv(a) + 1, "into", a))
        if a["kind"] == "group" and not a_row["open"]:
            opts.append((lv(a) + 1, "end", a))
        if a["kind"] == "item":
            opts.append((lv(a) + 1, "wrap", a))
        n = a
        while n["kind"] != "unit" and not (b_lvl is not None and b_lvl > lv(n)):
            opts.append((lv(n), "after", n))
            n = n["parent"]
        return [o for o in opts if o[0] >= (2 if x["kind"] == "item" else 1)]

    def _drag_place(self, gp):
        d = self._drag
        p = self.inner.mapFromGlobal(gp)
        cand = d["cand"]
        k = next((i for i, r in enumerate(cand) if p.y() < r["w"].y() + r["w"].height() / 2), len(cand))
        a_row = cand[k - 1] if k > 0 else None
        b_row = cand[k] if k < len(cand) else None
        opts = self._drop_options(d["x"], a_row, b_row)
        want = self._level(d["x"]) + round((gp.x() - d["start"].x()) / (2 * MAT_INDENT))
        d["opt"] = min(opts, key=lambda o: (abs(o[0] - want), -o[0])) if opts else None
        if d["opt"] is None:
            self.slot.hide()
            return
        lvl, act = d["opt"][0], d["opt"][1]
        y = (b_row["w"].y() - 2) if b_row is not None else (a_row["w"].y() + a_row["w"].height() + 2)
        x0 = lvl * MAT_INDENT + 16
        self.slot.setText("nowa podgrupa" if act == "wrap" else "")
        h = 18 if act == "wrap" else 8
        self.slot.setGeometry(x0, int(y - h / 2), max(self.inner.width() - x0 - 6, 40), h)
        self.slot.show()
        self.slot.raise_()

    def _drag_release(self, w, e):
        self._end_drag(apply=True)

    def _end_drag(self, apply):
        d, self._drag = self._drag, None
        if d is None or not d.get("on"):
            return
        QApplication.restoreOverrideCursor()
        self.slot.hide()
        try:
            d["w"].setProperty("lifted", False)
            d["w"].style().unpolish(d["w"])
            d["w"].style().polish(d["w"])
        except RuntimeError:
            pass
        if apply and d["opt"] is not None:
            QTimer.singleShot(0, lambda: self.drop(d["x"], d["opt"], d["tree"]))

    def drop(self, x, opt, tree):
        """Puts the dragged node x at the place opt = (level, action, node) of the tree."""
        roots = tree[0]
        lvl, act, n = opt
        old = CAT_SEP.join(self._path(x)) if x["kind"] == "group" else None
        src = x["parent"]
        src_auto = src["kind"] == "group" and (src["e"], self._path(src)) in self._auto
        src["ch"].remove(x)
        rename = None
        if act == "into":
            n["ch"].insert(0, x)
            x["parent"] = n
        elif act == "end":                               # a group goes to the start of the target, an item to its end
            n["ch"].insert(0, x) if x["kind"] == "group" else n["ch"].append(x)
            x["parent"] = n
        elif act == "after":
            sib = n["parent"]["ch"]
            sib.insert(sib.index(n) + 1, x)
            x["parent"] = n["parent"]
        else:                                            # wrap – a new subgroup with only x after the item n
            many = [nd for nd in self._sel_nodes(tree, x["e"]) if nd is not x] \
                if x["kind"] == "item" and ("i", x["key"]) in self.msel else []
            many = [nd for nd in many if nd is not n] if len(self.msel) > 1 else []
            sib = n["parent"]["ch"]
            if many:                                     # the selected rows go together (x stays in its order)
                allx = [x] + many
                for nd in many:
                    nd["parent"]["ch"].remove(nd)
                g = self._new_group_node(n["parent"], "Nowa podgrupa", allx)
            else:
                g = self._new_group_node(n["parent"], "Nowa podgrupa", [x])
            sib.insert(sib.index(n) + 1, g)
            self._unique(g)
            self._auto.add((x["e"], self._path(g)))
            rename = g
        if x["kind"] == "group":
            self._unique(x)
        if src_auto and not src["ch"] and src is not x["parent"]:   # subgroup made by dragging right – emptied
            src["parent"]["ch"].remove(src)
        self._finish(roots, x, old, rename=rename)

    # --- items
    def new_item(self):
        base = self.mats.get(self.sel_key)
        if base is None and self.sel_group is not None and self.sel_group[1]:   # selected group – into it
            e, path = self.sel_group
            base = dict(unit=LAB_UNITS[e], cat=CAT_SEP.join(path))
        cats = self.categories()
        it = dict(name="nowy materiał", value="0", unit=base["unit"] if base else "kN/m³",
                  cat=base["cat"] if base else (cats[0] if cats else "Bez kategorii"), src=MAT_USER_SRC)
        after = self.sel_key if self.sel_key in self.mats else next(
            (k_ for k_ in reversed(self.order) if self.mats[k_]["cat"] == it["cat"]
             and self.mats[k_]["unit"] == it["unit"]), None)
        k = self._put(it, after=after)
        self.order = [k_ for k_ in self.order if not (self.mats[k_].get("empty") and self.mats[k_]["cat"] == it["cat"]
                                                      and self.mats[k_]["unit"] == it["unit"])]
        self.save()
        self.search.blockSignals(True)
        self.search.clear()
        self.search.blockSignals(False)
        self.rebuild(select=k)
        t = self.tiles.get(k)
        if t is not None:
            t.edit()
        return k

    def dup_item(self, k0):
        it = dict(self.mats[k0])
        it["name"] += " - kopia"
        k = self._put(it, after=k0)
        self.save()
        self.rebuild(select=k)
        return k

    def del_item(self, k0):
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Baza materiałów", f"Usunąć z bazy „{self.mats[k0]['name']}”?",
                                B.Yes | B.No, B.No) != B.Yes:
            return
        self.order.remove(k0)
        del self.mats[k0]
        if self.sel_key == k0:
            self.sel_key = None
        self.save()
        self.rebuild()

    def add(self):
        k = self.current_key()
        if k is None or not self.confirm_close():
            return
        self._force = True
        self.chosen.emit(dict(self.mats[k]))
        self.close()

    # --- database file
    def import_file(self):
        path, _ = QFileDialog.getOpenFileName(self, "Wczytaj bazę materiałów", os.path.dirname(self.path),
                                              "Baza materiałów (*.txt);;Wszystkie pliki (*)")
        if not path:
            return
        try:
            items, bad = mat_load(path)
        except (OSError, UnicodeDecodeError) as e:
            QMessageBox.warning(self, "Baza materiałów", f"Nie można odczytać pliku:\n{e}")
            return
        if not items:
            QMessageBox.warning(self, "Baza materiałów", "Plik nie zawiera poprawnych pozycji bazy.")
            return
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Baza materiałów",
                                f"Zastąpić bieżącą bazę ({len(self.order)} pozycji) bazą z pliku ({len(items)} pozycji"
                                + (f", pominięto błędne wiersze: {bad}" if bad else "") + ")?",
                                B.Yes | B.No, B.No) != B.Yes:
            return
        self.mats, self.order = {}, []
        for it in items:
            self._put(it)
        self.save()
        self.rebuild()

    def export_file(self):
        path, _ = QFileDialog.getSaveFileName(self, "Zapisz bazę materiałów", MAT_FILE_NAME,
                                              "Baza materiałów (*.txt)")
        if not path:
            return
        try:
            mat_save(path, [self.mats[k] for k in self.order])
        except OSError as e:
            QMessageBox.warning(self, "Baza materiałów", f"Nie można zapisać pliku:\n{e}")
            return
        self._status(f"zapisano kopię: {path}")

    def restore_default(self):
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Baza materiałów", "Wstawić do bieżącej bazy zawartość bazy dostarczonej z "
                                "programem? Zmiany wprowadzone w bazie (nowe, zmienione i usunięte pozycje) "
                                "zostaną zastąpione – można to cofnąć (Cofnij), a do pliku trafią dopiero po "
                                "Zapisz do bazy.", B.Yes | B.No, B.No) != B.Yes:
            return
        self.load(MAT_DEFAULT, reset=False)
        self.path = mat_user_file()
        self._status("przywrócono zawartość bazy programu – zmiany niezapisane")


class MatBaseTile(QFrame):
    """Tile of a user material database in the database manager: ⠿ (order), name (double-click or right-click –
    rename), Ustaw jako domyślną, Duplikuj, Usuń."""

    def __init__(self, dlg, b, default, last):
        super().__init__()
        self.dlg, self.b = dlg, b
        self.setObjectName("tile")
        self.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.customContextMenuRequested.connect(lambda pos: dlg.tile_menu(self, self.mapToGlobal(pos)))
        h = QHBoxLayout(self)
        h.setContentsMargins(10, 6, 8, 6)
        h.setSpacing(8)
        self.handle = QLabel("⠿")
        self.handle.setObjectName("dragHandle")
        self.handle.setFixedWidth(12)
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        self.handle.setToolTip("Przeciągnij: kolejność baz")
        self.handle.mousePressEvent = lambda e: dlg.drag_press(self, e)
        self.handle.mouseMoveEvent = lambda e: dlg.drag_move(self, e)
        self.handle.mouseReleaseEvent = lambda e: dlg.drag_release(self, e)
        h.addWidget(self.handle, 0, Qt.AlignmentFlag.AlignTop)
        self.col = QVBoxLayout()
        self.col.setSpacing(1)
        self.title = QLabel(b["name"])
        self.title.setTextFormat(Qt.TextFormat.PlainText)
        self.title.setObjectName("tileName")
        self.title.mouseDoubleClickEvent = lambda e: self.rename()
        self.col.addWidget(self.title)
        info = QLabel("Plik: " + b["file"])
        info.setObjectName("muted")
        info.setWordWrap(True)
        self.col.addWidget(info)
        h.addLayout(self.col, 1)
        self._ed = None
        self.btn_def = QPushButton("Domyślna" if default else "Ustaw jako domyślną")
        self.btn_def.setEnabled(not default)
        self.btn_def.clicked.connect(lambda checked=False: dlg.set_default(b["id"]))
        self.btn_dup = QPushButton("Duplikuj")
        self.btn_dup.clicked.connect(lambda checked=False: dlg.duplicate(b["id"]))
        self.btn_del = QPushButton("Usuń")
        self.btn_del.setEnabled(not last)
        self.btn_del.setToolTip("Ostatniej bazy nie można usunąć" if last else "")
        self.btn_del.clicked.connect(lambda checked=False: dlg.delete(b["id"]))
        for w in (self.btn_def, self.btn_dup, self.btn_del):
            h.addWidget(w, 0, Qt.AlignmentFlag.AlignTop)

    def set_selected(self, on):
        if bool(self.property("sel")) != bool(on):
            self.setProperty("sel", bool(on))
            self.style().unpolish(self)
            self.style().polish(self)

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.dlg.select(self.b["id"])
        e.accept()

    def rename(self):
        if self._ed is not None:
            return
        ed = EditorLine(self._cancel, self._done)
        ed.setText(self.b["name"])
        ed.returnPressed.connect(self._done)
        self._ed = ed
        self.title.setVisible(False)
        self.col.insertWidget(0, ed)
        ed.setFocus()
        ed.selectAll()

    def _cancel(self):
        ed, self._ed = self._ed, None
        if ed is not None:
            ed.hide()
            ed.deleteLater()
            self.title.setVisible(True)

    def _done(self):
        ed = self._ed
        if ed is None:
            return
        t = " ".join(ed.text().split())
        self._cancel()
        if t and t != self.b["name"]:
            QTimer.singleShot(0, lambda: self.dlg.rename(self.b["id"], t))


class MatBasesDialog(QDialog):
    """Plik bazy → Zarządzaj bazami materiałów: tiles of the user databases (the database bundled with the program
    is read-only and not on the list – a user database is its editable copy). Choosing the default database,
    renaming (double-click / right click), Duplikuj, Usuń (the last one cannot be deleted), order by the ⠿ handle.
    Changes of the list are saved at once; the contents of a database – only by Zapisz do bazy."""

    def __init__(self, owner):
        super().__init__(owner)
        self.owner = owner
        self.setWindowTitle("Zarządzanie bazami materiałów")
        self.setModal(False)
        self.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        self.resize(720, 420)
        self.sel = None
        self.tiles, self._drag = [], None
        lay = QVBoxLayout(self)
        lay.setContentsMargins(10, 10, 10, 10)
        lay.setSpacing(8)
        hint = QLabel("Baza dostarczona z programem jest tylko do odczytu – bazy użytkownika są jej edytowalnymi "
                      "kopiami. Baza domyślna jest tą, którą pokazuje okno bazy materiałów i do której trafiają "
                      "pozycje dodawane z obciążeń własnych. Duplikat powstaje z zapisanego pliku bazy.")
        hint.setObjectName("muted")
        hint.setWordWrap(True)
        lay.addWidget(hint)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setFrameShape(QFrame.Shape.NoFrame)
        self.inner = QWidget()
        self.inner.setObjectName("page")
        self.vl = QVBoxLayout(self.inner)
        self.vl.setContentsMargins(0, 0, 4, 0)
        self.vl.setSpacing(4)
        sc.setWidget(self.inner)
        lay.addWidget(sc, 1)
        self.refresh()

    def refresh(self):
        self.bases, self.default = mat_bases()
        while self.vl.count():
            w = self.vl.takeAt(0).widget()
            if w is not None:
                w.hide()
                w.deleteLater()
        self.tiles = []
        for b in self.bases:
            t = MatBaseTile(self, b, b["id"] == self.default, len(self.bases) <= 1)
            t.set_selected(b["id"] == self.sel)
            self.vl.addWidget(t)
            self.tiles.append(t)
        self.vl.addStretch(1)

    def _save(self):
        mat_bases_save(self.bases, self.default)

    def select(self, bid):
        self.sel = bid
        for t in self.tiles:
            t.set_selected(t.b["id"] == bid)

    def _get(self, bid):
        return next(b for b in self.bases if b["id"] == bid)

    def _unique_name(self, name, bid=None):
        names = {b["name"] for b in self.bases if b["id"] != bid}
        out, n = name, 2
        while out in names:
            out, n = f"{name} ({n})", n + 1
        return out

    def rename(self, bid, name):
        self._get(bid)["name"] = self._unique_name(name, bid)
        self._save()
        self.refresh()
        self.owner._dirty_changed()
        self.owner._status()

    def set_default(self, bid):
        if bid == self.default or not self.owner.confirm_close():     # unsaved changes – question first
            return False
        self.default = bid
        self._save()
        self.owner.switch_base()
        self.refresh()
        return True

    def duplicate(self, bid):
        import shutil
        src = self._get(bid)
        used = {b["id"] for b in self.bases}
        n = 1
        while f"b{n}" in used:
            n += 1
        nid = f"b{n}"
        dst = os.path.join(os.path.dirname(mat_legacy_file()), f"materials_{nid}.txt")
        try:
            shutil.copyfile(src["file"] if os.path.exists(src["file"]) else MAT_DEFAULT, dst)
        except OSError as e:
            QMessageBox.warning(self, "Bazy materiałów", f"Nie można skopiować bazy:\n{e}")
            return None
        nb = dict(id=nid, name=self._unique_name(f"{src['name']} - kopia"), file=dst)
        self.bases.insert(self.bases.index(src) + 1, nb)
        self._save()
        self.sel = nid
        self.refresh()
        return nid

    def delete(self, bid):
        if len(self.bases) <= 1:
            return False
        b = self._get(bid)
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Bazy materiałów", f"Usunąć bazę „{b['name']}” wraz z jej plikiem?"
                                + (" Niezapisane zmiany w niej przepadną." if bid == self.default else ""),
                                B.Yes | B.No, B.No) != B.Yes:
            return False
        try:
            if os.path.exists(b["file"]):
                os.remove(b["file"])
        except OSError as e:
            QMessageBox.warning(self, "Bazy materiałów", f"Nie można usunąć pliku:\n{e}")
            return False
        self.bases.remove(b)
        was_default = bid == self.default
        if was_default:
            self.default = self.bases[0]["id"]
        self._save()
        if was_default:
            self.owner.switch_base()
        if self.sel == bid:
            self.sel = None
        self.refresh()
        return True

    def tile_menu(self, tile, gpos):
        from PySide6.QtWidgets import QMenu
        self.select(tile.b["id"])
        m = QMenu(self)
        acts = [("Zmień nazwę", tile.rename)]
        if tile.b["id"] != self.default:
            acts.append(("Ustaw jako domyślną", lambda: self.set_default(tile.b["id"])))
        acts.append(("Duplikuj", lambda: self.duplicate(tile.b["id"])))
        if len(self.bases) > 1:
            acts.append(("Usuń", lambda: self.delete(tile.b["id"])))
        for txt, fn in acts:
            m.addAction(txt).triggered.connect(lambda checked=False, fn=fn: fn())
        m.exec(gpos)

    # --- order: the ⠿ handle moves the tile
    def drag_press(self, tile, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag = dict(tile=tile, start=e.globalPosition().toPoint(), on=False)

    def drag_move(self, tile, e):
        d = self._drag
        if d is None or d["tile"] is not tile:
            return
        gp = e.globalPosition().toPoint()
        if not d["on"]:
            if (gp - d["start"]).manhattanLength() < 5:
                return
            d["on"] = True
            QApplication.setOverrideCursor(Qt.CursorShape.ClosedHandCursor)
        if d.get("slot") is None:                        # as in the other lists: the tile is lifted, the others make room
            geo = tile.geometry()
            slot = QLabel("")
            slot.setObjectName("dropSlot")
            slot.setFixedHeight(tile.height())
            idx = self.vl.indexOf(tile)
            self.vl.removeWidget(tile)
            self.vl.insertWidget(idx, slot)
            tile.setGeometry(geo)
            tile.setStyleSheet(f"QFrame#tile {{ border: 2px solid {ACCENT}; }}")
            tile.raise_()
            d.update(slot=slot, off=self.inner.mapFromGlobal(gp).y() - geo.y())
        y = clamp(self.inner.mapFromGlobal(gp).y(), 0, self.inner.height())
        tile.move(tile.x(), int(y - d["off"]))
        idx = sum(1 for t in self.tiles if t is not tile and t.y() + t.height() / 2 < y)
        if self.vl.indexOf(d["slot"]) != idx:
            self.vl.removeWidget(d["slot"])
            self.vl.insertWidget(idx, d["slot"])
            self.vl.activate()
            tile.raise_()

    def drag_release(self, tile, e):
        d, self._drag = self._drag, None
        if d is None or not d["on"]:
            return
        QApplication.restoreOverrideCursor()
        idx = self.vl.indexOf(d["slot"])
        self.vl.removeWidget(d["slot"])
        d["slot"].hide()
        d["slot"].deleteLater()
        tile.setStyleSheet("")
        self.vl.insertWidget(idx, tile)
        self.vl.activate()
        self.tiles.sort(key=lambda t: self.vl.indexOf(t))
        self.bases = [t.b for t in self.tiles]
        self._save()


class ProjectWindow(QWidget):
    """Main window (internally: KAYENN Manager) – the first window after start: Plik menu (new, open, save,
    print), list of cases (newest on top), Obciążenia normowe / Obciążenia własne (open / close).
    Closing the window ends the program (like Plik → Zakończ)."""

    def __init__(self, app):
        super().__init__(None, Qt.WindowType.Window)
        self.app = app
        self.setObjectName("page")
        self.setWindowTitle("KAYENN")
        self.resize(1100, 860)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(10, 10, 10, 10)
        lay.setSpacing(8)
        from PySide6.QtWidgets import QMenuBar
        mb = QMenuBar(self)
        app.file_menu(mb, project=True)
        self.edit_menu = edit_menu(mb, app.proj_hist, app.undo_project, app.redo_project)
        app.view_menu(mb)
        self.act_codes, self.act_lab = app.loads_menu(mb)
        self.lang_actions = app.language_menu(mb)
        app.about_menu(mb)
        lay.setMenuBar(mb)
        self.menu_bar = mb
        self.empty = QLabel("Projekt nie zawiera przypadków. Wybierz z menu „Obciążenia” obciążenia normowe albo "
                            "własne i dodaj przypadek przyciskiem „Dodaj do projektu”.")
        self.empty.setObjectName("muted")
        lay.addWidget(self.empty)
        self.list_bar = QWidget()                    # Rozwiń wszystko / Zwiń wszystko
        bh = QHBoxLayout(self.list_bar)
        bh.setContentsMargins(0, 0, 0, 0)
        bh.setSpacing(4)
        for txt, on in (("Rozwiń wszystko", True), ("Zwiń wszystko", False)):
            b = QPushButton(txt)
            b.clicked.connect(lambda checked=False, on=on: self.set_all_open(on))
            bh.addWidget(b)
        bh.addStretch(1)
        self.btn_del_sel = QPushButton("Usuń zaznaczone")        # visible while any case is selected
        self.btn_del_sel.setToolTip("Usuwa zaznaczone przypadki")
        self.btn_del_sel.clicked.connect(lambda checked=False: self.delete_selected())
        self.btn_del_sel.setVisible(False)
        bh.addWidget(self.btn_del_sel)
        self.sel = set()                             # selected cases (ids; only visible ones)
        self._anchor = None                          # the case a Shift+click range starts from
        self.list_bar.setVisible(False)
        lay.addWidget(self.list_bar)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setFrameShape(QFrame.Shape.NoFrame)
        self.list = CaseList(self)
        sc.setWidget(self.list)
        self.scroll = sc
        self._hold = None
        sc.verticalScrollBar().rangeChanged.connect(self._apply_hold)
        lay.addWidget(sc, 1)
        self.ticker = CommandTicker(app.cmd, self)   # the console: an overlay in the bottom left corner
        self.cards = []
        self.rows = []                               # visible rows of the list: cards and group headers
        self.heads = []

    def rebuild(self, keep_open=True):
        """Rebuilds the cards (after adding / editing a case). keep_open – expanded cards stay expanded
        (and the list stays in place); False – after opening a file / new project: everything collapsed."""
        opened = {c.case.get("id") for c in self.cards if c.body is not None} if keep_open else set()
        sb = self.scroll.verticalScrollBar()
        pos = sb.value() if keep_open else 0
        for c in self.cards:
            self.list.lay.removeWidget(c)
            c.hide()
            c.deleteLater()
        self.cards = []
        for case in self.app.project["cases"]:
            card = CaseCard(self, case)
            self.list.lay.insertWidget(self.list.lay.count() - 1, card)
            self.cards.append(card)
            if case.get("id") in opened:
                card.toggle()
        self.relayout()
        if pos:
            self.list.lay.activate()
            QTimer.singleShot(0, lambda: sb.setValue(pos))
        self.list.update()                           # watermark of an empty project
        self.update_buttons()

    def keep_view(self, fn):
        """fn() changes the cards – the list stays in place: the card visible at the top and its offset are
        remembered; restored immediately and after layout (reports and previews settle their height with a delay)."""
        sb = self.scroll.verticalScrollBar()
        v = sb.value()
        anchor = next((c for c in self.cards if c.isVisible() and c.y() + c.height() > v), None)
        off = v - anchor.y() if anchor is not None else 0
        fn()
        if anchor is None:
            return
        # for a moment every change of the list length (card without content, report settling its height) keeps
        # the same card in the same place; otherwise the scrollbar „falls” to the end of the briefly shortened list
        self._hold = (anchor, off, time.monotonic() + 1.2)
        self.list.lay.activate()
        self._apply_hold()
        for ms in (0, 100, 400, 1250):
            QTimer.singleShot(ms, self._apply_hold)

    def _apply_hold(self, *args):
        h = getattr(self, "_hold", None)
        if not h:
            return
        anchor, off, until = h
        if time.monotonic() > until or anchor not in self.cards:
            self._hold = None
            return
        self.scroll.verticalScrollBar().setValue(anchor.y() + off)

    def refresh_cases(self, cases=None):
        """After cases change: only their cards (expanded ones stay expanded, the list stays in place).
        cases=None – all cards."""
        def fn():
            for c in self.cards:
                if cases is None or c.case in cases or c.case.get("_calc") is None:
                    c.refresh()
        self.keep_view(fn)
        self.update_buttons()

    def insert_case(self, case):
        """New case – a new (collapsed) card without rebuilding the others; its place in the groups – after the
        case preceding it (ptree_sync)."""
        def fn():
            card = CaseCard(self, case)
            self.cards.append(card)
            self.relayout()
        self.keep_view(fn)
        self.update_buttons()

    def relayout(self):
        """The list from the project tree: group headers, cards in the tree order, indents, numbers by position
        (1., 2., 2.1 …); contents of collapsed groups hidden. Cards are not rebuilt (expanded ones stay)."""
        proj = self.app.project
        ptree_sync(proj)
        nums = project_numbers(proj)
        by_id = {c.case["id"]: c for c in self.cards}
        self.cards = [by_id[c["id"]] for c in proj["cases"] if c["id"] in by_id]
        lay = self.list.lay
        while lay.count() > 1:                       # (the last item – stretch)
            lay.takeAt(0)
        for h in self.heads:
            h.hide()
            h.deleteLater()
        self.heads, self.rows = [], []
        count = lambda n: sum(1 if "case" in c else count(c) for c in n["items"])

        def add(items, depth, visible, parent, off=False):
            for n in items:
                if "group" in n:
                    w = CaseGroupHeader(self, n, nums[id(n)], count(n))
                    w.set_print_state(off)
                    if depth:
                        w.setStyleSheet(f"QFrame#caseGroup {{ margin-left: {depth * CASE_INDENT}px; }}")
                    self.heads.append(w)
                    opened = n.get("open", True)
                else:
                    w = by_id.get(n["case"])
                    if w is None:
                        continue
                    w.set_number(nums[id(n)])
                    w.set_level(depth)
                    w.set_print_state(off)
                    opened = False
                lay.insertWidget(lay.count() - 1, w)
                w.setVisible(visible)
                if visible:
                    self.rows.append(dict(w=w, node=n, level=depth, open=opened, parent=parent))
                if "group" in n:
                    add(n["items"], depth + 1, visible and opened, n, off or bool(n.get("noprint")))
        add(proj["tree"], 0, True, None)
        self.empty.setVisible(not self.cards)
        self.list_bar.setVisible(bool(self.cards))
        self.list.update()                           # watermark of an empty project
        self._apply_sel()

    # --- selection of cases (click; Ctrl – add / remove; Shift – range from the last clicked)
    def _apply_sel(self):
        """Selection limited to the visible cases (a collapsed group never hides a selected case that a bulk
        action could delete); look of the cards and the Usuń zaznaczone button."""
        vis = {r["node"]["case"] for r in self.rows if "case" in r["node"]}
        self.sel &= vis
        if self._anchor not in vis:
            self._anchor = None
        for c in self.cards:
            c.set_selected(c.case["id"] in self.sel)
        self.btn_del_sel.setVisible(bool(self.sel))

    def clear_selection(self):
        if self.sel:
            self.sel = set()
            self._apply_sel()
            self.app.echo("SELECT NONE")

    def card_clicked(self, card, mods):
        cid = card.case["id"]
        ctrl = bool(mods & (Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.MetaModifier))
        vis = [r["node"]["case"] for r in self.rows if "case" in r["node"]]
        if mods & Qt.KeyboardModifier.ShiftModifier and self._anchor in vis and cid in vis:
            a, b = sorted((vis.index(self._anchor), vis.index(cid)))
            rng = set(vis[a:b + 1])
            self.sel = (self.sel | rng) if ctrl else rng
        elif ctrl:
            self.sel ^= {cid}
            self._anchor = cid
        else:
            self.sel = {cid}
            self._anchor = cid
        self._apply_sel()
        self.app.echo("SELECT " + " ".join(case_no(self.app, c) for c in self.app.project["cases"]
                                           if c["id"] in self.sel) if self.sel else "SELECT NONE")

    def menu_ids(self, case):
        """Cases the right-click menu of a card acts on: the selection when the card belongs to it, else the card."""
        return set(self.sel) if case["id"] in self.sel and len(self.sel) > 1 else {case["id"]}

    def group_cases(self, ids, edit=True):
        """Utwórz grupę: a new group „Grupa przypadków” at the place of the first of the cases (in list order);
        the cases move into it (the rest of the list stays ungrouped); the name is edited at once (edit=False –
        the console: no inline editing)."""
        tree = self.app.project["tree"]
        nodes = [n for n, _, _, _ in ptree_walk(tree) if "case" in n and n["case"] in ids]
        if not nodes:
            return None
        self.app.echo("GROUP " + " ".join(node_no(self.app, n) for n in nodes))
        lst = self._list_of(nodes[0])
        moved = {id(n) for n in nodes}
        pos = sum(1 for n in lst[:lst.index(nodes[0])] if id(n) not in moved)
        for n in nodes:
            self._list_of(n).remove(n)
        g = ptree_new_group(tree, items=nodes)
        lst.insert(pos, g)
        self.sel = set()
        self.keep_view(self.relayout)
        self.app.project_changed()
        if edit:
            self.rename_new(g)
        return g

    def delete_selected(self):
        cases = [c for c in self.app.project["cases"] if c["id"] in self.sel]
        if not cases:
            return
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Usuń zaznaczone", f"Usunąć zaznaczone przypadki ({len(cases)}) z projektu?",
                                B.Yes | B.No, B.No) != B.Yes:
            return
        self.app.echo("DELETE " + " ".join(case_no(self.app, c) for c in cases))
        self.sel = set()
        self.remove_cases(cases)

    # --- groups of cases (structure by dragging; right-click on a group header)
    def drop_options(self, xr, a_row, b_row, dx):
        """Place of the dragged row xr after the row a_row (b_row – the next one): (level, action, node);
        the level closest to the sideways offset of the cursor (to the right – deeper)."""
        opts = []
        if a_row is None:
            opts.append((0, "first", None))
            opts.append((1, "wrap", None))           # even the first case: a new group at the top
        else:
            a = a_row["node"]
            if "group" in a:
                opts.append((a_row["level"] + 1, "into" if a_row["open"] else "end", a))
            else:
                opts.append((a_row["level"] + 1, "wrap", a))
            parents = {id(n): par for n, _, _, par in ptree_walk(self.app.project["tree"])}
            n, lvl = a, a_row["level"]
            b_lvl = b_row["level"] if b_row is not None else None
            while n is not None and not (b_lvl is not None and b_lvl > lvl):
                opts.append((lvl, "after", n))
                n, lvl = parents.get(id(n)), lvl - 1
        want = xr["level"] + round(dx / (2 * CASE_INDENT))
        return min(opts, key=lambda o: (abs(o[0] - want), -o[0]))

    def _list_of(self, node):
        return next(lst for n, lst, _, _ in ptree_walk(self.app.project["tree"]) if n is node)

    def drop_row(self, xr, opt):
        """After dragging: the node of the row xr at the place opt. „wrap” (to the right of a case, also of the
        first one) – a new group „Grupa przypadków” with only this node; the other cases stay ungrouped."""
        if opt is None:
            self.relayout()
            return
        tree = self.app.project["tree"]
        x = xr["node"]
        lvl, act, n = opt
        xn = node_no(self.app, x)
        if act == "wrap":
            self.app.echo(f"GROUP {xn}")
        elif act == "first":
            self.app.echo(f"MOVE {xn} START")
        elif act in ("into", "end"):
            self.app.echo(f"MOVE {xn} INTO {node_no(self.app, n)}")
        else:
            self.app.echo(f"MOVE {xn} AFTER {node_no(self.app, n)}")
        many = act == "wrap" and "case" in x and x["case"] in self.sel and len(self.sel) > 1
        newg = None
        if many:                                     # all the selected cases into one new group
            moved = [nd for nd, _, _, _ in ptree_walk(tree) if "case" in nd and nd["case"] in self.sel]
            lst = tree if n is None else self._list_of(n)
            pos = 0 if n is None else lst.index(n) + 1
            pos -= sum(1 for nd in lst[:pos] if any(nd is m_ for m_ in moved))
            for nd in moved:
                self._list_of(nd).remove(nd)
            newg = ptree_new_group(tree, items=moved)
            lst.insert(pos, newg)
            self.sel = set()
        else:
            self._list_of(x).remove(x)
        if many:
            pass
        elif act == "first":
            tree.insert(0, x)
        elif act == "into":
            n["items"].insert(0, x)
        elif act == "end":
            n["items"].append(x)
        elif act == "after":
            lst = self._list_of(n)
            lst.insert(lst.index(n) + 1, x)
        else:                                        # wrap – only the dragged node gets a group
            g = newg = ptree_new_group(tree, items=[x])
            if n is None:
                tree.insert(0, g)
            else:
                lst = self._list_of(n)
                lst.insert(lst.index(n) + 1, g)
        self.keep_view(self.relayout)
        self.app.project_changed()
        self.update_buttons()
        if newg is not None:
            self.rename_new(newg)                    # the new group – name edited at once

    def move_case(self, cid, idx):
        """The case cid before the case now at position idx of the list (its group), idx ≥ number – at the end."""
        cases = self.app.project["cases"]
        tree = self.app.project["tree"]
        nodes = {n["case"]: n for n, _, _, _ in ptree_walk(tree) if "case" in n}
        x = nodes.get(cid)
        if x is None:
            return
        target = nodes.get(cases[idx]["id"]) if idx < len(cases) else None
        self._list_of(x).remove(x)
        if target is None or target is x:
            tree.append(x) if target is None else tree.insert(0, x)
        else:
            lst = self._list_of(target)
            lst.insert(lst.index(target), x)
        self.relayout()
        self.app.project_changed()

    def toggle_group(self, node):
        node["open"] = not node.get("open", True)
        self.app.echo(("EXPAND " if node["open"] else "COLLAPSE ") + node_no(self.app, node))
        self.keep_view(self.relayout)

    def group_menu(self, hd, gpos):
        """Right click on a group header: what dragging cannot do."""
        from PySide6.QtWidgets import QMenu
        m = QMenu(self)
        for txt, fn in (("Zmień nazwę", hd.start_rename), ("Nowa podgrupa", lambda: self.new_subgroup(hd.node)),
                        ("Rozgrupuj (przypadki zostają)", lambda: self.ungroup(hd.node)),
                        ("Usuń grupę z przypadkami", lambda: self.delete_group(hd.node))):
            m.addAction(txt).triggered.connect(lambda checked=False, fn=fn: fn())
        m.exec(gpos)

    def rename_group(self, node, name, focus=False):
        self.app.echo(f"RENAME {node_no(self.app, node)} {cq(name)}")
        node["name"] = name
        node["auto"] = False                         # named by the user – stays even when emptied
        self.keep_view(self.relayout)
        self.app.project_changed()
        if focus:
            self.focus_group(node)

    def focus_group(self, node):
        hd = next((h for h in self.heads if h.node is node), None)
        if hd is not None:
            hd.setFocus()

    def rename_new(self, g):
        """A new group: its name is edited at once (Enter keeps the default name)."""
        hd = next((h for h in self.heads if h.node is g), None)
        if hd is not None:
            QTimer.singleShot(0, hd.start_rename)

    def new_subgroup(self, node, edit=True):
        self.app.echo(f"SUBGROUP {node_no(self.app, node)}")
        g = ptree_new_group(self.app.project["tree"], auto=False)
        node["items"].append(g)
        node["open"] = True
        self.keep_view(self.relayout)
        self.app.project_changed()
        hd = next((h for h in self.heads if h.node is g), None)
        if hd is not None and edit:
            QTimer.singleShot(0, lambda: (self.scroll.ensureWidgetVisible(hd, 50, 80), hd.start_rename()))
        return g

    def ungroup(self, node):
        """Rozgrupuj: the contents of the group take its place."""
        self.app.echo(f"UNGROUP {node_no(self.app, node)}")
        lst = self._list_of(node)
        i = lst.index(node)
        lst[i:i + 1] = node["items"]
        self.keep_view(self.relayout)
        self.app.project_changed()

    def delete_group(self, node, ask=True):
        """Usuń grupę z przypadkami (question; cases being edited – the editing ends without saving).
        ask=False – the console (the command is undone with COFNIJ)."""
        ids = {n["case"] for n, _, _, _ in ptree_walk(node["items"]) if "case" in n}
        if ids and ask:
            B = QMessageBox.StandardButton
            if QMessageBox.question(self, "Usuń grupę", f"Usunąć grupę „{node['name']}” razem z przypadkami "
                                    f"({len(ids)})?", B.Yes | B.No, B.No) != B.Yes:
                return False
        self.app.echo(f"DELETEGROUP {node_no(self.app, node)}")
        for case in [c for c in self.app.edited_cases() if c.get("id") in ids]:
            ed, lw = self.app.editor, getattr(self.app, "lab_ed", None)
            for panel in (ed, lw):
                if panel is not None and panel.editing is case:
                    panel.end_edit(save=False)
        self._list_of(node).remove(node)
        self.app.project["cases"][:] = [c for c in self.app.project["cases"] if c["id"] not in ids]
        for c in [c for c in self.cards if c.case["id"] in ids]:
            self.cards.remove(c)
            c.hide()
            c.deleteLater()
        self.keep_view(self.relayout)
        self.app.project_changed()
        self.update_buttons()
        return True

    def set_all_open(self, opened):
        """Rozwiń wszystko – all groups and cards expanded; Zwiń wszystko – cards collapsed (groups stay)."""
        self.app.echo(("EXPAND" if opened else "COLLAPSE") + " ALL")

        def fn():
            if opened:
                for g, _, _, _ in ptree_walk(self.app.project["tree"]):
                    if "group" in g:
                        g["open"] = True
                self.relayout()
            for c in self.cards:
                c.set_open(opened)
        if opened:
            self.keep_view(fn)
        else:
            fn()

    def update_buttons(self):
        """Check marks of the Obciążenia menu (open windows) and the labels of the cards (edited case)."""
        app = self.app
        self.list_bar.setVisible(bool(self.cards))
        self.act_codes.setChecked(app.win.isVisible())
        lw = getattr(app, "lab", None)
        self.act_lab.setChecked(lw is not None and lw.isVisible())
        eds = app.edited_cases()
        for c in self.cards:
            c.btn_edit.setText("Zakończ edycję" if any(c.case is e for e in eds) else "Edytuj")

    def card_of(self, case):
        return next((c for c in self.cards if c.case is case), None)

    def edit_case(self, case):
        """Edytuj – the case in the code loads window; second click (Zakończ edycję) – end of editing.
        The list stays in place. An own-loads case – in the own-loads panel."""
        self.app.echo("ENDEDIT" if any(case is e for e in self.app.edited_cases()) else f"EDIT {case_no(self.app, case)}")
        if case["extra"].get("mode") == "własne":
            lw = getattr(self.app, "lab_ed", None)
            if lw is not None and lw.editing is case:
                self.keep_view(lambda: lw.close_panel())
            else:
                self.keep_view(lambda: self.app.edit_lab_case(case))
            return
        ed = self.app.editor
        if ed is not None and ed.editing is case:
            self.keep_view(lambda: self.app.editor.close_codes())
        else:
            self.keep_view(lambda: self.app.edit_case(case))

    def set_printed(self, ids, on):
        """Drukuj (the card menu, PRINTCASE): the cases go to the printout or not (a working case – kept in the
        project, left out of the printout and the numbering: 2.1, 2.1A, 2.2)."""
        cases = [c for c in self.app.project["cases"] if c["id"] in ids]
        ch = [c for c in cases if case_printed(c) != bool(on)]
        if not ch:
            return 0
        self.app.echo(f"PRINTCASE {' '.join(case_no(self.app, c) for c in ch)} {'ON' if on else 'OFF'}")
        for c in ch:
            if on:
                c["extra"].pop("noprint", None)
            else:
                c["extra"]["noprint"] = True
        self.relayout()
        self.app.project_changed()
        return len(ch)

    def set_group_printed(self, node, on):
        """Drukowany of a group: unchecked – everything in it is left out of the printout (numbers with the group's
        letter: 1A → 1.1A, 1.2A); the cases keep their own flags for when the group is printed again."""
        if bool(on) == (not node.get("noprint")):
            return 0
        self.app.echo(f"PRINTCASE {node_no(self.app, node)} {'ON' if on else 'OFF'}")
        if on:
            node.pop("noprint", None)
        else:
            node["noprint"] = True
        self.relayout()
        self.app.project_changed()
        return 1

    def duplicate_case(self, case):
        """Duplikuj – copy of the case right below it, name with the suffix „ - kopia”."""
        from datetime import datetime
        self.app.echo(f"DUPLICATE {case_no(self.app, case)}")
        proj = self.app.project
        n = proj["next"]
        proj["next"] = n + 1
        cp = json.loads(json.dumps({k: case.get(k) for k in ("state", "extra", "report")}, default=str))
        cp.update(id=n, name=case['name'] + tr(" - kopia"), created=datetime.now().strftime("%Y-%m-%d %H:%M"),
                  _calc=case.get("_calc"))
        proj["cases"].insert(proj["cases"].index(case) + 1, cp)
        self.insert_case(cp)
        self.app.project_changed()

    def delete_case(self, case):
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Usuń przypadek", f"Usunąć „{case['name']}” z projektu?",
                                B.Yes | B.No, B.No) != B.Yes:
            return
        self.app.echo(f"DELETE {case_no(self.app, case)}")
        self.remove_cases([case])

    def remove_cases(self, cases):
        """Removes cases from the project (cards, editing of them ends without saving); the list stays in place."""
        ed, lw = self.app.editor, getattr(self.app, "lab_ed", None)
        for case in cases:
            self.app.project["cases"].remove(case)
            card = self.card_of(case)
            if card is not None:
                self.cards.remove(card)
                self.list.lay.removeWidget(card)
                card.hide()
                card.deleteLater()
            if ed is not None and ed.editing is case:
                ed.end_edit(save=False)
            if lw is not None and lw.editing is case:
                lw.end_edit(save=False)
        self.keep_view(self.relayout)
        self.app.project_changed()

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self.ticker.place()

    def keyPressEvent(self, e):
        """Typing in the main window (no text field has the focus) goes to the command line."""
        if not forward_typing(self.ticker.inp, e):
            super().keyPressEvent(e)

    def changeEvent(self, e):
        """Minimising the program: Windows hides the windows owned by the main window, and after restoring Qt shows
        them at normal size – maximised ones (e.g. Model 3D) are maximised again."""
        if e.type() == QEvent.Type.WindowStateChange:
            if self.isMinimized():
                self._max_owned = [w for w in QApplication.topLevelWidgets()
                                   if w is not self and w.isVisible() and w.isMaximized()]
            elif e.oldState() & Qt.WindowState.WindowMinimized:
                ws, self._max_owned = getattr(self, "_max_owned", []), []

                def remax():
                    for w in ws:
                        try:
                            if w.isVisible() and not w.isMaximized():
                                w.showMaximized()
                        except RuntimeError:                 # window deleted in the meantime
                            pass
                for t in (0, 150):                           # Windows shows the windows with a delay
                    QTimer.singleShot(t, remax)
        super().changeEvent(e)

    def closeEvent(self, e):
        if self.app.quit_app():                      # closing the main window = end of the program
            e.accept()
        else:
            e.ignore()


PRINT_DPI = 96          # the document is laid out at this resolution on every system (not at the screen's)


def _doc_tables(frame, out):
    from PySide6.QtGui import QTextTable
    for f in frame.childFrames():
        if isinstance(f, QTextTable):
            out.append(f)
        _doc_tables(f, out)
    return out


def keep_tables_whole(doc, page_h):
    """A table that would be split between two pages moves in whole to the next page (together with the heading
    directly above it). Tables taller than a page cannot be kept whole. Marks from an earlier call (another
    page size) are removed first."""
    from PySide6.QtGui import QTextCursor, QTextFormat
    lay = doc.documentLayout()
    policy = QTextFormat.PageBreakFlag.PageBreak_AlwaysBefore
    for kind, obj in getattr(doc, "_marks", []):
        if kind == "block":
            cur = QTextCursor(obj)
            fm = cur.blockFormat()
            fm.setPageBreakPolicy(QTextFormat.PageBreakFlag(0))
            cur.setBlockFormat(fm)
        else:
            fm = obj.format()
            fm.setPageBreakPolicy(QTextFormat.PageBreakFlag(0))
            obj.setFormat(fm)
    doc._marks = []
    done = set()
    for _ in range(60):
        lay.pageCount()
        moved = False
        for t in _doc_tables(doc.rootFrame(), []):
            if id(t.lastCursorPosition().block()) in done:
                continue
            r = lay.frameBoundingRect(t)
            if r.height() > page_h - 1 or int(r.top() // page_h) == int((r.bottom() - 0.5) // page_h):
                continue
            done.add(id(t.lastCursorPosition().block()))
            before = doc.findBlock(max(t.firstPosition() - 2, 0))
            heading = (before.isValid() and before.text().strip() and before.length() < 120
                       and before.charFormat().fontWeight() >= 600)
            if heading:
                cur = QTextCursor(before)
                fm = cur.blockFormat()
                fm.setPageBreakPolicy(policy)
                cur.setBlockFormat(fm)
                doc._marks.append(("block", before))
            else:
                fm = t.format()
                fm.setPageBreakPolicy(policy)
                t.setFormat(fm)
                doc._marks.append(("table", t))
            moved = True
            break
        if not moved:
            break


def print_document(doc, printer):
    """Prints the report document page by page (own pagination: tables are not split between pages).
    The layout is at PRINT_DPI and the painter is scaled to the printer, so sizes are the same everywhere."""
    from PySide6.QtCore import QRectF, QSizeF
    from PySide6.QtGui import QImage, QPainter
    from PySide6.QtPrintSupport import QPrinter
    dev = getattr(doc, "_dev", None)
    if dev is None:
        dev = doc._dev = QImage(1, 1, QImage.Format.Format_ARGB32)
        dev.setDotsPerMeterX(round(PRINT_DPI / 0.0254))
        dev.setDotsPerMeterY(round(PRINT_DPI / 0.0254))
        doc.documentLayout().setPaintDevice(dev)
    page = printer.pageRect(QPrinter.Unit.DevicePixel)          # the painter's origin is its corner
    dpi = printer.logicalDpiX()
    sc = dpi / PRINT_DPI
    foot = 0.5 * dpi                                       # room for the page number (0.5 in)
    bw, bh = page.width() / sc, (page.height() - foot) / sc
    hd, hh = page_header_doc(getattr(doc, "_project", ""), bw, dev)     # project name on every page
    hh += 8                                                # a gap (and the line) below the header
    bh -= hh
    doc.setPageSize(QSizeF(bw, bh))
    keep_tables_whole(doc, bh)
    doc._page_h = bh
    n = max(doc.pageCount(), 1)
    first, last = 1, n
    if printer.printRange() == QPrinter.PrintRange.PageRange and printer.fromPage() > 0:
        first, last = max(printer.fromPage(), 1), min(printer.toPage() or n, n)
    painter = QPainter(printer)
    try:
        painter.setFont(QFont(FONT, 9))
        for i in range(first - 1, last):
            if i > first - 1:
                printer.newPage()
            painter.save()
            painter.scale(sc, sc)
            hd.drawContents(painter)
            painter.setPen(QPen(QColor("#9ca3af"), 0.8))
            painter.drawLine(0, int(hh - 4), int(bw), int(hh - 4))
            painter.translate(0, hh)
            painter.setClipRect(QRectF(0, 0, bw, bh))
            painter.translate(0, -i * bh)
            doc.drawContents(painter, QRectF(0, i * bh, bw, bh))
            painter.restore()
            painter.save()
            painter.setPen(QColor(TEXT))
            painter.drawText(QRectF(0, page.height() - foot, page.width(), foot * 0.8),
                             Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, str(i + 1))
            painter.restore()
    finally:
        painter.end()


class PrintManager(QDialog):
    """Plik → Drukuj…: the program's own print manager – settings on the left, a live preview of the pages on the
    right (the Windows 11 system print dialog cannot show a preview for Qt programs, and it carries the name of
    the executable instead of KAYENN). Non-blocking; the printer and the document live as long as the window."""

    PDF = "Zapisz jako PDF"
    PAPERS = ("A4", "A3", "A5", "Letter")
    MARGINS = (("Normalne – 20 mm", 20.0), ("Wąskie – 10 mm", 10.0), ("Szerokie – 30 mm", 30.0))
    # (text, QPrinter.PaperSource name) – the tray; it works as far as the printer driver supports it
    SOURCES = (("Automatyczny wybór", "Auto"), ("Podajnik górny", "Upper"), ("Podajnik środkowy", "Middle"),
               ("Podajnik dolny", "Lower"), ("Kaseta", "Cassette"), ("Podawanie ręczne", "Manual"))
    # (text, QPrinter.DuplexMode name, name in QPrinterInfo.supportedDuplexModes)
    DUPLEX = (("Jednostronny", "DuplexNone"), ("Dwustronny – po długiej krawędzi", "DuplexLongSide"),
              ("Dwustronny – po krótkiej krawędzi", "DuplexShortSide"))

    def __init__(self, app, parent, doc, title):
        super().__init__(parent)
        from PySide6.QtGui import QPageLayout, QPageSize
        from PySide6.QtPrintSupport import QPrinter, QPrinterInfo, QPrintPreviewWidget
        from PySide6.QtWidgets import QLineEdit, QSpinBox
        self.app, self.doc, self.title = app, doc, title
        self._QPageLayout, self._QPageSize, self._QPrinter = QPageLayout, QPageSize, QPrinter
        self.printer = QPrinter(QPrinter.PrinterMode.HighResolution)
        self.printer.setDocName(title)
        self.setWindowTitle(f"Drukowanie – {title}")
        self.setWindowFlag(Qt.WindowType.WindowContextHelpButtonHint, False)
        self.setWindowFlag(Qt.WindowType.WindowMaximizeButtonHint, True)

        root = QVBoxLayout(self)
        root.setContentsMargins(12, 12, 12, 12)
        root.setSpacing(8)
        body = QHBoxLayout()
        body.setSpacing(12)
        root.addLayout(body, 1)

        side = QVBoxLayout()
        side.setSpacing(6)
        body.addLayout(side)
        side_w = 320

        def field(label, widget):
            side.addWidget(QLabel(label))
            widget.setFixedWidth(side_w)
            side.addWidget(widget)

        self.cb_printer = QComboBox()
        self.cb_printer.addItems([self.PDF] + [p.printerName() for p in QPrinterInfo.availablePrinters()])
        default = QPrinterInfo.defaultPrinterName()
        i = self.cb_printer.findText(default) if default else -1
        self.cb_printer.setCurrentIndex(i if i >= 0 else 0)
        field("Drukarka", self.cb_printer)
        self.cb_orient = QComboBox()
        self.cb_orient.addItems(["Pionowa", "Pozioma"])
        field("Orientacja", self.cb_orient)
        self.cb_paper = QComboBox()
        self.cb_paper.addItems(self.PAPERS)
        field("Rozmiar papieru", self.cb_paper)
        self.cb_margin = QComboBox()
        self.cb_margin.addItems([t for t, _ in self.MARGINS])
        field("Marginesy", self.cb_margin)
        self.cb_range = QComboBox()
        self.cb_range.addItems(["Wszystkie strony", "Zakres stron"])
        field("Strony", self.cb_range)
        self.ed_range = QLineEdit()
        self.ed_range.setPlaceholderText("np. 2-4")
        self.ed_range.setVisible(False)
        self.ed_range.setFixedWidth(side_w)
        side.addWidget(self.ed_range)
        self.cb_duplex = QComboBox()
        self.cb_duplex.addItems([t for t, _ in self.DUPLEX])
        field("Druk", self.cb_duplex)
        self.cb_source = QComboBox()
        self.cb_source.addItems([t for t, _ in self.SOURCES])
        field("Podajnik papieru", self.cb_source)
        self.sp_copies = QSpinBox()
        self.sp_copies.setRange(1, 99)
        field("Liczba kopii", self.sp_copies)
        self.lb_pages = QLabel("")
        self.lb_pages.setObjectName("muted")
        side.addWidget(self.lb_pages)
        self.lb_msg = QLabel("")
        self.lb_msg.setObjectName("muted")
        self.lb_msg.setWordWrap(True)
        self.lb_msg.setFixedWidth(side_w)
        side.addWidget(self.lb_msg)
        side.addStretch(1)

        right = QVBoxLayout()
        right.setSpacing(6)
        body.addLayout(right, 1)
        nav = QHBoxLayout()
        nav.setSpacing(6)
        self.b_prev, self.b_next = QPushButton("Poprzednia"), QPushButton("Następna")
        self.lb_page = QLabel("")
        self.b_width, self.b_fit = QPushButton("Dopasuj do szerokości"), QPushButton("Cała strona")
        for b in (self.b_prev, self.b_next):
            nav.addWidget(b)
        nav.addWidget(self.lb_page)
        nav.addStretch(1)
        nav.addWidget(self.b_width)
        nav.addWidget(self.b_fit)
        right.addLayout(nav)
        self.preview = QPrintPreviewWidget(self.printer)
        self.preview.paintRequested.connect(lambda p: print_document(self.doc, p))
        right.addWidget(self.preview, 1)

        bb = QHBoxLayout()
        bb.setSpacing(6)
        self.b_print, self.b_cancel = QPushButton("Drukuj"), QPushButton("Anuluj")
        for b in (self.b_print, self.b_cancel):
            b.setObjectName("big")
            bb.addWidget(b, 1)
        root.addLayout(bb)

        self.cb_printer.currentIndexChanged.connect(lambda *_: self.apply())
        self.cb_orient.currentIndexChanged.connect(lambda *_: self.apply())
        self.cb_paper.currentIndexChanged.connect(lambda *_: self.apply())
        self.cb_margin.currentIndexChanged.connect(lambda *_: self.apply())
        self.cb_duplex.currentIndexChanged.connect(lambda *_: self._printer_options())
        self.cb_source.currentIndexChanged.connect(lambda *_: self._printer_options())
        self.cb_range.currentIndexChanged.connect(lambda *_: self._range_mode())
        self.ed_range.textChanged.connect(lambda *_: self._range_check())
        self.b_prev.clicked.connect(lambda checked=False: self._go(-1))
        self.b_next.clicked.connect(lambda checked=False: self._go(1))
        self.b_width.clicked.connect(lambda checked=False: self.preview.fitToWidth())
        self.b_fit.clicked.connect(lambda checked=False: self.preview.fitInView())
        self.preview.previewChanged.connect(self._pages_changed)
        self.b_print.clicked.connect(lambda checked=False: self.do_print())
        self.b_cancel.clicked.connect(self.close)
        self.apply()
        self.preview.fitToWidth()

    # ---------------------------------------------------------------- settings
    def apply(self):
        """Printer, paper and orientation from the controls → printer → refreshed preview."""
        QP = self._QPrinter
        pdf = self.cb_printer.currentText() == self.PDF
        if pdf:
            self.printer.setOutputFormat(QP.OutputFormat.PdfFormat)
        else:
            self.printer.setOutputFormat(QP.OutputFormat.NativeFormat)
            self.printer.setPrinterName(self.cb_printer.currentText())
        self.sp_copies.setEnabled(not pdf)
        self.cb_source.setEnabled(not pdf)
        self._duplex_modes(pdf)
        self.b_print.setText("Zapisz PDF…" if pdf else "Drukuj")
        sid = getattr(self._QPageSize.PageSizeId, self.cb_paper.currentText())
        self.printer.setPageSize(self._QPageSize(sid))
        self.printer.setPageOrientation(self._QPageLayout.Orientation.Landscape if self.cb_orient.currentIndex()
                                        else self._QPageLayout.Orientation.Portrait)
        mm = self.MARGINS[self.cb_margin.currentIndex()][1]
        from PySide6.QtCore import QMarginsF
        self.printer.setPageMargins(QMarginsF(mm, mm, mm, mm), self._QPageLayout.Unit.Millimeter)
        self._printer_options()
        self.preview.updatePreview()

    def _duplex_modes(self, pdf):
        """Only the duplex modes the chosen printer supports are available (PDF – none)."""
        from PySide6.QtPrintSupport import QPrinterInfo
        QP = self._QPrinter
        ok = {"DuplexNone"}
        if not pdf:
            info = QPrinterInfo.printerInfo(self.cb_printer.currentText())
            ok |= {getattr(m_, "name", str(m_)) for m_ in info.supportedDuplexModes()}
        model = self.cb_duplex.model()
        for i_, (_t, nm) in enumerate(self.DUPLEX):
            item = model.item(i_)
            if item is not None:
                item.setEnabled(nm in ok)
        if not model.item(self.cb_duplex.currentIndex()).isEnabled():
            self.cb_duplex.setCurrentIndex(0)
        self.cb_duplex.setEnabled(len(ok) > 1)

    def _printer_options(self):
        """Duplex and the tray → printer (not for PDF)."""
        if self.cb_printer.currentText() == self.PDF:
            return
        QP = self._QPrinter
        self.printer.setDuplex(getattr(QP.DuplexMode, self.DUPLEX[self.cb_duplex.currentIndex()][1]))
        self.printer.setPaperSource(getattr(QP.PaperSource, self.SOURCES[self.cb_source.currentIndex()][1]))

    def _range_mode(self):
        self.ed_range.setVisible(self.cb_range.currentIndex() == 1)
        self._range_check()

    def page_range(self):
        """(from, to) of the chosen range; None – all pages; False – invalid text."""
        if self.cb_range.currentIndex() == 0:
            return None
        t = self.ed_range.text().strip().replace("–", "-").replace(" ", "")
        m_ = re.fullmatch(r"(\d+)(?:-(\d+))?", t)
        if not m_:
            return False
        a, b = int(m_.group(1)), int(m_.group(2) or m_.group(1))
        if a < 1 or b < a or b > self.preview.pageCount():
            return False
        return a, b

    def _range_check(self):
        bad = self.page_range() is False
        self.ed_range.setStyleSheet(f"background:{ERR_BG};" if bad and self.ed_range.text().strip() else "")
        self.b_print.setEnabled(not bad)

    def _pages_changed(self):
        n = self.preview.pageCount()
        self.lb_pages.setText(f"Liczba stron: {n}")
        self.lb_page.setText(f"Strona {self.preview.currentPage()} z {n}")
        self._range_check()

    def _go(self, d):
        n = self.preview.pageCount()
        self.preview.setCurrentPage(min(max(self.preview.currentPage() + d, 1), max(n, 1)))
        self._pages_changed()

    # ---------------------------------------------------------------- printing
    def print_to(self, path=None):
        """Prints the document with the current settings; path – PDF file (PDF output)."""
        QP = self._QPrinter
        if path:
            self.printer.setOutputFormat(QP.OutputFormat.PdfFormat)
            self.printer.setOutputFileName(path)
        rng = self.page_range()
        if rng:
            self.printer.setPrintRange(QP.PrintRange.PageRange)
            self.printer.setFromTo(*rng)
        else:
            self.printer.setPrintRange(QP.PrintRange.AllPages)
        self.printer.setCopyCount(1 if self.cb_printer.currentText() == self.PDF else self.sp_copies.value())
        self.preview.print_()
        self.printer.setPrintRange(QP.PrintRange.AllPages)      # the preview shows all the pages again
        self.preview.updatePreview()

    def do_print(self):
        from PySide6.QtWidgets import QFileDialog
        if self.page_range() is False:
            return
        if self.cb_printer.currentText() == self.PDF:
            name = re.sub(r'[\\/:*?"<>|]+', "_", self.title) or "wydruk"
            path, _ = QFileDialog.getSaveFileName(self, "Zapisz jako PDF", name + ".pdf", "PDF (*.pdf)")
            if not path:
                return
            if not path.lower().endswith(".pdf"):
                path += ".pdf"
            self.print_to(path)
            self.lb_msg.setText(f"Zapisano: {path}")
        else:
            self.print_to()
            self.lb_msg.setText("Wysłano do drukarki.")
        self.close()


class AboutDialog(QDialog):
    """O programie (menu bar): logo, version, update check and automatic checking. The content is centred
    vertically. The automatic-check switch is saved at once (settings.json)."""

    def __init__(self, app, parent):
        super().__init__(parent)
        self.app = app
        self.setWindowTitle("O programie")
        self.setWindowFlag(Qt.WindowType.WindowContextHelpButtonHint, False)
        self.setMinimumSize(460, 340)
        v = QVBoxLayout(self)
        v.setContentsMargins(20, 16, 20, 16)
        v.setSpacing(10)
        v.addStretch(1)
        self.logo_kayenn = QLabel()
        self.logo_kayenn.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.logo_kayenn.setPixmap(self._wordmark(320))
        v.addWidget(self.logo_kayenn)
        self.ver_label = QLabel(f"KAYENN – wersja {APP_VERSION}")
        self.ver_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        v.addWidget(self.ver_label)
        self.b_update = QPushButton("Sprawdź aktualizacje")
        self.b_update.clicked.connect(lambda checked=False: self.check())
        v.addWidget(self.b_update, 0, Qt.AlignmentFlag.AlignCenter)
        self.upd_label = QLabel("")
        self.upd_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.upd_label.setWordWrap(True)
        self.upd_label.setOpenExternalLinks(True)
        v.addWidget(self.upd_label)
        self.b_install = QPushButton("Instaluj")         # shown when a newer version is found
        self.b_install.clicked.connect(lambda checked=False: self.install())
        self.b_install.hide()
        v.addWidget(self.b_install, 0, Qt.AlignmentFlag.AlignCenter)
        self._result = None
        self.ck_auto = QCheckBox("Sprawdzaj automatycznie")
        self.ck_auto.setChecked(bool(settings_get("update_auto", True)))
        self.ck_auto.toggled.connect(lambda on: settings_set("update_auto", bool(on)))
        v.addWidget(self.ck_auto, 0, Qt.AlignmentFlag.AlignCenter)
        v.addStretch(1)
        self._checker = None

    @staticmethod
    def _wordmark(w):
        from PySide6.QtGui import QPixmap
        pm = QPixmap(os.path.join(ASSETS, "kayenn_wordmark.png"))
        return pm.scaledToWidth(w, Qt.TransformationMode.SmoothTransformation) if not pm.isNull() else QPixmap()

    def check(self):
        """Sprawdź aktualizacje – in the background, the result in the label."""
        self.b_update.setEnabled(False)
        self.upd_label.setText("Sprawdzanie…")
        self._checker = UpdateChecker(self)
        self._checker.done.connect(self.show_result)
        self._checker.start()

    def show_result(self, r):
        self.b_update.setEnabled(True)
        self.upd_label.setText(update_text(r))
        self._result = r
        self.b_install.setVisible(bool(r.get("ok") and r.get("newer")))

    def install(self):
        """Instaluj – download, close, install and start the new version."""
        if self._result:
            self.app.echo("UPDATES INSTALL")
            start_update_install(self.app, self._result)


def update_text(r):
    """Update check result as rich text for the label / message."""
    if not r.get("ok"):
        return html.escape(r.get("msg", "Nie udało się sprawdzić aktualizacji."))
    if r.get("newer"):
        return (f'Dostępna jest nowa wersja <b>{html.escape(r["version"])}</b>. '
                f'<a href="{html.escape(r["url"])}">Co nowego</a>')
    if r.get("none"):
        return "Brak opublikowanych wydań – masz najnowszą wersję."
    return "Masz najnowszą wersję programu."


