    def fill_text(self, t, items):
        """items: ("v", value, description[, basis]) | ("h", heading) | ("n", note) | ("s", symbol, description) |
        ("r", basis) | ("t", table). Basis – the fragment of the code the calculation comes from."""
        esc = html.escape
        mono = f"font-family:'{MONO}',monospace; font-weight:bold; color:{TEXT};"
        out = []
        for it in items:
            if it[0] == "v":
                s = f'<span style="{mono}">{esc(it[1])}</span>'
                if it[2]:
                    s += f'<span style="color:{MUTED};">&nbsp; – {esc(it[2])}</span>'
                if len(it) > 3 and it[3]:
                    s += basis_html(it[3])
                out.append(f'<p style="margin:0 0 3px 0;">{s}</p>')
            elif it[0] == "r":                       # basis only (under a table / a group of lines)
                out.append(f'<p style="margin:0 0 3px 0;">{basis_html(it[1])}</p>')
            elif it[0] == "s":
                out.append(f'<p style="margin:0 0 1px 12px;"><span style="{mono}">{esc(it[1])}</span>'
                           f'<span style="color:{MUTED};"> – {esc(it[2])}</span></p>')
            elif it[0] == "h":
                out.append(f'<p style="margin:8px 0 2px 0; font-weight:bold;">{esc(it[1])}</p>')
            elif it[0] == "t":                       # summary table
                tb = it[1]
                if not tb.rows:
                    continue
                cell = "padding:2px 6px; border-bottom:1px solid #e5e7eb;"
                h = [f'<table cellspacing="0" style="margin:4px 0 4px 0; border-collapse:collapse;"><tr>']
                for i, hd in enumerate(tb.heads):
                    h.append(f'<th style="{cell} background:#eef1f5; text-align:'
                             f'{"left" if i in tb.left else "right"};">{esc(hd)}</th>')
                h.append("</tr>")
                for vals, tags in tb.rows:
                    if "sep" in tags:
                        h.append(f'<tr><td colspan="{len(tb.heads)}" style="{cell} font-weight:bold; '
                                 f'background:#f8f9fb;">{esc(vals[0])}</td></tr>')
                        continue
                    col = "#1d4ed8" if "neg" in tags else ("#b91c1c" if "pos" in tags else TEXT)
                    h.append("<tr>" + "".join(
                        f'<td style="{cell} color:{col}; text-align:{"left" if i in tb.left else "right"}; '
                        f'{"" if i in tb.left else mono.replace("font-weight:bold;", "").replace(f"color:{TEXT};", "")}">'
                        f'{esc(v).replace("  ", "&nbsp;&nbsp;")}</td>' for i, v in enumerate(vals)) + "</tr>")
                h.append("</table>")
                out.append("".join(h))
            else:
                out.append(f'<p style="margin:2px 0 1px 0; color:#92400e;">{esc(it[1])}</p>')
        sb = t.verticalScrollBar()
        pos = sb.value()
        out.append(char_note_html())
        t.setHtml("".join(out))
        QTimer.singleShot(0, lambda: sb.setValue(pos))     # keep the scroll position

    # ------------------------------------------------------------ projects ---
    def file_menu(self, mb, project):
        """Plik menu. Main window: Nowy projekt, Otwórz, Zapisz, Zapisz jako, Zakończ; code loads: Zakończ."""
        mf = mb.addMenu("Plik")
        entries = [("Zakończ", "EXIT", self.on_close)]
        if project:
            entries = [("Nowy projekt", "NEW", self.file_new),
                       ("Otwórz plik projektu…", "OPEN", self.file_open), None,
                       ("Zapisz", "SAVE", self.file_save), ("Zapisz jako…", "SAVEAS", self.file_save_as),
                       None, ("Informacje o projekcie…", "PROJECTINFO", self.project_info),
                       ("Otwórz w edytorze tekstu", "EDITOR", self.open_in_editor),
                       ("Drukuj…", "PRINT", self.print_project), None,
                       ("Opcje…", "OPTIONS", self.options), None] + entries
        for entry in entries:
            if entry is None:
                mf.addSeparator()
                continue
            text, cmd, fn = entry                      # cmd – the console command of the item (shortcuts file)
            act = mf.addAction(text)
            SHORTCUTS.bind(act, cmd, scope="app" if project else None)       # main window: in every window
            act.triggered.connect(lambda checked=False, fn=fn: fn())
        return mf

    def view_menu(self, mb):
        """Widok menu: Konsola (the command line with its history; the check mark follows the window)."""
        mv = mb.addMenu("Widok")
        act = mv.addAction("Konsola")
        act.setCheckable(True)
        SHORTCUTS.bind(act, "CONSOLE", scope="app")
        act.triggered.connect(lambda checked=False: self.cmd.show_console(checked))
        self.cmd.view_action = act
        return mv

    def loads_menu(self, mb):
        """Obciążenia menu: Obciążenia normowe, Obciążenia własne (check mark = the window is open)."""
        m = mb.addMenu("Obciążenia")
        out = []
        for text, cmd, fn in (("Obciążenia normowe", "CODES", self.toggle_codes),
                              ("Obciążenia własne", "LAB", self.toggle_lab)):
            act = m.addAction(text)
            act.setCheckable(True)
            SHORTCUTS.bind(act, cmd, echo=False, scope="app")          # toggle_codes / toggle_lab write the echo themselves
            act.triggered.connect(lambda checked=False, fn=fn: fn())
            out.append(act)
        return out

    def options(self, toggle=False):
        """Plik → Opcje…: non-blocking window (keyboard shortcuts); toggle (the command OPTIONS) – an open window
        is closed."""
        host = self.host
        d = getattr(host, "_opt_dlg", None)
        if toggle and d is not None and d.isVisible():
            d.close()
            return None
        if d is None:
            d = OptionsDialog(host, host.pw)
            d.setModal(False)
            host._opt_dlg = d
            d.finished.connect(lambda r: (setattr(host, "_opt_dlg", None), d.deleteLater()))
        d.show()
        d.raise_()
        d.activateWindow()
