class MaterialTile(QFrame):
    """Database item tile: name, value (range described in words), source; on the right Edytuj, Duplikuj, Usuń.
    Click – select, double-click – Dodaj. Edytuj – form inside the tile (Zapisz / Anuluj)."""

    def __init__(self, dlg, key):
        super().__init__()
        self.dlg, self.key = dlg, key
        self.setObjectName("tile")
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(10, 6, 8, 6)
