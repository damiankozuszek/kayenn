            rows.append(f"α_{kind} = {f(al)} (ψ₀ = {f(psi0)}, {'A' if kind == 'A' else 'n'} = {par:g}) → "
                        + (f"<b>zredukowane qₖ = {f(al * qv)} kN/m²</b>" if qv is not None else "") +
                        (" (6.3.1.2(10), wzór 6.1)" if kind == "A" else " (6.3.1.2(11), wzór 6.2)"))
        if ex["part"] is not None:
            rows.append(f"przestawne ścianki działowe: <b>+ {f(ex['part'])} kN/m²</b> "
                        f"({USE_PARTS[self.use_part.currentIndex()]}, 6.3.1.2(8))")
        if ex["total"] is not None:
            rows.append(f"<b>qₖ łącznie = {f(ex['total'])} kN/m²</b>")
        if ex["fl"]:
            d_ = ex["fl"]
            nw, lift, a_, b_, l_, _ = d_["data"]
            rows.append(f"φ = {f(d_['phi'])} ({USE_TYRES[max(self.use_tyre.currentIndex(), 0)].split(' (')[0]}, "
                        f"6.3.2.3(4)) → <b>Qₖ,dyn = φ·Qₖ = {f(d_['dyn'])} kN</b> (6.3)")
            rows.append(f"obciążenie poziome od przyspieszania i hamowania: <b>0,3·Qₖ = {f(d_['hor'])} kN</b> "
                        "(6.3.2.3(7))")
            rows.append(f"wymiary (Tablica 6.5, Rysunek 6.1): rozstaw kół a = {f(a_)} m, szerokość b = {f(b_)} m, "
                        f"długość l = {f(l_)} m; ciężar netto {f(nw)} kN, udźwig {f(lift)} kN")
            rows.append("Obciążenie przykładane razem z obciążeniem równomiernym z Tablic 6.2, 6.4 lub 6.8 "
                        "(6.3.2.2(7)); podnośniki cięższe niż 110 kN – dokładniejsza analiza (6.3.2.3(5)).")
        if ex["bar"]:
            b = ex["bar"]
            rows.append(f"{html.escape(USE_BSIT[b['sit']])} (Zał. B, {USE_BSIT_REF[b['sit']]}); "
                        f"{html.escape(USE_BCLASS[1 if b['big'] else 0])} (B(3), B(4))")
            rows.append(f"F = 0,5·m·v²/(δc + δb) = 0,5·{b['m']:g}·4,5²/({b['dc']:g} + {b['db']:g}) = {f(b['F'])} kN "
                        "(B(2), m [kg], v [m/s], δ [mm])")
            rows.append(f"<b>siła pozioma {'F' if b['k'] == 1 else ('F/2' if b['k'] == 0.5 else '2F')} = "
                        f"{f(b['Fd'])} kN</b>, prostopadła do bariery, rozłożona równomiernie na dowolnej długości "
                        f"1,5 m, na wysokości: {b['hgt']}")
        return (f"<p style='margin:0 0 4px 0;'><b>Obciążenia użytkowe</b> – {html.escape(gt)}<br>"
                f"Kategoria: {html.escape(self._use_title())}</p>"
                f"<p style='margin:0 0 4px 0;'>{'<br>'.join(rows)}</p>"
                f"<p style='color:{MUTED}; margin:0;'>PN-EN 1991-1-1, {html.escape(src)}</p>" + char_note_html())

    def _use_state(self):
        e, v, _ = self._use_entry()
        return dict(grupa=USE_GROUPS[max(self.use_group.currentIndex(), 0)][0], kategoria=e["code"],
                    uzytkowanie=v["code"] if e.get("like") else None, qk=self.use_q.text().strip(),
                    Qk=self.use_Q.text().strip(), scianki=self.use_part.currentIndex(),
                    redukcja=self.use_red.currentIndex(), A=self.use_A.text().strip(), n=self.use_n.text().strip(),
                    opony=self.use_tyre.currentIndex(), bariera=dict(
                        klasa=self.use_bcl.currentIndex(), polozenie=self.use_bsit.currentIndex(),
                        **{k: ws[1].text().strip() for k, ws in self.use_bw.items()}))

    def _use_set_state(self, d):
        if not d:
            return
        gi = next((i for i, g_ in enumerate(USE_GROUPS) if g_[0] == d.get("grupa")), None)
        if gi is None:
            return
        self.use_group.setCurrentIndex(gi)
        ci = next((i for i, e in enumerate(USE_GROUPS[gi][3]) if e["code"] == d.get("kategoria")), 0)
        self.use_cat.setCurrentIndex(ci)
        li = next((i for i, e in enumerate(USE_LIKE) if e["code"] == d.get("uzytkowanie")), None)
        if li is not None:
            self.use_like.setCurrentIndex(li)
        self.use_q.setText(str(d.get("qk", "")))
        self.use_Q.setText(str(d.get("Qk", "")))
        self.use_part.setCurrentIndex(min(max(int(d.get("scianki", 0) or 0), 0), len(USE_PARTS) - 1))
        self.use_red.setCurrentIndex(min(max(int(d.get("redukcja", 0) or 0), 0), len(USE_REDS) - 1))
        self.use_A.setText(str(d.get("A", "20")))
        self.use_n.setText(str(d.get("n", "3")))
        self.use_tyre.setCurrentIndex(min(max(int(d.get("opony", 0) or 0), 0), len(USE_TYRES) - 1))
        br = d.get("bariera") or {}
        self.use_bcl.setCurrentIndex(min(max(int(br.get("klasa", 0) or 0), 0), len(USE_BCLASS) - 1))
        self.use_bsit.setCurrentIndex(min(max(int(br.get("polozenie", 0) or 0), 0), len(USE_BSIT) - 1))
        for k, val in (("m", "3000"), ("dc", "100"), ("db", "0")):
            self.use_bw[k][1].setText(str(br.get(k, val)))
        self._use_show()

    # ---------------------------------------------------------------- form ---
    def fill_slots(self, slots, fields, diff_on):
        """Assigns geometry fields to slots; returns the active field definitions."""
        has_diff = "#diff" in fields
        layout = []
        for f in fields:
            if isinstance(f, str):
                if f == "#diff" and diff_on:
                    layout.append(None)              # empty slot: α₂ goes under α₁
                continue
            if has_diff and f[0].endswith("alpha2") and not diff_on:
                continue
            layout.append(f)
        active = [f for f in layout if f]
        for i, (lb, e, un) in enumerate(slots):
            f = layout[i] if i < len(layout) else None
            if f:
                key, lab, unit = f[:3]
                if has_diff and diff_on and key.endswith("_alpha"):
                    lab = "Kąt α₁ (połać 1)"
                if lb.text() != lab:
                    lb.setText(lab)
                tip = f"Zakres: {field_range(f)}°" if unit == "°" else ""   # angles only
                if e.toolTip() != tip:
                    e.setToolTip(tip)
                if un.text() != unit:
                    un.setText(unit)
                if e._key != key:
                    e._key = key
                    e.setText(self.v[key].get())
                    e.setEnabled(True)
                if not e._shown:
                    e._shown = True
                    for w_ in (lb, e, un):
                        w_.setVisible(True)
            else:
                e._key = None
                if e._shown:
                    e._shown = False
                    for w_ in (lb, e, un):
                        w_.setVisible(False)
        return active

    def schedule(self):
        # changes in the code loads form do not mark the project as changed (the save question only appears
        # after adding / changing a case – project_changed)
        if self._pending:
            return
        self._pending = True
        QTimer.singleShot(0, self.recalc)

    def _mark_bad(self, e, bad):
        if e._bad != bad:
            e._bad = bad
            e.setProperty("bad", bad)
            e.style().unpolish(e)
            e.style().polish(e)

    def _val(self, f, widgets):
        key, lab, unit, lo, hi, strict, integer = f
        v = parse_num(self.v[key].get())
        bad = v is None or (v <= lo if strict else v < lo) or v > hi or (integer and abs(v - round(v)) > 1e-9)
        for e in widgets:
            self._mark_bad(e, bad)
        if bad:
            self._errors.append(key)
            return None
        return int(round(v)) if integer else v

    def _read_simple(self, key, lo, hi, strict=False, active=True):
        ws = self.entries.get(key, [])
        if not active:
            for e in ws:
                self._mark_bad(e, False)
            return 0.0
        return self._val((key, "", "", lo, hi, strict, False), ws)

    def _read_geo(self, slots, fields, prefix_len=2, skip=()):
        out = {}
        for f in fields:
            ws = [e for _, e, _ in slots if e._key == f[0]]
            if f[0] in skip:
                for e in ws:
                    e.setEnabled(False)
                    self._mark_bad(e, False)
                out[f[0][prefix_len:]] = 0.0
                continue
            for e in ws:
                if not e.isEnabled():
                    e.setEnabled(True)
            out[f[0][prefix_len:]] = self._val(f, ws)
        return out

    def recalc(self):
        self._scene_ver = getattr(self, "_scene_ver", 0) + 1     # invalidates the cached geometry of the 3D model
        self._pending = False
        self._in_recalc = True
        try:
            self._recalc()
        finally:
            self._in_recalc = False
        if not self._loading and not self._fh_mute:     # Cofnij: the form change recorded after a moment
            self._fh_timer.start()
            self.form_hist.notify()

    def _apply_location(self):
        """Location: coordinates in the tabs; zones and altitude changed relative to the map – field names
        in red with the „zmienione ręcznie” note, Przywróć button."""
        loc = self.loc.get()
        self._zinfo = {}
        if loc:
            for kind in ("snow", "wind"):
                self._zinfo[kind] = zone_lookup(kind, loc["lon"], loc["lat"])
            txt = f"{loc['lat']:.4f}° N, {loc['lon']:.4f}° E"
        else:
            txt = "nie wybrano – wybierz w oknie głównym: Plik → Informacje o projekcie"
        for lb in self.loc_labels:
            lb.configure(text=txt)
        fl = self._manual_flags()
        self._manual = fl
        marks = [(cb._label, fl[n]) for cb, n in zip(self.zone_boxes, ("snow_zone", "wind_zone"))]
        marks += [(e._label, fl["A"]) for e in self.entries.get("A", [])]
        for lb, on in marks:
            t = lb._base + ("\nzmienione ręcznie" if on else "")
            if lb.text() != t:
                lb.setText(t)
                lb.setStyleSheet(f"color:{MANUAL_COL};" if on else "")
        for b in self.loc_restore:
            b.setVisible(bool(loc))
            b.setEnabled(any(fl.values()))

    def _zone_note(self, kind):
        zi = getattr(self, "_zinfo", {}).get(kind)
        if not zi or getattr(self, "_manual", {}).get(kind + "_zone"):
            return ""
        if zi["zone"] is None:
            return "\n⚠ Punkt poza Polską – wybierz strefę ręcznie."
        t = ""
        for d, z in zi["near"]:
            t += f"\nGranica ze strefą {z} w odległości ok. {f2(d, 0)} km"
            t += (" – w pasie 10 km można przyjąć średnią sₖ obu stref (strefę można zmienić ręcznie)."
                  if kind == "snow" else " – sprawdź lokalizację z mapą normy.")
        return t

    def _recalc(self):
        self._apply_location()
        self._errors = []
        geo_err = []
        ct_f = self.ct_mode.get() == CT_MODES[1]
        cpi_kind = CPI_MODES.index(self.cpi_mode.get()) if self.cpi_mode.get() in CPI_MODES else 0
        skind, sfields = SNOW_TYPES[self.snow_type.get()]
        wkind, wfields = WIND_TYPES[self.wind_type.get()]
        canopy = wkind in ("can1", "can2")
        for k, on in (("U", ct_f), ("ti", ct_f), ("mu", cpi_kind == 1 and not canopy),
                      ("ndom", cpi_kind == 2 and not canopy), ("phi", canopy)):
            for e in self.entries[k]:
                if e.isEnabled() != on:
                    e.setEnabled(on)
        if self.dom_cb.isEnabled() != (cpi_kind == 2 and not canopy):
            self.dom_cb.setEnabled(cpi_kind == 2 and not canopy)
        A = self._read_simple("A", 0, 2500)
        U = self._read_simple("U", 1, 4.5, active=ct_f)
        ti = self._read_simple("ti", -50, 60, active=ct_f)
        nret = self._read_simple("nret", 5, 10000)               # Annex D(1): not for P > 0.2 (n < 5 years)
        cse = self._read_simple("cseason", 0, 1, True)          # NA.4: recommended 1.0 (not above 1.0)
        Al = self._read_simple("Aload", 0, 1e6, True)
        mu = self._read_simple("mu", 0.33, 1, active=cpi_kind == 1 and not canopy)
        ndom = self._read_simple("ndom", 2, 1000, active=cpi_kind == 2 and not canopy)
        phi = self._read_simple("phi", 0, 1, active=canopy)
        oro_k = OROGRAPHY.index(self.w_oro.get()) if self.w_oro.get() in OROGRAPHY else 0
        for k, on in (("oH", oro_k > 0), ("oLu", oro_k > 0), ("oLd", oro_k == 1), ("ox", oro_k > 0)):
            for e in self.entries[k]:
                if e.isEnabled() != on:
                    e.setEnabled(on)
        oro = dict(kind=oro_k, H=self._read_simple("oH", 0, 2000, True, oro_k > 0),
                   Lu=self._read_simple("oLu", 0, 1e5, True, oro_k > 0),
                   Ld=self._read_simple("oLd", 0, 1e5, True, oro_k == 1) or 1.0,
                   x=self._read_simple("ox", -1e5, 1e5, False, oro_k > 0)) if oro_k else None

        # ---------- snow: building
        sdiff = skind == "duo" and self.s_diff.get()
        sact = self.fill_slots(self.s_slots, sfields, sdiff)
        if self._s_layout != skind:            # layout changed only when the shape changes
            self._s_layout = skind
            self.s_diff_cb.setVisible(skind == "duo")
            self.s_obst_lb.setVisible(skind == "obst")
            self.s_obst_cb.setVisible(skind == "obst")
            self.s_exc_cb.setVisible(skind in EXC_FIELDS)
            self.s_ex.setVisible(skind in ("duo", "obst") or skind in EXC_FIELDS)
        skip = ("s_yob",) if self.s_obst.get() != OBST_TYPES[1] else ()
        sp_geo = self._read_geo(self.s_slots, sact, skip=skip)
        exc_on = bool(self.s_exc.get()) and skind in EXC_SECTIONS
        secs = EXC_SECTIONS.get(skind, []) if exc_on else []
        exc = {}
        for (pos, key), hw in self.s_xhdr.items():
            want = pos < len(secs) and secs[pos][0] == key
            if hw._want != want:
                hw._want = want
                hw.setVisible(want)
        for pos in range(4):
            sec = secs[pos] if pos < len(secs) else None
            on = bool(sec and getattr(self, "sx_" + sec[0]).get())
            act = self.fill_slots(self.s_xsl[pos], sec[2] if on else [], False)
            if sec:
                exc[sec[0]] = on
                if on:
                    exc.update(self._read_geo(self.s_xsl[pos], act))
        sp_geo["exc"] = exc if exc_on else None
        sp_geo["A"] = A
        if skind == "duo" and not sdiff:
            sp_geo["alpha2"] = sp_geo.get("alpha")
        sp_geo["otype"] = self.s_obst.get()
        # ---------- wind: building
        wdiff = False                  # wind: the code gives no procedure for different slope angles
        if wkind == "flat":                      # only the field of the chosen edge type (Table 7.2)
            hide = {EDGE_TYPES[0]: ("w_r", "w_am"), EDGE_TYPES[1]: ("w_hp", "w_am"),
                    EDGE_TYPES[2]: ("w_hp", "w_r")}.get(self.w_edge.get(), ("w_r", "w_am"))
            wfields = [f for f in wfields if f[0] not in hide]
        wact = self.fill_slots(self.w_slots, wfields, wdiff)
        if self._w_layout != wkind:
            self._w_layout = wkind
            self.w_ex.setVisible(wkind == "multi")
            self.w_edge_ex.setVisible(wkind == "flat")
        wp_geo = self._read_geo(self.w_slots, wact)
        wp_geo.update(A=A, mtype=self.w_mtype.get(), edge=self.w_edge.get())
        if wkind == "duo" and not wdiff:
            wp_geo["alpha2"] = wp_geo.get("alpha")

        self.desc_update()
        # ---------- geometry check (invalid field – marked red)
        tg = lambda a: math.tan(math.radians(a))
        s_msg, w_msg = [], []
        bad = set(self._errors)
        S_KEYS = {"A", "U", "ti", "nret"}
        W_KEYS = {"A", "cseason", "Aload", "mu", "ndom", "phi", "oH", "oLu", "oLd", "ox"}
        s_ok = not any(k in S_KEYS or k.startswith("s_") for k in bad)
        w_ok = not any(k in W_KEYS or k.startswith("w_") for k in bad)
        if not s_ok:
            s_msg.append("Śnieg: popraw zaznaczone pola.")
        if not w_ok:
            w_msg.append("Wiatr: popraw zaznaczone pola.")

        def geo(ok, msgs, cond, key, text):
            if ok and cond():
                msgs.append(text)
                self._mark_key(key)
                return False
            return ok
        s_ok = geo(s_ok, s_msg, lambda: skind == "vault" and sp_geo["f"] > sp_geo["B"] / 2, "s_f",
                   "Śnieg: wyniosłość łuku h nie może przekraczać b/2.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "obst" and sp_geo["otype"] == OBST_TYPES[1]
                   and sp_geo["yob"] > sp_geo["B"] - 0.25, "s_yob", "Śnieg: ścianka musi leżeć na dachu (y ≤ B − 0,25 m).")
        sx = sp_geo.get("exc") or {}
        s_ok = geo(s_ok, s_msg, lambda: skind == "abut" and sx.get("annex") and sx["xh"] >= sp_geo["H"] + sp_geo["dh"], "s_xh",
                   "Śnieg: przybudówka – h musi być mniejsze od wysokości okapu budowli wyższej.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "abut" and sx.get("annex") and min(sx["xw"], sp_geo["L"]) / 2 *
                   tg(sx["xa"]) >= sx["xh"], "s_xa",
                   "Śnieg: kalenica przybudówki musi być niżej niż okap budowli wyższej.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "flat" and sx.get("fobst") and sx["fw"] >= sp_geo["L"], "s_fw",
                   "Śnieg: przeszkoda musi być węższa niż dach.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "flat" and sx.get("fobst") and sx["fd"] >= sp_geo["B"], "s_fd",
                   "Śnieg: przeszkoda musi być płytsza niż dach.")
        s_ok = geo(s_ok, s_msg, lambda: sx.get("canopy") and sx["ch"] >= sp_geo["H"],
                   "s_ch",
                   "Śnieg: zadaszenie musi leżeć poniżej krawędzi dachu.")
        s_ok = geo(s_ok, s_msg, lambda: skind in ("mono", "duo", "multi", "vault") and sx.get("pobst")
                   and not 0 < sx["poy"] < sp_geo["B"] - 0.25, "s_poy",
                   "Śnieg: przeszkoda musi leżeć na dachu (0 < y < B − 0,25 m).")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "vault" and wp_geo["f"] > wp_geo["B"] / 2, "w_f",
                   "Wiatr: wyniosłość łuku f nie może przekraczać d/2.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "dome" and wp_geo["f"] > wp_geo["D"] / 2, "w_f",
                   "Wiatr: wyniosłość kopuły f nie może przekraczać d/2.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "hip" and not Hip(wp_geo["L"], wp_geo["B"], wp_geo["H"],
                                                                   wp_geo["alpha"], wp_geo["a90"]).valid, "w_a90",
                   "Wiatr: połacie szczytowe nie mieszczą się na długości L (zwiększ α₉₀ lub L).")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "trough" and wp_geo["B"] / 2 * tg(wp_geo["alpha"]) >= wp_geo["H"],
                   "w_alpha", "Wiatr: kosz dachu schodzi poniżej poziomu terenu.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "can2" and wp_geo["alpha"] < 0
                   and wp_geo["B"] / 2 * tg(-wp_geo["alpha"]) >= wp_geo["H"],
                   "w_alpha", "Wiatr: kosz wiaty schodzi poniżej poziomu terenu.")
        self._s_ok, self._w_ok = s_ok, w_ok
        msgs = s_msg + w_msg
        self.status.configure(text=("⚠ " + "  ".join(msgs) + "  Model i wyniki – ostatnie poprawne dane.")
                              if msgs else "")

        # ---------- snow (independent of wind)
        if s_ok:
            sg = SnowGeo(skind, sp_geo)
            sp = dict(zone=self.snow_zone.get(), ce=self.snow_ce.get(), ct_formula=ct_f, U=U, ti=ti,
                      guard=self.guard.get(), nret=nret)
            self.sgeo = sg
            self.snow = calc_snow(sg, sp)
            cases = [c["name"] for c in self.snow["cases"]]
            for cb in self.case_boxes:
                self._set_items(cb, cases)
            if self.snow_case.get() not in cases:
                self.snow_case.set(cases[0])
            self.show_snow()
        # ---------- wind (independent of snow)
        if w_ok:
            wg = WindGeo(wkind, wp_geo)
            wp = dict(zone=self.wind_zone.get(), cat=self.terrain.get(),
                      cdir=cdir_value(self.wind_zone.get(), self.cdir_sec.get()), cdir_sec=self.cdir_sec.get(),
                      cseason=cse, Aload=Al, cpi_kind=cpi_kind, mu=mu, ndom=ndom,
                      dom_zone=self.dom_zone.get()[0], phi=phi, oro=oro,
                      cfr=CFR_VALUES[CFR_TYPES.index(self.w_cfr.get())] if self.w_cfr.get() in CFR_TYPES else 0.02,
                      delta=CSCD_DELTA[CSCD_STRUCT.index(self.w_struct.get())]
                      if self.w_struct.get() in CSCD_STRUCT else 0.10,
                      skin=SKIN_TYPES.index(self.w_skin.get()) if self.w_skin.get() in SKIN_TYPES else 0)
            ths = [f"{t}°" for t in wind_thetas(wg)]
            for cb in self.theta_boxes:
                self._set_items(cb, ths, len(ths) > 1)
            if self.theta.get() not in ths:
                self.theta.set(ths[0])
            th = int(self.theta.get().rstrip("°"))
            vars_ = wind_variants(wg, th)
            labs = [l for l, _ in vars_]
            for cb in self.variant_boxes:
                self._set_items(cb, labs, len(labs) > 1)
            if self.variant.get() not in labs:
                self.variant.set(labs[0])
            var = dict(vars_)[self.variant.get()]
            if self._last_theta != th:
                self._last_theta = th
                self.yaw = self.default_yaw(th)
            self.wgeo, self.wp = wg, wp
            self.wind = calc_wind(wg, wp, th, var)
            self.env = wind_envelope(wg, wp)
            self.show_wind()
        self.draw3d()

    def _mark_key(self, key):
        """Marks red all fields showing the given quantity."""
        ws = list(self.entries.get(key, [])) + [e for _, e, _ in self.s_slots + self.w_slots if e._key == key]
        for e in ws:
            self._mark_bad(e, True)

    def desc_update(self):
        self.ce_desc.configure(text=SNOW_CE[self.snow_ce.get()][1] + self._zone_note("snow"))
        self.wind_desc.configure(text=WIND_ZONES[self.wind_zone.get()] + "\nKategoria " + self.terrain.get() +
                                 ": " + TERRAIN[self.terrain.get()][3] + self._zone_note("wind"))

    # ============================================================ 3D WINDOW ===
    def toggle_3d(self):
        if self.win3d is not None and self.win3d.isVisible():
            self.hide_3d()
        else:
            self.show_3d()

    def show_3d(self):
        if self.win3d is None:
            self._build_3d()
        if self._3d_geom is not None:
            self.win3d.restoreGeometry(self._3d_geom)
        else:
            fg = self.win.frameGeometry()
            self.win3d.resize(960, 720)
            self.win3d.move(fg.x() + fg.width() + 12, max(fg.y(), 0))
        self.win3d.show()
        self.win3d.raise_()
        self.win3d.activateWindow()
        self.btn3d.setText("Zamknij model 3D")
        self.draw3d()

    def hide_3d(self):
        if self.win3d is None:
            return
        self._3d_geom = self.win3d.saveGeometry()
        self.close_editor()
        self.win3d.hide()
        self.btn3d.setText("Model 3D")

    def _build_3d(self):
        w = Win3D(self)
        w.setWindowTitle("Model 3D")
        w.setMinimumSize(640, 480)
        self.win3d = w
        lay = QVBoxLayout(w)
        lay.setContentsMargins(10, 8, 10, 10)
        lay.setSpacing(6)
        bar = QHBoxLayout()
        # --- snow options
        self.tb_snow = QWidget()
        h = QHBoxLayout(self.tb_snow)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(QLabel("Przypadek śniegu"))
        cb = self._mk_combo(self.snow_case, [c["name"] for c in self.snow["cases"]] if self.snow else ["i"], 4)
        h.addWidget(cb)
        self.case_boxes.append(cb)
        # --- wind options
        self.tb_wind = QWidget()
        h = QHBoxLayout(self.tb_wind)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(QLabel("Kierunek θ"))
        tl = [f"{t}°" for t in wind_thetas(self.wgeo)] if self.wgeo else ["0°"]
        cb = self._mk_combo(self.theta, tl, 5)
        cb.setEnabled(len(tl) > 1)
        h.addWidget(cb)
        self.theta_boxes.append(cb)
        h.addSpacing(10)
        h.addWidget(QLabel("Wariant"))
        vl = [l for l, _ in wind_variants(self.wgeo, self.wind["theta"])] if self.wgeo else []
        cb = self._mk_combo(self.variant, vl, 28)
        cb.setEnabled(len(vl) > 1)
        h.addWidget(cb)
        self.variant_boxes.append(cb)
        bar.addWidget(self.tb_snow)
        bar.addWidget(self.tb_wind)
        bar.addStretch(1)
        bar2 = QHBoxLayout()
        bar2.addWidget(self._mk_check("Etykiety", self.labels3d))
        bar2.addWidget(self._mk_check("Wymiary pól", self.dims3d))
        bar2.addWidget(self._mk_check("Wymiary budynku", self.bdims3d))
        self.ck_odims = self._mk_check("Wymiary orografii", self.odims3d)
        bar2.addWidget(self.ck_odims)
        bar2.addStretch(1)
        b = QPushButton("Widok domyślny")
        b.clicked.connect(lambda checked=False: self.reset_view())
        bar2.addWidget(b)
        self.tb_box = QWidget()                     # the whole bar – hidden when there is no model (Użytkowe tab)
        tbl = QVBoxLayout(self.tb_box)
        tbl.setContentsMargins(0, 0, 0, 0)
        tbl.setSpacing(6)
        tbl.addLayout(bar)
        tbl.addLayout(bar2)
        lay.addWidget(self.tb_box)
        self.cv = Canvas3D(self)
        lay.addWidget(self.cv, 1)
        self._tb_mode = None

    def update_toolbar(self, mode):
        """The 3D window bar shows only options for the displayed load."""
        self.ck_odims.setVisible(mode == "wiatr" and self.w_oro.get() != OROGRAPHY[0])
        if self._tb_mode == mode:
            return
        self._tb_mode = mode
        wind = mode == "wiatr"
        self.tb_snow.setVisible(not wind)
        self.tb_wind.setVisible(wind)

    def draw3d(self):
        """Redraws the model – batched, at most once per event loop cycle."""
        if self._draw_pending:
            return
        self._draw_pending = True
        QTimer.singleShot(0, self._draw3d_run)

    def _draw3d_run(self):
        self._draw_pending = False
        self._draw3d_now()
        if self.cv is not None:
            self.cv.update()

    # ---------------------------------------------------- editing dimensions in 3D ---
    def open_editor(self, key, pos):
        self.close_editor()
        keys = key if isinstance(key, tuple) else (key,)
        f = self.field_def(keys[0])
        fr = QFrame(self.cv)
        fr.setObjectName("editor")
        h = QHBoxLayout(fr)
        h.setContentsMargins(5, 2, 5, 2)
        h.setSpacing(4)
        lab = f[1] if f else keys[0]
        if f and f[2] == "°":                      # angle range hint
            rng = f"{field_range(f)}°"
            lab = lab[:-1] + f", {rng})" if lab.endswith(")") else lab + f" ({rng})"
        h.addWidget(QLabel(lab + ":"))
        ent = EditorLine(lambda: self.close_editor(fr), lambda: QTimer.singleShot(150, lambda: self.close_editor(fr)))
        ent.setAlignment(AL_R)
        ent.setFixedWidth(QFontMetrics(ui_font(FONT, 10)).horizontalAdvance("0") * 9 + 12)
        ent.setText(self.v[keys[0]].get())
        h.addWidget(ent)
        h.addWidget(QLabel(f[2] if f else ""))
        fr.adjustSize()
        x = int(clamp(pos[0] - fr.width() / 2, 2, max(self.cv.width() - fr.width() - 2, 2)))
        y = int(clamp(pos[1] - fr.height() / 2, 2, max(self.cv.height() - fr.height() - 2, 2)))
        fr.move(x, y)
        fr.show()
        ent.setFocus()
        ent.selectAll()
        self._editor = fr

        def commit():
            v = parse_num(ent.text())
            ok = v is not None
            if ok and f:
                k_, lab_, unit, lo, hi, strict, integer = f
                ok = (v > lo if strict else v >= lo) and v <= hi and (not integer or abs(v - round(v)) < 1e-9)
            if not ok:
                ent.setProperty("bad", True)
                ent.setStyleSheet(f"background:{ERR_BG};")
                return
            txt = ent.text().strip()
            self.close_editor(fr)
            for k_ in keys:
                self.v[k_].set(txt)
        ent.returnPressed.connect(commit)

    def field_def(self, key):
        """Field definition for the current shape (the same key may have different ranges in different shapes)."""
        for tp, var in ((SNOW_TYPES, self.snow_type), (WIND_TYPES, self.wind_type)):
            for f in tp[var.get()][1]:
                if not isinstance(f, str) and f[0] == key:
                    return f
        return FIELD_DEFS.get(key)

    def close_editor(self, only=None):
        ed = self._editor
        if ed is None or (only is not None and ed is not only):
            return
        self._editor = None
        ed.hide()
        ed.deleteLater()

    # ============================================================ PROJECT ===
    @staticmethod
    def _globals_of(st):
        """Data shared by the whole project: location, altitude and zones."""
        op = st.get("opcje", {})
        return dict(A=str(st.get("pola", {}).get("A", "")), snow_zone=op.get("snow_zone"),
                    wind_zone=op.get("wind_zone"), loc=st.get("lokalizacja"),
                    manual=bool(st.get("strefy_recznie", False)))

    @staticmethod
    def _put_globals(st, g):
        st.setdefault("pola", {})["A"] = g["A"]
        op = st.setdefault("opcje", {})
        op["snow_zone"], op["wind_zone"] = g["snow_zone"], g["wind_zone"]
        st["lokalizacja"] = g["loc"]
        st["strefy_recznie"] = g["manual"]

    def _cur_mode(self):
        """Load type of the current tab: „użytkowe”, „śnieg” or „wiatr”."""
        return "użytkowe" if self.nb.currentIndex() == TAB_USE else self.mode3d.get()

    def _main_extra(self):
        return {"mode": self._cur_mode(), "snow_case": self.snow_case.get(),
                "view": {k: getattr(self, k) for k in VIEW_KEYS},
                "toggles": {k: bool(getattr(self, k).get()) for k in TOGGLE_KEYS}}

    def project_changed(self):
        if not self._loading:
            self.dirty = True
            self.host.proj_hist.push(self._proj_snap())
            self.update_title()

    def _in_case(self, st, extra, fn):
        """Runs fn() with the form temporarily set to the case data, then restores the form."""
        self.close_editor()
        if self._pending:
            self.recalc()
        main_st, main_sc, dirty = self.get_state(), self.snow_case.get(), self.dirty
        view, last_th = {k: getattr(self, k) for k in VIEW_KEYS}, self._last_theta
        try:
            self.set_state(st)
            sc = extra.get("snow_case")
            if self.snow and sc in [c["name"] for c in self.snow["cases"]]:
                self.snow_case.set(sc)
            return fn()
        finally:
            self.set_state(main_st)
            if self.snow and main_sc in [c["name"] for c in self.snow["cases"]]:
                self.snow_case.set(main_sc)
            for k, v in view.items():
                setattr(self, k, v)
            self._last_theta = last_th
            self.dirty = dirty
            self.update_title()
            self.draw3d()

    def _grab_current(self, mode):
        """Current calculation of the code loads form (results, model, data for later editing)."""
        if mode == "użytkowe":
            ok, err = self._use_valid()
            return dict(ok=ok, err=err, state=self.get_state(), calc=dict(mode=mode, snow_case=None),
                        report=self._use_report())
        return dict(ok=bool(getattr(self, "_w_ok" if mode == "wiatr" else "_s_ok", False)),
                    err=self.status.text(), state=self.get_state(),
                    calc=dict(sgeo=self.sgeo, snow=self.snow, wgeo=self.wgeo, wind=self.wind, mode=mode,
                              snow_case=self.snow_case.get()),
                    report=source_html(self.wind_text if mode == "wiatr" else self.snow_text))

    def _compute(self, case):
        mode = case["extra"].get("mode", "śnieg")
        if mode == "własne":                          # own loads – without the code loads form
            d = case["state"].get("wlasne") or {}
            sm = lab_summary(d.get("pozycje") or [])
            return dict(ok=sm["ok"], err=sm["err"], state=case["state"], calc=dict(mode=mode, snow_case=None),
                        report=lab_report(d))
        return self._in_case(case["state"], case["extra"], lambda: self._grab_current(mode))

    def _apply_result(self, case, r):
        case["state"] = r["state"]
        case["report"] = r["report"]
        case["_calc"] = r["calc"]
        case["extra"]["snow_case"] = r["calc"]["snow_case"]

    def ensure_calc(self, case):
        if case.get("_calc") is None:
            r = self._compute(case)
            self._apply_result(case, r)          # invalid data – we still show the last valid model

    def recapture_case(self, case):
        """Recalculates a case after its data changed. False – invalid data."""
        r = self._compute(case)
        if not r["ok"]:
            case["_err"] = r["err"]
            return False
        self._apply_result(case, r)
        return True

    def field_def_state(self, st, key):
        op = st.get("opcje", {})
        for tp, n in ((SNOW_TYPES, "snow_type"), (WIND_TYPES, "wind_type")):
            if op.get(n) in tp:
                for f in tp[op[n]][1]:
                    if not isinstance(f, str) and f[0] == key:
                        return f
        return FIELD_DEFS.get(key)

    # --- drawing a saved case on any canvas
    _CTX_ATTRS = ("sgeo", "snow", "wgeo", "wind", "cv", "yaw", "pitch", "zoom", "pan_x", "pan_y", "piv", "_scene_key",
                  "_scene_cache", "_snow_ztop", "_edit_keys", "_placed", "_defer_angles", "_scene_ver", "_s_ok", "_w_ok", "_ctx")

    def render_case(self, cv, case, image=False):
        self.ensure_calc(case)
        calc, ex = case["_calc"], case["extra"]
        vpd = getattr(cv, "vp", None) or ex                   # the viewport's data (view, toggles)
        view = getattr(cv, "view", None) or vpd.get("view") or {}
        miss = object()
        saved = {n: getattr(self, n, miss) for n in self._CTX_ATTRS}
        vars_ = {n: getattr(self, n)._v for n in ("snow_case", "mode3d") + TOGGLE_KEYS}
        tg = vpd.get("toggles") or {}
        try:
            self.sgeo, self.snow, self.wgeo, self.wind = calc["sgeo"], calc["snow"], calc["wgeo"], calc["wind"]
            self.cv = cv
            self.piv = None
            for k in VIEW_KEYS:
                if k in view:
                    setattr(self, k, view[k])
            self._scene_key = getattr(cv, "_scene_key", None)
            self._scene_cache = getattr(cv, "_scene_cache", None)
            self._scene_ver = ("przypadek", id(calc))
            self._edit_keys = {}
            self._s_ok = self._w_ok = True
            self._ctx = "img" if image else "view"
            self.snow_case._v = calc["snow_case"]
            self.mode3d._v = calc["mode"]
            for k in TOGGLE_KEYS:
                getattr(self, k)._v = bool(tg.get(k, True))
            self._draw3d_now()
            cv._scene_key, cv._scene_cache, cv._edit_keys = self._scene_key, self._scene_cache, self._edit_keys
        finally:
            for n, v in saved.items():
                if v is miss:
                    if hasattr(self, n):
                        delattr(self, n)
                else:
                    setattr(self, n, v)
            for n, v in vars_.items():
                getattr(self, n)._v = v

    SNAP_W, SNAP_H, SNAP_DPR = 780, 540, 3         # image for printing: logical size, pixel density

    def snapshot(self, case, w=SNAP_W, h=SNAP_H, dpr=SNAP_DPR, vp=None):
        """Image of the case 3D model (for printing). Canvas of a size close to the image on paper (labels
        almost at natural size), painted at dpr-times pixel density (sharp lines and text)."""
        from PySide6.QtGui import QPixmap
        cv = getattr(self, "_snap_cv", None)
        if cv is None:
            cv = self._snap_cv = Canvas3D(self)
            cv.setAttribute(Qt.WidgetAttribute.WA_DontShowOnScreen, True)
        cv.resize(w, h)
        cv._scene_key = None
        cv.vp = vp                                    # the viewport to draw (None – the first)
        self.render_case(cv, case, image=True)
        pm = QPixmap(int(w * dpr), int(h * dpr))
        pm.setDevicePixelRatio(dpr)
        pm.fill(QColor(Canvas3D.BG_COL))
        cv.render(pm)
        return pm

    # --- code loads window buttons
    def set_editing(self, case):
        self.editing = case
        self.btn_add.setVisible(case is None)        # when editing a case only the 3D model button at the bottom
        self.update_title()
        self.update_buttons()

    def update_buttons(self):
        if getattr(self, "pw", None) is not None and self.pw.app is not None:
            self.pw.update_buttons()

    # --- own loads window (KAYENN Lab) above the main window
    def _lab_win(self, edit=False):
        host = self.host
        attr = "lab_ed" if edit else "lab"
        w = getattr(host, attr, None)
        if w is None:
            w = LabWindow(host, edit=edit)
            setattr(host, attr, w)
        return w

    def echo(self, line):
        """Writes what the user did in the windows to the console, as the command that does the same."""
        c = self.host.cmd
        if c is not None:
            c.echo(line)

    def _var_name(self, var):
        names = self.__dict__.get("_var_names")
        if names is None:
            names = self._var_names = {id(getattr(self, n)): n for n in self.STATE_VARS + ("w_diff", "snow_case")}
        return names.get(id(var))

    def _user_field(self, name, getter, now=False):
        """A field changed by the user: the console gets „FIELD name value” – at once for a choice (now), for typed
        text after a short pause in typing (or at once when the field is left / Enter – `_flush_field`)."""
        h = self.host
        if not name or h.cmd is None or h.cmd.depth or self._loading:
            return
        tm = self.__dict__.setdefault("_fe_timers", {})
        t = tm.get(name)
        if t is None:
            t = tm[name] = QTimer()
            t.setSingleShot(True)
            t.setInterval(300)
            t.timeout.connect(lambda t=t, name=name: self.echo(f"FIELD {name} {cq(t._g())}"))
        t._g = getter
        if now:
            t.stop()
            self.echo(f"FIELD {name} {cq(getter())}")
        else:
            t.start()

    def _flush_field(self, name):
        t = self.__dict__.get("_fe_timers", {}).get(name)
        if t is not None and t.isActive():
            t.stop()
            t.timeout.emit()

    def _hook_use(self):
        """Fields of the imposed-loads tab: the user's changes go to the console."""
        for name, label, w, kind in use_spec(self):
            if kind == "combo":
                w.activated.connect(lambda i, name=name, w=w: self._user_field(name, w.currentText, now=True))
            else:
                w.textEdited.connect(lambda t, name=name, w=w: self._user_field(name, w.text))
                w.editingFinished.connect(lambda name=name: self._flush_field(name))

    def toggle_lab(self):
        w = getattr(self.host, "lab", None)
        self.echo("LAB CLOSE" if w is not None and w.isVisible() else "LAB OPEN")
        if w is not None and w.isVisible():
            w.close_panel()
        else:
            self._lab_win().show_panel()

    def edit_lab_case(self, case):
        """Edytuj an own-loads case – separate panel (the adding panel works independently)."""
        w = self._lab_win(edit=True)
        if w.editing is not None and w.editing is not case and not w.end_edit():
            return
        w.start_edit(case)
        self.update_buttons()

    def add_lab_case(self, data):
        """Dodaj do projektu from the own-loads panel – new case at the top of the list."""
        from datetime import datetime
        host = self.host
        n = host.project["next"]
        host.project["next"] = n + 1
        case = {"id": n, "name": tr(f"Przypadek {n}"), "created": datetime.now().strftime("%Y-%m-%d %H:%M"),
                "extra": {"mode": "własne"}, "state": {"wlasne": data}}
        host.project["cases"].insert(0, case)
        host._apply_result(case, host._compute(case))
        host.project_changed()
        host.pw.insert_case(case)
        return case

    def store_lab_case(self, case, data):
        """Zakończ edycję of own loads – changed items go to the case."""
        host = self.host
        case["state"] = {"wlasne": data}
        host._apply_result(case, host._compute(case))
        host.project_changed()

    # --- code loads window (KAYENN Codes) above the main window
    def toggle_codes(self):
        self.echo("CODES CLOSE" if self.win.isVisible() else "CODES OPEN")
        if self.win.isVisible():
            self.close_codes()
        else:
            self.open_codes()

    def open_codes(self):
        if not self.win.isVisible():
            if not getattr(self, "_codes_placed", False):     # first time – above the main window
                g = self.pw.frameGeometry()
                scr = self.pw.screen().availableGeometry()
                d = 40 if self.host is self else 90           # editing panel – offset from the adding panel
                self.win.move(max(g.x() + d, scr.x()), max(g.y() + d - 10, scr.y()))
                self._codes_placed = True
            self.win.show()
        self.win.raise_()
        self.win.activateWindow()
        self.update_buttons()

    def close_codes(self):
        """Closing the panel (X, Zamknij obciążenia normowe; in the editing panel – also Zakończ edycję).
        False – the user stayed in editing."""
        if not self.end_edit():
            return False
        self.close_editor()
        self.hide_3d()
        self.win.hide()
        self.update_buttons()
        return True

    def end_edit(self, save=True):
        """Editing panel: end of case editing – changes go to the case, the panel closes.
        False – invalid data and the user chose to go back to editing."""
        case = self.editing
        if case is None:
            return True
        if save:
            if self._pending:
                self.recalc()
            self.close_editor()
            mode = self._cur_mode()
            r = self._grab_current(mode)
            if not r["ok"]:
                B = QMessageBox.StandardButton
                box = QMessageBox(QMessageBox.Icon.Warning, "Edycja przypadku",
                                  f"Dane przypadku „{case['name']}” są niepoprawne – zmian nie można zapisać:\n"
                                  + (r["err"] or "sprawdź dane budynku."), B.Discard | B.Cancel, self._front())
                box.button(B.Discard).setText("Odrzuć zmiany")
                box.button(B.Cancel).setText("Wróć do edycji")
                if box.exec() != B.Discard:
                    return False
            else:
                extra = self._main_extra()
                old = json.dumps([case.get("state"), {k: case["extra"].get(k) for k in extra}], sort_keys=True,
                                 default=str)
                new = json.dumps([r["state"], extra], sort_keys=True, default=str)
                if old != new:
                    if case["extra"].get("viewports"):
                        extra["viewports"] = case["extra"]["viewports"]      # other viewports of the case stay
                    if case["extra"].get("noprint"):
                        extra["noprint"] = True                              # left out of the printout – stays
                    case["extra"] = extra
                    self.info_msg(self._store_case(case, r, f"Zaktualizowano: „{case['name']}”."))
                    self.project_changed()
        self.set_editing(None)
        self.close_editor()
        self.hide_3d()
        self.win.hide()
        if case in self.project["cases"]:
            self.pw.refresh_cases([case])
        self.update_buttons()
        return True

    def _store_case(self, case, r, msg):
        """Results to the case + shared project data (location, A) in all cases."""
        self._apply_result(case, r)
        g = self._globals_of(r["state"])
        if self.project.get("globals") not in (None, g):             # location / altitude change
            n_ = 0
            for c in self.project["cases"]:
                if c is not case and c["extra"].get("mode") != "własne" and self._globals_of(c["state"]) != g:
                    self._put_globals(c["state"], g)
                    c["_calc"] = None                                 # recalculated on opening / printing
                    n_ += 1
            if n_:
                msg += f" Lokalizację i wysokość n.p.m. zmieniono we wszystkich przypadkach ({n_})."
        self.project["globals"] = g
        return msg

    def add_or_update(self):
        self.echo("ADD")
        if self._pending:
            self.recalc()
        self.close_editor()
        mode = self._cur_mode()
        r = self._grab_current(mode)
        if not r["ok"]:
            QMessageBox.warning(self.win, "Projekt", "Nie można zapisać przypadku – dane są niepoprawne:\n"
                                + (r["err"] or "sprawdź dane budynku."))
            return
        extra = self._main_extra()
        case = self.editing
        if case is None:
            from datetime import datetime
            n = self.project["next"]
            self.project["next"] = n + 1
            case = {"id": n, "name": tr(f"Przypadek {n}"), "created": datetime.now().strftime("%Y-%m-%d %H:%M"),
                    "extra": extra}
            self.project["cases"].insert(0, case)                    # newest on top
            msg = f"Dodano do projektu: „{case['name']}”."
        else:
            if case["extra"].get("viewports"):
                extra["viewports"] = case["extra"]["viewports"]              # other viewports of the case stay
            if case["extra"].get("noprint"):
                extra["noprint"] = True                                      # left out of the printout – stays
            case["extra"] = extra
            msg = f"Zaktualizowano: „{case['name']}”."
        msg = self._store_case(case, r, msg)
        self.project_changed()
        self.info_msg(msg)
        if self.pw.card_of(case) is None:
            self.pw.insert_case(case)
        else:
            self.pw.refresh_cases([case])

    def info_msg(self, text):
        self.proj_msg.setText(text)
        self.proj_msg.setVisible(bool(text))
        QTimer.singleShot(6000, lambda t=text: self.proj_msg.text() == t and self.proj_msg.setVisible(False))

    def edit_case(self, case):
        """Edytuj – the case in a separate editing panel above the main window (the case adding panel works
        independently). Changes go to the case when editing ends (Zakończ edycję or X)."""
        host = self.host
        ed = host.editor
        if ed is None:
            ed = host.editor = App(self.qapp, host=host)
            ed.win.resize(host.win.size())
        elif ed.editing is not None and ed.editing is not case and not ed.end_edit():
            return
        ed._start_edit(case)

    def _start_edit(self, case):
        self.close_editor()
        ex = case["extra"]
        dirty = self.dirty
        self.set_state(case["state"])
        self.dirty = dirty
        md = ex.get("mode", "śnieg")
        self.nb.setCurrentIndex({"wiatr": TAB_WIND, "użytkowe": TAB_USE}.get(md, TAB_SNOW))
        if md != "użytkowe":
            self.mode3d.set(md)
        if self.snow and ex.get("snow_case") in [c["name"] for c in self.snow["cases"]]:
            self.snow_case.set(ex["snow_case"])
        for k, v in (ex.get("view") or {}).items():
            if k in VIEW_KEYS:
                setattr(self, k, v)
        for k, v in (ex.get("toggles") or {}).items():
            if k in TOGGLE_KEYS:
                getattr(self, k).set(bool(v))
        self.set_editing(case)
        self._form_reset()
        self.open_codes()
        self.draw3d()
        self.info_msg(f"Edycja: „{case['name']}”. Zmiany trafią do projektu po zakończeniu edycji.")

    # --- saving / loading
    def _project_dump(self):
        keys = ("id", "name", "created", "state", "extra", "report")
        return {"nazwa": self.project.get("name") or "", "next": self.project["next"],
                "globals": self.project.get("globals"),
                "przypadki": [{k: c.get(k) for k in keys} for c in self.project["cases"]],
                "uklad": ptree_dump(self.project.get("tree") or [])}

    def _project_load(self, d):
        self.project = {"cases": [], "next": 1, "globals": None, "name": "", "tree": []}
        if not d:
            return
        self.project["name"] = str(d.get("nazwa") or "")
        for c in d.get("przypadki", []):
            if isinstance(c, dict) and "state" in c:
                c.setdefault("extra", {})
                c.setdefault("name", f"Przypadek {c.get('id', '?')}")
                c["_calc"] = None
                self.project["cases"].append(c)
        ids = [c.get("id", 0) for c in self.project["cases"] if isinstance(c.get("id"), int)]
        for c in self.project["cases"]:
            if not isinstance(c.get("id"), int):
                c["id"] = max(ids + [0]) + 1
                ids.append(c["id"])
        self.project["next"] = max(int(d.get("next", 1)), max(ids + [0]) + 1)
        self.project["globals"] = d.get("globals")
        self.project["tree"] = ptree_load(d.get("uklad"))   # groups of cases (older files – a flat list)
        ptree_sync(self.project)

    # --- printing
    def project_document(self, title=False):
        """The printout as a QTextDocument; title – also the project name at the top (for the text editor; the
        printout has it in the page header)."""
        from PySide6.QtCore import QUrl
        from PySide6.QtGui import QTextDocument
        esc = html.escape
        doc = QTextDocument()
        doc.setDefaultFont(QFont(FONT, 9))
        parts = ([f'<p style="font-size:9pt;">Projekt: <b>{esc(self.project_title())}</b></p>'] if title else [])
        head = ""                                         # the project name is in the page header (print_document)
        ptree_sync(self.project)
        nums = project_numbers(self.project)
        num_of, path_of = {}, {}                          # case number and the groups it is in (as in the list)

        def walk(items, path):
            for n in items:
                if "group" in n:
                    walk(n["items"], path + [f"{nums[id(n)]} {n['name']}"])
                else:
                    num_of[n["case"]], path_of[n["case"]] = nums[id(n)], path
        walk(self.project["tree"], [])
        skip_ = noprint_ids(self.project)
        for i, case in enumerate([c for c in self.project["cases"] if c["id"] not in skip_]):
            grp = " › ".join(path_of.get(case["id"], []))
            title = f"{num_of.get(case['id'], '')} {case['name']}".strip()
            head_i = esc(grp)
            self.ensure_calc(case)
            ex, op = case["extra"], case["state"].get("opcje", {})
            mode = ex.get("mode", "śnieg")
            if mode in REPORT_ONLY:                  # no 3D model – only the information about the values
                brk = ' style="page-break-before:always;"' if i else ""
                parts.append(f'<div{brk}><p style="color:#6b7280; font-size:8pt;">{head_i}</p>'
                             f'<h2 style="margin:4px 0 2px 0;">{esc(title)}</h2>'
                             f'{html_body(case.get("report") or "")}</div>')
                continue
            imgs = ""
            iw = 560 if title else 620                      # the editor's page is narrower (A4, 2.54 cm margins)
            for j, vp in enumerate([ex] + list(ex.get("viewports") or [])):     # every viewport of the case
                img = self.snapshot(case, vp=vp).toImage()
                doc.addResource(QTextDocument.ResourceType.ImageResource, QUrl(f"przypadek{i}_{j}.png"), img)
                imgs += (f'<p align="center"><img src="przypadek{i}_{j}.png" width="{iw}" '
                         f'height="{iw * img.height() / img.width():.0f}"></p>')
            sub = (f"Śnieg · {op.get('snow_type', '')} · przypadek ({case['_calc']['snow_case']})" if mode != "wiatr"
                   else f"Wiatr · {op.get('wind_type', '')} · θ = {op.get('theta', '')}"
                   + (f" · {op.get('variant')}" if op.get("variant") else ""))
            brk = ' style="page-break-before:always;"' if i else ""
            parts.append(f'<div{brk}><p style="color:#6b7280; font-size:8pt;">{head_i}</p>'
                         f'<h2 style="margin:4px 0 2px 0;">{esc(title)}</h2>'
                         f'<p style="color:#6b7280; margin:0 0 6px 0;">{esc(sub)}</p>'
                         f'{imgs}'
                         f'{html_body(case.get("report") or "")}</div>')
        doc.setHtml("".join(parts))
        doc._project = self.project_title()
        return doc

    def print_project(self, pdf=None):
        """Drukuj… (print preview); pdf – the console: straight to a PDF file, no window."""
        if not self.project["cases"]:
            QMessageBox.information(self.pw or self.win, "Drukuj", "Projekt nie zawiera przypadków.")
            return
        if len(noprint_ids(self.project)) >= len(self.project["cases"]):
            QMessageBox.information(self.pw or self.win, "Drukuj", "Żaden przypadek nie jest przeznaczony do druku "
                                    "(pole „drukowany” przy przypadku lub grupie).")
            return
        try:
            from PySide6.QtPrintSupport import QPrinter
        except ImportError:
            QMessageBox.critical(self.pw or self.win, "Drukuj", "Brak modułu drukowania Qt (QtPrintSupport).")
            return
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            doc = self.project_document()                 # once – 3D model images are computed only here
        finally:
            QApplication.restoreOverrideCursor()
        dlg = PrintManager(self, self.pw or self.win, doc, self.project_title())
        if pdf:
            try:
                dlg.print_to(pdf)
            finally:
                dlg.close()
                dlg.deleteLater()
            return pdf
        scr = (self.pw or self.win).screen().availableGeometry()
        dlg.resize(min(1200, scr.width() - 80), scr.height() - 80)
        # the manager owns its printer; the document must live as long as the window
        keep = self.__dict__.setdefault("_print_keep", {})
        k = id(dlg)
        keep[k] = (dlg.printer, doc)
        dlg.setAttribute(Qt.WidgetAttribute.WA_DeleteOnClose, True)
        dlg.destroyed.connect(lambda *_a, k=k: keep.pop(k, None))    # printer released only after the window
        self._preview = dlg                               # (tests: access to the print manager)
        dlg.setModal(False)                               # does not block other windows
        dlg.show()

    # ============================================== scenes and 3D model drawing ===
    def get_state(self):
        st = {"program": "KAYENN", "wersja": 1,
              "pola": {k: v.get() for k, v in self.v.items()}}
        st["opcje"] = {n: getattr(self, n).get() for n in self.STATE_VARS}
        st["lokalizacja"] = self.loc.get()
        st["strefy_recznie"] = any(self._manual_flags().values())
        st["uzytkowe"] = self._use_state()
        return st

    def set_state(self, st):
        self._loading = True
        try:
            for k, val in st.get("pola", {}).items():
                if k in self.v:
                    self.v[k].set(str(val))
            for n, val in self.OPT_DEFAULTS.items():      # options missing in older files – defaults
                if n not in st.get("opcje", {}):
                    getattr(self, n).set(val)
            for n, val in st.get("opcje", {}).items():
                if n in self.OPT_DEFAULTS and val not in {"w_oro": OROGRAPHY, "w_cfr": CFR_TYPES,
                                                         "w_struct": CSCD_STRUCT, "w_skin": SKIN_TYPES}[n]:
                    val = self.OPT_DEFAULTS[n]
                if isinstance(val, str):
                    val = LEGACY_OPTS.get(val, val)
                if n in self.STATE_VARS:
                    if n == "cpi_mode" and val not in CPI_MODES:
                        val = CPI_MODES[0]           # older files („własna wartość”) – the code method (7.2.9(6))
                    getattr(self, n).set(val)
            self.loc.set(st.get("lokalizacja"))
            self._use_set_state(st.get("uzytkowe"))
            self.recalc()
            th = st.get("opcje", {}).get("theta")
            vr = st.get("opcje", {}).get("variant")
            if th:
                self.theta.set(th)
            if vr:
                self.variant.set(vr)
            self.recalc()
        finally:
            self._loading = False
        self.update_title()

    def file_new(self):
        if not self.end_editor() or not self._ask_save():
            return
        self.project_path = None
        self._project_load(None)
        self.set_editing(None)
        self.pw.rebuild(keep_open=False)
        self.set_state({"pola": DEFAULTS, "opcje": dict(
            snow_type="Dwupołaciowy", wind_type="Dwuspadowy", snow_zone="1", snow_ce="Normalny",
            ct_mode=CT_MODES[0], guard=False, s_diff=False, s_obst=OBST_TYPES[0], s_exc=False,
            **{"sx_" + k_: v_ for k_, v_ in EXC_SEC_DEFAULT.items()},
            w_mtype=MULTI_TYPES[0],
            wind_zone="1", terrain="II", theta="0°", variant="", cpi_mode=CPI_MODES[0],
            cdir_sec=CDIR_ANY, dom_zone=DOM_ZONES[0], w_edge=EDGE_TYPES[0], **self.OPT_DEFAULTS)})
        self.dirty = False
        self.update_title()
        self._form_reset()
        self._proj_reset()

