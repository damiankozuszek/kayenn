class App:
    NSLOT = 6
    STATE_VARS = ("snow_type", "wind_type", "snow_zone", "snow_ce", "ct_mode", "guard", "s_diff", "s_obst", "s_exc",
                  "sx_fobst", "sx_canopy", "sx_annex", "sx_epar", "sx_gpar", "sx_pobst", "sx_gap",
                  "w_mtype", "wind_zone", "terrain", "theta", "variant", "cpi_mode", "cdir_sec", "dom_zone", "w_edge",
                  "w_oro", "w_cfr", "w_struct", "w_skin")
    OPT_DEFAULTS = dict(w_oro=OROGRAPHY[0], w_cfr=CFR_TYPES[1], w_struct=CSCD_STRUCT[0], w_skin=SKIN_TYPES[0])

    @staticmethod
    def _shared(name):
        """Project data shared by both code loads panels – kept in the main object (host)."""
        key = "_sh_" + name
        return property(lambda self: getattr(self.host, key), lambda self, v: setattr(self.host, key, v))

    project = _shared.__func__("project")
    pw = _shared.__func__("pw")
    dirty = _shared.__func__("dirty")
    project_path = _shared.__func__("project_path")

    def __init__(self, qapp, host=None):
        """host=None – main object: main window + case adding panel. host=App – case editing panel
        (separate form, the same project)."""
        self.host = host or self
        if host is None:                           # interface language (settings.json; a new installation – English)
            apply_language(settings_get("language", LANG_DEFAULT), save=False)
        self.editor = None                         # editing panel (main object only)
        self.qapp = qapp
        self._pending = False
        self._draw_pending = False
        self._in_recalc = False
        self._loading = True
        # Cofnij / Ponów: the form of this panel (snapshots get_state, recorded 0.5 s after the last change) and
        # the project (main object; a snapshot after every project change)
        self._fh_timer = QTimer()
        self._fh_timer.setSingleShot(True)
        self._fh_timer.setInterval(500)
        self._fh_timer.timeout.connect(self._form_push)
        self._fh_mute = False
        self.form_hist = History(pending=self._fh_timer.isActive)
        if self.host is self:
            self.dirty = False
            self.proj_hist = History()
        self.cmd = CommandProcessor(self) if self.host is self else None     # console (main object only)
        if self.cmd is not None:                                              # typing from any window of the program
            self.cmd._keys = CommandKeys(self.cmd)
            qapp.installEventFilter(self.cmd._keys)
        self.sgeo = self.wgeo = self.snow = self.wind = self.env = None
        self.win3d = self.cv = None
        self._3d_geom = None
        self._last_theta = None
        self._editor = None
        self._edit_keys = {}
        self._tb_mode = None
        self.yaw, self.pitch, self.zoom = math.radians(-32), math.radians(24), 1.0
        self.piv = None
        self.pan_x = self.pan_y = 0.0

        self.v = {k: Var(val) for k, val in DEFAULTS.items()}
        self.snow_type = Var("Dwupołaciowy")
        self.wind_type = Var("Dwuspadowy")
        self.snow_zone = Var("1")
        self.snow_ce = Var("Normalny")
        self.ct_mode = Var(CT_MODES[0])
        self.guard = Var(False)
        self.s_diff = Var(False)
        self.w_diff = Var(False)
        self.s_obst = Var(OBST_TYPES[0])
        self.s_exc = Var(False)
        for k_, v_ in EXC_SEC_DEFAULT.items():
            setattr(self, "sx_" + k_, Var(v_))
        self.w_mtype = Var(MULTI_TYPES[0])
        self.wind_zone = Var("1")
        self.terrain = Var("II")
        self.theta = Var("0°")
        self.variant = Var("")
        self.cpi_mode = Var(CPI_MODES[0])
        self.cdir_sec = Var(CDIR_ANY)
        self.dom_zone = Var(DOM_ZONES[0])
        self.w_edge = Var(EDGE_TYPES[0])
        for k_, v_ in self.OPT_DEFAULTS.items():  # orography, friction, cscd, multi-skin walls (wind)
            setattr(self, k_, Var(v_))
        self.loc = Var(None)                       # location: dict(lat, lon, alt, name) or None
        self.mode3d = Var("śnieg")
        self.snow_case = Var("i")
        self.labels3d = Var(True)
        self.arrows3d = Var(True)
        self.dims3d = Var(True)
        self.bdims3d = Var(True)
        self.odims3d = Var(True)                   # dimensions of the orography (separate from the others)
        if self.host is self:
            self.project = {"cases": [], "next": 1, "globals": None, "name": "", "tree": []}   # cases (newest first)
            self.pw = None                         # main window (KAYENN Manager)
        self.editing = None                        # case edited in this panel (editing panel only)
        self._ctx = None

        self.entries = {}
        self.theta_boxes, self.variant_boxes, self.case_boxes = [], [], []
        self.zone_boxes, self.loc_labels, self.loc_restore = [], [], []
        self._build()
        if self.host is self:
            self.pw = ProjectWindow(self)
        # the code loads window is owned by the main window – always above it
        self.win.setParent(self.pw, self.win.windowFlags() | Qt.WindowType.Window)
        for k, var in self.v.items():
            var.trace(lambda k=k: self._var_changed(k))
        for var in (self.guard, self.s_diff, self.w_diff, self.snow_type, self.wind_type, self.snow_zone,
                    self.snow_ce, self.ct_mode, self.s_obst, self.s_exc, self.sx_fobst, self.sx_canopy,
                    self.sx_annex, self.sx_epar, self.sx_gpar, self.sx_pobst, self.sx_gap, self.w_mtype, self.wind_zone, self.terrain,
                    self.theta, self.variant, self.cpi_mode, self.cdir_sec, self.dom_zone, self.w_edge,
                    self.w_oro, self.w_cfr, self.w_struct, self.w_skin, self.loc):
            var.trace(self._opt_changed)
        self.snow_case.trace(self._case_changed)
        for var in (self.labels3d, self.arrows3d, self.dims3d, self.bdims3d, self.odims3d):
            var.trace(self.draw3d)
        if self.host is self:
            self.project_path = None
        self.recalc()
        self._loading = False
        self.update_title()
        self._form_reset()
        if self.host is self:
            self._proj_reset()
            SHORTCUTS.start(self)                      # the shortcut file: menu items, console aliases, key combinations
            self.cmd.say("Wpisz polecenie (HELP – lista poleceń).", "note")      # scrolls away with the history

    # ------------------------------------------------------ Cofnij / Ponów ---
    def _form_reset(self):
        self._fh_timer.stop()
        self.form_hist.reset(self.get_state())

    def _form_push(self):
        self._fh_timer.stop()
        if self._loading:
            self._fh_timer.start()
            return
        self.form_hist.push(self.get_state())

    def undo_form(self, redo=False):
        """Cofnij / Ponów in the code loads form (the form state; text fields first undo their own typing)."""
        if self._fh_timer.isActive():
            self._form_push()
        h = self.form_hist
        if not (h.can_redo() if redo else h.can_undo()):
            return
        st = h.redo() if redo else h.undo()
        self._fh_mute = True
        try:
            self.set_state(copy.deepcopy(st))
        finally:
            self._fh_mute = False
        self._fh_timer.stop()
        h.replace(self.get_state())
        h.notify()

    def redo_form(self):
        self.undo_form(redo=True)

    def _proj_snap(self):
        """Project snapshot for Cofnij: cases (without calculation results), name, location."""
        h = self.host
        p = h.project
        return dict(name=p.get("name") or "", next=p.get("next", 1), globals=copy.deepcopy(p.get("globals")),
                    loc=copy.deepcopy(h.loc.get()), tree=copy.deepcopy(p.get("tree") or []),
                    cases=[dict(id=c.get("id"), name=c.get("name"), created=c.get("created"),
                                state=copy.deepcopy(c.get("state")), extra=copy.deepcopy(c.get("extra")),
                                report=c.get("report")) for c in p["cases"]])

    def _proj_reset(self):
        self.host.proj_hist.reset(self._proj_snap())

    def undo_project(self, redo=False):
        """Cofnij / Ponów in the project (adding, editing, deleting, duplicating, reordering, renaming cases,
        project information). Edited cases – the editing ends first."""
        h = self.host
        hist = h.proj_hist
        if not (hist.can_redo() if redo else hist.can_undo()):
            return
        if not h.end_editor():
            return
        if not (hist.can_redo() if redo else hist.can_undo()):
            return
        h._proj_restore(hist.redo() if redo else hist.undo())

    def redo_project(self):
        self.undo_project(redo=True)

    def _proj_restore(self, snap):
        old = {c.get("id"): c for c in self.project["cases"]}
        cases = []
        for c in snap["cases"]:
            n = dict(c, state=copy.deepcopy(c["state"]), extra=copy.deepcopy(c["extra"]))
            o = old.get(c["id"])
            same = o is not None and o.get("state") == n["state"] and o.get("extra") == n["extra"]
            n["_calc"] = o.get("_calc") if same else None
            if same:
                n["report"] = o.get("report")
            cases.append(n)
        self.project.update(name=snap["name"], next=snap["next"], globals=copy.deepcopy(snap["globals"]),
                            cases=cases, tree=copy.deepcopy(snap.get("tree") or []))
        if snap["loc"] != self.loc.get():
            for app in (self, self.editor):
                if app is not None:
                    app._put_location(copy.deepcopy(snap["loc"]))
        self.dirty = not self.proj_hist.at_saved()
        self.update_title()
        self.pw.rebuild(keep_open=True)

    # ------------------------------------------------------ bindings ---
    def _var_changed(self, key):
        self._sync_entries(key)
        if not self._in_recalc:
            self.schedule()

    def _opt_changed(self):
        if not self._in_recalc:
            self.schedule()

    def _case_changed(self):
        if not self._in_recalc:
            self.on_snow_case()

    def _sync_entries(self, key):
        val = self.v[key].get()
        ws = list(self.entries.get(key, [])) + [e for _, e, _ in self.s_slots + self.w_slots if e._key == key]
        for e in ws:
            if e.text() != val:
                e.setText(val)

    def _sync_combo(self, cb):
        val = cb._var.get()
        if cb.currentText() != val:
            i = cb.findText(val)
            if i >= 0:
                cb._sync = True
                cb.setCurrentIndex(i)
                cb._sync = False

    def _set_items(self, cb, values, enabled=True):
        values = list(values)
        if cb._items != values:
            cb._sync = True
            cb.clear()
            cb.addItems(values)
            cb._items = values
            cb._sync = False
            self._sync_combo(cb)
        if cb.isEnabled() != enabled:
            cb.setEnabled(enabled)

    def _mk_combo(self, var, values, width=12):
        cb = QComboBox()
        cb._var, cb._sync, cb._items = var, False, []
        self._set_items(cb, values)
        cb.currentTextChanged.connect(lambda t, cb=cb: None if cb._sync else (     # the source value, not the
            cb._var.set(cb.currentText()), self._user_field(self._var_name(cb._var), cb._var.get, now=True)))
        var.trace(lambda cb=cb: self._sync_combo(cb))
        if width:
            fm = QFontMetrics(cb.font())
            cb.setFixedWidth(fm.horizontalAdvance("0") * width + 34)
        return cb

    def _mk_check(self, text, var):
        ch = QCheckBox(text)
        ch.setChecked(bool(var.get()))
        ch._sync, ch._var = False, var
        ch.toggled.connect(lambda on, ch=ch, var=var: None if ch._sync else (
            var.set(bool(on)), self._user_field(self._var_name(var), lambda var=var: "ON" if var.get() else "OFF", now=True)))

        def sync(ch=ch, var=var):
            if ch.isChecked() != bool(var.get()):
                ch._sync = True
                ch.setChecked(bool(var.get()))
                ch._sync = False
        var.trace(sync)
        return ch

    def _mk_entry(self):
        e = QLineEdit()
        e.setAlignment(AL_R)
        fm = QFontMetrics(ui_font(FONT, 10))
        e.setFixedWidth(fm.horizontalAdvance("0") * 9 + 12)
        e._bad = False
        return e

    # ------------------------------------------------------- widgets ---
    def card(self, layout, title=None, stretch=0):
        f = QFrame()
        f.setObjectName("card")
        g = QGridLayout(f)
        g.setContentsMargins(10, 8, 10, 8)
        g.setHorizontalSpacing(4)
        g.setVerticalSpacing(4)
        g.setColumnStretch(0, 1)
        g.setColumnStretch(3, 1)
        if title:
            lb = QLabel(title)
            lb.setObjectName("cardTitle")
            g.addWidget(lb, 0, 0, 1, 6)
        layout.addWidget(f, stretch)
        f.grid = g
        return f

    def _unit(self, text):
        u = QLabel(text)
        u.setObjectName("muted")
        u.setMinimumWidth(QFontMetrics(u.font()).horizontalAdvance("kg/m³") + 10)
        return u

    def num(self, c, r, col, key, label, unit):
        g = c.grid
        lb = QLabel(label)
        lb._base = label
        g.addWidget(lb, r, col * 3)
        e = self._mk_entry()
        e._label = lb
        e._key = key
        e.setText(self.v[key].get())
        e.textEdited.connect(lambda t, k=key: (self.v[k].set(t), self._user_field(k, lambda k=k: self.v[k].get())))
        e.editingFinished.connect(lambda k=key: self._flush_field(k))
        g.addWidget(e, r, col * 3 + 1, 1, 1, AL_R)
        g.addWidget(self._unit(unit), r, col * 3 + 2)
        self.entries.setdefault(key, []).append(e)
        return e

    def combo(self, c, r, col, var, label, values, width=12, span=1):
        g = c.grid
        lb = QLabel(label)
        lb._base = label
        g.addWidget(lb, r, col * 3)
        cb = self._mk_combo(var, values, None if span > 1 else width)
        cb._label = lb
        if span > 1:
            g.addWidget(cb, r, 1, 1, 5)
        else:
            g.addWidget(cb, r, col * 3 + 1, 1, 1, AL_R)
        return cb

