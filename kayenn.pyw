        root.addWidget(self.btn_main)
        self._db = None
        self.changed()
        self.hist.reset(self.data())

    def _h_push(self):
        self._h_timer.stop()
        self.hist.push(self.data())

    def undo(self, redo=False):
        """Cofnij / Ponów in the item list (adding, deleting, values, dimensions, order)."""
        if self._h_timer.isActive():
            self._h_push()
        if not (self.hist.can_redo() if redo else self.hist.can_undo()):
            return
        st = self.hist.redo() if redo else self.hist.undo()
        self._h_mute = True
        try:
            self.set_data(st)
        finally:
            self._h_mute = False
        self._h_timer.stop()
        self.hist.replace(self.data())
        self.hist.notify()

    def redo(self):
        self.undo(redo=True)

    @property
    def cards(self):                                         # (CaseList: dragged items)
        return self.rows

    def place_case(self, row, idx):
        """After dragging: the item (already at idx in the layout) – the same order in the list."""
        old = self.rows.index(row)
        if old == idx:
            return
        self.rows.insert(idx, self.rows.pop(old))
        self.items.insert(idx, self.items.pop(old))
        self.changed()

    # --- items
    def _insert(self, item, idx=None):
        idx = len(self.rows) if idx is None else idx
        row = LabRow(self, item)
        self.items.insert(idx, item)
        self.rows.insert(idx, row)
        self.list.lay.insertWidget(idx, row)
        self.changed()
        QTimer.singleShot(0, lambda: self.scroll.ensureWidgetVisible(self.add_bar if idx == len(self.rows) - 1
                                                                     else row))
        return row

    def _append(self, item):
        return self._insert(item)

    def add_manual(self):
        n = len(self.items) + 1
        self.app.echo(f"LABADD {cq(tr(f'Obciążenie {n}'))}")
        row = self._append(dict(nazwa=tr(f"Obciążenie {n}"), wartosc="", jedn="kN/m²", z_bazy=False, wym={}))
        row.val.setFocus()
        return row

    def add_material(self, mat):
        self.app.echo(f"LABDB {cq(mat['name'])}")
        lo, hi = mat_range(mat["value"]) or (0.0, 0.0)
        rng = mat["value"] if abs(hi - lo) > 1e-12 else ""
        val = (f"{hi:g}" if rng else str(mat["value"]).strip()).replace(".", ",")
        return self._append(dict(nazwa=mat["name"], wartosc=val, jedn=mat["unit"], z_bazy=True, przedzial=rng,
                                 kategoria=mat.get("cat", ""), zrodlo=mat.get("src", ""), wym={}))

    def duplicate_row(self, row):
        i = self.rows.index(row)
        self.app.echo(f"LABDUP {i + 1}")
        it = json.loads(json.dumps(self.items[i]))
        it["nazwa"] = it.get('nazwa', '') + tr(" - kopia")
        return self._insert(it, i + 1)

    def remove_row(self, row):
        i = self.rows.index(row)
        self.app.echo(f"LABDEL {i + 1}")
        self.rows.pop(i)
        self.items.pop(i)
        self.list.lay.removeWidget(row)
        row.hide()
        row.deleteLater()
        self.changed()

    def clear(self):
        for row in list(self.rows):
            self.list.lay.removeWidget(row)
            row.hide()
            row.deleteLater()
        self.rows, self.items = [], []

    def set_data(self, data):
        self.clear()
        for it in (data or {}).get("pozycje") or []:
            self._append(json.loads(json.dumps(it)))
        self.changed()

    def data(self):
        return {"pozycje": json.loads(json.dumps(self.items))}

    def changed(self):
        s = lab_summary(self.items)
        for i, (row, r) in enumerate(zip(self.rows, s["rows"])):
            row.update_result(i, r)
        self.empty.setVisible(not self.items)
        if s["ok"]:
            self.summary.setText(f"Suma obciążeń: <b>{lab_fmt(s['total'])} {s['unit']}</b>"
                                 f"&nbsp;&nbsp;<span style='color:{MUTED};'>(jednostka wspólna dla wszystkich "
                                 f"pozycji: {s['unit']})</span>")
            self.summary.setStyleSheet(css_pt("font-size: 11pt;"))
        else:
            self.summary.setText(("⚠ " if self.items else "") + html.escape(s["err"]))
            self.summary.setStyleSheet(css_pt("font-size: 11pt; color: #b91c1c;" if self.items else "font-size: 11pt;"))
        if not self.edit_mode:
            self.btn_main.setEnabled(s["ok"])
            self.btn_main.setToolTip("" if s["ok"] else s["err"])
        if hasattr(self, "hist") and not self._h_mute:
            self._h_timer.start()
            self.hist.notify()
        return s

    def info_msg(self, text):
        self.msg.setText(text)
        self.msg.setVisible(bool(text))
        QTimer.singleShot(6000, lambda t=text: self.msg.text() == t and self.msg.setVisible(False))

    # --- material database
    def open_db(self):
        if self._db is not None:
            self._db.raise_()
            self._db.activateWindow()
            return self._db
        d = MaterialDialog(self)
        d.chosen.connect(self.add_material)
        d.destroyed.connect(lambda *a: setattr(self, "_db", None))
        self._db = d
        d.show()
        return d

    # --- window
    def show_panel(self):
        if not self.isVisible():
            if not getattr(self, "_placed", False):          # first time – above the main window
                g = self.app.pw.frameGeometry()
                scr = self.app.pw.screen().availableGeometry()
                d = 60 if not self.edit_mode else 110
                self.move(max(g.x() + d, scr.x()), max(g.y() + d - 10, scr.y()))
                self._placed = True
            self.show()
        self.raise_()
        self.activateWindow()
        self.app.update_buttons()

    def close_panel(self):
        """X / Zamknij obciążenia własne (when editing – ends the editing). False – the user stayed in editing."""
        if self.edit_mode and not self.end_edit():
            return False
        if self._db is not None:
            self._db.close()
        self.hide()
        self.app.update_buttons()
        return True

    def closeEvent(self, e):
        if getattr(self.app, "_quitting", False):
            e.accept()
            return
        e.ignore()
        self.close_panel()

    def on_main(self):
        self.app.echo("ENDEDIT" if self.edit_mode else "ADDLAB")
        if self.edit_mode:
            self.close_panel()
            return
        s = self.changed()
        if not s["ok"]:
            QMessageBox.warning(self, "Obciążenia własne", "Nie można dodać przypadku do projektu:\n" + s["err"])
            return
        case = self.app.add_lab_case(self.data())
        self.info_msg(f"Dodano do projektu: „{case['name']}”.")

    # --- case editing
    def start_edit(self, case):
        self.editing = case
        self.set_data(case["state"].get("wlasne"))
        self._h_timer.stop()
        self.hist.reset(self.data())
        self.setWindowTitle(f"Obciążenia własne – edycja: {case['name']}")
        self.show_panel()

    def end_edit(self, save=True):
        """End of editing – changes go to the case. False – invalid data and the user went back to editing."""
        case = self.editing
        if case is None:
            return True
        if save:
            s = self.changed()
            if not s["ok"]:
                B = QMessageBox.StandardButton
                box = QMessageBox(QMessageBox.Icon.Warning, "Edycja przypadku",
                                  f"Przypadku „{case['name']}” nie można zapisać:\n{s['err']}", B.Discard | B.Cancel,
                                  self)
                box.button(B.Discard).setText("Odrzuć zmiany")
                box.button(B.Cancel).setText("Wróć do edycji")
                if box.exec() != B.Discard:
                    return False
            else:
                data = self.data()
                if json.dumps(data, sort_keys=True) != json.dumps(case["state"].get("wlasne"), sort_keys=True):
                    self.app.store_lab_case(case, data)
        self.editing = None
        if self._db is not None:
            self._db.close()
        self.hide()
        if case in self.app.project["cases"]:
            self.app.pw.refresh_cases([case])
        self.app.update_buttons()
        return True


class History:
    """Cofnij / Ponów – snapshots of a state (compared with ==; never modified – restore a copy).
    pos – the current snapshot, saved – the snapshot matching the saved file (None – none).
    pending – optional callable: a change is waiting to be recorded (Cofnij available)."""
    LIMIT = 100

    def __init__(self, pending=None):
        self.stack, self.pos, self.saved, self.listeners, self.pending = [], -1, None, [], pending

    def notify(self):
        for fn in list(self.listeners):
            fn()

    def reset(self, state):
        self.stack, self.pos, self.saved = [state], 0, 0
        self.notify()

    def push(self, state):
        """New state after a change (the same as the current one – ignored). True – recorded."""
        if not self.stack:
            self.reset(state)
            return False
        if state == self.stack[self.pos]:
            return False
        del self.stack[self.pos + 1:]
        if self.saved is not None and self.saved > self.pos:
            self.saved = None
        self.stack.append(state)
        extra = len(self.stack) - self.LIMIT
        if extra > 0:
            del self.stack[:extra]
            self.saved = None if self.saved is None or self.saved < extra else self.saved - extra
        self.pos = len(self.stack) - 1
        self.notify()
        return True

    def replace(self, state):
        """The current snapshot as the restored state really is (after Cofnij / Ponów)."""
        if self.stack:
            self.stack[self.pos] = state

    def can_undo(self):
        return self.pos > 0 or bool(self.pending and self.pending())

    def can_redo(self):
        return 0 <= self.pos < len(self.stack) - 1

    def undo(self):
        self.pos -= 1
        self.notify()
        return self.stack[self.pos]

    def redo(self):
        self.pos += 1
        self.notify()
        return self.stack[self.pos]

    def mark_saved(self):
        self.saved = self.pos

    def at_saved(self):
        return self.saved is not None and self.saved == self.pos


# ================================================== commands and keyboard shortcuts ===
# Every function of the program has a command (typed in the console: Widok → Konsola; a command can also be run by
# a key combination). The shortcuts live in an editable text file: one line
# „skrót, *POLECENIE [argumenty]” – an alias typed in the console or a key combination (Ctrl+P). The file holds
# only what is currently in use; Opcje → Edytuj skróty klawiaturowe opens it in the default text editor.
class CmdError(Exception):
    """A command that cannot be executed – the message goes to the console."""


class Command:
    def __init__(self, name, fn, usage, doc, keys, group, params):
        self.name, self.fn, self.usage, self.doc, self.keys, self.group = name, fn, usage, doc, keys, group
        self.params = params                             # prompts when the command is typed without arguments


COMMANDS = {}                                            # NAME -> Command (registration order = order in POMOC)


def command(name, usage="", doc="", keys=(), group="", params=()):
    """Registers a console command: fn(app, args) -> text / list of lines / None; CmdError – message.
    Names are English and have no spaces (they stay the same in every language of the interface); a command
    typed without arguments asks for them one by one (a line with arguments runs at once): params = ((prompt, required,
    kind[, condition]), …), kind „one” – the whole answer is one argument, „rest” – the words of the answer;
    an empty answer cancels the command (required) or ends the questions (optional). keys – default key
    combinations (the first run of the shortcut file lists them)."""
    def deco(fn):
        COMMANDS[name] = Command(name, fn, usage, doc, tuple(keys), group, tuple(params))
        return fn
    return deco


def cq(text):
    """A word of a command line: in double quotes when it has spaces (or is empty)."""
    t = str(text)
    return f'"{t}"' if (not t or re.search(r"\s", t)) else t


# command names of the first version (Polish) → the current ones; the shortcut file of that version still works
LEGACY_COMMANDS = dict(
    SKROTYDOMYSLNE="SHORTCUTSRESET", SKROTYWCZYTAJ="SHORTCUTSRELOAD", SKROTYLISTA="SHORTCUTSLIST",
    ZAKONCZEDYCJE="ENDEDIT", WLASNEZAPISZDOBAZY="LABTODB", WLASNEDUPLIKUJ="LABDUP", WLASNEDODAJ="LABADD",
    WLASNEUSUN="LABDEL", WLASNEPOLE="LABFIELD", WLASNEBAZA="LABDB", WLASNELISTA="LABLIST", DODAJWLASNE="ADDLAB",
    BAZASZUKAJ="DBSEARCH", ZAPISZJAKO="SAVEAS", USUNGRUPE="DELETEGROUP", ROZGRUPUJ="UNGROUP", OPROGRAMIE="ABOUT",
    AKTUALIZACJE="UPDATES", LOKALIZACJA="LOCATION", ZMIENNAZWE="RENAME", PRZYPADKI="CASES", PRZENIES="MOVE",
    ZAKLADKA="TAB", ZALOZENIA="ASSUMPTIONS", DUPLIKUJ="DUPLICATE", PODGRUPA="SUBGROUP", PRZYWROC="RESTORELOC",
    SKROTY="SHORTCUTS", KONSOLA="CONSOLE", NORMOWE="CODES", GRUPUJ="GROUP", ZAZNACZ="SELECT", WYNIKI="RESULTS",
    DRUKUJ="PRINT", EDYTOR="EDITOR", EDYTUJ="EDIT", OPCJE="OPTIONS", OTWORZ="OPEN", ZAKONCZ="EXIT", ZAPISZ="SAVE",
    COFNIJ="UNDO", ROZWIN="EXPAND", CZYSC="CLEAR", POMOC="HELP", PONOW="REDO", NOWY="NEW", NAZWA="PROJECTNAME",
    INFO="PROJECTINFO", USUN="DELETE", DODAJ="ADD", ZWIN="COLLAPSE", POLE="FIELD", WLASNE="LAB")


def cmd_name(s):
    """Command name as typed: without diacritics, upper case („Zapisz” = „ZAPISZ”)."""
    return _fold(s).upper()


def cmd_tokens(line):
    """Words of a command line; text in double quotes is one word (the backslashes of paths stay as they are)."""
    return [a if (a or not b) else b for a, b in re.findall(r'"([^"]*)"|(\S+)', line)]


SHORTCUTS_HEAD = """; KAYENN – keyboard shortcuts (a file to edit).
;
; Every line has the form:    shortcut, *COMMAND [arguments]
;   - a shortcut typed in the console (View → Console), e.g.:     P, *PRINT
;   - a key combination (contains "+" or is F1…F12), e.g.:        Ctrl+P, *PRINT
;     A combination with arguments can be assigned too:           Ctrl+Shift+K, *CONSOLE
;   - several shortcuts of one command – several lines.
; Lines starting with ";" or "#" are comments. HELP in the console lists the commands.
; Changes work as soon as the file is saved. Options → Restore the default keyboard shortcuts
; goes back to the installed state.
;
; --- shortcuts typed in the console (none defined yet) ---
;
; --- key combinations ---
"""
# the file is always in English (whatever the interface language); the header of the first versions (Polish)
# is replaced with this one when the file is read – the user's lines stay
SHORTCUTS_HEAD_OLD = (
    "; KAYENN – skróty klawiaturowe (plik do edycji).", ";",
    "; Każdy wiersz ma postać:    skrót, *POLECENIE [argumenty]",
    ";   - skrót wpisywany w konsoli (Widok → Konsola), np.:        P, *PRINT",
    ";   - kombinacja klawiszy (zawiera „+” albo to F1…F12), np.:   Ctrl+P, *PRINT",
    ";     Kombinację z argumentem można też przypisać:             Ctrl+Shift+K, *CONSOLE",
    ";   - kilka skrótów do jednego polecenia – kilka wierszy.",
    "; Wiersze zaczynające się od „;” lub „#” są komentarzem. Listę poleceń pokaże HELP w konsoli.",
    "; Zmiany działają od razu po zapisaniu pliku. Opcje → Przywróć domyślne skróty klawiaturowe",
    "; wraca do stanu z instalacji.",
    "; --- skróty wpisywane w konsoli (na razie nie zdefiniowano żadnych) ---",
    "; --- kombinacje klawiszy ---")


def shortcuts_migrate(text):
    """The Polish header of the first versions → the English one (the user's own lines unchanged)."""
    if not text.startswith(SHORTCUTS_HEAD_OLD[0]):
        return text
    old = set(SHORTCUTS_HEAD_OLD)
    rest = [ln for ln in text.splitlines() if ln.rstrip() not in old]
    while rest and not rest[0].strip():
        rest.pop(0)
    return SHORTCUTS_HEAD + "\n".join(rest) + ("\n" if rest else "")


def shortcuts_file():
    return os.path.join(user_data_dir(), "shortcuts.txt")


def shortcuts_default_text():
    lines = [f"{k}, *{c.name}" for c in COMMANDS.values() for k in c.keys]
    return SHORTCUTS_HEAD + "\n".join(lines) + "\n"


def _is_key_text(s):
    return "+" in s or bool(re.fullmatch(r"F\d{1,2}", s, re.I))


def _seq_text(s):
    return QKeySequence(s, QKeySequence.SequenceFormat.PortableText).toString(QKeySequence.SequenceFormat.PortableText)


class Shortcuts:
    """The shortcut file: aliases typed in the console and key combinations → commands. Menu items register
    with bind(action, COMMAND) – the combinations of the file are put on them; other combinations run the
    command from anywhere in the program. The file is watched – a saved change takes effect at once."""

    def __init__(self):
        self.aliases = {}                                # ALIAS -> command line
        self.keys = {}                                   # key combination (portable text) -> command line
        self.errors = []
        self._bound = []                                 # [(QAction, COMMAND, callback)]
        self._generic = []                               # actions of the combinations without a menu item
        self._host = None
        self._watch = None

    # --- file
    def ensure_file(self):
        path = shortcuts_file()
        if not os.path.exists(path):
            try:
                os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    f.write(shortcuts_default_text())
            except OSError:
                pass
        return path

    def parse(self, text):
        self.aliases, self.keys, self.errors = {}, {}, []
        for no, raw in enumerate(text.splitlines(), 1):
            s = raw.strip()
            if not s or s[0] in ";#":
                continue
            m = re.match(r"^(.*?)\s*,\s*\*\s*(\S+)\s*(.*)$", s)
            if not m:
                self.errors.append(f"wiersz {no}: oczekiwano postaci „skrót, *POLECENIE”")
                continue
            left, name, rest = m.group(1).strip(), cmd_name(m.group(2)), m.group(3).strip()
            name = LEGACY_COMMANDS.get(name, name)
            if name not in COMMANDS:
                self.errors.append(f"wiersz {no}: nieznane polecenie „{m.group(2)}”")
                continue
            line = (name + " " + rest).strip()
            if _is_key_text(left):
                seq = _seq_text(left)
                if not seq:
                    self.errors.append(f"wiersz {no}: nie rozpoznano kombinacji klawiszy „{left}”")
                    continue
                self.keys[seq] = line
            elif re.fullmatch(r"\w+", left):
                self.aliases[cmd_name(left)] = line
            else:
                self.errors.append(f"wiersz {no}: skrót „{left}” – tylko litery i cyfry (bez spacji)")

    def reload(self):
        path = self.ensure_file()
        try:
            with open(path, encoding="utf-8-sig") as f:
                text = f.read()
        except (OSError, UnicodeDecodeError) as e:
            self.errors = [f"nie można odczytać pliku skrótów: {e}"]
            return False
        new = shortcuts_migrate(text)
        if new != text:                                  # the Polish header of the first versions → English
            try:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(new)
                text = new
            except OSError:
                pass
        self.parse(text)
        self.refresh()
        if self._host is not None and self._host.cmd is not None:
            for e in self.errors:
                self._host.cmd.say("Skróty klawiaturowe, " + e, "err")
        return not self.errors

    def edit(self):
        """Opcje → Edytuj skróty klawiaturowe: the file in the default text editor."""
        from PySide6.QtCore import QUrl
        from PySide6.QtGui import QDesktopServices
        path = self.ensure_file()
        if QDesktopServices.openUrl(QUrl.fromLocalFile(path)):
            return path
        try:                                             # no association with .txt – a plain editor
            import subprocess
            if sys.platform == "win32":
                subprocess.Popen(["notepad.exe", path])
            elif sys.platform == "darwin":
                subprocess.Popen(["open", "-t", path])
            else:
                subprocess.Popen(["xdg-open", path])
            return path
        except OSError:
            return None

    def restore_default(self):
        """Przywróć domyślne skróty klawiaturowe: the file takes the installed content (the old one – shortcuts.bak)."""
        path = shortcuts_file()
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            if os.path.exists(path):
                with open(path, encoding="utf-8-sig") as f:
                    old = f.read()
                if old != shortcuts_default_text():
                    with open(os.path.splitext(path)[0] + ".bak", "w", encoding="utf-8") as f:
                        f.write(old)
            with open(path, "w", encoding="utf-8") as f:
                f.write(shortcuts_default_text())
        except OSError:
            return False
        self.reload()
        return True

    # --- applying
    def seqs(self, name):
        """Key combinations of the command (as set in the file; only those without arguments)."""
        return [QKeySequence(k, QKeySequence.SequenceFormat.PortableText) for k, line in self.keys.items()
                if line.upper() == name]

    def bind(self, action, name, changed=None, echo=True, scope="window"):
        """The menu item / action runs the command NAME itself; the combinations of the file go onto it.
        Using it is written in the console (the command that was run)."""
        action._scope = scope             # "app" – works in every window, "window" – in its own, None – no shortcut
        self._bound.append((action, name, changed))
        self._apply(action, name, changed)
        if echo:
            action.triggered.connect(lambda checked=False, n=name: self._echo(n))

    def _echo(self, line):
        if self._host is not None and self._host.cmd is not None:
            self._host.cmd.echo(line)

    def _apply(self, action, name, changed):
        try:
            sc = getattr(action, "_scope", "window")
            if sc is None:
                return
            action.setShortcutContext(Qt.ShortcutContext.ApplicationShortcut if sc == "app"
                                      else Qt.ShortcutContext.WindowShortcut)
            action.setShortcuts(self.seqs(name))
            if changed is not None:
                changed(action)
        except RuntimeError:                             # the window is gone
            pass

    def _alive(self):
        out = []
        for act, name, ch in self._bound:
            try:
                act.objectName()
                out.append((act, name, ch))
            except RuntimeError:
                pass
        self._bound = out
        return out

    def refresh(self):
        bound = self._alive()
        for act, name, ch in bound:
            self._apply(act, name, ch)
        for a in self._generic:
            try:
                a.setEnabled(False)
                a.deleteLater()
            except RuntimeError:
                pass
        self._generic = []
        host = self._host
        pw = getattr(host, "pw", None) if host is not None else None
        if pw is None:
            return
        names = {n for _, n, _ in bound}
        from PySide6.QtGui import QAction
        for seq, line in self.keys.items():
            if line.upper() in names:                    # a menu item carries it
                continue
            a = QAction(pw)
            a.setShortcut(QKeySequence(seq, QKeySequence.SequenceFormat.PortableText))
            a.setShortcutContext(Qt.ShortcutContext.ApplicationShortcut)
            a.triggered.connect(lambda checked=False, line=line: host.cmd.run(line))
            pw.addAction(a)
            self._generic.append(a)

    def start(self, host):
        """At the start of the program (after the main window exists): reads the file and starts watching it."""
        from PySide6.QtCore import QFileSystemWatcher
        self._host = host
        self.reload()
        if self._watch is not None:
            self._watch.deleteLater()
        self._watch = QFileSystemWatcher([shortcuts_file()] if os.path.exists(shortcuts_file()) else [])
        timer = QTimer()
        timer.setSingleShot(True)
        timer.setInterval(250)

        def later():
            path = self.ensure_file()
            if path not in self._watch.files():          # editors that save by replacing the file
                self._watch.addPath(path)
            self.reload()
        timer.timeout.connect(later)
        self._watch._timer = timer
        self._watch.fileChanged.connect(lambda p: timer.start())


SHORTCUTS = Shortcuts()


def edit_menu(mb, hist, undo, redo):
    """Edycja menu: Cofnij, Ponów (skróty z pliku skrótów: domyślnie Ctrl+Z, Ctrl+Y / Ctrl+Shift+Z)."""
    m = mb.addMenu("Edycja")
    au = m.addAction("Cofnij")
    SHORTCUTS.bind(au, "UNDO")
    ar = m.addAction("Ponów")
    SHORTCUTS.bind(ar, "REDO")
    au.triggered.connect(lambda checked=False: undo())
    ar.triggered.connect(lambda checked=False: redo())

    def upd():
        au.setEnabled(hist.can_undo())
        ar.setEnabled(hist.can_redo())
    hist.listeners.append(upd)
    upd()
    m.undo_action, m.redo_action = au, ar
    return m


def undo_buttons(w, hist, undo, redo):
    """Cofnij / Ponów buttons with the shortcuts (windows without a menu bar)."""
    from PySide6.QtGui import QAction
    out = []
    for txt, name, fn in (("Cofnij", "UNDO", undo), ("Ponów", "REDO", redo)):
        b = QPushButton(txt)
        b.clicked.connect(lambda checked=False, fn=fn: fn())
        act = QAction(txt, w)

        def tip(a, b=b, txt=txt):
            ks = ", ".join(k.toString(QKeySequence.SequenceFormat.NativeText) for k in a.shortcuts())
            b.setToolTip(f"{txt} ({ks})" if ks else txt)
        SHORTCUTS.bind(act, name, tip)
        act.triggered.connect(lambda checked=False, fn=fn: fn())
        w.addAction(act)
        out.append(b)

    def upd():
        out[0].setEnabled(hist.can_undo())
        out[1].setEnabled(hist.can_redo())
    hist.listeners.append(upd)
    upd()
    return out


class _UndoKeys(QObject):
    """Ctrl+Z / Ctrl+Y in a text field: the field's own undo while it has something to undo, otherwise the
    window's Cofnij / Ponów (the field does not swallow the shortcut)."""

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Type.ShortcutOverride and isinstance(obj, QLineEdit):
            seq = QKeySequence(e.keyCombination())
            exact = QKeySequence.SequenceMatch.ExactMatch
            if any(seq.matches(k) == exact for k in SHORTCUTS.seqs("UNDO")):
                if not obj.isUndoAvailable():
                    e.ignore()
                    return True
            elif any(seq.matches(k) == exact for k in SHORTCUTS.seqs("REDO")):
                if not obj.isRedoAvailable():
                    e.ignore()
                    return True
        return False


