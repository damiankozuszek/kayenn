#  SOLIDS
# ===================================================================
def area_centroid(poly):
    """Centroid of a planar 3D polygon (area-weighted)."""
    p0 = poly[0]
    A = 0.0
    c = [0.0, 0.0, 0.0]
    for k in range(1, len(poly) - 1):
        p1, p2 = poly[k], poly[k + 1]
        u = [p1[i] - p0[i] for i in range(3)]
        w = [p2[i] - p0[i] for i in range(3)]
        cr = (u[1] * w[2] - u[2] * w[1], u[2] * w[0] - u[0] * w[2], u[0] * w[1] - u[1] * w[0])
        ar = math.sqrt(sum(x * x for x in cr)) / 2
        A += ar
        for i in range(3):
            c[i] += ar * (p0[i] + p1[i] + p2[i]) / 3
    if A < 1e-12:
        return centroid(poly)
    return tuple(x / A for x in c)


def grid_points(poly, n, step, limit=60):
    """Points of a regular grid (spacing step) inside a planar 3D polygon – arrow anchors."""
    ax = max(range(3), key=lambda i: abs(n[i]))
    i, j = [k for k in range(3) if k != ax]
    p2 = [(p[i], p[j]) for p in poly]
    a0, a1 = min(p[0] for p in p2), max(p[0] for p in p2)
    b0, b1 = min(p[1] for p in p2), max(p[1] for p in p2)
    p0 = poly[0]

    def inside(a, b):
        c, m = False, len(p2)
        for k in range(m):
            (x1, y1), (x2, y2) = p2[k], p2[(k + 1) % m]
            if (y1 > b) != (y2 > b) and a < x1 + (b - y1) * (x2 - x1) / (y2 - y1):
                c = not c
        return c
    out = []
    ka = math.floor(a0 / step - 0.5)
    while (ka + 0.5) * step <= a1:
        a = (ka + 0.5) * step
        kb = math.floor(b0 / step - 0.5)
        while (kb + 0.5) * step <= b1:
            b = (kb + 0.5) * step
            if a0 < a < a1 and b0 < b < b1 and inside(a, b):
                q = [0.0, 0.0, 0.0]
                q[i], q[j] = a, b
                q[ax] = p0[ax] - (n[i] * (a - p0[i]) + n[j] * (b - p0[j])) / n[ax]
                out.append(tuple(q))
            kb += 1
        ka += 1
    if not out:
        out = [centroid(poly)]
    if len(out) > limit:
        out = out[::math.ceil(len(out) / limit)]
    return out


def separated(P, Q, m=0.5):
    """Whether the screen projections of two (convex) polygons are disjoint – separating axis test."""
    for poly in (P, Q):
        n = len(poly)
        for k in range(n):
            x1, y1 = poly[k][0], poly[k][1]
            x2, y2 = poly[(k + 1) % n][0], poly[(k + 1) % n][1]
            ax, ay = y1 - y2, x2 - x1
            l = math.hypot(ax, ay)
            if l < 1e-9:
                continue
            ax, ay = ax / l, ay / l
            pa = [ax * q[0] + ay * q[1] for q in P]
            qa = [ax * q[0] + ay * q[1] for q in Q]
            if max(pa) <= min(qa) + m or max(qa) <= min(pa) + m:
                return True
    return False


def depth_sort(items):
    """Drawing order (painter's algorithm with plane tests).
    items: [(depth, face, screen points (X, Y, D))]; D grows away from the viewer."""
    n = len(items)
    info = []
    for depth, f_, pr in items:
        xs, ys = [p[0] for p in pr], [p[1] for p in pr]
        nx, ny, nz = newell(pr)
        l = math.sqrt(nx * nx + ny * ny + nz * nz)
        plane = None
        if l > 1e-12:
            nv = (nx / l, ny / l, nz / l)
            if abs(nv[2]) > 1e-6:
                if nv[2] > 0:                         # normal facing the viewer (D decreases)
                    nv = (-nv[0], -nv[1], -nv[2])
                plane = (nv, pr[0])
        info.append((min(xs), max(xs), min(ys), max(ys), plane))

    def side(pts, plane, eps=1e-6):
        nv, p0 = plane
        sg = [nv[0] * (q[0] - p0[0]) + nv[1] * (q[1] - p0[1]) + nv[2] * (q[2] - p0[2]) for q in pts]
        scale = max(1.0, max(abs(v) for v in sg))
        e = eps * scale
        if all(v <= e for v in sg):
            return -1                                 # entirely behind the plane
        if all(v >= -e for v in sg):
            return 1                                  # entirely in front of the plane
        return 0

    axes = []                                         # separating axes (edge normals) and own projection
    for _, _, pr in items:
        al = []
        for k in range(len(pr)):
            x1, y1 = pr[k][0], pr[k][1]
            x2, y2 = pr[(k + 1) % len(pr)][0], pr[(k + 1) % len(pr)][1]
            ax, ay = y1 - y2, x2 - x1
            l = math.hypot(ax, ay)
            if l > 1e-9:
                ax, ay = ax / l, ay / l
                pa = [ax * q[0] + ay * q[1] for q in pr]
                al.append((ax, ay, min(pa), max(pa)))
        axes.append(al)

    def sep(i, j, m=0.5):
        for a_, b_ in ((i, j), (j, i)):
            qb = items[b_][2]
            for ax, ay, lo, hi in axes[a_]:
                pb = [ax * q[0] + ay * q[1] for q in qb]
                if hi <= min(pb) + m or max(pb) <= lo + m:
                    return True
        return False

    after = [[] for _ in range(n)]                    # (successor, whether the rule is hard)
    indeg = [0] * n
    hard_in = [0] * n

    def edge(i, j, hard=False):
        after[i].append((j, hard))
        indeg[j] += 1
        if hard:
            hard_in[j] += 1
    for i in range(n):
        a = info[i]
        for j in range(i + 1, n):
            b = info[j]
            if a[1] <= b[0] + 0.5 or b[1] <= a[0] + 0.5 or a[3] <= b[2] + 0.5 or b[3] <= a[2] + 0.5:
                continue
            pi, pj = items[i][2], items[j][2]
            if sep(i, j):                              # projections do not overlap – any order
                continue
            fi, fj = items[i][1], items[j][1]
            if fi.get("base") is not None and fi.get("base") == fj.get("on"):     # roof slope under snow
                edge(i, j, True)
                continue
            if fj.get("base") is not None and fj.get("base") == fi.get("on"):
                edge(j, i, True)
                continue
            i_first = j_first = False
            if b[4] and side(pi, b[4]) == -1:
                i_first = True
            elif a[4] and side(pj, a[4]) == 1:
                i_first = True
            if a[4] and side(pj, a[4]) == -1:
                j_first = True
            elif b[4] and side(pi, b[4]) == 1:
                j_first = True
            if i_first and j_first:                    # coplanar – priority decides
                pri, prj = fi.get("prio", 1), fj.get("prio", 1)
                if pri != prj:
                    i_first, j_first = pri < prj, prj < pri
            if i_first and not j_first:
                edge(i, j)
            elif j_first and not i_first:
                edge(j, i)
    import heapq
    heap = [(-items[k][0], k) for k in range(n) if indeg[k] == 0]
    heapq.heapify(heap)
    done, out = [False] * n, []
    while len(out) < n:
        if not heap:
            # cycle: split at the farthest face that is not waiting for a hard rule
            rest = [k for k in range(n) if not done[k]]
            cand = [k for k in rest if hard_in[k] == 0] or rest
            k = max(cand, key=lambda k: items[k][0])
            heap.append((-items[k][0], k))
        _, k = heapq.heappop(heap)
        if done[k]:
            continue
        done[k] = True
        out.append(items[k])
        for j, hard in after[k]:
            indeg[j] -= 1
            if hard:
                hard_in[j] -= 1
            if indeg[j] == 0 and not done[j]:
                heapq.heappush(heap, (-items[j][0], j))
    return out


def tjunction_fix(patches, eps=1e-6):
    """Inserts into patch edges the vertices of neighbouring patches lying on those edges (T-junctions),
    so shared edges are identical – no false snow side walls."""
    pts = [(q, pi) for pi, pt in enumerate(patches) for q in pt["poly"]]
    out = []
    for pi, pt in enumerate(patches):
        P, M = pt["poly"], pt["mu"]
        bx = [min(q[0] for q in P) - 1e-6, max(q[0] for q in P) + 1e-6,
              min(q[1] for q in P) - 1e-6, max(q[1] for q in P) + 1e-6]
        near = [(q, qi) for q, qi in pts if qi != pi and bx[0] <= q[0] <= bx[1] and bx[2] <= q[1] <= bx[3]]
        nP, nM = [], []
        for j in range(len(P)):
            a, b = P[j], P[(j + 1) % len(P)]
            ma, mb = M[j], M[(j + 1) % len(P)]
            nP.append(a)
            nM.append(ma)
            d = [b[i] - a[i] for i in range(3)]
            l2 = sum(v * v for v in d)
            if l2 < 1e-12:
                continue
            ins = []
            for q, qi in near:
                t = sum((q[i] - a[i]) * d[i] for i in range(3)) / l2
                if eps < t < 1 - eps:
                    r = [a[i] + t * d[i] - q[i] for i in range(3)]
                    if sum(v * v for v in r) < 1e-10:
                        ins.append(t)
            for t in sorted(set(round(t, 9) for t in ins)):
                nP.append(tuple(a[i] + t * d[i] for i in range(3)))
                nM.append(ma + t * (mb - ma))
        out.append(dict(pt, poly=nP, mu=nM) if len(nP) != len(P) else pt)
    return out


def clip_rect(poly, x0, x1, y0, y1):
    """Polygon (3D points) clipped to the rectangle x0..x1, y0..y1 in plan (Sutherland–Hodgman)."""
    def cut(pts, ax, lim, keep_ge):
        out = []
        for i, a in enumerate(pts):
            b = pts[(i + 1) % len(pts)]
            ina, inb = (a[ax] >= lim - 1e-9) == keep_ge, (b[ax] >= lim - 1e-9) == keep_ge
            if ina != inb and abs(b[ax] - a[ax]) > 1e-12:
                t = (lim - a[ax]) / (b[ax] - a[ax])
                out.append(tuple(u + (v - u) * t for u, v in zip(a, b)))
            if inb:
                out.append(b)
        return out
    pts = [tuple(p) for p in poly]
    for ax, lim, ge in ((0, x0, True), (0, x1, False), (1, y0, True), (1, y1, False)):
        if not pts:
            break
        pts = cut(pts, ax, lim, ge)
    return pts


def parapet_faces(L, B, H, hp, t=0.25, col="#d6d3cd", top="#c9c3ba", out=WALL_OUT):
    """Parapet of thickness t around the roof perimeter: outer and inner walls and top."""
    zt = H + hp
    o = [(0, 0), (L, 0), (L, B), (0, B)]
    i_ = [(t, t), (L - t, t), (L - t, B - t), (t, B - t)]
    n_out = [(0, -1, 0), (1, 0, 0), (0, 1, 0), (-1, 0, 0)]
    n_in = [(0, 1, 0), (-1, 0, 0), (0, -1, 0), (1, 0, 0)]
    faces = []
    for k in range(4):
        a, b = o[k], o[(k + 1) % 4]
        c, d = i_[k], i_[(k + 1) % 4]
        faces.append(dict(poly=[(a[0], a[1], H), (b[0], b[1], H), (b[0], b[1], zt), (a[0], a[1], zt)],
                          fill=col, outline=out, n=n_out[k], cull=True))
        faces.append(dict(poly=[(c[0], c[1], H), (d[0], d[1], H), (d[0], d[1], zt), (c[0], c[1], zt)],
                          fill=col, outline=out, n=n_in[k], cull=True))
        faces.append(dict(poly=[(a[0], a[1], zt), (b[0], b[1], zt), (d[0], d[1], zt), (c[0], c[1], zt)],
                          fill=top, outline=out, n=(0, 0, 1), cull=True))
    return faces


class Prism:
    """Constant cross-section solid: x – along L, y – across (roof profile z(y)), z – up.
    prof – list of (y, z) locally from 0 to B; oy – offset in y."""

    def __init__(self, L, B, prof, oy=0.0):
        self.L, self.B, self.prof, self.oy = L, B, prof, oy
        self.h_top = max(z for _, z in prof)

    def z_at(self, yl):
        pr = self.prof
        if yl <= pr[0][0]:
            return pr[0][1]
        for (y0, z0), (y1, z1) in zip(pr, pr[1:]):
            if y0 <= yl <= y1 and y1 - y0 > 1e-12:
                return z0 + (z1 - z0) * (yl - y0) / (y1 - y0)
        return pr[-1][1]

    def rz(self, x, y):
        return self.z_at(y - self.oy)

    def segs(self):
        """Profile segments (global y): (y0, z0, y1, z1) – roof slopes."""
        o = self.oy
        return [(y0 + o, z0, y1 + o, z1) for (y0, z0), (y1, z1) in zip(self.prof, self.prof[1:])
                if y1 - y0 > 1e-9]

    @staticmethod
    def seg_angle(s):
        y0, z0, y1, z1 = s
        return math.degrees(math.atan2(abs(z1 - z0), y1 - y0))

    def strips(self):
        L = self.L
        return [[(0, y0, z0), (L, y0, z0), (L, y1, z1), (0, y1, z1)] for y0, z0, y1, z1 in self.segs()]

    def vfaces(self):
        """Vertical walls inside the profile (sawtooth roof)."""
        L, o, out = self.L, self.oy, []
        for (y0, z0), (y1, z1) in zip(self.prof, self.prof[1:]):
            if abs(y1 - y0) <= 1e-9 and abs(z1 - z0) > 1e-9:
                y = y0 + o
                out.append(([(0, y, min(z0, z1)), (L, y, min(z0, z1)), (L, y, max(z0, z1)),
                             (0, y, max(z0, z1))], (0, 1, 0)))
        return out

    def walls(self):
        L, B, o = self.L, self.B, self.oy
        z0, zB = self.prof[0][1], self.prof[-1][1]
        front = [(0, o, 0), (L, o, 0), (L, o, z0), (0, o, z0)]
        back = [(L, o + B, 0), (0, o + B, 0), (0, o + B, zB), (L, o + B, zB)]

        def gable(x):
            return [(x, o, 0), (x, o + B, 0)] + [(x, y + o, z) for y, z in reversed(self.prof)]
        return [("y0", front, (0, -1, 0)), ("yB", back, (0, 1, 0)),
                ("x0", gable(0), (-1, 0, 0)), ("xL", gable(L), (1, 0, 0))]


def prof_flat(B, H):
    return [(0.0, H), (B, H)]


def prof_mono(B, H, a):
    return [(0.0, H), (B, H + B * math.tan(math.radians(a)))]


def ridge_pos(w, a1, a2):
    t1, t2 = math.tan(math.radians(a1)), math.tan(math.radians(a2))
    return w * t2 / (t1 + t2) if t1 + t2 > 0 else w / 2


def prof_duo(B, H, a1, a2):
    yr = ridge_pos(B, a1, a2)
    return [(0.0, H), (yr, H + yr * math.tan(math.radians(a1))), (B, H)]


def prof_trough(B, H, a):
    return [(0.0, H), (B / 2, H - B / 2 * math.tan(math.radians(a))), (B, H)]


def prof_multi_duo(B, H, n, a1, a2):
    w = B / n
    yr = ridge_pos(w, a1, a2)
    hr = H + yr * math.tan(math.radians(a1))
    pts = []
    for k in range(n):
        pts += [(k * w, H), (k * w + yr, hr)]
    pts.append((B, H))
    return pts


def prof_saw(B, H, n, a):
    w = B / n
    hh = H + w * math.tan(math.radians(a))
    pts = [(0.0, H)]
    for k in range(n):
        pts.append(((k + 1) * w, hh))
        if k < n - 1:
            pts.append(((k + 1) * w, H))
    return pts


def prof_multi_valley(B, H, n, a):
    """Fig. 7.10 c: monopitch spans at both ends (rising inwards), troughs between them."""
    w = B / n
    t = math.tan(math.radians(a))
    hp = H + w * t
    pts = [(0.0, H), (w, hp)]
    for k in range(1, n - 1):
        pts += [(k * w + w / 2, hp - w / 2 * t), ((k + 1) * w, hp)]
    pts.append((B, H))
    return pts


def prof_vault(B, H, f, N=24):
    R = (f * f + (B / 2) ** 2) / (2 * f)
    zc = H + f - R
    return [(B * i / N, zc + math.sqrt(max(R * R - (B * i / N - B / 2) ** 2, 0))) for i in range(N + 1)]


class Hip:
    """Hipped roof on an L × B plan (ridge along x)."""

    def __init__(self, L, B, H, a0, a90):
        self.L, self.B, self.H = L, B, H
        self.t0, self.t90 = math.tan(math.radians(a0)), math.tan(math.radians(a90))
        self.h_top = H + B / 2 * self.t0
        self.run = (B / 2) * self.t0 / self.t90
        self.valid = L >= 2 * self.run - 1e-9

    def rz(self, x, y):
        L, B = self.L, self.B
        return self.H + max(0.0, min(y * self.t0, (B - y) * self.t0, x * self.t90, (L - x) * self.t90))

    def slopes(self):
        L, B, r = self.L, self.B, self.run
        A, Bp, C, D = (0, 0), (L, 0), (L, B), (0, B)
        P, Q = (r, B / 2), (L - r, B / 2)
        rid = (P, Q) if L - 2 * r > 1e-6 else None
        return [dict(poly=[A, Bp, Q, P], eave=(A, Bp), hips=[(Bp, Q), (P, A)], ridge=rid),
                dict(poly=[C, D, P, Q], eave=(C, D), hips=[(D, P), (Q, C)], ridge=rid),
                dict(poly=[D, A, P], eave=(D, A), hips=[(A, P), (P, D)], ridge=None),
                dict(poly=[Bp, C, Q], eave=(Bp, C), hips=[(C, Q), (Q, Bp)], ridge=None)]

    def walls(self):
        L, B, H = self.L, self.B, self.H
        return [("y0", [(0, 0, 0), (L, 0, 0), (L, 0, H), (0, 0, H)], (0, -1, 0)),
                ("yB", [(L, B, 0), (0, B, 0), (0, B, H), (L, B, H)], (0, 1, 0)),
                ("x0", [(0, B, 0), (0, 0, 0), (0, 0, H), (0, B, H)], (-1, 0, 0)),
                ("xL", [(L, 0, 0), (L, B, 0), (L, B, H), (L, 0, H)], (1, 0, 0))]


class Dome:
    """Dome on a circular plan of diameter D, cylindrical walls of height H, rise f."""

    def __init__(self, D, H, f, nr=7, ns=28):
        self.D, self.H, self.f = D, H, f
        self.rho = D / 2
        self.R = (f * f + self.rho ** 2) / (2 * f)
        self.zc = H + f - self.R
        self.h_top = H + f
        self.nr, self.ns = nr, ns

    def cap_point(self, r, ang):
        c = self.rho
        return (c + r * math.cos(ang), c + r * math.sin(ang),
                self.zc + math.sqrt(max(self.R ** 2 - r * r, 0)))

    def rz(self, x, y):
        r = math.hypot(x - self.rho, y - self.rho)
        return self.zc + math.sqrt(max(self.R ** 2 - r * r, 0)) if r <= self.rho else self.H

    def cap_facets(self):
        out = []
        for i in range(self.nr):
            r0, r1 = self.rho * i / self.nr, self.rho * (i + 1) / self.nr
            for j in range(self.ns):
                a0, a1 = 2 * math.pi * j / self.ns, 2 * math.pi * (j + 1) / self.ns
                if i == 0:
                    out.append([self.cap_point(0, 0), self.cap_point(r1, a0), self.cap_point(r1, a1)])
                else:
                    out.append([self.cap_point(r0, a0), self.cap_point(r1, a0), self.cap_point(r1, a1),
                                self.cap_point(r0, a1)])
        return out

    def wall_facets(self):
        out, c, H = [], self.rho, self.H
        for j in range(self.ns):
            a0, a1 = 2 * math.pi * j / self.ns, 2 * math.pi * (j + 1) / self.ns
            p0 = (c + c * math.cos(a0), c + c * math.sin(a0))
            p1 = (c + c * math.cos(a1), c + c * math.sin(a1))
            am = (a0 + a1) / 2
            out.append(([(p0[0], p0[1], 0), (p1[0], p1[1], 0), (p1[0], p1[1], H), (p0[0], p0[1], H)],
                        (math.cos(am), math.sin(am), 0)))
        return out


