def lab_dims(exp):
    """Dimensions that can be defined for a unit with exponent exp: kN/m³ – thickness, width, length;
    kN/m² – width, length; kN/m – length; kN – none. Each defined dimension lowers the exponent by 1."""
    return LAB_DIMS[3 - exp:] if 0 <= exp <= 3 else ()


def unit_exp(u):
    """Unit exponent (kN → 0, kN/m → 1, kN/m² → 2, kN/m³ → 3); None – unknown unit."""
    s = str(u or "").strip().lower().replace(" ", "").replace("^", "").replace("²", "2").replace("³", "3")
    return {"kn": 0, "kn/m": 1, "kn/m2": 2, "kn/m3": 3}.get(s)


def lab_fmt(v, d=3):
    s = f"{v:.{d}f}".replace(".", ",")
    return s.replace("-", "−") if v < 0 else s


def mat_range(txt):
    """Database value: a number or a range „od…do” → (min, max); None – invalid."""
    s = str(txt or "").strip().replace("...", "…").replace("÷", "…")
    for sep in ("…", " do ", " – ", " - "):
        if sep in s:
            a, b = s.split(sep, 1)
            lo, hi = parse_num(a.replace("od", "")), parse_num(b)
            if lo is None or hi is None:
                return None
            return (min(lo, hi), max(lo, hi))
    v = parse_num(s)
    return None if v is None else (v, v)


def user_data_dir():
    """User data folder: Windows %APPDATA%\\KAYENN, macOS ~/Library/Application Support/KAYENN,
    Linux $XDG_CONFIG_HOME/KAYENN (default ~/.config/KAYENN)."""
    home = os.path.expanduser("~")
    if sys.platform == "win32":
        base = os.environ.get("APPDATA") or os.path.join(home, "AppData", "Roaming")
    elif sys.platform == "darwin":
        base = os.path.join(home, "Library", "Application Support")
    else:
        base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    return os.path.join(base, "KAYENN")


def migrate_user_file(new, old):
    """Rename a user file from its former Polish name (once, silently)."""
    try:
        if not os.path.exists(new) and os.path.exists(old):
            os.replace(old, new)
    except OSError:
        pass
    return new


def settings_file():
    d = user_data_dir()
    return migrate_user_file(os.path.join(d, "settings.json"), os.path.join(d, "ustawienia.json"))


def settings_get(key, default=None):
    """User setting (settings.json in the user data folder); default when missing or unreadable."""
    try:
        with open(settings_file(), encoding="utf-8") as f:
            return json.load(f).get(key, default)
    except (OSError, ValueError, AttributeError):
        return default


def settings_set(key, value):
    try:
        with open(settings_file(), encoding="utf-8") as f:
            d = json.load(f)
        if not isinstance(d, dict):
            d = {}
    except (OSError, ValueError):
        d = {}
    d[key] = value
    try:
        os.makedirs(os.path.dirname(settings_file()), exist_ok=True)
        with open(settings_file(), "w", encoding="utf-8") as f:
            json.dump(d, f, ensure_ascii=False, indent=1)
    except OSError:
        pass


# --- About the program: update check; page header of the printout
REPO = "damiankozuszek/kayenn"
RELEASES_URL = f"https://github.com/{REPO}/releases"
UPDATE_EVERY = 24 * 3600              # automatic check at most once a day (seconds)


def version_tuple(v):
    """'v0.1.2' / '0.1.2-beta' → (0, 1, 2); unreadable → ()."""
    m = re.match(r"\s*v?(\d+(?:\.\d+)*)", v or "")
    return tuple(int(x) for x in m.group(1).split(".")) if m else ()


def check_update(timeout=10):
    """Asks GitHub for the latest published release. Returns dict(ok, newer, version, url, msg)."""
    import urllib.error
    import urllib.request
    try:
        req = urllib.request.Request(f"https://api.github.com/repos/{REPO}/releases/latest",
                                     headers={"User-Agent": "KAYENN/" + APP_VERSION,
                                              "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            d = json.loads(r.read().decode("utf-8", "replace"))
        tag = d.get("tag_name", "")
        new, cur = version_tuple(tag), version_tuple(APP_VERSION)
        if not new:
            return dict(ok=False, msg="Nie udało się odczytać numeru najnowszej wersji.")
        assets = [dict(name=x.get("name", ""), url=x.get("browser_download_url", ""), size=x.get("size") or 0,
                       digest=x.get("digest") or "") for x in d.get("assets") or []]
        return dict(ok=True, newer=new > cur, version=tag.lstrip("vV"), url=d.get("html_url") or RELEASES_URL,
                    assets=assets)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return dict(ok=True, newer=False, version=APP_VERSION, url=RELEASES_URL, none=True)
        return dict(ok=False, msg=f"Serwer aktualizacji odpowiedział błędem {e.code}.")
    except Exception as e:     # no network, timeout
        return dict(ok=False, msg="Brak połączenia z serwerem aktualizacji (" + str(e) + ").")


