        # Cofnij / Ponów: snapshots of the item list (recorded 0.5 s after the last change)
        self._h_timer = QTimer(self)
        self._h_timer.setSingleShot(True)
        self._h_timer.setInterval(500)
        self._h_timer.timeout.connect(self._h_push)
