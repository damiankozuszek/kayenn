        self.use_bsit.addItems(USE_BSIT)
        g.addWidget(self.use_bsit_lb, 10, 0)
        g.addWidget(self.use_bsit, 10, 1, 1, 5)
        self.use_bw = {}
        for r_, (key, lab, un, val) in enumerate((("m", "Masa całkowita pojazdu m", "kg", "3000"),
                                                  ("dc", "Odkształcenie pojazdu δc", "mm", "100"),
                                                  ("db", "Odkształcenie bariery δb", "mm", "0"))):
            lb, en, ul = QLabel(lab), self._mk_entry(), self._unit(un)
            en.setText(val)
            g.addWidget(lb, 11 + r_, 0)
            g.addWidget(en, 11 + r_, 1, 1, 1, AL_R)
            g.addWidget(ul, 11 + r_, 2)
            en.textEdited.connect(lambda t: self._use_show())
            self.use_bw[key] = (lb, en, ul)
        self.use_check = LabelX("")
        self.use_check.setWordWrap(True)
        c.grid.addWidget(self.use_check, 14, 0, 1, 6)
        lay.addStretch(1)
        self.use_group.currentIndexChanged.connect(lambda i: self._use_fill_cats())
        self.use_cat.currentIndexChanged.connect(lambda i: self._use_show(reset=True))
        self.use_like.currentIndexChanged.connect(lambda i: self._use_show(reset=True))
        for e in (self.use_q, self.use_Q, self.use_A, self.use_n):
            e.textEdited.connect(lambda t: self._use_check())
        for cb in (self.use_part, self.use_red, self.use_tyre, self.use_bcl, self.use_bsit):
            cb.currentIndexChanged.connect(lambda i: self._use_show())
        self._use_fill_cats()

    def _use_fill_cats(self):
        gi = max(self.use_group.currentIndex(), 0)
        self.use_cat.blockSignals(True)
        self.use_cat.clear()
        self.use_cat.addItems([e["name"] for e in USE_GROUPS[gi][3]])
        self.use_cat.blockSignals(False)
        self._use_show(reset=True)

    def _use_entry(self):
        """(selected item, item with the values – for cat. I: the selected use, source)."""
        gk, _, tab, es = USE_GROUPS[max(self.use_group.currentIndex(), 0)]
        e = es[max(self.use_cat.currentIndex(), 0)]
        if e.get("like"):
            v = USE_LIKE[max(self.use_like.currentIndex(), 0)]
            src = next(t for k, _, t, es_ in USE_GROUPS if v in es_)
            return e, v, f"Tablica 6.9 (kategoria I) → {src}"
        return e, e, e.get("tab", tab)

    @staticmethod
    def _use_fmt(v):
        t = f"{v:.2f}".rstrip("0")
        return (t + "0" if t.endswith(".") else t).replace(".", ",")

    def _use_show(self, reset=False):
        e, v, src = self._use_entry()
        like = bool(e.get("like"))
        self.use_like.setVisible(like)
        self.use_like_lb.setVisible(like)
        desc = e["desc"] + (f"\nUżytkowanie: {v['name']}. {v['desc']}" if like else "")
        self.use_desc.configure(text=desc)
        line = bool(v.get("line"))
        qu = "kN/m" if line else "kN/m²"
        f = self._use_fmt
        rows = []
        for sym, rng, un, what in (("q<sub>k</sub>", v.get("q"), qu,
                                    "obciążenie liniowe (poziome)" if line else "obciążenie równomiernie rozłożone"),
                                   ("Q<sub>k</sub>", v.get("Q"), "kN", "obciążenie skupione")):
            if not rng:
                continue
            lo, hi, rec = rng
            if abs(lo - hi) < 1e-9:
                rows.append(f"<b>{sym} = {f(rec)} {un}</b> – {what} (wartość jedyna)")
            else:
                rows.append(f"{sym}: od {f(lo)} do {f(hi)} {un} – {what}; "
                            f"<b>wartość zalecana {f(rec)} {un}</b>")
        if v.get("barrier"):
            rows.append("<b>F = 0,5·m·v²/(δc + δb)</b> – siła pozioma od uderzenia pojazdu (B(2)); pojazdy ≤ 2500 kg "
                        "i bariera sztywna (δb = 0): F = 150 kN (B(3)) – obliczenie poniżej")
        if not rows:
            rows.append("Norma nie podaje wartości liczbowych.")
        notes = [n for n in (v.get("note"), e.get("note") if e is not v else None) if n]
        if v.get("low_min"):
            notes.append("Załącznik krajowy (NB1): wartości nie mniejsze niż dolne granice przedziałów Tablicy 6.2. "
                         "Jeśli jest to konieczne (np. schody, balkony), wartości zwiększa się (6.3.1.2(2)).")
        html_ = "<br>".join(rows) + f"<br><span style='color:{MUTED}'>PN-EN 1991-1-1, {src}" + \
            "".join(f"<br>{html.escape(n)}" for n in notes) + "</span>"
        self.use_norm.setText(html_)
        fl, bar = bool(v.get("fl")), bool(v.get("barrier"))
        for w_ in (self.use_tyre_lb, self.use_tyre):
            w_.setVisible(fl)
        for w_ in (self.use_bcl_lb, self.use_bcl, self.use_bsit_lb, self.use_bsit):
            w_.setVisible(bar)
        for key, ws in self.use_bw.items():
            for w_ in ws:
                w_.setVisible(bar and (key != "m" or self.use_bcl.currentIndex() == 1))
        has_q = (bool(v.get("q")) or v.get("q") is None and not v.get("Q")) and not bar
        has_Q = bool(v.get("Q"))
        self._use_has = (has_q, has_Q)
        for w_ in (self.use_q_lb, self.use_q, self.use_q_un):
            w_.setVisible(has_q)
        for w_ in (self.use_Q_lb, self.use_Q, self.use_Q_un):
            w_.setVisible(has_Q)
        self.use_q_un.setText(qu)
        if reset:
            self.use_q.setText(f"{v['q'][2]:g}" if v.get("q") else "")
            self.use_Q.setText(f"{v['Q'][2]:g}" if v.get("Q") else "")
        pa, ra, na = self._use_applicable()
        for w_ in (self.use_part_lb, self.use_part):
            w_.setVisible(pa)
        for w_ in (self.use_red_lb, self.use_red):
            w_.setVisible(ra)
        k = self.use_red.currentIndex() if ra else 0
        if k == 2 and not na:
            k = 0
        for w_ in (self.use_A_lb, self.use_A, self.use_A_un):
            w_.setVisible(ra and k == 1)
        for w_ in (self.use_n_lb, self.use_n, self.use_n_un):
            w_.setVisible(ra and k == 2)
        self._use_check()

    def _use_applicable(self):
        """(partitions 6.3.1.2(8), reduction αA 6.3.1.2(10), reduction αn 6.3.1.2(11)) for the selected category."""
        e, v, _ = self._use_entry()
        has_q = bool(v.get("q")) and not v.get("line")
        part = self.use_group.currentIndex() == 0 and v["code"] not in ("A2", "A3") and has_q
        return part, has_q and v["code"][0] in "ABCDE", has_q and v["code"][0] in "ABCD"

    def _use_extra(self):
        """Partitions and reduction chosen on the form:
        dict(part=qk of partitions or None, red=(kind, α, ψ0, parameter) or None, total=qk sum or None, err=text)."""
        e, v, _ = self._use_entry()
        pa, ra, na = self._use_applicable()
        out = dict(part=None, red=None, total=None, err="", fl=None, bar=None)
        q = parse_num(self.use_q.text()) if self.use_q.text().strip() else None
        if v.get("fl"):
            Q = parse_num(self.use_Q.text())
            phi = USE_TYRE_PHI[max(self.use_tyre.currentIndex(), 0)]
            if Q is not None and Q >= 0:
                out["fl"] = dict(Q=Q, phi=phi, dyn=phi * Q, hor=0.3 * Q, data=v["fl"])
        if v.get("barrier"):
            big = self.use_bcl.currentIndex() == 1
            vals = {k: parse_num(ws[1].text()) for k, ws in self.use_bw.items()}
            m = vals["m"] if big else 1500.0
            if big and (m is None or m <= 2500):
                out["err"] = "Masa pojazdu m: wartość > 2500 kg (B(4))."
            elif vals["dc"] is None or vals["dc"] <= 0 or vals["db"] is None or vals["db"] < 0:
                out["err"] = "Odkształcenia δc > 0 i δb ≥ 0 [mm]."
            else:
                F = use_barrier_F(m, vals["dc"], vals["db"])
                sit = max(self.use_bsit.currentIndex(), 0)
                k = (1.0, 0.5, 2.0)[sit]
                if sit == 2 and big:
                    out["err"] = "B(7) dotyczy siły z B(3) (pojazdy ≤ 2500 kg)."
                else:
                    hgt = "610 mm ponad poziomem podjazdu" if sit else (
                        "375 mm ponad poziomem stropu (B(5))" if not big else "wysokość zderzaka (B(5))")
                    out["bar"] = dict(m=m, dc=vals["dc"], db=vals["db"], F=F, k=k, Fd=k * F, sit=sit, big=big,
                                      hgt=hgt)
        if pa and self.use_part.currentIndex() > 0:
            out["part"] = USE_PART_Q[self.use_part.currentIndex()]
        k = self.use_red.currentIndex() if ra else 0
        if k == 2 and not na:
            k = 0
        if k:
            psi0 = USE_PSI0[v["code"][0]]
            if k == 1:
                A = parse_num(self.use_A.text())
                if A is None or A <= 0:
                    out["err"] = "Powierzchnia obciążona A: niepoprawna wartość (A > 0)."
                else:
                    out["red"] = ("A", use_alpha_A(psi0, A, v["code"]), psi0, A)
            else:
                n = parse_num(self.use_n.text())
                if n is None or abs(n - round(n)) > 1e-9 or n < 3 or n > 200:
                    out["err"] = "Liczba kondygnacji n: liczba całkowita ≥ 3 (6.3.1.2(11): n > 2)."
                else:
                    out["red"] = ("n", use_alpha_n(psi0, int(round(n))), psi0, int(round(n)))
        if q is not None and (out["part"] is not None or out["red"]):
            out["total"] = q * (out["red"][1] if out["red"] else 1.0) + (out["part"] or 0.0)
        return out

    def _use_check(self):
        """Adopted value relative to the code range."""
        e, v, _ = self._use_entry()
        msgs, bad = [], False
        has = getattr(self, "_use_has", (True, True))
        for ent, rng, sym, on in ((self.use_q, v.get("q"), "qₖ", has[0]), (self.use_Q, v.get("Q"), "Qₖ", has[1])):
            if not on:
                continue
            t = ent.text().strip()
            if not t:
                continue
            x = parse_num(t)
            if x is None or x < 0:
                msgs.append(f"{sym}: niepoprawna wartość.")
                bad = True
                continue
            if not rng:
                continue
            lo, hi, rec = rng
            if x < lo - 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – poniżej dolnej granicy {self._use_fmt(lo)}"
                            + (" (niedopuszczalne wg Załącznika krajowego NB1)." if v.get("low_min") else "."))
                bad = True
            elif x > hi + 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – powyżej przedziału normowego (wartość zwiększona).")
            elif abs(x - rec) > 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – w przedziale normowym, inna niż zalecana.")
        ex = self._use_extra()
        if ex["err"]:
            msgs.append(ex["err"])
            bad = True
        f = self._use_fmt
        if ex["red"]:
            kind, al, psi0, par = ex["red"]
            msgs.append(f"α_{kind} = {f(al)} (ψ₀ = {f(psi0)}, {'A' if kind == 'A' else 'n'} = {par:g}) → "
                        f"zredukowane qₖ = {f(al * (parse_num(self.use_q.text()) or 0.0))} kN/m²."
                        if parse_num(self.use_q.text()) is not None else f"α_{kind} = {f(al)}.")
        if ex["part"] is not None:
            msgs.append(f"+ ścianki działowe {f(ex['part'])} kN/m².")
        if ex["total"] is not None:
            msgs.append(f"Razem qₖ = {f(ex['total'])} kN/m².")
        if ex["fl"]:
            d_ = ex["fl"]
            msgs.append(f"Qₖ,dyn = φ·Qₖ = {f(d_['phi'])}·{f(d_['Q'])} = {f(d_['dyn'])} kN (6.3); obciążenie poziome "
                        f"0,3·Qₖ = {f(d_['hor'])} kN (6.3.2.3(7)).")
        if ex["bar"]:
            b = ex["bar"]
            msgs.append(f"F = 0,5·{b['m']:g}·4,5²/({b['dc']:g} + {b['db']:g}) = {f(b['F'])} kN"
                        + (f" → {'F/2' if b['k'] == 0.5 else '2F'} = {f(b['Fd'])} kN" if b["k"] != 1 else "")
                        + f"; na długości 1,5 m, {b['hgt']}.")
        self.use_check.configure(text=" ".join(msgs))
        self.use_check.setStyleSheet(f"color:{MANUAL_COL};" if bad else f"color:{MUTED};")
        pa, ra, na = self._use_applicable()
        if ra:
            self.use_red_note.configure(text=("Redukcja dotyczy qₖ (nie Qₖ); dla qₖ do obliczeń "
                                              "stosuje się zredukowaną wartość. Przy oddziaływaniu towarzyszącym "
                                              "stosuje się tylko jeden ze współczynników ψ₀ lub αₙ."
                                              if self.use_red.currentIndex() else ""))
        else:
            self.use_red_note.configure(text="")
        for ent in (self.use_q, self.use_Q):
            x = parse_num(ent.text()) if ent.text().strip() else 0.0
            self._mark_bad(ent, x is None)

    def _use_valid(self):
        """(whether it can be added to the project, error description)."""
        e, v, _ = self._use_entry()
        has = getattr(self, "_use_has", (True, True))
        vals = []
        for ent, rng, sym, on in ((self.use_q, v.get("q"), "qₖ", has[0]), (self.use_Q, v.get("Q"), "Qₖ", has[1])):
            if not on or not ent.text().strip():
                continue
            x = parse_num(ent.text())
            if x is None or x < 0:
                return False, f"{sym}: niepoprawna wartość."
            if rng and v.get("low_min") and x < rng[0] - 1e-9:
                return False, f"{sym} poniżej dolnej granicy przedziału normowego (Załącznik krajowy NB1)."
            vals.append(x)
        ex = self._use_extra()
        if ex["err"]:
            return False, ex["err"]
        if v.get("barrier"):
            return (True, "") if ex["bar"] else (False, "Uzupełnij dane bariery.")
        if not vals:
            return False, "Podaj przyjętą wartość obciążenia."
        return True, ""

    def _use_values(self):
        """[(symbol, value, unit, range)] – values adopted for the project."""
        e, v, src = self._use_entry()
        has = getattr(self, "_use_has", (True, True))
        un_q = "kN/m" if v.get("line") else "kN/m²"
        out = []
        for ent, rng, sym, un, on in ((self.use_q, v.get("q"), "qₖ", un_q, has[0]),
                                      (self.use_Q, v.get("Q"), "Qₖ", "kN", has[1])):
            x = parse_num(ent.text()) if on and ent.text().strip() else None
            if x is not None:
                out.append((sym, x, un, rng))
        if v.get("barrier"):
            b = self._use_extra()["bar"]
            if b:
                out.append(("Qₖ", b["Fd"], "kN", None))
        return out

    def _use_title(self):
        e, v, _ = self._use_entry()
        return e["name"] + (f" → {v['name']}" if e.get("like") else "")

