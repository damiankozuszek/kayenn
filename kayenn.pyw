def _dec(x):
    return f"{x:.2f}".replace(".", ",")


def use_barrier_F(m, dc, db, v=4.5):
    """Annex B(2): F = 0.5·m·v²/(δc + δb) [kN] (m in kg, v in m/s, δ in mm)."""
    return 0.5 * m * v * v / (dc + db)
