# ========================================================= helpers ===
def parse_num(s):
    s = s.strip().replace(" ", "").replace(" ", "").replace(",", ".")
    if not s:
        return None
    try:
        v = float(s)
    except ValueError:
        return None
    return v if math.isfinite(v) else None


def f2(v, d=2, sign=False):
    if v is None:
        return "—"
    s = f"{v:+.{d}f}" if sign else f"{v:.{d}f}"
    if s in ("-0." + "0" * d, "+0." + "0" * d):
        s = ("+" if sign else "") + "0." + "0" * d
    return s.replace("-", "−")


def interp(x, xs, ys):
    if x <= xs[0]:
        return ys[0]
    if x >= xs[-1]:
        return ys[-1]
    for i in range(len(xs) - 1):
        if xs[i] <= x <= xs[i + 1]:
            if xs[i + 1] == xs[i]:
                return ys[i + 1]
            t = (x - xs[i]) / (xs[i + 1] - xs[i])
            return ys[i] + t * (ys[i + 1] - ys[i])
    return ys[-1]


def mix(c1, c2, t):
    t = max(0.0, min(1.0, t))
    return "#%02x%02x%02x" % tuple(int(a + (b - a) * t) for a, b in zip(c1, c2))


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


# ------------------------------------------------- polygon geometry ---
def _clip(pts, f, c, keep_ge):
    out = []
    n = len(pts)
    for i in range(n):
        p, q = pts[i], pts[(i + 1) % n]
        fp, fq = f(p) - c, f(q) - c
        if not keep_ge:
            fp, fq = -fp, -fq
        pin, qin = fp >= -1e-9, fq >= -1e-9
        if pin:
            out.append(p)
        if pin != qin:
            t = fp / (fp - fq)
            out.append(tuple(a + (b - a) * t for a, b in zip(p, q)))
    return out


def clip_poly(pts, f, lo, hi):
    """Part of the polygon where lo <= f(p) <= hi."""
    if not pts:
        return []
    pts = _clip(pts, f, lo, True)
    if len(pts) < 3:
        return []
    pts = _clip(pts, f, hi, False)
    return pts if len(pts) >= 3 else []


def newell(pts):
    nx = ny = nz = 0.0
    n = len(pts)
    for i in range(n):
        x1, y1, z1 = pts[i]
        x2, y2, z2 = pts[(i + 1) % n]
        nx += (y1 - y2) * (z1 + z2)
        ny += (z1 - z2) * (x1 + x2)
        nz += (x1 - x2) * (y1 + y2)
    return nx, ny, nz


def poly_area(pts):
    if not pts:
        return 0.0
    if len(pts[0]) == 2:
        a = 0.0
        for i in range(len(pts)):
            x1, y1 = pts[i]
            x2, y2 = pts[(i + 1) % len(pts)]
            a += x1 * y2 - x2 * y1
        return abs(a) / 2
    nx, ny, nz = newell(pts)
    return math.sqrt(nx * nx + ny * ny + nz * nz) / 2


def centroid(pts):
    n = len(pts)
    return tuple(sum(p[i] for p in pts) / n for i in range(len(pts[0])))


def unit(v):
    l = math.sqrt(sum(c * c for c in v)) or 1.0
    return tuple(c / l for c in v)


def line_dist_fn(p, q, inside):
    """Linear function: distance from line pq (2D), positive on the side of point 'inside'."""
    dx, dy = q[0] - p[0], q[1] - p[1]
    l = math.hypot(dx, dy) or 1.0
    nx, ny = -dy / l, dx / l
    if (inside[0] - p[0]) * nx + (inside[1] - p[1]) * ny < 0:
        nx, ny = -nx, -ny
    return lambda pt: (pt[0] - p[0]) * nx + (pt[1] - p[1]) * ny


