    @staticmethod
    def default_yaw(theta):
        return math.radians({0: -32, 90: 58, 180: 148}.get(theta, -32))

    def reset_view(self):
        th = self.wind["theta"] if self.wind else 0
        self.yaw, self.pitch, self.zoom = self.default_yaw(th), math.radians(24), 1.0
        self.pan_x = self.pan_y = 0.0
        self.piv = None
        self.draw3d()

    def _pan_press(self, e):
        self._pan_last = (e.x, e.y)
        self.cv.configure(cursor="fleur")

    def _pan(self, e):
        lx, ly = self._pan_last
        self._pan_last = (e.x, e.y)
        self.pan_x += e.x - lx
        self.pan_y += e.y - ly
        self.draw3d()

    def _press(self, e):
        self._last = (e.x, e.y)
        self._moved = False

    @staticmethod
    def pick_pivot(cv):
        """Rotation point: the model point shown in the centre of the view (the nearest surface of the building
        or the ground on the line of sight; nothing there – the point of that line at the depth of the current
        rotation point). None – the view was not drawn yet."""
        pr = getattr(cv, "_proj", None)
        if pr is None:
            return None
        ctr, sc, cy, sy, cp, sp, ox, oy, W, Hc = pr
        xr, u = (W / 2 - ox) / sc, (oy - Hc / 2) / sc

        def world(D):                              # inverse of the projection at the depth D
            yr, z = sp * u + cp * D, cp * u - sp * D
            return (ctr[0] + xr * cy + yr * sy, ctr[1] - xr * sy + yr * cy, ctr[2] + z)
        A, B_ = world(0.0), world(1.0)
        v = tuple(b - a for a, b in zip(A, B_))
        best = None
        polys = list(getattr(cv, "_proj_faces", []))
        for poly in polys + [None]:
            if poly is None:                       # the ground (z = 0) – only the drawn ground plate
                gx0, gx1, gy0, gy1 = getattr(cv, "_proj_ground", (0, 0, 0, 0))
                if abs(v[2]) < 1e-12:
                    continue
                t = -A[2] / v[2]
                q = tuple(a + t * b for a, b in zip(A, v))
                if not (gx0 <= q[0] <= gx1 and gy0 <= q[1] <= gy1):
                    continue
            else:
                n = newell(poly)
                nn = sum(a * b for a, b in zip(n, v))
                if abs(nn) < 1e-12:
                    continue
                t = sum(a * (b - c) for a, b, c in zip(n, poly[0], A)) / nn
                q = tuple(a + t * b for a, b in zip(A, v))
                k = max(range(3), key=lambda i: abs(n[i]))          # point in polygon – in the plane
                ia, ib = [i for i in range(3) if i != k]
                inside = False
                for j in range(len(poly)):
                    p1, p2 = poly[j], poly[j - 1]
                    if (p1[ib] > q[ib]) != (p2[ib] > q[ib]):
                        xa = p1[ia] + (q[ib] - p1[ib]) * (p2[ia] - p1[ia]) / (p2[ib] - p1[ib])
                        if q[ia] < xa:
                            inside = not inside
                if not inside:
                    continue
            if best is None or t < best:
                best = t
        return world(best if best is not None else 0.0)

    def set_pivot(self, view=None, cv=None):
        """Rotation start: the rotation point = the model point in the centre of the view (the picture does not
        move – that point already is in the centre, so the pan becomes zero)."""
        q = self.pick_pivot(cv if cv is not None else self.cv)
        if q is None:
            return
        if view is not None:
            view.update(piv=list(q), pan_x=0.0, pan_y=0.0)
        else:
            self.piv, self.pan_x, self.pan_y = list(q), 0.0, 0.0

    def _rotate(self, e):
        lx, ly = self._last
        if abs(e.x - lx) + abs(e.y - ly) < 3 and not getattr(self, "_moved", False):
            return
        if not getattr(self, "_moved", False):
            self.set_pivot()
        self._moved = True
        self._last = (e.x, e.y)
        self.yaw += (e.x - lx) * 0.01
        self.pitch = clamp(self.pitch + (e.y - ly) * 0.01, math.radians(2), math.radians(88))
        self.draw3d()

    def _pan_by(self, dx, dy):
        self.pan_x += dx
        self.pan_y += dy
        self.draw3d()

    def _zoom(self, f, at=None):
        """Zoom by f; at = (x, y) – the point under the cursor stays in place (None – the view centre)."""
        old = self.zoom
        self.zoom = clamp(self.zoom * f, getattr(self.cv, "_zmin", ZOOM_MIN), ZOOM_MAX)
        if at is not None and old > 0 and self.cv is not None:
            self.pan_x, self.pan_y = zoom_pan(self.pan_x, self.pan_y, self.zoom / old, at,
                                              self.cv.winfo_width(), self.cv.winfo_height())
        self.draw3d()

    def _load_scale(self):
        """Load layer scale on the 3D model: zooming in (zoom > 1) – thinner layers, so that their thickness on the
        screen stays the same (a close look at a tall building is not covered by huge layers). Quantised in 10%
        steps – the scene is rebuilt only when the step changes. (step, factor)."""
        z = max(getattr(self, "zoom", 1.0) or 1.0, 1.0)
        q = round(math.log(z) / math.log(1.1))
        return q, 1.1 ** -q

    def _dim_scale(self):
        """Offset factor of dimensions / angle texts: `_load_scale` factor × compensation of the wider framing
        with orography (`_view_k`, so the offsets keep the same size on the screen as without the terrain)."""
        return self._load_scale()[1] * (getattr(self, "_view_k", 1.0) or 1.0)

    def _oro_terrain(self, g):
        """Orography on the 3D model (wind): terrain along the wind with the building on a flat shelf –
        dict(quads, edges, pts, prof, ...) or None. The terrain is drawn under the building (not in faces)."""
        w = getattr(self, "wind", None)
        oro = ((w or {}).get("info") or {}).get("oro")
        if not oro:
            return None
        fr = wind_frame(g, w["theta"])
        d, b, to = fr["d"], fr["b"], fr["to_xy"]
        B0 = max(g.L, g.B, getattr(g, "h_top", 0.0) or 0.0, 1e-3)
        pr = oro_profile(oro, d, B0)
        ext = max(0.8 * B0, 0.12 * (pr["hi"] - pr["lo"]))      # width of the terrain across the wind
        t0, t1 = -ext, b + ext
        sc_ = d / 2

        def pt(q, t, z):
            x, y = to(sc_ + q, t)
            return (x, y, z)
        quads, pts = [], []
        for (qa, za), (qb, zb) in zip(pr["V"], pr["V"][1:]):
            poly = [pt(qa, t0, za), pt(qb, t0, zb), pt(qb, t1, zb), pt(qa, t1, za)]
            pts += poly
            wall = abs(qa - qb) < 1e-9
            flat = abs(za - zb) < 1e-9
            quads.append(dict(poly=poly, fill="#b9c0a8" if wall else ("#e4e8dc" if flat else "#cdd4bd"),
                              outline="#c5cbb9" if flat else "#9aa28a"))
        edges = [[pt(q, t, z) for q, z in pr["V"]] for t in (t0, t1)]
        return dict(quads=quads, edges=edges, pts=pts, prof=pr, pt=pt, t0=t0, t1=t1, fr=fr, d=d, b=b, B0=B0, ext=ext,
                    oro=oro)

    def _draw_terrain(self, cv, P, terr):
        items = []
        for q in terr["quads"]:
            pr = [P(p) for p in q["poly"]]
            items.append((sum(p[2] for p in pr) / 4, q, pr))
        for _, q, pr in sorted(items, key=lambda x: -x[0]):
            cv.create_polygon(*[c for p in pr for c in p[:2]], fill=q["fill"], outline=q["outline"])
        for e in terr["edges"]:
            pr = [P(p) for p in e]
            cv.create_line(*[c for p in pr for c in p[:2]], fill="#7c8470", width=1.5)

    def _oro_dims(self, cv, P, facing, terr):
        """Dimensions of the orography: height H, slope length Lu (Ld), distance of the building from the crest x.
        The texts show the true values (the drawing may be scaled). On the viewer's side, outside the terrain."""
        pr, pt, fr = terr["prof"], terr["pt"], terr["fr"]
        to = fr["to_xy"]
        a0, a1 = to(0, 0), to(0, -1)
        v = (a1[0] - a0[0], a1[1] - a0[1])
        l = math.hypot(*v) or 1.0
        near_lo = facing((v[0] / l, v[1] / l, 0))       # the side t = t0 faces the viewer → dimensions there
        sgn = -1 if near_lo else 1
        tedge = terr["t0"] if near_lo else terr["t1"]
        N = 0.4 * terr["B0"] * self._load_scale()[1]    # offset module (the building size – the terrain is in real scale)
        col = ORO_COL
        t_at = lambda k: tedge + sgn * N * k
        zf = pr["zf"]
        zmin = min(z for _, z in pr["V"])
        lev = lambda k: zmin - N * k                     # dimension lines hang below the terrain, one level each
        up = (0, 0, 0.2 * N)
        # x – from the building to the crest; Ld (hill) – from the crest; Lu – from the foot to the crest. The extension
        # lines are vertical (from the terrain points down to the dimension line)
        u0, u1 = sorted((0.0, pr["qc"]))
        self._dchain(cv, P, lambda u: pt(u, tedge, 0.0) if abs(u) < 1e-9 else pt(u, tedge, pr["z_crest"]),
                     lambda u: pt(u, tedge, lev(1)), [(u0, u1, f"=x = {f2(pr['x'])} m", "ox")], up, col)
        segs = [(min(pr["foot"], pr["qc"]), max(pr["foot"], pr["qc"]), f"=Lu = {f2(pr['Lu'])} m", "oLu")]
        if pr["hill"]:                                   # Lu and Ld – one line (the slopes meet at the crest)
            segs.append((pr["qc"], pr["foot2"], f"=Ld = {f2(pr['Ld'])} m", "oLd"))
        self._dchain(cv, P, lambda u: pt(u, tedge, zf(u)), lambda u: pt(u, tedge, lev(2)), segs, up, col)
        # H – vertical, beside the crest (hill) / the end of the upper plateau (escarpment)
        zl = pr["z_foot"]
        sh = pr["qc"] if pr["hill"] else pr["hi"]
        a, c = P(pt(pr["foot"], tedge, zl)), P(pt(sh, tedge, zl))
        cv.create_line(a[0], a[1], c[0], c[1], fill=col, dash=(2, 2))
        self._dchain(cv, P, lambda u: pt(sh, tedge, u), lambda u: pt(sh, t_at(1), u),
                     [(zl, pr["z_crest"], f"=H = {f2(pr['H'])} m", "oH")], (0, 0, 0), col)

    def scene_wind(self):
        """Wind like snow: neutral building surfaces, on each zone a semi-transparent load layer
        outside the surface – thickness ∝ |we|, colour: pressure red, suction blue. Label – the value
        with its unit only (no zone letter). Dome – zones coloured on the surface (no layer)."""
        g, w = self.wgeo, self.wind
        faces, texts, lines = [], [], []
        canopy = g.kind in ("can1", "can2")
        size = max(g.L, g.B, getattr(g, "h_top", 0.0) or 0.0, 1e-3)
        wmax = max([abs(z["we"]) for z in w["zones"]] + [1e-9])
        tsc = 0.07 * size / wmax * self._load_scale()[1]   # layer thickness (smaller than the dimension offset N)
        slabs = []
        # zone edges split at the vertices of neighbouring zones – shared edges are then identical
        # (layers joined at corners, eaves and ridge without gaps)
        par_in = g.kind == "flat" and g.hp > 0      # parapet: the roof layers only inside its inner faces
        t_par = 0.25          # thickness of parapet_faces (t)

        def zpoly(z):
            if par_in and z["kind"] == "roof":
                return clip_rect(z["poly"], t_par, g.L - t_par, t_par, g.B - t_par)
            return z["poly"]
        allv = [q for z in w["zones"] if not z.get("dome") for q in zpoly(z)]

        def split_edges(P):
            out = []
            for j in range(len(P)):
                a_, b_ = P[j], P[(j + 1) % len(P)]
                d_ = tuple(y_ - x_ for x_, y_ in zip(a_, b_))
                L2 = sum(c_ * c_ for c_ in d_)
                out.append(a_)
                if L2 < 1e-12:
                    continue
                ins = []
                for q in allv:
                    t_ = sum((qc - ac) * dc for qc, ac, dc in zip(q, a_, d_)) / L2
                    if 1e-6 < t_ < 1 - 1e-6:
                        foot = tuple(ac + dc * t_ for ac, dc in zip(a_, d_))
                        if sum((qc - fc) ** 2 for qc, fc in zip(q, foot)) < 1e-10:
                            ins.append((t_, q))
                for t_, q in sorted(ins):
                    if all(sum((qc - oc) ** 2 for qc, oc in zip(q, o_)) > 1e-12 for o_ in out[-1:]):
                        out.append(q)
            return out
        for z in w["zones"]:
            t = min(abs(z["cpe"]) / 2.0, 1.0)
            col = mix((255, 255, 255), PRESS_COL if z["cpe"] > 0 else SUCT_COL, 0.15 + 0.6 * t)
            dome = z.get("dome")
            lab = None if dome else f"{f2(z['we'], 3, True)} kN/m²"
            grp = None if dome else (z["kind"], z["name"], round(z["cpe"], 4), z.get("rect") or id(z))
            P = zpoly(z)
            if len(P) < 3:
                continue
            n = unit(newell(P))
            if z["kind"] in ("roof", "canopy"):     # roof slope: normal always up (troughed roofs)
                if n[2] < 0:
                    n = tuple(-c for c in n)
            else:                                    # wall: normal pointing out of the building
                c = centroid(P)
                if n[0] * (c[0] - g.L / 2) + n[1] * (c[1] - g.B / 2) < 0:
                    n = tuple(-c_ for c_ in n)
            if dome:
                faces.append(dict(poly=P, fill=col, outline=col, n=n, value=z["we"], cull=not canopy,
                                  kind=z["kind"]))
                continue
            roofy = z["kind"] in ("roof", "canopy")
            d = tsc * abs(z["we"])
            P = split_edges(P)
            zero = d < 1e-9                        # zone with zero load (e.g. cpe = −0.0) – label on the surface
            faces.append(dict(poly=P, fill=ROOF_COL if roofy else WALL_COL, outline=ROOF_OUT if roofy else WALL_OUT,
                              n=n, cull=not canopy, kind=z["kind"], base=("w", id(z)),
                              label=lab if zero else None, grp=grp if zero else None))
            if zero:
                continue
            top = [tuple(a_ + nn * d for a_, nn in zip(q, n)) for q in P]
            edge = mix((255, 255, 255), PRESS_COL if z["cpe"] > 0 else SUCT_COL, 0.85)
            faces.append(dict(poly=top, fill=col, outline=edge, n=n, cull=True, label=lab, grp=grp, prio=0,
                              alpha=SNOW_ALPHA, on=("w", id(z)), value=z["we"], kind=z["kind"]))
            slabs.append((P, top, n, d, col, edge, z))
        # layer side walls: each zone is a separate layer closed by side walls (also at corners, eaves
        # and ridge – no slanted walls or closing triangles); boundary between zones of the same surface – thickness
        # step facing the thinner layer
        keyf = lambda p: (round(p[0], 4), round(p[1], 4), round(p[2], 4))
        same = lambda n1, n2: sum(x_ * y_ for x_, y_ in zip(n1, n2)) > 0.999
        edges, closing = {}, {}
        for i, sl in enumerate(slabs):
            P = sl[0]
            for j in range(len(P)):
                j1 = (j + 1) % len(P)
                edges.setdefault(frozenset((keyf(P[j]), keyf(P[j1]))), []).append((i, j, j1))
        for k, lst in edges.items():
            if len(lst) >= 2:
                (i1, a1, b1), (i2, a2, b2) = lst[0], lst[1]
                if same(slabs[i1][2], slabs[i2][2]):            # same surface – thickness step
                    if abs(slabs[i1][3] - slabs[i2][3]) < 1e-9:
                        continue
                    hi, lo = (i1, i2) if slabs[i1][3] > slabs[i2][3] else (i2, i1)
                    ia, ib = (a1, b1) if hi == i1 else (a2, b2)
                    la, lb = (a2, b2) if hi == i1 else (a1, b1)
                    Ph, th, Pl, tl = slabs[hi][0], slabs[hi][1], slabs[lo][0], slabs[lo][1]
                    ta = next(tl[q] for q in (la, lb) if keyf(Pl[q]) == keyf(Ph[ia]))
                    tb = next(tl[q] for q in (la, lb) if keyf(Pl[q]) == keyf(Ph[ib]))
                    self._wind_side(faces, [th[ia], th[ib], tb, ta], centroid(th), slabs[hi])   # step facing the thinner layer
                    continue
            for i, ja, jb in lst:                           # outer edge / other surface – closing wall
                closing.setdefault(i, set()).add(ja)
        # closing walls of one zone along one straight edge – a single wall: the edge is split at the
        # neighbours' vertices only for matching shared edges, otherwise every split point would show as an
        # artificial line on the wall (e.g. where a roof zone boundary meets the eaves)
        for i, js in closing.items():
            P, top = slabs[i][0], slabs[i][1]
            npt = len(P)
            dirs = {}
            for j in js:
                e_ = tuple(b_ - a_ for a_, b_ in zip(P[j], P[(j + 1) % npt]))
                ln_ = math.sqrt(sum(c_ * c_ for c_ in e_))
                dirs[j] = tuple(c_ / ln_ for c_ in e_) if ln_ > 1e-12 else None
            cont = lambda j: (j in js and (j - 1) % npt in js and dirs[j] and dirs[(j - 1) % npt]
                              and sum(x_ * y_ for x_, y_ in zip(dirs[j], dirs[(j - 1) % npt])) > 1 - 1e-9)
            nw = unit(newell(P))
            for ja in sorted(js):
                if cont(ja):
                    continue                                # inside a run – drawn with the run's first edge
                k = ja
                while cont((k + 1) % npt) and (k + 1) % npt != ja:
                    k = (k + 1) % npt
                jb = (k + 1) % npt
                # zone interior on the left of the edge (relative to the Newell normal) – the centroid fails
                # for concave zones (e.g. gable wall of a troughed roof: wall flipped, see-through gap)
                e_ = tuple(b_ - a_ for a_, b_ in zip(P[ja], P[jb]))
                lft = (nw[1] * e_[2] - nw[2] * e_[1], nw[2] * e_[0] - nw[0] * e_[2], nw[0] * e_[1] - nw[1] * e_[0])
                mid = tuple((a_ + b_) / 2 for a_, b_ in zip(P[ja], P[jb]))
                inner = tuple(m_ + 0.01 * c_ for m_, c_ in zip(mid, lft))
                self._wind_side(faces, [P[ja], P[jb], top[jb], top[ja]], inner, slabs[i])
        for pt in w["points"]:
            texts.append((pt["pos"], f"{f2(pt['we'], 3, True)} kN/m²"))
        if g.kind == "dome":
            for P, n in g.shape.wall_facets():
                faces.append(dict(poly=P, fill=NEUTRAL_COL, outline=NEUTRAL_COL, n=n, cull=True))
        if isinstance(g.shape, Prism):
            for P, n in g.shape.vfaces():
                faces.append(dict(poly=P, fill=NEUTRAL_COL, outline="#6b7280", n=n, cull=False))
        if g.kind == "flat" and g.hp > 0:
            faces += parapet_faces(g.L, g.B, g.H, g.hp, col=NEUTRAL_COL, top="#c4c8ce", out="#6b7280")
        if canopy:
            pr = g.shape
            for x in (0.15, g.L - 0.15):
                for y in (0.15, g.B - 0.15):
                    lines.append(((x, y, 0), (x, y, pr.rz(x, y) - 0.05), "#6b7280", 4))
        return faces, texts, lines

    @staticmethod
    def _wind_side(faces, q, inner, slab):
        """Side wall of a wind load layer (normal pointing out of the layer)."""
        if poly_area(q) < 1e-12:
            return
        n = unit(newell(q))
        cq = centroid(q)
        if sum(a_ * (b_ - c_) for a_, b_, c_ in zip(n, cq, inner)) < 0:
            n = tuple(-a_ for a_ in n)
        faces.append(dict(poly=q, fill=slab[4], outline=slab[5], n=n, cull=True, prio=0, alpha=SNOW_ALPHA,
                          on=("w", id(slab[6]))))

    def scene_snow(self):
        g, s = self.sgeo, self.snow
        faces, texts, lines = [], [], []
        par = g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]
        for pr in [g.main] + ([g.upper] if g.upper else []):
            for key, P, n in pr.walls():
                faces.append(dict(poly=P, fill=WALL_COL, outline=WALL_OUT, n=n, cull=True))
            strips = pr.strips()
            if par and pr is g.main:   # roof inside a parapet – only within the parapet walls
                t, H_ = 0.25, g.H
                strips = [[(t, t, H_), (g.L - t, t, H_), (g.L - t, g.B - t, H_), (t, g.B - t, H_)]]
            for P in strips:           # roof slopes under the snow always drawn before it
                nu = unit(newell(P))
                nu = nu if nu[2] >= 0 else tuple(-c for c in nu)
                faces.append(dict(poly=P, fill=ROOF_COL, outline=ROOF_OUT, n=nu, cull=True, base=id(pr)))
        for so in g.solids:                        # annex, canopy, parapets and obstructions (Annex B)
            for P, n in so.walls:
                faces.append(dict(poly=P, fill=so.fill, outline=so.out, n=n, cull=True))
            for P in so.roofs:
                nu = unit(newell(P))
                nu = nu if nu[2] >= 0 else tuple(-c for c in nu)
                faces.append(dict(poly=P, fill=so.rfill, outline=so.rout, n=nu, cull=True, base=id(so)))
        if g.kind == "obst":
            hob, H, L, B = g.p["hob"], g.H, g.L, g.B
            if par:
                faces += parapet_faces(L, B, H, hob)
            else:
                yo, tw = g.p["yob"], 0.25
                for P, n in (([(0, yo, H), (L, yo, H), (L, yo, H + hob), (0, yo, H + hob)], (0, -1, 0)),
                             ([(L, yo + tw, H), (0, yo + tw, H), (0, yo + tw, H + hob), (L, yo + tw, H + hob)],
                              (0, 1, 0)),
                             ([(0, yo, H + hob), (L, yo, H + hob), (L, yo + tw, H + hob), (0, yo + tw, H + hob)],
                              (0, 0, 1)),
                             ([(0, yo + tw, H), (0, yo, H), (0, yo, H + hob), (0, yo + tw, H + hob)], (-1, 0, 0)),
                             ([(L, yo, H), (L, yo + tw, H), (L, yo + tw, H + hob), (L, yo, H + hob)], (1, 0, 0))):
                    faces.append(dict(poly=P, fill="#9ca3af", outline="#4b5563", n=n, cull=True))
        case = next((c for c in s["cases"] if c["name"] == self.snow_case.get()), s["cases"][0])
        extra = [] if case["acc"] else s["extra"]     # exceptional drift – the only snow (taller roof unloaded)
        mumax = max([c["mumax"] for c in s["cases"] if c["acc"] == case["acc"]] +
                    [m for pt in extra for m in pt["mu"]] + [1e-6])
        size = max(g.L, g.B + (g.upper.B if g.upper else 0), g.h_top)
        sc = 0.16 * size / mumax
        hob = g.p["hob"] if g.kind == "obst" else (g.p["dh"] if g.kind == "abut" else None)
        kh = 0.85
        if g.exc and g.kind in ("mono", "duo", "multi", "vault"):
            hs = [g.exc[k_] for k_, f_ in (("pah", "epar"), ("gah", "gpar"), ("poh", "pobst")) if g.exc.get(f_)]
            hob, kh = (min(hs), 0.6) if hs else (None, kh)
        if g.kind == "flat" and g.fobst:
            hob, kh = g.fobst.g["h"], 0.6
        if hob:                                    # snow layer clearly lower than the obstruction
            sc = min(sc, max(kh * hob, 0.04 * size) / mumax)
        sc *= self._load_scale()[1]                # zoomed in – thinner layers (constant thickness on the screen)
        patches = ([dict(pt, on=pt.get("on", id(g.main))) for pt in case["patches"]] +
                   [dict(pt, on=id(g.upper), xtra=True) for pt in extra])
        def clip4(pt, f, lo, hi):
            P4 = [(x, y, z, m_) for (x, y, z), m_ in zip(pt["poly"], pt["mu"])]
            P4 = clip_poly(P4, f, lo, hi)
            return dict(pt, poly=[q[:3] for q in P4], mu=[q[3] for q in P4]) if P4 else None
        if par:                                    # snow inside the parapet
            t = 0.25
            keep = [pt for pt in patches if pt["on"] != id(g.main)]
            patches = [pt for pt in patches if pt["on"] == id(g.main)]
            patches = [q for q in (clip4(pt, lambda q: q[0], t, g.L - t) for pt in patches) if q]
            patches = [q for q in (clip4(pt, lambda q: q[1], t, g.B - t) for pt in patches) if q] + keep
        if g.kind == "obst" and not par:           # snow does not enter the wall
            yo, tw = g.p["yob"], 0.25
            cut = []
            for pt in patches:
                if pt["on"] != id(g.main):
                    cut.append(pt)
                    continue
                for lo, hi in ((-1e9, yo), (yo + tw, 1e9)):
                    q = clip4(pt, lambda q: q[1], lo, hi)
                    if q and poly_area(q["poly"]) > 1e-9:
                        cut.append(q)
            patches = cut
        for x0, x1, y0, y1 in g.keepout:            # parapets and obstructions: snow only outside them
            cut = []
            for pt in patches:
                if pt["on"] != id(g.main):
                    cut.append(pt)
                    continue
                # 3 × 3 grid split around the rectangle (without the centre) – no patch crosses the obstruction
                # wall planes, so the drawing order of snow and obstruction is unambiguous
                parts = []
                for ya_, yb_ in ((-1e9, y0), (y0, y1), (y1, 1e9)):
                    band = clip4(pt, lambda q: q[1], ya_, yb_)
                    if not band:
                        continue
                    for xa_, xb_ in ((-1e9, x0), (x0, x1), (x1, 1e9)):
                        if (ya_, xa_) == (y0, x0):
                            continue
                        parts.append(clip4(band, lambda q: q[0], xa_, xb_))
                parts = [q for q in parts if q and poly_area(q["poly"]) > 1e-9]
                big = max(parts, key=lambda q: poly_area(q["poly"]), default=None)
                cut += [dict(q, label=pt.get("label") if q is big else None) for q in parts]
            patches = cut
        patches = tjunction_fix(patches)
        keyf = lambda p: (round(p[0], 4), round(p[1], 4), round(p[2], 4))
        edges = {}                                 # edge → [(patch no., {point: top})]
        tops = []
        for ip, pt in enumerate(patches):
            P, mus = pt["poly"], pt["mu"]
            top = [(x, y, z + m * sc) for (x, y, z), m in zip(P, mus)]
            tops.append(top)
            for j in range(len(P)):
                j1 = (j + 1) % len(P)
                k = frozenset((keyf(P[j]), keyf(P[j1])))
                edges.setdefault(k, []).append((ip, {keyf(P[j]): top[j], keyf(P[j1]): top[j1]}))
        self._snow_ztop = max([p_[2] for ip, t_ in enumerate(tops) if patches[ip]["on"] == id(g.main)
                               for p_ in t_] + [g.main.h_top])
        tnorm = []
        for t_ in tops:
            n_ = unit(newell(t_))
            tnorm.append(n_ if n_[2] >= 0 else tuple(-v for v in n_))
        for ip, pt in enumerate(patches):
            P, mus, top = pt["poly"], pt["mu"], tops[ip]
            if max(mus) <= 1e-9:
                continue
            lab = None
            if pt.get("label"):
                m0, m1 = pt["seg"]
                cb = s["base"] if pt.get("xtra") else case["base"]
                if abs(m0 - m1) < 1e-9:
                    lab = f"{f2(m0 * cb, 2)} kN/m²"
                else:
                    lab = f"{f2(m0 * cb, 2)} → {f2(m1 * cb, 2)} kN/m²"
            mask = []                              # outline: outer edge, step or surface break
            for j in range(len(P)):
                lst = edges[frozenset((keyf(P[j]), keyf(P[(j + 1) % len(P)])))]
                if len(lst) < 2:
                    mask.append(True)
                    continue
                (i1, t1), (i2, t2) = lst[0], lst[1]
                other = i2 if i1 == ip else i1
                ka_, kb_ = keyf(P[j]), keyf(P[(j + 1) % len(P)])
                step = abs(t1[ka_][2] - t2[ka_][2]) > 1e-6 or abs(t1[kb_][2] - t2[kb_][2]) > 1e-6
                crease = sum(a_ * b_ for a_, b_ in zip(tnorm[ip], tnorm[other])) < math.cos(math.radians(0.5))
                mask.append(step or crease)
            faces.append(dict(poly=top, fill="#eef6ff", outline="#5b8fc7", n=tnorm[ip], cull=True, label=lab,
                              on=pt["on"], prio=0, alpha=SNOW_ALPHA, edges=mask))
        pcs = [centroid(pt["poly"]) for pt in patches]

        # outer edges: at a vertex where two of them are collinear the vertical edge of the side wall
        # is not outlined (a wall made of several patches looks like one)
        vdirs = {}
        for k, lst in edges.items():
            if len(lst) == 1 and len(k) == 2:
                ka, kb = list(k)
                dx, dy = kb[0] - ka[0], kb[1] - ka[1]
                ln = math.hypot(dx, dy)
                if ln > 1e-9:
                    for v_ in (ka, kb):
                        vdirs.setdefault(v_, []).append((dx / ln, dy / ln))

        def on_keepout(pa, pb, e_=1e-6):
            for x0, x1, y0, y1 in g.keepout:
                for c_, v_ in ((0, x0), (0, x1), (1, y0), (1, y1)):
                    if abs(pa[c_] - v_) < e_ and abs(pb[c_] - v_) < e_:
                        o_ = 1 - c_
                        lo_, hi_ = (y0, y1) if o_ == 1 else (x0, x1)
                        if lo_ - e_ <= pa[o_] <= hi_ + e_ and lo_ - e_ <= pb[o_] <= hi_ + e_:
                            return True
            return False

        vtop = {}                                  # snow top heights at a vertex (different – thickness step)
        for k, lst in edges.items():
            for _ip, tp in lst:
                for v_ in k:
                    if v_ in tp:
                        vtop.setdefault(v_, set()).add(round(tp[v_][2], 5))

        def smooth(v_):
            d = vdirs.get(v_, [])
            return (len(d) == 2 and abs(d[0][0] * d[1][1] - d[0][1] * d[1][0]) < 1e-6
                    and len(vtop.get(v_, ())) <= 1)          # at a thickness step the vertical edge stays

        def side_face(q, toward, on=None, mask=None):
            if poly_area(q) < 1e-9:
                return
            n = unit(newell(q))
            cq = centroid(q)
            if sum(a_ * (b_ - d_) for a_, b_, d_ in zip(n, toward, cq)) < 0:
                n = tuple(-a_ for a_ in n)
            faces.append(dict(poly=q, fill="#d6e7fa", outline="#5b8fc7", n=n, cull=True, prio=0, on=on,
                              alpha=SNOW_ALPHA, edges=mask))
        for k, lst in edges.items():
            ka, kb = list(k) if len(k) == 2 else (next(iter(k)),) * 2
            if len(lst) == 1:                      # outer edge: snow side wall
                ip, tp = lst[0]
                P = patches[ip]["poly"]
                pa = next(p for p in P if keyf(p) == ka)
                pb = next(p for p in P if keyf(p) == kb)
                # the wall at a parapet / obstruction is drawn too: seen from above its upper part may show above
                # the parapet (pitched roof at the eaves) – without it the roof slope showed through
                c = pcs[ip]
                out = (2 * (pa[0] + pb[0]) / 2 - c[0], 2 * (pa[1] + pb[1]) / 2 - c[1], (pa[2] + pb[2]) / 2)
                side_face([pa, pb, tp[kb], tp[ka]], out, patches[ip]["on"],
                          [True, not smooth(kb), True, not smooth(ka)])
            else:                                  # boundary of two patches: step where the thickness differs
                (i1, t1), (i2, t2) = lst[0], lst[1]
                da, db = t1[ka][2] - t2[ka][2], t1[kb][2] - t2[kb][2]
                if abs(da) < 1e-6 and abs(db) < 1e-6:
                    continue
                low = pcs[i2] if (da + db) > 0 else pcs[i1]
                side_face([t1[ka], t1[kb], t2[kb], t2[ka]], low, patches[i1]["on"])
        return faces, texts, lines

    def _draw3d_now(self):
        cv = self.cv
        ctx = self._ctx                                  # drawing a saved case (main window / printout)
        if cv is None or (not ctx and not self.win3d.isVisible()):
            return
        cv.delete("all")
        W, Hc = cv.winfo_width(), cv.winfo_height()
        if W < 50:
            return
        if not ctx and self.nb.currentIndex() == TAB_USE:   # Użytkowe tab – no 3D model
            self.close_editor()
            if self.win3d is not None:
                self.win3d.setWindowTitle("Model 3D" + self.edit_suffix())
            if getattr(self, "tb_box", None) is not None:
                self.tb_box.setVisible(False)
            cv.create_text(W / 2, Hc / 2, text="Brak modelu 3D dla tego przypadku", font=(FONT, 13, "bold"),
                           fill=MUTED)
            cv.update()
            return
        mode = self.mode3d.get()
        if (self.wgeo if mode == "wiatr" else self.sgeo) is None:
            return
        if not ctx:
            if getattr(self, "tb_box", None) is not None and not self.tb_box.isVisible():
                self.tb_box.setVisible(True)
            self.update_toolbar(mode)
            self._title3d()
            self.close_editor()
        self._edit_keys = {}
        key = (mode, getattr(self, "_scene_ver", 0), self.snow_case.get() if mode != "wiatr" else None,
               self._load_scale()[0])
        if getattr(self, "_scene_key", None) == key:          # rotation / pan only – geometry unchanged
            faces, texts, lines, self._snow_ztop = self._scene_cache
        else:
            faces, texts, lines = self.scene_wind() if mode == "wiatr" else self.scene_snow()
            self._scene_key = key
            self._scene_cache = (faces, texts, lines, getattr(self, "_snow_ztop", 0.0))
        g = self.wgeo if mode == "wiatr" else self.sgeo
        # view framing from the building only (load layers change with the zoom – the view must not jump)
        allp = [p for f_ in faces if "alpha" not in f_ for p in f_["poly"]] or [p for f_ in faces for p in f_["poly"]]
        xs, ys, zs = [p[0] for p in allp], [p[1] for p in allp], [p[2] for p in allp]
        x0, x1, y0, y1, z1 = min(xs), max(xs), min(ys), max(ys), max(zs)
        size = max(x1 - x0, y1 - y0, z1, 1e-3)
        ctr = ((x0 + x1) / 2, (y0 + y1) / 2, z1 / 2)
        piv = getattr(self, "piv", None)
        if piv:                                    # rotation point chosen by the user (point in the screen centre)
            ctr = tuple(float(c) for c in piv)
        terr = self._oro_terrain(g) if mode == "wiatr" else None     # orography – terrain under the building
        # the framing never depends on the terrain: the position and magnification of the model stay the same
        # when the orography is switched on (the terrain is only drawn around the building, cropped by the view)
        self._view_k = 1.0
        zmin = ZOOM_MIN                            # with a terrain the zoom-out reaches the whole terrain
        if terr:
            tp = terr["pts"] + allp
            full = max(max(p[i] for p in tp) - min(p[i] for p in tp) for i in range(3))
            zmin = max(min(ZOOM_MIN, 2.3 * size / (1.4 * full)), 0.01)
        try:
            cv._zmin = zmin
        except Exception:
            pass
        sc = self.zoom * min(W, Hc) / (2.3 * size)
        cy, sy = math.cos(self.yaw), math.sin(self.yaw)
        cp, sp = math.cos(self.pitch), math.sin(self.pitch)
        ox, oy = W / 2 + self.pan_x, Hc / 2 + self.pan_y
        cv._proj = (ctr, sc, cy, sy, cp, sp, ox, oy, W, Hc)
        cv._proj_faces = [f_["poly"] for f_ in faces if "alpha" not in f_]

        def P(p):
            x, y, z = p[0] - ctr[0], p[1] - ctr[1], p[2] - ctr[2]
            xr, yr = x * cy - y * sy, x * sy + y * cy
            return (ox + xr * sc, oy - (z * cp + yr * sp) * sc, yr * cp - z * sp)

        def facing(n):
            return (n[0] * sy + n[1] * cy) * cp - n[2] * sp < -1e-6

        bctr = ((x0 + x1) / 2, (y0 + y1) / 2, min(zs) + (z1 - min(zs)) * 0.35)

        def outward(poly):
            n = unit(newell(poly))
            c = centroid(poly)
            if sum(a * (b - d) for a, b, d in zip(n, c, bctr)) < 0:
                n = tuple(-a for a in n)
            return n

        # ground
        m = (0.8 if mode == "wiatr" else 0.5) * size
        gr = [(x0 - m, y0 - m, 0), (x1 + m, y0 - m, 0), (x1 + m, y1 + m, 0), (x0 - m, y1 + m, 0)]
        cv._proj_ground = (x0 - m, x1 + m, y0 - m, y1 + m)
        # VTK (the graphics card) draws the ground / terrain and the faces; everything after is painted over it
        sc3 = dict(polys=[], edges=[], flat=[], proj=cv._proj, bg=Canvas3D.BG_COL) if VtkScene.get() else None
        if sc3 is not None:
            cv.create_scene3d(sc3)
        if terr and sc3 is not None:
            for q in terr["quads"]:
                sc3["polys"].append((q["poly"], q["fill"], None, True))
                if q.get("outline"):
                    Q = q["poly"]
                    sc3["edges"].extend((Q[i], Q[(i + 1) % len(Q)], q["outline"], 1) for i in range(len(Q)))
            for e in terr["edges"]:
                sc3["edges"].extend((e[i], e[i + 1], "#7c8470", 1.5) for i in range(len(e) - 1))
            items_ = sorted(((sum(P(p)[2] for p in q["poly"]) / 4, q) for q in terr["quads"]), key=lambda x: -x[0])
            sc3["flat"].extend(([P(p)[:2] for p in q["poly"]], q["fill"], q["outline"], None, None, 1)
                               for _, q in items_)
        elif terr:
            self._draw_terrain(cv, P, terr)
        else:
            if sc3 is not None:
                sc3["polys"].append((gr, "#eef0ec", None, False))                 # flat ground: unlit
                sc3["edges"].extend((gr[i], gr[(i + 1) % 4], "#d4d8d0", 1) for i in range(4))
                sc3["flat"].append(([P(p)[:2] for p in gr], "#eef0ec", "#d4d8d0", None, None, 1))
            else:
                cv.create_polygon(*[c for p in gr for c in P(p)[:2]], fill="#eef0ec", outline="#d4d8d0")
            step = 10 ** math.floor(math.log10(size / 2 if size > 2 else 1))
            grid = []
            k = math.ceil((x0 - m) / step)
            while k * step <= x1 + m:
                grid.append(((k * step, y0 - m, 0), (k * step, y1 + m, 0)))
                k += 1
            k = math.ceil((y0 - m) / step)
            while k * step <= y1 + m:
                grid.append(((x0 - m, k * step, 0), (x1 + m, k * step, 0)))
                k += 1
            for a3, b3 in grid:
                if sc3 is not None:
                    sc3["edges"].append((a3, b3, "#e2e5df", 1))
                else:
                    a, b = P(a3), P(b3)
                    cv.create_line(a[0], a[1], b[0], b[1], fill="#e2e5df")
        fnt = (FONT, 9)
        self._placed = []                                # occupied label rectangles (labels, dimensions)
        self._defer_angles = None
        if mode == "wiatr":
            fr = wind_frame(g, self.wind["theta"])
            p1 = fr["to_xy"](-0.95 * m, fr["b"] / 2)
            p2 = fr["to_xy"](-0.55 * m, fr["b"] / 2)
            if terr:                              # the arrow above the terrain (heights along the profile)
                pr_ = terr["prof"]
                zt = lambda sv: pr_["zf"](sv - fr["d"] / 2) if abs(sv - fr["d"] / 2) > pr_["padq"] else 0.0
                z1_, z2_ = zt(-0.95 * m) + 0.02, zt(-0.55 * m) + 0.02
            else:
                z1_ = z2_ = 0.02
            a, b = P((p1[0], p1[1], z1_)), P((p2[0], p2[1], z2_))
            cv.create_line(a[0], a[1], b[0], b[1], width=7, arrow="last", arrowshape=(18, 22, 8), fill="#b45309")
            # label beyond the arrow tail (on its extension), so the arrow does not cross it
            wtxt, wfnt = f"wiatr θ = {self.wind['theta']}°", (FONT, 10, "bold")
            tmp = cv.create_text(0, 0, text=wtxt, font=wfnt)
            bx = cv.bbox(tmp)
            cv.delete(tmp)
            tw, th = bx[2] - bx[0], bx[3] - bx[1]
            dx, dy = a[0] - b[0], a[1] - b[1]
            dl = math.hypot(dx, dy) or 1.0
            dx, dy = dx / dl, dy / dl
            r = abs(dx) * tw / 2 + abs(dy) * th / 2 + 6
            tx, ty = a[0] + dx * r, a[1] + dy * r
            cv.create_text(tx, ty, text=wtxt, font=wfnt, fill="#b45309")
            self._placed.append((tx - tw / 2 - 3, ty - th / 2 - 2, tx + tw / 2 + 3, ty + th / 2 + 2))
        for f_ in faces:
            if f_.get("n") is None:
                f_["n"] = outward(f_["poly"])
        drawn = []
        for f_ in faces:
            if f_.get("cull") and not facing(f_["n"]):
                continue
            pr = [P(p) for p in f_["poly"]]
            drawn.append((sum(p[2] for p in pr) / len(pr), f_, pr))
        drawn = depth_sort(drawn)
        for depth, f_, pr in drawn:
            if sc3 is None:
                cv.create_polygon(*[c for p in pr for c in p[:2]], fill=f_["fill"], outline=f_["outline"], width=1,
                                  alpha=f_.get("alpha"), edges=f_.get("edges"))
                continue
            Q = f_["poly"]
            sc3["polys"].append((Q, f_["fill"], f_.get("alpha"), True))
            if f_.get("outline"):
                ed = f_.get("edges") or [True] * len(Q)
                sc3["edges"].extend((Q[i], Q[(i + 1) % len(Q)], f_["outline"], 1)
                                    for i, on in enumerate(ed) if on)
            sc3["flat"].append(([p[:2] for p in pr], f_["fill"], f_["outline"], f_.get("alpha"), f_.get("edges"), 1))
        for a3, b3, col, wdt in lines:
            a, b = P(a3), P(b3)
            cv.create_line(a[0], a[1], b[0], b[1], fill=col, width=wdt)
        # one arrow and one label per zone (largest visible part)
        best = {}
        for depth, f_, pr in drawn:
            gk = f_.get("grp")
            if gk is None:
                continue
            ar = poly_area([(p[0], p[1]) for p in pr])
            if gk not in best or ar > best[gk][0]:
                best[gk] = (ar, id(f_))
        rep = {v[1] for v in best.values()}
        is_rep = lambda f_: f_.get("grp") is None or id(f_) in rep
        if False:                                    # arrows replaced by the load layer (scene_wind)
            vals = [abs(f_["value"]) for _, f_, _ in drawn if f_.get("value") is not None]
            wmax = max(vals + [1e-9])
            # one arrow per zone: at the geometric centre of the zone, length ∝ |we|
            groups = {}
            for f_ in faces:
                if f_.get("value") is None:
                    continue
                gk = f_.get("grp") or ("single", id(f_))
                groups.setdefault(gk, []).append(f_)
            visible = {f_.get("grp") or ("single", id(f_)) for _, f_, _ in drawn}
            for gk, fl in groups.items():
                v = fl[0]["value"]
                if gk not in visible or abs(v) < 1e-9 or not all(f_.get("arr", True) for f_ in fl):
                    continue
                A = gx = gy = gz = 0.0
                nx_ = ny_ = nz_ = 0.0
                for f_ in fl:
                    ar = poly_area(f_["poly"])
                    c = area_centroid(f_["poly"])
                    A += ar
                    gx += c[0] * ar
                    gy += c[1] * ar
                    gz += c[2] * ar
                    n = f_["n"]
                    if f_.get("kind") == "canopy" and n[2] < 0:
                        n = tuple(-a_ for a_ in n)
                    nx_ += n[0] * ar
                    ny_ += n[1] * ar
                    nz_ += n[2] * ar
                if A <= 0:
                    continue
                c = (gx / A, gy / A, gz / A)
                if fl[0].get("kind") in ("roof", "canopy") and len(fl) > 1:
                    c = (c[0], c[1], g.rz(c[0], c[1]))          # zone centre lies on the roof slope
                if fl[0].get("anchor"):
                    c = fl[0]["anchor"]                          # concave zone – a point inside the zone
                n = unit((nx_, ny_, nz_))
                ln = 0.20 * size * abs(v) / wmax
                tip = tuple(ci + ni * ln for ci, ni in zip(c, n))
                a_, b_ = (P(tip), P(c)) if v > 0 else (P(c), P(tip))
                cv.create_line(a_[0], a_[1], b_[0], b_[1], arrow="last", width=2.5,
                               fill="#991b1b" if v > 0 else "#1e40af", arrowshape=(11, 13, 5))
        # dimensions before labels: dimension texts stay on the dimension lines, load labels avoid them;
        # angle texts last – they avoid the labels (as before)
        self._defer_angles = []
        self._dim_used = set()                   # sides with blue dimensions on the ground: ("x"/"y", ±1)
        try:
            if mode == "śnieg" and self.dims3d.get():
                self.draw_snow_dims(cv, g, P, facing, size)
            if mode == "wiatr" and self.dims3d.get():
                self.draw_dims(cv, g, P, facing, size)
            if terr and self.odims3d.get():
                self._oro_dims(cv, P, facing, terr)
            if self.bdims3d.get():
                self.draw_bdims(cv, mode, g, P, facing, size)
        finally:
            angles, self._defer_angles = self._defer_angles, None
        if self.labels3d.get():
            for pos, txt in texts:
                c = P(pos)
                self._label(cv, c[0], c[1] - 16, txt, outline="#111827", dodge=True)
            cand = []
            for depth, f_, pr in drawn:
                if not f_.get("label") or not is_rep(f_):
                    continue
                ar = poly_area([(p[0], p[1]) for p in pr])
                if ar >= (450 if mode == "wiatr" else 250):
                    cand.append((ar, f_, pr))
            for ar, f_, pr in sorted(cand, key=lambda x: -x[0]):
                c = P(f_.get("anchor") or centroid(f_["poly"]))
                self._label(cv, c[0], c[1], f_["label"], dodge=True, poly=[(p[0], p[1]) for p in pr])
        for args in angles:
            self._angle_label(*args)
        if mode == "śnieg" and self.snow["overhang"]:
            self.draw_overhang(cv, g, P, facing, self.snow["overhang"], size)
        if hasattr(cv, "raise_tagged"):
            cv.raise_tagged("plaque")                 # dimension / load plaques above everything else (they mask it)
        self.draw_legend(cv, mode, g, Hc, fnt)
        if terr:
            cv.create_text(14, 14, anchor="nw", font=(FONT, 9, "bold"), fill=MUTED, text="orografia w realnej skali")
        if not getattr(self, "_w_ok" if mode == "wiatr" else "_s_ok", True):
            cv.create_text(12, 10, anchor="nw", fill="#b91c1c", font=(FONT, 9, "bold"),
                           text="⚠ Błędne dane budynku – pokazano ostatni poprawny model")
        if ctx == "img":
            return
        card_view = ctx == "view" and not (isinstance(cv, CaseCanvas) and cv.is_active())
        cv.create_text(W - 10, Hc - 8, anchor="se", justify="right", fill="#8a929c", font=(FONT, 8),
                       text=("Kliknij podgląd, aby powiększać kółkiem i gestami\n" if card_view else "")
                       + "Lewy przycisk – obrót\nŚrodkowy (lub Shift + lewy) – przesuwanie\n"
                         "Kółko – powiększenie\nPanel dotykowy: dwa palce – przesuwanie, "
                         "rozsunięcie – powiększenie\nKliknięcie wymiaru – zmiana")

    def _label(self, cv, x, y, text, outline="", dodge=False, poly=None):
        """Label with a background. When it overlaps a text drawn earlier: with dodge=True moved to the nearest
        free place (first inside the poly zone, then right next to it – with a leader line), otherwise skipped."""
        fnt = (FONT, 8, "bold")
        tmp = cv.create_text(0, 0, text=text, font=fnt, justify="center")
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        hw, hh = (bx[2] - bx[0]) / 2 + 3, (bx[3] - bx[1]) / 2 + 2
        placed = getattr(self, "_placed", [])
        free = lambda cx, cy: not any(cx - hw < o[2] and o[0] < cx + hw and cy - hh < o[3] and o[1] < cy + hh
                                      for o in placed)
        W, Hc = cv.winfo_width(), cv.winfo_height()
        on_cv = lambda cx, cy: hw <= cx <= W - hw and hh <= cy <= Hc - hh
        pos, leader = ((x, y), False) if free(x, y) else (None, False)
        if pos is None and dodge:
            near = None
            for r in range(4, 124, 4):
                for k in range(24):
                    t = math.radians(-90 + 15 * k)
                    cx, cy = x + r * math.cos(t), y + r * math.sin(t)
                    if not (on_cv(cx, cy) and free(cx, cy)):
                        continue
                    if poly is not None and _pip(cx, cy, poly):
                        pos = (cx, cy)
                        break
                    if near is None and r <= 48:
                        near = (cx, cy)
                if pos is not None:
                    break
            if pos is None and near is not None:
                pos, leader = near, True
            elif pos is not None and poly is None:
                leader = math.hypot(pos[0] - x, pos[1] - y) > 12
        if pos is None:
            return False
        cx, cy = pos
        self._placed = placed + [(cx - hw, cy - hh, cx + hw, cy + hh)]
        if leader:                                     # leader line from the label anchor to the text
            cv.create_line(x, y, cx, cy, fill="#4b5563", width=1)
            cv.create_oval(x - 2, y - 2, x + 2, y + 2, fill="#4b5563", outline="")
        tid = cv.create_text(cx, cy, text=text, font=fnt, fill="#111827", justify="center")
        bx = cv.bbox(tid)
        rid = cv.create_rectangle(bx[0] - 2, bx[1] - 1, bx[2] + 2, bx[3] + 1, fill="#ffffff", outline=outline,
                                  stipple="" if outline else "gray75")
        cv.tag_raise(tid, rid)
        for it in (rid, tid):
            cv.addtag_withtag("plaque", it)
        return True

    def draw_legend(self, cv, mode, g, Hc, fnt):
        """Legend of the currently visible symbols only."""
        items = []                       # (kind, colour, description)
        if mode == "wiatr":
            can = g.kind in ("can1", "can2")
            items.append(("box", mix((255, 255, 255), PRESS_COL, 0.6),
                          "parcie (+) [kN/m²] – ku dołowi" if can else "parcie (+) [kN/m²]"))
            items.append(("box", mix((255, 255, 255), SUCT_COL, 0.6),
                          "ssanie (−) [kN/m²] – ku górze" if can else "ssanie (−) [kN/m²]"))
            if self.dims3d.get() and g.kind != "dome":
                items.append(("line", DIM_COL, "wymiary pól (w rzucie poziomym)"))
        else:
            items.append(("box", "#f0f7ff", "obciążenie śniegiem dachu [kN/m²]"))
            if self.snow["overhang"]:
                items.append(("line", OVH_COL, "nawis śnieżny [kN/m] – dodatkowe obciążenie liniowe na krawędzi okapu"))
            if self.dims3d.get():
                items.append(("line", SDIM_COL, "wymiary pól obciążenia"))
        if mode == "wiatr" and self.odims3d.get() and (self.wind.get("info") or {}).get("oro"):
            items.append(("line", ORO_COL, "wymiary orografii" if self._ctx == "img" else "wymiary orografii (kliknij, aby zmienić)"))
        if self.bdims3d.get():
            items.append(("line", BDIM_COL, "wymiary budynku" if self._ctx == "img"       # printout – no clicking
                          else "wymiary budynku (kliknij, aby zmienić)"))
        y = Hc - 14 - 20 * len(items)
        for kind, col, txt in items:
            if kind == "box":
                cv.create_rectangle(14, y + 1, 30, y + 15, fill=col, outline="#4b5563")
            elif kind == "arrow":
                cv.create_line(14, y + 8, 30, y + 8, fill=col, width=2, arrow="last", arrowshape=(7, 8, 3))
            else:
                cv.create_line(14, y + 8, 30, y + 8, fill=col, width=3)
            cv.create_text(38, y + 8, text=txt, anchor="w", font=fnt, fill=TEXT)
            y += 20

    def draw_overhang(self, cv, g, P, facing, ov, size):
        L, B, H = g.L, g.B, g.H
        segs = g.main.segs()
        a0, a1 = Prism.seg_angle(segs[0]), Prism.seg_angle(segs[-1])
        per = {o["edge"]: o for o in ov["per"]}
        edges = []
        if "all" in per:
            o = per["all"]
            edges = [((0, 0, H), (L, 0, H), (0, -1, 0), (0, 0, 1), o), ((L, B, H), (0, B, H), (0, 1, 0), (0, 0, 1), o),
                     ((0, B, H), (0, 0, H), (-1, 0, 0), (0, 0, 1), o), ((L, 0, H), (L, B, H), (1, 0, 0), (0, 0, 1), o)]
        if "y0" in per:
            sa, ca = math.sin(math.radians(a0)), math.cos(math.radians(a0))
            edges.append(((0, 0, H), (L, 0, H), (0, -1, 0), (0, -sa, ca), per["y0"]))
        if "yB" in per:
            sa, ca = math.sin(math.radians(a1)), math.cos(math.radians(a1))
            edges.append(((L, B, H), (0, B, H), (0, 1, 0), (0, sa, ca), per["yB"]))
        hgt, off = 0.10 * size, 0.015 * size
        labelled = set()
        for p0, p1, wn, rn, oe in edges:
            if not (facing(wn) or facing(rn)):
                continue
            n = max(4, int(round(math.dist(p0, p1) / size * 12)))
            tails = []
            for i in range(n + 1):
                t = i / n
                x = p0[0] + (p1[0] - p0[0]) * t + wn[0] * off
                y = p0[1] + (p1[1] - p0[1]) * t + wn[1] * off
                a, b = P((x, y, p0[2] + hgt)), P((x, y, p0[2]))
                cv.create_line(a[0], a[1], b[0], b[1], arrow="last", width=2, fill=OVH_COL, arrowshape=(7, 9, 3))
                tails.append(a)
            cv.create_line(*[c for p in tails for c in p[:2]], fill=OVH_COL, width=3)
            if id(oe) not in labelled:
                labelled.add(id(oe))
                m_ = tails[len(tails) // 2]
                tid = cv.create_text(m_[0], m_[1] - 10, text=f"sₑ = {f2(oe['se'], 3)} kN/m",
                                     font=(FONT, 9, "bold"), fill=OVH_COL)
                bx = cv.bbox(tid)
                rid = cv.create_rectangle(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1, fill="#ffffff", outline=OVH_COL)
                cv.tag_raise(tid, rid)

    def _chain(self, cv, P, path, segs, off, lab_off, col):
        """Dimension chain: path(u) → 3D point, segs = [(u0, u1, text[, field key])].
        A dimension with a key can be clicked and changed."""
        fnt = (FONT, 8, "bold")
        for u in sorted({v for s_ in segs for v in s_[:2]}):
            p = path(u)
            a, c = P(p), P(tuple(x + o for x, o in zip(p, off)))
            cv.create_line(a[0], a[1], c[0], c[1], fill=col, dash=(2, 2))
            cv.create_oval(c[0] - 2.5, c[1] - 2.5, c[0] + 2.5, c[1] + 2.5, fill=col, outline="")
        for sg_ in segs:
            u0, u1, nm = sg_[:3]
            key = sg_[3] if len(sg_) > 3 else None
            if u1 - u0 < 1e-6:
                continue
            pts = [P(tuple(x + o for x, o in zip(path(u0 + (u1 - u0) * i / 12), off))) for i in range(13)]
            cv.create_line(*[c for p in pts for c in p[:2]], fill=col, width=1.5)
            lp = P(tuple(x + o + lo for x, o, lo in zip(path((u0 + u1) / 2), off, lab_off)))
            self._dim_box(cv, lp[0], lp[1], f"{f2(u1 - u0)} m", col, "#ffffff", key)

    def _dchain(self, cv, P, path, lpt, segs, lab_off, col, via=None, lab_t=0.5):
        """Dimension chain: path(u) – base point, lpt(u) – point on the dimension line; the extension line
        runs from the base point (through via(u), if given) to the dimension line.
        segs = [(u0, u1, text[, field key])]; dimension = u1 − u0. The text offset lab_off (model units) scales
        with the zoom like the load layers and the dimension offsets (the text stays at its line)."""
        f_ = self._dim_scale()
        lab_off = tuple(o * f_ for o in lab_off)
        for u in sorted({v for s_ in segs for v in s_[:2]}):
            pts = [P(path(u))] + ([P(via(u))] if via is not None and via(u) is not None else []) + [P(lpt(u))]
            a, c = pts[0], pts[-1]
            if sum(abs(p_[0] - q_[0]) + abs(p_[1] - q_[1]) for p_, q_ in zip(pts, pts[1:])) > 0.5:
                cv.create_line(*[v for p_ in pts for v in p_[:2]], fill=col, dash=(2, 2))
            cv.create_oval(c[0] - 2.5, c[1] - 2.5, c[0] + 2.5, c[1] + 2.5, fill=col, outline="")
        seen = set()
        for sg_ in segs:
            u0, u1, nm = sg_[:3]
            k_ = (round(u0, 6), round(u1, 6))
            if u1 - u0 < 1e-6 or k_ in seen:
                continue
            seen.add(k_)
            a, b = P(lpt(u0)), P(lpt(u1))
            cv.create_line(a[0], a[1], b[0], b[1], fill=col, width=1.5)
            key = sg_[3] if len(sg_) > 3 else None
            txt = nm[1:] if isinstance(nm, str) and nm.startswith("=") else f"{f2(u1 - u0)} m"   # "=text" – given
            lab_at = lambda t: P(tuple(x + o for x, o in zip(lpt(u0 + (u1 - u0) * t), lab_off)))
            lp = lab_at(lab_t)
            if self._box_busy(cv, lp[0], lp[1], txt):        # text spot taken – shift along the dimension line
                cands = [lab_at(lab_t + dt) for dt in (0.12, -0.12, 0.24, -0.24, 0.36, -0.36)
                         if 0.1 <= lab_t + dt <= 0.9]
                # short segments (e.g. zones at the top of a multispan roof) – texts stepped outwards
                um = (u0 + u1) / 2
                pb, pl = P(path(um)), P(lpt(um))
                ox, oy = pl[0] - pb[0], pl[1] - pb[1]
                if math.hypot(ox, oy) < 1.0:                    # no offset – perpendicular to the line, upwards
                    ox, oy = -(b[1] - a[1]), b[0] - a[0]
                    if oy > 0:
                        ox, oy = -ox, -oy
                ol = math.hypot(ox, oy) or 1.0
                ox, oy = ox / ol, oy / ol
                tmp = cv.create_text(0, 0, text=txt, font=(FONT, 8, "bold"))
                bx = cv.bbox(tmp)
                cv.delete(tmp)
                step = abs(ox) * (bx[2] - bx[0] + 8) + abs(oy) * (bx[3] - bx[1] + 4)
                cands += [(lp[0] + ox * step * k, lp[1] + oy * step * k) for k in (1, 2, 3)]
                for q in cands:
                    if not self._box_busy(cv, q[0], q[1], txt):
                        if q in cands[-3:]:                     # offset text – tick to the dimension line
                            cv.create_line(lp[0], lp[1], q[0], q[1], fill=col, dash=(1, 2))
                        lp = q
                        break
            self._dim_box(cv, lp[0], lp[1], txt, col, "#ffffff" if col != BDIM_COL else "#fff7ed", key)

    def _box_busy(self, cv, x, y, text):
        """Whether the dimension text at point (x, y) overlaps a text placed earlier."""
        tmp = cv.create_text(x, y, text=text, font=(FONT, 8, "bold"))
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        b = (bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1)
        return any(b[0] < o[2] and o[0] < b[2] and b[1] < o[3] and o[1] < b[3] for o in getattr(self, "_placed", []))

    def _dim_box(self, cv, x, y, text, col, bg, key):
        tid = cv.create_text(x, y, text=text, font=(FONT, 8, "bold"), fill=col)
        bx = cv.bbox(tid)
        rid = cv.create_rectangle(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1, fill=bg, outline=col,
                                  dash=() if key else (2, 2))
        self._placed = getattr(self, "_placed", []) + [(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1)]
        cv.tag_raise(tid, rid)
        for it in (rid, tid):                           # plaques stay above all other drawing
            cv.addtag_withtag("plaque", it)
        if key:
            tag = f"edit{len(self._edit_keys)}"
            self._edit_keys[tag] = (key, (x, y))
            for it in (tid, rid):
                cv.addtag_withtag(tag, it)
                cv.addtag_withtag("editable", it)

    def _angle_label(self, cv, P, pos, text, key=None):
        """Angle text; when it overlaps a load label (or another angle text) – moved
        to the nearest free place (no leader line)."""
        if getattr(self, "_defer_angles", None) is not None:      # drawn after the load labels
            self._defer_angles.append((cv, P, pos, text, key))
            return
        c = P(pos)
        tmp = cv.create_text(0, 0, text=text, font=(FONT, 8, "bold"))
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        hw, hh = (bx[2] - bx[0]) / 2 + 4, (bx[3] - bx[1]) / 2 + 2
        placed = getattr(self, "_placed", [])
        hit = lambda x, y: any(x - hw < o[2] and o[0] < x + hw and y - hh < o[3] and o[1] < y + hh for o in placed)
        x, y = c[0], c[1]
        if hit(x, y):
            done = False
            for r in range(6, 240, 4):
                for k in range(24):
                    t = math.radians(-90 + 15 * k)
                    xx, yy = c[0] + r * math.cos(t), c[1] + r * math.sin(t)
                    if not hit(xx, yy):
                        x, y, done = xx, yy, True
                        break
                if done:
                    break
        self._placed = placed + [(x - hw, y - hh, x + hw, y + hh)]
        self._dim_box(cv, x, y, text, BDIM_COL, "#fff7ed", key)

    def draw_bdims(self, cv, mode, g, P, facing, size):
        """Building dimensions (clickable). Horizontal – on the ground, vertical – in the plane of the gable wall, on the far
        side of the building (they do not hide it). Order from the building: blue zone dimensions, partial building
        dimensions, overall ones – each line on the first free level (module N = DIM_STEP · model size); a side
        without blue dimensions – building dimensions closer. Extension lines always reach the base points."""
        col = BDIM_COL
        snow = mode == "śnieg"
        pf = "s_" if snow else "w_"
        z0_ = (0, 0, 0)
        N = DIM_STEP * size * self._dim_scale()
        used = getattr(self, "_dim_used", set())
        first = lambda side: 2 if side in used else 1           # first free level on the given side
        if g.kind == "dome":
            sh = g.shape
            yf, ny = (0.0, -1) if facing((0, -1, 0)) else (sh.D, 1)
            xs, nx = (0.0, -1) if facing((-1, 0, 0)) else (sh.D, 1)
            self._dchain(cv, P, lambda u: (u, sh.rho, 0.0), lambda u: (u, yf + ny * first(("y", ny)) * N, 0.0),
                         [(0.0, sh.D, "", "w_D")], z0_, col)
            xb, nb = (sh.D, 1) if nx < 0 else (0.0, -1)          # heights on the other side of the dome
            base = lambda u: (xb, sh.rho, u) if u <= sh.H + 1e-9 else (sh.rho, sh.rho, u)
            self._dchain(cv, P, base, lambda u: (xb + nb * N, sh.rho, u),
                         [(0.0, sh.H, "", "w_H"), (sh.H, sh.H + sh.f, "", "w_f")], z0_, col)
            self._dchain(cv, P, base, lambda u: (xb + nb * 2 * N, sh.rho, u), [(0.0, sh.H + sh.f, "")], z0_, col,
                         lab_t=0.78)
            return
        L = g.L
        prisms = [g.main] + ([g.upper] if snow and g.upper else []) if snow else [g.shape]
        ys = [pr.oy for pr in prisms if isinstance(pr, Prism)] + [0.0]
        ye = [pr.oy + pr.B for pr in prisms if isinstance(pr, Prism)] + [g.B]
        y0, y1 = min(ys), max(ye)
        yf, ny = (y0, -1) if facing((0, -1, 0)) else (y1, 1)
        yL = yf                                  # dimension L – outside the annex (the canopy is higher – not in the way)
        if snow:
            ext = [q[1] for so in (g.annex,) if so for P, _ in so.walls for q in P]
            yL = min([yf] + ext) if ny < 0 else max([yf] + ext)
        xs, nx = (0.0, -1) if facing((-1, 0, 0)) else (L, 1)
        rz = g.main.rz if snow else g.rz
        main = g.main if snow else g.shape
        # ---- horizontal, on the ground: length L (overall) along the long wall; annex on this side –
        # its width (partial) closer, L farther
        kL = first(("y", ny)) * N
        if snow and g.annex and ((g.annex.g["ya"] + g.annex.g["yb"]) / 2 < g.B / 2) == (ny < 0):
            kL += N
        self._dchain(cv, P, lambda u: (u, yf, 0.0), lambda u: (u, yL + ny * kL, 0.0), [(0.0, L, "", pf + "L")],
                     z0_, col, lab_t=0.5 if yL == yf else 0.2)      # text away from the annex dimensions
        # ---- horizontal, on the ground, at the gable wall: widths
        if snow and g.upper:
            gp_ = getattr(g, "gap", 0.0)            # B3(2): the gap between the buildings dimensioned separately
            overall = [(g.upper.oy, g.upper.oy + g.p["b1"], "", "s_b1")] +                 ([(-gp_, 0.0, "", "s_gd")] if gp_ > 0 else []) + [(0.0, g.B, "", "s_B")]
        else:
            overall = [(0.0, g.B, "", pf + "B")]
        part, pbase = None, None
        if snow and g.kind == "multi":
            w_ = g.B / g.p["n"]
            part = [(i * w_, (i + 1) * w_, "") for i in range(g.p["n"])]
            pbase = lambda u: (xs, u, rz(xs, u))                 # valleys and eaves of the spans
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[1]:
            part = [(0.0, g.p["yob"], "", "s_yob")]
            pbase = lambda u: (xs, u, g.H)
        lv = first(("x", nx))
        if part:
            kP = lv * N
            self._dchain(cv, P, pbase, lambda u: (xs + nx * kP, u, 0.0), part, z0_, col,
                         via=lambda u: (xs, u, 0.0))
            lv += 1
        kB = lv * N
        self._dchain(cv, P, lambda u: (xs, u, 0.0), lambda u: (xs + nx * kB, u, 0.0), overall, z0_, col)
        # ---- vertical: heights on the other side of the building – in the plane of the far gable wall, at the corner
        # on the viewer's side, offset outwards (they do not hide the building)
        xF, nF = (L, 1) if xs == 0.0 else (0.0, -1)
        if snow and g.upper and yf == y0:
            ze, hk = g.upper.rz(xF, y0 + 1e-9), None
        else:
            ze = rz(xF, yf)
            hk = pf + "H" if abs(ze - g.H) < 1e-6 else None
        hparts = [(0.0, ze, "", hk)]
        if not snow and g.kind == "flat" and g.hp > 0:
            hparts.append((ze, ze + g.hp, "", "w_hp"))
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]:
            hparts.append((ze, ze + g.p["hob"], "", "s_hob"))
        top_pt = None
        if isinstance(main, Prism):
            ytop = max(main.prof, key=lambda q: q[1])[0] + main.oy
            if main.h_top > ze + 1e-3:
                top_pt = (xF, ytop, main.h_top)
                if g.kind == "vault":
                    hparts.append((ze, main.h_top, "", pf + "f"))
        elif isinstance(main, Hip):
            xr = main.run if xF == 0 else L - main.run
            top_pt = (xr, g.B / 2, main.h_top)
        htot = top_pt[2] if top_pt else (hparts[-1][1] if hparts else 0.0)

        def hbase(u):
            if top_pt and abs(u - top_pt[2]) < 1e-9:
                return top_pt
            return (xF, yf, u)
        # eaves parapet on the viewer's side – its height closest (N), building heights one level farther
        hs = N if snow and getattr(g, "exc", None) and any(abs(ye - yf) < 1e-6 for ye, _ in g.eave_par) else 0.0
        if not hparts:
            pass
        elif len(hparts) > 1 or top_pt:     # on the extension lines of dimension L: partial – N, overall – like L
            kH = max(kL, 2 * N) + hs
            self._dchain(cv, P, hbase, lambda u: (xF, yf + ny * (N + hs), u), hparts, z0_, col)
            self._dchain(cv, P, hbase, lambda u: (xF, yL + ny * kH, u), [(0.0, htot, "")], z0_, col,
                         lab_t=0.78)                            # text higher than the partial texts
        else:                                                   # single height – on the extension line of L
            self._dchain(cv, P, hbase, lambda u: (xF, yL + ny * (kL + hs), u), hparts, z0_, col)
        # ---- roof slope angles
        if isinstance(main, Prism):
            seen = []
            for sg_ in main.segs():
                a = Prism.seg_angle(sg_)
                if a < 0.5 or g.kind == "vault" or len(seen) >= 2 or any(abs(a - b) < 1e-6 for b in seen):
                    continue
                seen.append(a)
            if seen:
                done = []
                for sg_ in main.segs():
                    a = Prism.seg_angle(sg_)
                    if any(abs(a - b) < 1e-6 for b in done) or not any(abs(a - b) < 1e-6 for b in seen):
                        continue
                    done.append(a)
                    my = (sg_[0] + sg_[2]) / 2
                    mz = (sg_[1] + sg_[3]) / 2
                    if len(seen) == 1:
                        akey = (pf + "alpha", pf + "alpha2") if (snow and g.kind == "multi") else pf + "alpha"
                    else:
                        akey = pf + ("alpha" if len(done) == 1 else "alpha2")
                    if not snow and g.kind == "can2":
                        a = g.p["alpha"]                    # canopy: signed angle (−20…+30°)
                    xm = L / 2                                   # centre of the slope (at half length)
                    self._angle_label(cv, P, (xm, my, rz(xm, my) + 0.01 * size * self._dim_scale()), f"{f2(a, 1)}°", akey)
        elif isinstance(main, Hip):
            sh = main
            self._angle_label(cv, P, (L / 2, yf + (-ny) * g.B / 4, rz(L / 2, yf + (-ny) * g.B / 4) + 0.03 * size * self._dim_scale()),
                              f"{f2(g.p['alpha'], 1)}°", "w_alpha")
            self._angle_label(cv, P, (xs + (-nx) * sh.run / 2, g.B / 2, rz(xs + (-nx) * sh.run / 2, g.B / 2) +
                                      0.03 * size * self._dim_scale()), f"{f2(g.p['a90'], 1)}°", "w_a90")
        # ---- roof angle of the taller building (adjacent taller building)
        if snow and g.upper and g.p["aup"] >= 0.5 and facing((0, -1, 0)):   # angle of the taller building – from its side
            up = g.upper
            sgs = up.segs()
            vis = [q for q in sgs if facing(unit((0.0, -(q[3] - q[1]), q[2] - q[0])))]
            sg_ = (vis or sgs)[-1]                               # visible slope (preferably from the lower roof)
            my = (sg_[0] + sg_[2]) / 2
            xm = L / 2
            self._angle_label(cv, P, (xm, my, up.rz(xm, my) + 0.01 * size * self._dim_scale()), f"{f2(g.p['aup'], 1)}°", "s_aup")
        # ---- additional elements (at their own edges)
        if snow and g.upper and not facing((0, -1, 0)):          # step visible only from the lower roof side
            self._dchain(cv, P, lambda u: (xF, 0.0, u), lambda u: (xF + nF * N, 0.0, u),
                         [(g.H, g.H + g.p["dh"], "", "s_dh")], z0_, col)
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[1]:
            yo = g.p["yob"] + 0.25 if yf == y0 else g.p["yob"]
            self._dchain(cv, P, lambda u: (xF, yo, u), lambda u: (xF + nF * N, yo, u),
                         [(g.H, g.H + g.p["hob"], "", "s_hob")], z0_, col)
        if snow and getattr(g, "exc", None):
            self.draw_exc_dims(cv, g, P, facing, N, xs, nx)

    def draw_exc_dims(self, cv, g, P, facing, N, xs, nx):
        """Dimensions of additional elements for exceptional drifts (clickable): annex, canopy,
        obstructions and parapets. One module N (as building dimensions); dimensions on the far side of the element
        (heights and depths – at the far end), annex and canopy – only from their side of the building."""
        col, z0_ = BDIM_COL, (0, 0, 0)
        k2 = N
        sx = lambda a, b: (a, -1) if facing((-1, 0, 0)) else (b, 1)      # near end (x)
        sxf = lambda a, b: (b, 1) if facing((-1, 0, 0)) else (a, -1)     # far end (x)
        side_ = (-1 if (g.annex.g["ya"] + g.annex.g["yb"]) / 2 < g.B / 2 else 1) if g.annex else 0
        if g.annex and facing((0, side_, 0)):       # annex – dimensions only when its side is visible
            a = g.annex.g
            x_, n_ = sxf(a["x0"], a["x1"])                # depth and height difference – on the far side
            self._dchain(cv, P, lambda u: (u, a["ya"], 0.0), lambda u: (u, a["ya"] - k2, 0.0),
                         [(a["x0"], a["x1"], "", "s_xw")], z0_, col)
            he_ = a["he"]                                 # depth – at the annex eaves height
            self._dchain(cv, P, lambda u: (x_, u, he_), lambda u: (x_ + n_ * k2, u, he_),
                         [(a["ya"], a["yb"], "", "s_xd")], z0_, col)
            hu = g.upper.prof[0][1]
            self._dchain(cv, P, lambda u: (x_, a["yb"], u), lambda u: (x_ + n_ * k2, a["yb"], u),
                         [(a["he"], hu, "", "s_xh")], z0_, col)
            if a["a"] >= 0.5:
                xq, yq = (a["x0"] + a["xm"]) / 2, (a["ya"] + a["yb"]) / 2
                self._angle_label(cv, P, (xq, yq, (a["he"] + a["zr"]) / 2 + 0.05), f"{f2(a['a'], 1)}°", "s_xa")
        if g.canopy and facing((0, 1, 0)):      # canopy on the wall y = B – dimensions when the wall is visible
            c = g.canopy.g
            x_, n_ = sx(c["x1"], c["x0"])                 # dimensions on the far side – away from the building dimensions
            n_ = -n_
            yw, ye_ = c["yw"], c["yw"] + c["c"]
            self._dchain(cv, P, lambda u: (u, ye_, c["hc"]), lambda u: (u, ye_ + k2, c["hc"]),
                         [(c["x0"], c["x1"], "", "s_cw")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, u, c["hc"]), lambda u: (x_ + n_ * k2, u, c["hc"]),
                         [(yw, ye_, "", "s_cb")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, yw, u), lambda u: (x_ + n_ * k2, yw, u),
                         [(c["hc"], c["hedge"], "", "s_ch")], z0_, col)
        if g.fobst:                            # obstruction dimensions on the far side (the near one is taken by the drift zones)
            o = g.fobst.g
            x_, n_ = sx(o["x1"], o["x0"])
            n_ = -n_
            y_, m_ = (o["y1"], 1) if facing((0, -1, 0)) else (o["y0"], -1)
            zt = g.H + o["h"]
            self._dchain(cv, P, lambda u: (u, y_, zt), lambda u: (u, y_ + m_ * k2, zt),
                         [(o["x0"], o["x1"], "", "s_fw")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, u, zt), lambda u: (x_ + n_ * k2, u, zt),
                         [(o["y0"], o["y1"], "", "s_fd")], z0_, col)
            xn, sn = (o["x1"], 1) if facing((-1, 0, 0)) else (o["x0"], -1)     # height – far corner (x)
            yn = o["y0"] if facing((0, -1, 0)) else o["y1"]
            self._dchain(cv, P, lambda u: (xn, yn, u), lambda u: (xn + sn * N, yn, u),
                         [(g.H, zt, "", "s_fh")], z0_, col)
        pr = g.main
        xF, nF = (g.L, 1) if xs == 0.0 else (0.0, -1)            # far gable
        # eaves parapet – height at the far gable; parapet on the viewer's side – outside the eaves (N),
        # before the building heights (which then go one level farther)
        near = [q for q in g.eave_par if facing((0, -q[1], 0))]
        for ye, dr in (near or g.eave_par)[:1]:
            z0 = pr.rz(0, ye)
            if near:
                self._dchain(cv, P, lambda u: (xF, ye, u), lambda u: (xF, ye - dr * N, u),
                             [(z0, z0 + g.exc["pah"], "", "s_pah")], z0_, col)
            else:
                self._dchain(cv, P, lambda u: (xF, ye, u), lambda u: (xF + nF * N, ye, u),
                             [(z0, z0 + g.exc["pah"], "", "s_pah")], z0_, col)
        far_gp = [q for q in g.gable_par if (q[0] == 0.0) != facing((-1, 0, 0))]
        for gx, dr in (far_gp or g.gable_par)[:1]:              # gable parapet – height (far one)
            ytop = max(pr.prof, key=lambda q: q[1])[0]
            zr = pr.rz(gx, ytop)
            self._dchain(cv, P, lambda u: (gx, ytop, u), lambda u: (gx - dr * N, ytop, u),
                         [(zr, zr + g.exc["gah"], "", "s_gah")], z0_, col)
        if g.obst_y is not None:                                # obstruction on a roof slope – position and height
            yo = g.obst_y
            za, zb = pr.rz(xs, yo), pr.rz(xs, yo + TW_OBST)
            zt = max(za, zb) + g.exc["poh"]
            ko = N if g.kind == "multi" else k2                  # spans (multispan roof) take 2N
            self._dchain(cv, P, lambda u: (xs, u, pr.rz(xs, u)), lambda u: (xs + nx * ko, u, 0.0),
                         [(0.0, yo, "", "s_poy")], z0_, col, via=lambda u: (xs, u, 0.0))
            ox0, ox1 = g.obst_x
            xe_, ne_ = (ox1, 1) if facing((-1, 0, 0)) else (ox0, -1)     # far end of the obstruction
            yb_ = yo if za >= zb else yo + TW_OBST
            self._dchain(cv, P, lambda u: (xe_, yb_, u), lambda u: (xe_ + ne_ * N, yb_, u),
                         [(max(za, zb), zt, "", "s_poh")], z0_, col)
            yf_, mf_ = (yo + TW_OBST, 1) if facing((0, -1, 0)) else (yo, -1)   # length – on the far side
            self._dchain(cv, P, lambda u: (u, yf_, zt), lambda u: (u, yf_ + mf_ * k2, zt),
                         [(ox0, ox1, "", "s_pol")], z0_, col)

    def draw_snow_dims(self, cv, g, P, facing, size):
        """Snow load zone dimensions (in plan). Horizontal edge (eaves) – dimension line
        in the plane of the eaves; sloping gable – in the plane of the gable wall, vertical extension lines."""
        s = self.snow
        case = next((c for c in s["cases"] if c["name"] == self.snow_case.get()), s["cases"][0])
        N_ = DIM_STEP * size * self._dim_scale()
        if getattr(g, "upper", None) and facing((0, -1, 0)):     # lower roof behind the taller building – no dimensions
            return
        for ax, a0, a1, z, segs in case.get("xdim", []):     # extent of drifts on additional elements
            segs = [(u0, u1, "") for u0, u1 in segs if u1 - u0 > 1e-6]
            if not segs:
                continue
            if ax == "y":
                xs_, nx_ = (a0, -1) if facing((-1, 0, 0)) else (a1, 1)
                if z is None:                                   # roof slope: dimension above the roof, vertical lines
                    zl_ = getattr(self, "_snow_ztop", g.main.h_top) + N_
                    self._dchain(cv, P, lambda u: (xs_, u, g.main.rz(xs_, u)), lambda u: (xs_, u, zl_), segs,
                                 (0, 0, 0), SDIM_COL)
                else:
                    self._dchain(cv, P, lambda u: (xs_, u, z), lambda u: (xs_ + nx_ * N_, u, z), segs, (0, 0, 0),
                                 SDIM_COL)
            else:
                ys_, ny_ = (a0, -1) if facing((0, -1, 0)) else (a1, 1)
                z_ = z if z is not None else g.main.rz(0, ys_)
                self._dchain(cv, P, lambda u: (u, ys_, z_), lambda u: (u, ys_ + ny_ * N_, z_), segs, (0, 0, 0),
                             SDIM_COL)
        spans = [sp for sp in case.get("spans", []) if sp[1] - sp[0] > 1e-6]
        if not spans:
            return
        xs, nx = (g.L, 1) if facing((-1, 0, 0)) else (0.0, -1)        # far gable – on the other side of the building
        pr = g.main
        col = SDIM_COL
        lo_, hi_ = min(sp[0] for sp in spans), max(sp[1] for sp in spans)
        zs = [pr.rz(xs, lo_ + (hi_ - lo_) * i / 40) for i in range(41)]
        if max(zs) - min(zs) < 1e-6:
            z0, k = zs[0], DIM_STEP * size * self._dim_scale()
            path = lambda u: (xs, u, z0)
            lpt = lambda u: (xs + nx * k, u, z0)
        else:
            zl = getattr(self, "_snow_ztop", pr.h_top) + DIM_STEP * size * self._dim_scale()
            path = lambda u: (xs, u, pr.rz(xs, u))
            lpt = lambda u: (xs, u, zl)
        self._dchain(cv, P, path, lpt, [sp[:3] for sp in spans], (0, 0, 0.025 * size), col)
        if g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]:   # parapet: drifts also along L
            e_ = min(spans[0][1] - spans[0][0], g.L / 2)
            yf, ny = (0.0, -1) if facing((0, -1, 0)) else (g.B, 1)
            segs = [(0.0, e_, "lₛ ="), (e_, g.L - e_, ""), (g.L - e_, g.L, "lₛ =")] if g.L > 2 * e_ + 1e-9 else []
            if segs:
                k = DIM_STEP * size * self._dim_scale()
                self._dchain(cv, P, lambda u: (u, yf, g.H), lambda u: (u, yf + ny * k, g.H), segs,
                             (0, 0, 0.025 * size), col)

    def draw_dims(self, cv, g, P, facing, size):
        """Wind zone dimensions (in plan). Walls – on the ground; roof at the eaves – in the plane of the eaves;
        sloping gable – in the plane of the gable wall (vertical extension lines)."""
        if g.kind == "dome":
            return
        w = self.wind
        fr = wind_frame(g, w["theta"])
        b, d, to, so, tof = fr["b"], fr["d"], fr["to_xy"], fr["s_of"], fr["t_of"]

        def xy_dir(ds, dt):
            a, c = to(0, 0), to(ds, dt)
            v = (c[0] - a[0], c[1] - a[1])
            l = math.hypot(*v) or 1
            return (v[0] / l, v[1] / l)
        o_t0 = xy_dir(0, -1)
        if facing((o_t0[0], o_t0[1], 0)):
            tside, out = 0.0, o_t0
        else:
            tside, out = b, (-o_t0[0], -o_t0[1])
        ups = xy_dir(-1, 0)
        col = DIM_COL
        k1 = DIM_STEP * size * self._dim_scale()                      # offset module N
        lab = (0, 0, 0.025 * size)
        roofz = [z for z in w["zones"] if z["kind"] in ("roof", "canopy") and not z.get("dome")]

        def edge_segs(fixed, val):
            """Segments of roof zones lying on the edge s = val or t = val."""
            segs, zs = set(), []
            on = lambda p: abs((so(p) if fixed == "s" else tof(p)) - val) < 1e-6
            par = lambda p: tof(p) if fixed == "s" else so(p)
            for z in roofz:
                P_ = z["poly"]
                for i in range(len(P_)):
                    a_, b_ = P_[i], P_[(i + 1) % len(P_)]
                    if on(a_) and on(b_) and abs(par(a_) - par(b_)) > 1e-6:
                        u0, u1 = sorted((par(a_), par(b_)))
                        segs.add((round(u0, 6), round(u1, 6), z["name"]))
                        zs += [a_[2], b_[2]]
            merged = []
            for sg_ in sorted(segs):                            # adjacent segments of the same zone – merged
                if merged and merged[-1][2] == sg_[2] and abs(merged[-1][1] - sg_[0]) < 1e-6:
                    merged[-1] = (merged[-1][0], sg_[1], sg_[2])
                else:
                    merged.append(sg_)
            return merged, zs

        def edge_chain(fixed, val, outward, segs=None, zs=None, row=1.0):
            if segs is None:
                segs, zs = edge_segs(fixed, val)
                if len(segs) < 2:
                    return
            pt = (lambda u: to(val, u)) if fixed == "s" else (lambda u: to(u, val))
            if max(zs) - min(zs) < 1e-6:                        # eaves: plane of the eaves
                z0, k = zs[0], k1 * row
                path = lambda u: (*pt(u), z0)
                lpt = lambda u: (pt(u)[0] + outward[0] * k, pt(u)[1] + outward[1] * k, z0)
            else:                                               # gable: plane of the gable wall
                zl = max(zs) + k1 * row
                path = lambda u: (*pt(u), g.rz(*pt(u)))
                lpt = lambda u: (*pt(u), zl)
            self._dchain(cv, P, path, lpt, segs, lab, col)

        if g.dims_roof or g.kind == "hip":
            edge_chain("s", 0.0, ups)                               # windward eaves / gable
            if g.kind not in ("can1", "can2"):
                # side edge of the roof – on the other side of the building (far edge / far gable); on the viewer's
                # side the wall dimensions on the ground remain
                tfar, ofar = b - tside, (-out[0], -out[1])
                segs, zs = edge_segs("t", tfar)
                if len(segs) < 2:
                    tfar, ofar = tside, out
                    segs, zs = edge_segs("t", tside)
                if len(segs) >= 2:
                    edge_chain("t", tfar, ofar, segs, zs)
            edge_chain("s", d, (-ups[0], -ups[1]))                  # leeward eaves (e.g. zone J)
            if g.kind in ("can1", "can2"):                          # canopies: split across the wind (B–A–B)
                _, zs0 = edge_segs("s", 0.0)
                segs = sorted({(round(z["rect"][2], 6), round(z["rect"][3], 6), z["name"]) for z in roofz
                               if "rect" in z and z["rect"][0] - 1e-6 <= d / 4 <= z["rect"][1] + 1e-6})
                if len(segs) >= 2 and zs0:
                    edge_chain("s", 0.0, ups, segs, zs0)
                # split along the wind in the middle (C–A–D–A–C) – as for buildings: on the other side of the canopy
                tfar, ofar = b - tside, (-out[0], -out[1])
                _, zsb = edge_segs("t", tfar)
                segs = sorted({(round(z["rect"][0], 6), round(z["rect"][1], 6), z["name"]) for z in roofz
                               if "rect" in z and z["rect"][2] - 1e-6 <= b / 2 <= z["rect"][3] + 1e-6})
                if len(segs) >= 2 and zsb:
                    edge_chain("t", tfar, ofar, segs, zsb)
        # walls: on the ground, along the side wall
        segs = [(z["srange"][0], z["srange"][1], z["name"]) for z in w["zones"] if "srange" in z]
        if segs:
            side = ("x", 1 if out[0] > 0 else -1) if abs(out[0]) > abs(out[1]) else ("y", 1 if out[1] > 0 else -1)
            getattr(self, "_dim_used", set()).add(side)
            self._dchain(cv, P, lambda u: (*to(u, tside), 0.0),
                         lambda u: (to(u, tside)[0] + out[0] * k1, to(u, tside)[1] + out[1] * k1, 0.0), segs, lab, col)
        if g.kind in ("can1", "can2"):
            return
        bd = self.bdims3d.get()                   # b and h are already among the building dimensions
        if not bd:
            k = k1
            self._dchain(cv, P, lambda u: (*to(0, u), 0.0),
                         lambda u: (to(0, u)[0] + ups[0] * k, to(0, u)[1] + ups[1] * k, 0.0),
                         [(0.0, b, "b =")], lab, col)
        bands = [(z["zband"][0], z["zband"][1], "") for z in w["zones"] if "zband" in z]
        if len(bands) <= 1:
            if bd:
                return
            bands = [(0.0, g.h_top, "h =")]
        # height bands of the windward wall: the chain in front of the windward wall, at its corner on the viewer's
        # side; a level above the wall corner (e.g. the roof top) – the extension line runs from the point of the
        # side roof edge at that height, so it is clear what the dimension measures
        cx, cy_ = to(0, tside)
        ox_, oy_ = ups[0] * k1, ups[1] * k1
        zc = g.rz(cx, cy_)
        edge = [to(d * i / 80, tside) for i in range(81)]
        edge = [(p_[0], p_[1], g.rz(*p_)) for p_ in edge]

        def hbase(u):
            if u <= zc + 1e-6:
                return (cx, cy_, u)
            hit = next((q for q in edge if q[2] >= u - 1e-6), max(edge, key=lambda q: q[2]))
            return (hit[0], hit[1], u)
        self._dchain(cv, P, hbase, lambda u: (cx + ox_, cy_ + oy_, u), bands,
                     (out[0] * 0.06 * size, out[1] * 0.06 * size, 0), col)


def _check_image():
    """Check mark for check boxes (PNG in the temp folder – no SVG plugin needed)."""
    import tempfile
    from PySide6.QtGui import QPixmap
    path = os.path.join(tempfile.gettempdir(), "kayenn_check.png")
    pm = QPixmap(28, 28)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
    pen = QPen(QColor("#ffffff"))
    pen.setWidthF(3.6)
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.drawPolyline(QPolygonF([QPointF(6, 14.5), QPointF(11.5, 20), QPointF(22, 8)]))
    p.end()
    pm.save(path, "PNG")
    return path.replace("\\", "/")


def zoom_pan(pan_x, pan_y, k, at, W, Hc):
    """Pan after zooming by k so that the model point under the cursor at = (x, y) stays under the cursor
    (orthographic view: screen = centre + pan + projection · scale)."""
    ox, oy = W / 2 + pan_x, Hc / 2 + pan_y
    return at[0] - (at[0] - ox) * k - W / 2, at[1] - (at[1] - oy) * k - Hc / 2


def chevron_pixmap(direction="down", color="#4b5563", size=20, width=2.2):
    """Chevron (▸ / ▾ drawn as lines – crisp at any size, no font glyph needed); direction down / right."""
    from PySide6.QtGui import QPixmap
    dpr = 2
    pm = QPixmap(size * dpr, size * dpr)
    pm.setDevicePixelRatio(dpr)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
    pen = QPen(QColor(color))
    pen.setWidthF(width)
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    s, c = size * 0.22, size / 2
    if direction == "down":
        pts = [QPointF(c - 1.6 * s, c - 0.8 * s), QPointF(c, c + 0.8 * s), QPointF(c + 1.6 * s, c - 0.8 * s)]
    else:
        pts = [QPointF(c - 0.8 * s, c - 1.6 * s), QPointF(c + 0.8 * s, c), QPointF(c - 0.8 * s, c + 1.6 * s)]
    p.drawPolyline(QPolygonF(pts))
    p.end()
    return pm


def _arrow_image():
    """Drop-down arrow for combo boxes and menu buttons (PNG in the temp folder, like the check mark)."""
    import tempfile
    path = os.path.join(tempfile.gettempdir(), "kayenn_down.png")
    chevron_pixmap("down", "#4b5563", 20, 2.4).save(path, "PNG")
    return path.replace("\\", "/")


def register_file_type():
    """Windows: project files (.kayenn) opened with this program by double-click (current user registry, no
    administrator rights). Written only when changed – e.g. after the program was moved elsewhere."""
    if sys.platform != "win32" or FROZEN:            # installed program – the installer writes the association
        return
    try:
        import winreg
        exe = sys.executable
        if exe.lower().endswith("python.exe"):
            exe_w = exe[:-10] + "pythonw.exe"
            if os.path.exists(exe_w):
                exe = exe_w                                     # no console window
        script = os.path.abspath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)
        cmd = f'"{exe}" "{script}" "%1"'
        prog = "KAYENN.Projekt"
        want = {rf"Software\Classes\{PROJECT_EXT}": prog,
                rf"Software\Classes\{prog}": "Projekt KAYENN",
                rf"Software\Classes\{prog}\shell\open\command": cmd}
        if os.path.exists(ICON_FILE):
            want[rf"Software\Classes\{prog}\DefaultIcon"] = f'"{ICON_FILE}",0'
        changed = False
        for key, val in want.items():
            try:
                with winreg.OpenKey(winreg.HKEY_CURRENT_USER, key) as k:
                    cur = winreg.QueryValueEx(k, "")[0]
            except OSError:
                cur = None
            if cur != val:
                with winreg.CreateKey(winreg.HKEY_CURRENT_USER, key) as k:
                    winreg.SetValueEx(k, "", 0, winreg.REG_SZ, val)
                changed = True
        if changed:
            import ctypes
            ctypes.windll.shell32.SHChangeNotify(0x08000000, 0, None, None)   # refresh file associations in Explorer
    except Exception:
        pass                                                    # the association is a convenience – the program works without it


def load_fonts():
    """Fonts from the fonts/ folder (Noto) – registration and substitutes for symbols. True – loaded."""
    from PySide6.QtGui import QFontDatabase
    ok = False
    if os.path.isdir(FONT_DIR):
        for f in sorted(os.listdir(FONT_DIR)):
            if f.lower().endswith((".ttf", ".otf")):
                ok = QFontDatabase.addApplicationFont(os.path.join(FONT_DIR, f)) >= 0 or ok
    for fam in (FONT, MONO):
        QFont.insertSubstitutions(fam, FONT_FALLBACK)
    return ok


def css_pt(css):
    """„Npt” sizes in a style sheet scaled by UI_PT (the same on-screen size on every system)."""
    if abs(UI_PT - 1.0) < 1e-9:
        return css
    import re
    return re.sub(r"(\d+(?:\.\d+)?)pt\b", lambda m_: f"{float(m_.group(1)) * UI_PT:.2f}pt", css)


def ui_font(family, pt, bold=False):
    f = QFont(family)
    f.setPointSizeF(pt * UI_PT)
    f.setBold(bold)
    return f


def setup_qapp(qapp):
    """Common look on every system: Fusion style, the program's light palette (no system dark mode),
    Noto fonts, point sizes as at 96 dpi (macOS counts points at 72 dpi)."""
    global UI_PT
    scr = qapp.primaryScreen()
    dpi = scr.logicalDotsPerInchY() if scr is not None else 96.0
    UI_PT = 96.0 / dpi if dpi > 0 else 1.0
    _FONTS.clear()
    _METRICS.clear()
    load_fonts()
    if os.path.exists(ICON_FILE):
        qapp.setWindowIcon(QIcon(ICON_FILE))
    qapp.setStyle("Fusion")
    pal = qapp.palette()
    R = QPalette.ColorRole
    for role, col in ((R.Window, BG), (R.WindowText, TEXT), (R.Base, "#ffffff"), (R.AlternateBase, "#f6f7f9"),
                      (R.Text, TEXT), (R.Button, "#eef0f3"), (R.ButtonText, TEXT), (R.Highlight, ACCENT),
                      (R.HighlightedText, "#ffffff"), (R.ToolTipBase, "#ffffff"), (R.ToolTipText, TEXT),
                      (R.PlaceholderText, MUTED), (R.Light, "#ffffff"), (R.Midlight, "#e3e6ea"),
                      (R.Mid, "#c4c9d0"), (R.Dark, "#9aa1ab"), (R.Shadow, "#6b7280"), (R.Link, ACCENT)):
        pal.setColor(role, QColor(col))
    for grp in (QPalette.ColorGroup.Disabled,):
        for role in (R.WindowText, R.Text, R.ButtonText):
            pal.setColor(grp, role, QColor("#a3a8b0"))
    qapp.setPalette(pal)
    qapp.setFont(ui_font(FONT, 9))
    qapp.setStyleSheet(css_pt(STYLE.replace("@CHECK@", _check_image()).replace("@DOWN@", _arrow_image())))
    if not _UNDO_FILTER:                              # Ctrl+Z in an empty-history text field – the window's Cofnij
        _UNDO_FILTER.append(_UndoKeys())
        qapp.installEventFilter(_UNDO_FILTER[0])


class _FileOpener(QObject):
    """macOS: Finder delivers the file with a FileOpen event (not in the arguments) – opens the project."""

    def __init__(self):
        super().__init__()
        self.app, self.pending = None, []

    def attach(self, app):
        self.app = app
        for p in self.pending:
            QTimer.singleShot(0, lambda p=p: self._open(p))
        self.pending = []

    def _open(self, path):
        if self.app is not None and self.app.end_editor() and self.app._ask_save():
            self.app.open_path(path)

    def eventFilter(self, obj, e):
        if e.type() == QEvent.Type.FileOpen and e.file():
            if self.app is None:
                self.pending.append(e.file())
            else:
                self._open(e.file())
            return True
        return False


def main():
    if "--vtk-probe" in sys.argv:                    # the 3D engine test in a child process (VtkScene.probe)
        VtkScene.probe_main()
    if sys.platform == "win32":
        try:   # own identifier – the taskbar shows the KAYENN icon instead of the Python one
            import ctypes
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("KAYENN")
        except Exception:
            pass
    QApplication.setAttribute(Qt.ApplicationAttribute.AA_DontUseNativeMenuBar, True)   # macOS: menu inside the window
    qapp = QApplication(sys.argv)
    qapp.setApplicationName("KAYENN")
    qapp.setApplicationVersion(APP_VERSION)
    opener = _FileOpener()
    qapp.installEventFilter(opener)                  # macOS: .kayenn file opened from Finder (FileOpen event)
    setup_qapp(qapp)
    register_file_type()
    app = App(qapp)
    opener.attach(app)
    scr = qapp.primaryScreen().availableGeometry()
    app.win.resize(640, min(960, scr.height() - 60))
    app.pw.resize(min(1100, scr.width() - 80), min(860, scr.height() - 60))
    app.pw.move(scr.x() + 30, scr.y() + 20)
    files = [a for a in sys.argv[1:] if not a.startswith("-") and os.path.isfile(a)]
    if files:                                        # double-click on a project file
        app.open_path(files[0])
    app.pw.rebuild()
    app.pw.showMaximized()                           # always the main window first, maximised
    if "--autotest" not in sys.argv and not os.environ.get("KAYENN_NO_UPDATE"):
        QTimer.singleShot(3000, app.auto_update_check)
    if "--autotest" in sys.argv:                     # package check: start, report, screenshots, quit
        QTimer.singleShot(2500, lambda: _autotest(app, qapp))
    sys.exit(qapp.exec())


def _autotest(app, qapp):
    """Trial run of the package (packaging/build.py): autotest.json report and window screenshots in the
    KAYENN_AUTOTEST_DIR folder; exit code 2 – program fonts or material database missing."""
    from PySide6.QtGui import QFontInfo
    d = os.environ.get("KAYENN_AUTOTEST_DIR")
    fam = QFontInfo(qapp.font()).family()
    try:
        n_mat = len(mat_load(MAT_DEFAULT)[0])
    except (OSError, UnicodeDecodeError):
        n_mat = 0
    scr = qapp.primaryScreen()
    info = dict(version=APP_VERSION, system=sys.platform, platform=qapp.platformName(), font=fam,
                ui_pt=UI_PT, dpi=scr.logicalDotsPerInchY() if scr else None,
                dpr=scr.devicePixelRatio() if scr else None, materials=n_mat, base_dir=BASE_DIR,
                user_data=user_data_dir())
    ok = fam == FONT and n_mat > 1000
    try:                                             # the map: the widget with the zones paints (no network)
        from PySide6.QtGui import QImage
        MapView.NETWORK = False
        mv = MapView()
        mv.resize(400, 300)
        mv.jump_to(21.01, 52.23, 9)
        img = QImage(400, 300, QImage.Format.Format_ARGB32)
        mv.render(img)
        info["map"] = img.pixel(200, 150) != QColor("#e4e8ee").rgba()       # the zone tints the background
        mv.deleteLater()
        MapView.NETWORK = True
    except Exception as e:
        info["map"] = repr(e)
    try:                                             # TLS for the map tiles, search and altitude (https)
        from PySide6.QtNetwork import QSslSocket
        info["tls"] = bool(QSslSocket.supportsSsl())
    except Exception as e:
        info["tls"] = repr(e)
    ok = ok and info["map"] is True and info["tls"] is True
    try:                                             # the 3D engine (VTK on the graphics card, else the basic one;
        info["renderer"] = VtkScene.status()          # CI machines without a GPU – the basic one, not an error)
    except Exception as e:
        info["renderer"] = repr(e)
    if d:
        os.makedirs(d, exist_ok=True)

        def shot(w, name):
            for _ in range(5):
                qapp.processEvents()
            w.grab().save(os.path.join(d, name + ".png"))
        try:
            app.open_codes()
            app.show_3d()
            app.win3d.resize(1000, 720)
            app.draw3d()
            shot(app.win, "2_code_loads")
            shot(app.win3d, "3_3d_model")
            app.hide_3d()
            app.close_codes()
            app.toggle_lab()
            lw = app.lab
            r0 = lw.add_manual()
            r0.val.setText("0,5")
            r0.unit.setCurrentIndex(2)               # kN/m – the same unit as the profile from the database
            db = lw.open_db()
            db.search.setText("IPE 200")
            db.rebuild()
            shot(db, "5_material_database")
            db.select(next(iter(db.tiles)))
            db.add()
            shot(lw, "4_own_loads")
            lw.on_main()
            lw.close_panel()
            shot(app.pw, "1_main_window")
        except Exception as e:                   # auxiliary screenshots – an error is written to the report
            info["error"] = repr(e)
            ok = False
        with open(os.path.join(d, "autotest.json"), "w", encoding="utf-8") as f:
            json.dump(info, f, ensure_ascii=False, indent=1)
    app.dirty = False
    app.quit_app()
    qapp.exit(0 if ok else 2)                        # exit code for the build script


if __name__ == "__main__":
    main()
