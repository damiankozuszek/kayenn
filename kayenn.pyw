def use_alpha_A(psi0, A, code):
    """6.3.1.2(10), expression (6.1): αA = 5/7·ψ0 + A0/A ≤ 1.0 (A0 = 10 m²); categories C and D: αA ≥ 0.6."""
    a = min(5.0 / 7.0 * psi0 + 10.0 / A, 1.0)
    return max(a, 0.6) if code[0] in "CD" else a


def use_alpha_n(psi0, n):
    """6.3.1.2(11), expression (6.2): αn = (2 + (n − 2)·ψ0) / n, n > 2 – storeys above the loaded element."""
    return (2.0 + (n - 2) * psi0) / n
