    def open_in_editor(self):
        """Plik → Otwórz w edytorze tekstu: the report as an .odt file in the default text editor, so the engineer
        can add the office data and correct the printout."""
        if not self.project["cases"]:
            QMessageBox.information(self.pw or self.win, "Otwórz w edytorze tekstu", "Projekt nie zawiera przypadków.")
            return None
        if len(noprint_ids(self.project)) >= len(self.project["cases"]):
            QMessageBox.information(self.pw or self.win, "Otwórz w edytorze tekstu", "Żaden przypadek nie jest "
                                    "przeznaczony do druku (pole „drukowany” przy przypadku lub grupie).")
            return None
        from PySide6.QtCore import QUrl
        from PySide6.QtGui import QDesktopServices, QTextDocumentWriter
        import tempfile
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            doc = self.project_document(title=True)
            name = re.sub(r'[\\/:*?"<>|]+', "_", self.project_title()).strip() or "projekt"
            path = os.path.join(tempfile.mkdtemp(prefix="kayenn_"), f"{name}.odt")
            ok = QTextDocumentWriter(path, b"ODF").write(doc)
            if ok:
                odt_fix_frames(path)
        finally:
            QApplication.restoreOverrideCursor()
        if not ok or not QDesktopServices.openUrl(QUrl.fromLocalFile(path)):
            QMessageBox.warning(self.pw or self.win, "Otwórz w edytorze tekstu",
                                "Nie udało się otworzyć raportu w edytorze tekstu.\nPlik: " + path)
            return None
        return path

    def auto_update_check(self):
        """At start: when allowed and at most once a day – a quiet check; a new version → a notice."""
        if not settings_get("update_auto", True):
            return
        if time.time() - float(settings_get("update_checked", 0) or 0) < UPDATE_EVERY:
            return
        self._upd = UpdateChecker()

        def done(r):
            if r.get("ok"):
                settings_set("update_checked", time.time())
            if r.get("ok") and r.get("newer"):
                mb = QMessageBox(QMessageBox.Icon.Information, "KAYENN", "Dostępna jest nowa wersja programu "
                                 + r["version"] + ".", QMessageBox.StandardButton.NoButton, self.host.pw)
                mb.setInformativeText(f'<a href="{html.escape(r["url"])}">Co nowego</a>')
                b_inst = mb.addButton("Instaluj", QMessageBox.ButtonRole.AcceptRole)
                mb.addButton("Później", QMessageBox.ButtonRole.RejectRole)
                mb.buttonClicked.connect(lambda b: (self.echo("UPDATES INSTALL"), start_update_install(self, r))
                                         if b is b_inst else None)
                mb.setModal(False)
                mb.show()
                self._upd_msg = mb
        self._upd.done.connect(done)
        self._upd.start()

    def language_menu(self, mb):
        """Język / Language menu: the interface languages, each named in its own language (check mark – the current
        one). The change works at once in every window."""
        from PySide6.QtGui import QActionGroup
        m = mb.addMenu("Język")
        grp = QActionGroup(m)
        grp.setExclusive(True)
        acts = {}
        for code, name in LANGS:
            act = m.addAction(name)
            act.setCheckable(True)
            act.setChecked(code == LANG)
            grp.addAction(act)
            SHORTCUTS.bind(act, "LANGUAGE", echo=False, scope="app")
            act.triggered.connect(lambda checked=False, c=code: (self.echo(f"LANGUAGE {c.upper()}"),
                                                                 self.set_language(c)))
            acts[code] = act
        return acts

    def set_language(self, code):
        """Interface language (menu Język / Language, the command LANGUAGE): saved in settings.json, applied at
        once to every window."""
        host = self.host
        changed = apply_language(code)
        pw = getattr(host, "pw", None)
        for c, act in (getattr(pw, "lang_actions", None) or {}).items():
            act.setChecked(c == LANG)
        if changed:
            host._lang_refresh()
        return changed

    def set_renderer(self, which):
        """The 3D engine (Plik → Opcje, RENDERER): VTK on the graphics card or the basic one; every 3D view is
        drawn again at once."""
        settings_set("renderer", "basic" if which == "basic" else "vtk")
        if which != "basic":
            VtkScene._failed = None                  # try again (e.g. a driver updated)
        self.host._lang_refresh()

    def _lang_refresh(self):
        """After a language change: what is built from texts at drawing time (titles, 3D models, card previews,
        the assumptions window)."""
        for a in (self, self.editor):
            if a is None:
                continue
            a.update_title()
            a._scene_key = None
            if getattr(a, "win3d", None) is not None and a.win3d.isVisible():
                a._draw3d_now()
            if getattr(a, "win_ass", None) is not None:
                a._fill_assumptions()
        pw = getattr(self, "pw", None)
        if pw is not None:
            pw.refresh_cases()
            pw.update()
            for w in pw.findChildren(QWidget):
                w.update()

    def about_menu(self, mb):
        """O programie – an item right on the menu bar (opens the window; no drop-down menu)."""
        act = mb.addAction("O programie")
        SHORTCUTS.bind(act, "ABOUT", scope="app")
        act.triggered.connect(lambda checked=False: self.about())
        return act

    def _front(self):
        """Window above which dialogs are shown (active program window, otherwise the main window)."""
        aw = QApplication.activeWindow()
        if aw is not None and aw in (self.win, getattr(self, "pw", None)):
            return aw
        pw = getattr(self, "pw", None)
        return pw if pw is not None else self.win

    def project_title(self):
        """Project name (Plik → Informacje o projekcie…), or the file name when there is none."""
        nm = (self.project.get("name") or "").strip()
        if nm:
            return nm
        return os.path.basename(self.project_path) if self.project_path else "nowy projekt"

    def project_info(self):
        """Plik → Informacje o projekcie…: project name and location (map)."""
        host = self.host
        d = getattr(host, "_info_dlg", None)
        if d is not None:                            # already open – bring to front
            d.raise_()
            d.activateWindow()
            return
        cur = host.loc.get()
        d = ProjectInfoDialog(host, host.pw, host.project.get("name") or "", cur)
        d.setModal(False)                            # does not block other windows
        host._info_dlg = d
        d.accepted.connect(lambda: host._apply_info(d, cur))
        d.finished.connect(lambda r: (setattr(host, "_info_dlg", None), d.deleteLater()))
        d.show()

    def _apply_info(self, d, cur):
        host = self.host
        changed = False
        name = " ".join(d.name_edit.text().split())
        if name != (host.project.get("name") or ""):
            host.project["name"] = name
            changed = True
        if d.loc and d.loc != cur:
            host.set_project_location(d.loc)
            changed = True
        if changed:
            host.project_changed()

    def pick_location(self, parent, cur, done, toggle=False):
        """Picking a point on the map; result → done(loc).
        The map does not block other windows; there is only one map window (called again it is brought to the
        front, with toggle – closed)."""
        host = self.host
        old = getattr(host, "_map_dlg", None)
        if old is not None and old.isVisible():
            if toggle:
                old.close()
            else:
                old.raise_()
                old.activateWindow()
            return
        dlg = MapDialog(parent, "snow", cur)
        dlg.setModal(False)
        host._map_dlg = dlg
        dlg.accepted.connect(lambda: dlg.result_loc and done(dlg.result_loc))
        dlg.finished.connect(lambda r: (setattr(host, "_map_dlg", None) if getattr(host, "_map_dlg", None) is dlg
                                        else None, dlg.deleteLater()))
        dlg.show()

    @staticmethod
    def _auto_values(loc):
        """Values from the map: zones (snow, wind) and altitude – None when they cannot be determined."""
        if not loc:
            return dict(snow_zone=None, wind_zone=None, A=None)
        key = (loc["lat"], loc["lon"], loc.get("alt"))
        if key not in _AUTO_CACHE:
            zs = zone_lookup("snow", loc["lon"], loc["lat"])["zone"]
            zw = zone_lookup("wind", loc["lon"], loc["lat"])["zone"]
            _AUTO_CACHE[key] = dict(snow_zone=str(zs) if zs else None, wind_zone=str(zw) if zw else None,
                                    A=f"{max(loc['alt'], 0):.0f}" if loc.get("alt") is not None else None)
        return dict(_AUTO_CACHE[key])

    def _put_location(self, loc):
        """Location to the form: zones and altitude from the map."""
        self.loc.set(loc)
        self.restore_location()

    def restore_location(self):
        """Przywróć: zones and altitude from the map (undo manual changes)."""
        au = self._auto_values(self.loc.get())
        if au["snow_zone"]:
            self.snow_zone.set(au["snow_zone"])
        if au["wind_zone"]:
            self.wind_zone.set(au["wind_zone"])
        if au["A"] is not None:
            self.v["A"].set(au["A"])

    def set_project_location(self, loc):
        """New project location: both code loads panels and all cases."""
        host = self.host
        for app in (host, host.editor):
            if app is not None:
                app._put_location(loc)
        au = self._auto_values(loc)
        for c in host.project["cases"]:
            if c["extra"].get("mode") == "własne":     # no location
                continue
            st = c["state"]
            st["lokalizacja"] = loc
            st["strefy_recznie"] = False
            op = st.setdefault("opcje", {})
            if au["snow_zone"]:
                op["snow_zone"] = au["snow_zone"]
            if au["wind_zone"]:
                op["wind_zone"] = au["wind_zone"]
            if au["A"] is not None:
                st.setdefault("pola", {})["A"] = au["A"]
            c["_calc"] = None                        # recalculated when the card is expanded / printed
        if host._pending:
            host.recalc()
        host.project["globals"] = host._globals_of(host.get_state())
        host.pw.refresh_cases()

    def _manual_flags(self):
        """Which map values were changed by hand: dict(snow_zone, wind_zone, A) → bool."""
        au = self._auto_values(self.loc.get())
        fl = dict(snow_zone=bool(au["snow_zone"]) and self.snow_zone.get() != au["snow_zone"],
                  wind_zone=bool(au["wind_zone"]) and self.wind_zone.get() != au["wind_zone"])
        a_now = parse_num(self.v["A"].get())
        fl["A"] = au["A"] is not None and (a_now is None or abs(a_now - float(au["A"])) > 1e-9)
        return fl

    def update_title(self):
        """Main window: only the project name (KAYENN icon next to the title). No module names."""
        star = "*" if self.dirty else ""
        self.win.setWindowTitle("Obciążenia normowe" + self.edit_suffix())
        self._title3d()
        if getattr(self, "pw", None) is not None:
            self.pw.setWindowTitle(f"{star}{self.project_title()}")

    def edit_suffix(self):
        ed = getattr(self, "editing", None)
        return f" – edycja: {ed['name']}" if ed else ""

    def _title3d(self):
        if getattr(self, "win3d", None) is not None:
            mode = self.mode3d.get()
            self.win3d.setWindowTitle("Model 3D – " + ("wiatr" if mode == "wiatr" else "śnieg") + self.edit_suffix())

    def _ask_save(self):
        """Save question – only when the project (cases) changed, not the code loads form.
        True – may continue; False – cancelled."""
        if not self.dirty or (not self.project_path and not self.project["cases"] and not self.project.get("name")):
            return True
        B = QMessageBox.StandardButton
        ans = QMessageBox.question(self._front(), "KAYENN", "Zapisać zmiany w bieżącym projekcie?",
                                   B.Yes | B.No | B.Cancel, B.Yes)
        if ans == B.Cancel:
            return False
        if ans == B.Yes:
            return self.file_save()
        return True

    def quit_app(self):
        """End of the program (Plik → Zakończ or closing the main window). False – the user cancelled."""
        if self.host is not self:
            return self.host.quit_app()
        if getattr(self, "_quitting", False):
            return True
        if not self.end_editor():                    # unsaved case editing – first to the project
            return False
        if not self._ask_save():
            return False
        for lw in (getattr(self, "lab", None), getattr(self, "lab_ed", None)):
            db = getattr(lw, "_db", None)             # material database with unsaved changes – the question
            if db is not None and not db.confirm_close():
                return False
        self._quitting = True
        for app in (self.editor, self):
            if app is None:
                continue
            app._quitting = True
            for w in (app.win3d, getattr(app, "win_ass", None), app.win):
                if w is not None:
                    w.hide()
        self.pw.hide()
        QApplication.quit()
        return True

    def end_editor(self, save=True):
        """End of editing in the editing panels (code loads, own loads). False – the user stayed
        in editing."""
        ed = self.host.editor
        if ed is not None and not ed.end_edit(save):
            return False
        lw = getattr(self.host, "lab_ed", None)
        return lw is None or lw.end_edit(save)

    def edited_cases(self):
        """Cases edited in the editing panels (code loads, own loads)."""
        ed, lw = self.host.editor, getattr(self.host, "lab_ed", None)
        return [c for c in (ed.editing if ed is not None else None, lw.editing if lw is not None else None) if c]

    def edited_case(self):
        eds = self.edited_cases()
        return eds[0] if eds else None

    def file_open(self):
        if not self.end_editor() or not self._ask_save():
            return
        path, _ = QFileDialog.getOpenFileName(self._front(), "Otwórz projekt",
                                              os.path.dirname(self.project_path or ""),
                                              f"Projekt KAYENN (*{PROJECT_EXT});;Wszystkie pliki (*)")
        if path:
            self.open_path(path)

    def open_path(self, path):
        """Loads a project file (menu or double-click on a project file). True – loaded."""
        try:
            with open(path, encoding="utf-8") as fh:
                st = json.load(fh)
            if not isinstance(st, dict):
                raise ValueError("to nie jest plik projektu")
        except (OSError, ValueError) as ex:
            QMessageBox.critical(self._front(), "KAYENN", f"Nie można odczytać pliku:\n{ex}")
            return False
        self.project_path = os.path.abspath(path)
        self.set_state(st)
        self._project_load(st.get("projekt"))
        self.set_editing(None)
        self.dirty = False
        self.update_title()
        self.pw.rebuild(keep_open=False)
        self._form_reset()
        self._proj_reset()
        return True

    def file_save(self):
        if not self.project_path:
            return self.file_save_as()
        return self._write(self.project_path)

    def file_save_as(self):
        start = self.project_path or ("projekt" + PROJECT_EXT)
        path, _ = QFileDialog.getSaveFileName(self._front(), "Zapisz projekt jako", start,
                                              f"Projekt KAYENN (*{PROJECT_EXT})")
        if not path:
            return False
        if not path.lower().endswith(PROJECT_EXT):
            path += PROJECT_EXT
        return self._write(path)

    def _write(self, path):
        try:
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(dict(self.get_state(), projekt=self._project_dump()), fh, ensure_ascii=False, indent=2)
        except OSError as ex:
            QMessageBox.critical(self._front(), "KAYENN", f"Nie można zapisać pliku:\n{ex}")
            return False
        self.project_path = path
        self.dirty = False
        self.host.proj_hist.mark_saved()
        self.update_title()
        return True

    def on_close(self):
        self.quit_app()

    def show_assumptions(self):
        """Calculation assumptions in a separate, resizable window."""
        d = getattr(self, "win_ass", None)
        if d is None:
            d = QDialog(self.win)
            d.setWindowTitle("Założenia do obliczeń")
            d.setWindowFlag(Qt.WindowType.WindowMaximizeButtonHint, True)
            d.setWindowFlag(Qt.WindowType.WindowContextHelpButtonHint, False)
            d.resize(820, 640)
            lay = QVBoxLayout(d)
            t = no_tr(QTextBrowser())                 # its own text in every language (ASSUMPTIONS_EN)
            t.setOpenLinks(False)
            self._ass_view = t
            self._fill_assumptions()
            lay.addWidget(t, 1)
            b = QPushButton("Zamknij")
            b.clicked.connect(lambda checked=False: d.close())
            hb = QHBoxLayout()
            hb.addStretch(1)
            hb.addWidget(b)
            lay.addLayout(hb)
            self.win_ass = d
        d.show()
        d.raise_()
        d.activateWindow()

    def _fill_assumptions(self):
        """The assumptions text of the current language as HTML (continuation lines joined – wrapping follows
        the window)."""
        t = getattr(self, "_ass_view", None)
        if t is None:
            return
        lines = []
        for ln in (ASSUMPTIONS_EN if LANG == "en" else ASSUMPTIONS).split("\n"):
            if ln.startswith("  ") and lines:
                lines[-1] += " " + ln.strip()
            else:
                lines.append(ln)
        out = []
        for i, ln in enumerate(lines):
            nxt = lines[i + 1] if i + 1 < len(lines) else ""
            e = html.escape(ln)
            if set(nxt.strip()) == {"="}:
                out.append(f'<h2 style="margin:4px 0 6px 0;">{e}</h2>')
            elif set(ln.strip()) == {"="} or not ln.strip():
                continue
            elif ln.isupper() or ln[:5].isupper() and " – " in ln and not ln.startswith(("•", " ")):
                out.append(f'<h3 style="margin:14px 0 4px 0;">{e}</h3>')
            elif ln.startswith("•"):
                out.append(f'<p style="margin:2px 0 3px 18px; text-indent:-12px;">{e}</p>')
            else:
                out.append(f'<p style="margin:12px 0 2px 0;">{e}</p>')
        t.setHtml("".join(out))

