        self.form = None
        self.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.customContextMenuRequested.connect(lambda pos: self.dlg.tile_menu(self, self.mapToGlobal(pos)))
        self.show_view()

    def show_view(self):
        it = self.dlg.mats[self.key]
        if self.form is not None:
            self.lay.removeWidget(self.form)
            self.form.hide()
            self.form.deleteLater()
            self.form = None
        v = QWidget()
        h = QHBoxLayout(v)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(8)
        hd = QLabel("⠿")                                 # dragging: order, to the right – indent
        hd.setObjectName("dragHandle")
