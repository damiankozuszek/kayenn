    # --- dragging by the ⠿ handle (like case cards in the main window)
    def _drag_press(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_start = e.globalPosition()
            self.handle.setCursor(Qt.CursorShape.ClosedHandCursor)

    def _drag_move(self, e):
        if self._drag_start is None:
            return
        lst = self.win.list
        if lst.dragging is None:
            if (e.globalPosition() - self._drag_start).manhattanLength() < 4:
                return
            lst.begin_drag(self, self._drag_start)
        lst.drag_to(e.globalPosition())

    def _drag_release(self, e):
        self._drag_start = None
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        if self.win.list.dragging is self:
            self.win.list.end_drag()

    # --- changes
    def _echo(self, field, getter, now=False):
        """A change typed by the user – at once for a choice, for typed text after a short pause in typing the console gets „LABFIELD n field value”."""
        app = self.win.app
        if app.host.cmd is None or app.host.cmd.depth:
            return
        t = self.__dict__.get("_etimers", {}).get(field)
        if t is None:
            t = self.__dict__.setdefault("_etimers", {})[field] = QTimer(self)
            t.setSingleShot(True)
            t.setInterval(300)
            t.timeout.connect(lambda t=t, field=field: self.win.rows and self in self.win.rows and app.echo(
                f"LABFIELD {self.win.rows.index(self) + 1} {field} {cq(t._g() or '-')}"))
        t._g = getter
        if now:
            t.stop()
            t.timeout.emit()
        else:
            t.start()

    def flush_echo(self):
        """Field left / Enter: what was typed goes to the console at once."""
        for t in self.__dict__.get("_etimers", {}).values():
            if t.isActive():
                t.stop()
                t.timeout.emit()

    def _name(self, t):
        self.item["nazwa"] = t
        self._echo("NAME", self.name.text)
        self.win.changed()

    def _val(self, t):
        self.item["wartosc"] = t
        self._echo("VALUE", self.val.text)
        if self.item.get("przedzial"):
            self.item["przedzial"] = ""                # value changed by hand – no range information
            self.info.setText(" · ".join(x for x in (self.item.get("kategoria", ""), self.item.get("zrodlo", "")) if x))
        self.win.changed()

    def _mult(self, t):
        self.item["mnoznik"] = t.strip()
        self._echo("MULTIPLIER", self.mult.text)
        self.win.changed()

    def _unit(self, i):
        self.item["jedn"] = LAB_UNITS[self.unit.itemData(i)]
        self._echo("UNIT", lambda: self.item["jedn"], now=True)
        self._show_dims()
        self.win.changed()

    def _dim(self, k):
        box, ch, e = self.dims[k]
        e.setEnabled(ch.isChecked())
        self.item.setdefault("wym", {})[k] = [ch.isChecked(), e.text().strip()]
        self._echo({"t": "THICKNESS", "b": "WIDTH", "d": "LENGTH"}[k],
                   lambda ch=ch, e=e: e.text().strip() if ch.isChecked() else "-")
        self.win.changed()

    def _show_dims(self):
        exp = unit_exp(self.item.get("jedn"))
        ok = {k for k, _ in lab_dims(exp if exp is not None else 0)}
        for k, (box, ch, e) in self.dims.items():
            box.setVisible(k in ok)

    def add_to_db(self):
        """Dodaj do bazy – dialog with category (suggested) and source; the item goes into its category."""
        if parse_num(self.val.text()) is None or not self.name.text().strip():
            QMessageBox.warning(self.win, "Dodaj do bazy", "Podaj nazwę i poprawną wartość obciążenia.")
            return None
        d = MatAddDialog(self.win, self.item)
        d.accepted.connect(lambda d=d: self._added(d.mat))
        self._add_dlg = d                                  # (tests)
        d.show()
        return d

    def _added(self, mat):
        self.win.app.echo(f"LABTODB {self.win.rows.index(self) + 1} {cq(mat['cat'])} {cq(mat['src'])}"
                          if self in self.win.rows else "LABTODB")
        if self.win._db is not None:
            if self.win._db.dirty():                     # unsaved changes there – the item is added to them too
                self.win._db.add_loaded(mat)
            else:
                self.win._db.load(mat_active_file())
        self.win.info_msg(f"Dodano do bazy materiałów: „{mat['name']}” ({mat['value']} {mat['unit']}, "
                          f"kategoria „{mat['cat']}”).")

    def update_result(self, i, r):
        self.num.setText(f"{i + 1}.")
        if r["ok"]:
            res = f"<b>{lab_fmt(r['val'])} {r['unit']}</b>"
            self.res.setText(f"{html.escape(r['expr'])} = {res}" if r["expr"] else res)
            self.res.setStyleSheet("")
        else:
            self.res.setText(html.escape(r["err"]))
            self.res.setStyleSheet("color:#b91c1c;")
        self.val.setProperty("bad", parse_num(self.val.text()) is None)
        self.val.style().unpolish(self.val)
        self.val.style().polish(self.val)


