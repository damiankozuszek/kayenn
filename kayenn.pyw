class TableData:
    """Summary table inserted into the report (HTML); interface of the former table: delete / insert."""

    def __init__(self, heads, left_cols):
        self.heads, self.left, self.rows = list(heads), set(left_cols), []

    def get_children(self):
        return ()

    def delete(self, *a):
        self.rows = []

    def insert(self, parent, index, values=(), tags=()):
        self.rows.append(([str(v) for v in values], tuple(tags)))


class Tree(QTreeWidget):
    """Results table (interface compatible with the existing code: delete / insert)."""

    def __init__(self, heads, widths, stretch_col, left_cols):
        super().__init__()
        self.setColumnCount(len(heads))
        self.setHeaderLabels(list(heads))
        self.setRootIsDecorated(False)
        self.setUniformRowHeights(True)
        self.setSelectionMode(QAbstractItemView.SelectionMode.NoSelection)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self._left = set(left_cols)
        hd = self.header()
        hd.setStretchLastSection(False)
        hd.setDefaultAlignment(Qt.AlignmentFlag.AlignCenter)
        for i, w in enumerate(widths):
            self.setColumnWidth(i, int(w * 1.15))
            hd.setSectionResizeMode(i, QHeaderView.ResizeMode.Stretch if i == stretch_col
                                    else QHeaderView.ResizeMode.Interactive)
        self._sv = 0

    def get_children(self):
        return ()

    def delete(self, *a):
        self._sv = self.verticalScrollBar().value()
        self.setUpdatesEnabled(False)
        self.clear()
        QTimer.singleShot(0, self._restore)

    def _restore(self):
        self.verticalScrollBar().setValue(self._sv)
        self.setUpdatesEnabled(True)

    def insert(self, parent, index, values=(), tags=()):
        it = QTreeWidgetItem([str(v) for v in values])
        col = None
        if "neg" in tags:
            col = QColor("#1d4ed8")
        elif "pos" in tags:
            col = QColor("#b91c1c")
        for c in range(len(values)):
            it.setTextAlignment(c, AL_L if c in self._left else AL_R)
            if col is not None:
                it.setForeground(c, QBrush(col))
            if "sep" in tags:
                it.setBackground(c, QBrush(QColor("#f1f3f5")))
        if "sep" in tags:
            f = it.font(0)
            f.setBold(True)
            it.setFont(0, f)
        self.addTopLevelItem(it)


# ------------------------------------------------- 3D canvas (API like tk.Canvas) ---
_FONTS = {}
_METRICS = {}


def qfont(spec):
    spec = tuple(spec)
    f = _FONTS.get(spec)
    if f is None:
        f = QFont(spec[0])
        f.setPointSizeF(float(spec[1]) * UI_PT)
        f.setBold("bold" in spec[2:])
        _FONTS[spec] = f
    return f


class _Ev:
    def __init__(self, x, y):
        self.x, self.y = x, y


# ======================================================= 3D drawing on the graphics card (VTK) ===
# The faces of a 3D scene (building, load layers, ground or terrain) are drawn by VTK (OpenGL, off screen) into an
# image that Canvas3D paints first; dimensions, labels, arrows and the legend are painted over it by QPainter as
# before, with exactly the same projection (VTK parallel camera = the program's orthographic view). One shared
# off-screen window serves every canvas (3D window, card previews, printout). No VTK / no OpenGL 3.2 / switched off
# (Plik → Opcje, RENDERER BASIC, KAYENN_RENDERER=basic) – Canvas3D draws the faces itself (the basic renderer).
def renderer_choice():
    env = (os.environ.get("KAYENN_RENDERER") or "").strip().lower()
    if env in ("basic", "vtk"):
        return env
    return "basic" if settings_get("renderer", "vtk") == "basic" else "vtk"


class VtkScene:
    _inst = None
    _failed = None                                   # the reason VTK cannot be used (None – not tried / fine)

    @classmethod
    def get(cls):
        """The shared VTK renderer, or None (the basic renderer draws the faces)."""
        if renderer_choice() != "vtk" or cls._failed:
            return None
        if cls._inst is None:
            if not cls.probe():
                return None
            try:
                cls._inst = cls()
            except Exception as e:                   # no VTK, no OpenGL 3.2 (e.g. a virtual machine)
                cls._failed = str(e) or type(e).__name__
                return None
        return cls._inst

    PROBE_OK_DAYS, PROBE_FAIL_DAYS = 30, 1

    @classmethod
    def probe(cls):
        """Can VTK draw on this computer? Checked in a separate short process (`--vtk-probe`): without a usable
        OpenGL driver (a virtual machine, a remote desktop, an old driver) VTK can crash the whole process instead of
        raising an error – the program must not go down with it. The answer is remembered in settings.json
        (`vtk_probe`: a success for 30 days, a failure is checked again the next day; per VTK version and program)."""
        import subprocess
        try:
            from vtkmodules.vtkCommonCore import vtkVersion
            ver = vtkVersion.GetVTKVersion()
        except Exception as e:                       # VTK not installed (running from source without it)
            cls._failed = f"brak biblioteki VTK ({type(e).__name__})"
            return False
        key = f"{ver}|{sys.executable}"
        c = settings_get("vtk_probe") or {}
        age = time.time() - float(c.get("t", 0) or 0) if isinstance(c, dict) else 1e12
        if isinstance(c, dict) and c.get("key") == key and age < (cls.PROBE_OK_DAYS if c.get("ok") else
                                                                    cls.PROBE_FAIL_DAYS) * 86400:
            if not c.get("ok"):
                cls._failed = c.get("why") or "OpenGL 3.2 niedostępny"
            return bool(c.get("ok"))
        argv = [sys.executable] + ([] if FROZEN else [os.path.abspath(__file__)]) + ["--vtk-probe"]
        kw = dict(capture_output=True, timeout=40)
        if sys.platform == "win32":
            kw["creationflags"] = 0x08000000           # no console window
        try:
            r = subprocess.run(argv, **kw)
            ok = r.returncode == 0
            why = "" if ok else f"OpenGL 3.2 niedostępny (test: kod {r.returncode})"
        except (OSError, subprocess.SubprocessError) as e:
            ok, why = False, f"test VTK nieudany ({type(e).__name__})"
        settings_set("vtk_probe", dict(key=key, ok=ok, t=time.time(), why=why))
        if not ok:
            cls._failed = why
        return ok

    @staticmethod
    def probe_main():
        """`kayenn --vtk-probe`: a tiny off-screen VTK picture; exit code 0 – VTK works here (else it crashes or
        returns 3)."""
        try:
            import vtkmodules.vtkRenderingOpenGL2          # noqa: F401
            from vtkmodules.vtkCommonCore import vtkPoints
            from vtkmodules.vtkCommonDataModel import vtkPolyData, vtkCellArray
            from vtkmodules.vtkRenderingCore import vtkRenderer, vtkRenderWindow, vtkActor, vtkPolyDataMapper
            rw = vtkRenderWindow()
            rw.SetOffScreenRendering(1)
            rw.SetSize(64, 64)
            ren = vtkRenderer()
            ren.SetUseDepthPeeling(1)
            rw.AddRenderer(ren)
            pts, cells = vtkPoints(), vtkCellArray()
            cells.InsertNextCell(3)
            for q in ((0, 0, 0), (1, 0, 0), (0, 1, 0)):
                cells.InsertCellPoint(pts.InsertNextPoint(*q))
            pd = vtkPolyData()
            pd.SetPoints(pts)
            pd.SetPolys(cells)
            mp = vtkPolyDataMapper()
            mp.SetInputData(pd)
            act = vtkActor()
            act.SetMapper(mp)
            ren.AddActor(act)
            rw.Render()
            ok = not hasattr(rw, "SupportsOpenGL") or rw.SupportsOpenGL()
        except Exception:
            ok = False
        os._exit(0 if ok else 3)

    @classmethod
    def status(cls):
        """Text for the console / options: which renderer draws the 3D models."""
        if renderer_choice() != "vtk":
            return "prosty (bez karty graficznej) – wybrany w opcjach"
        v = cls.get()
        if v is None:
            return f"prosty – VTK niedostępne ({cls._failed})"
        return f"VTK {v.version} (karta graficzna, OpenGL)"

    def __init__(self):
        import vtkmodules.vtkRenderingOpenGL2          # noqa: F401 – registers the OpenGL implementation
        from vtkmodules.vtkCommonCore import vtkVersion
        from vtkmodules.vtkRenderingCore import vtkRenderer, vtkRenderWindow, vtkLight
        self.version = vtkVersion.GetVTKVersion()
        rw = vtkRenderWindow()
        rw.SetOffScreenRendering(1)
        rw.SetMultiSamples(0)
        rw.SetAlphaBitPlanes(1)
        rw.SetSize(32, 32)
        ren = vtkRenderer()
        ren.SetUseDepthPeeling(1)                    # translucent load layers in the right order (no sorting)
        ren.SetMaximumNumberOfPeels(10)
        ren.SetOcclusionRatio(0.0)
        ren.SetUseFXAA(True)                         # smooth edges
        ren.AutomaticLightCreationOff()
        for pos, inten in (((-0.55, -0.85, 1.0), 0.62), ((0.7, 0.4, 0.6), 0.22)):   # key and fill light (world)
            lt = vtkLight()
            lt.SetLightTypeToSceneLight()
            lt.SetPositional(False)
            lt.SetPosition(*pos)
            lt.SetFocalPoint(0, 0, 0)
            lt.SetIntensity(inten)
            ren.AddLight(lt)
        head = vtkLight()
        head.SetLightTypeToHeadlight()
        head.SetIntensity(0.28)
        ren.AddLight(head)
        rw.AddRenderer(ren)
        rw.Render()
        if hasattr(rw, "SupportsOpenGL") and not rw.SupportsOpenGL():
            raise RuntimeError("OpenGL 3.2 niedostępny")
        self.rw, self.ren = rw, ren
        self._actors = []

    @staticmethod
    def _rgb(c):
        c = QColor(c or "#cccccc")
        return c.red(), c.green(), c.blue()

    def _build(self, polys, edges):
        """polys: [(points3d, fill, alpha 0–255 or None, lit)], edges: [(a3d, b3d, color, width)] → actors.
        No normals are given: VTK takes the face normal on the viewer's side (flat shading), so every visible face
        is lit the same way whatever the order of its points. Unlit faces (the flat ground) keep their colour."""
        from vtkmodules.vtkCommonCore import vtkPoints, vtkUnsignedCharArray
        from vtkmodules.vtkCommonDataModel import vtkPolyData, vtkCellArray
        from vtkmodules.vtkRenderingCore import vtkActor, vtkPolyDataMapper
        out = []
        for want_opaque, want_lit in ((True, False), (True, True), (False, True)):
            pts, cells = vtkPoints(), vtkCellArray()
            cols = vtkUnsignedCharArray()
            cols.SetNumberOfComponents(4)
            cols.SetName("rgba")
            n_ = 0
            for P, fill, alpha, lit in polys:
                a = 255 if alpha is None else int(alpha)
                if (a >= 255) != want_opaque or (want_opaque and bool(lit) != want_lit) or len(P) < 3:
                    continue
                cells.InsertNextCell(len(P))
                for q in P:
                    cells.InsertCellPoint(pts.InsertNextPoint(*q))
                r, g, b = self._rgb(fill)
                cols.InsertNextTuple4(r, g, b, a)
                n_ += 1
            if not n_:
                continue
            pd = vtkPolyData()
            pd.SetPoints(pts)
            pd.SetPolys(cells)
            pd.GetCellData().SetScalars(cols)
            mp = vtkPolyDataMapper()
            mp.SetInputData(pd)
            mp.SetScalarModeToUseCellData()
            mp.SetColorModeToDirectScalars()
            mp.SetResolveCoincidentTopologyToPolygonOffset()
            mp.SetRelativeCoincidentTopologyPolygonOffsetParameters(1.0, 1.0)
            act = vtkActor()
            act.SetMapper(mp)
            pr = act.GetProperty()
            pr.SetInterpolationToFlat()
            if not want_lit:
                pr.LightingOff()
            else:
                pr.SetAmbient(0.55 if want_opaque else 0.62)
                pr.SetDiffuse(0.55 if want_opaque else 0.45)
                pr.SetSpecular(0.0 if want_opaque else 0.12)
                pr.SetSpecularPower(18)
            pr.BackfaceCullingOff()
            out.append(act)
        by_w = {}
        for a3, b3, col, w in edges:
            by_w.setdefault(float(w), []).append((a3, b3, col))
        for w, segs in by_w.items():
            pts, cells = vtkPoints(), vtkCellArray()
            cols = vtkUnsignedCharArray()
            cols.SetNumberOfComponents(3)
            for a3, b3, col in segs:
                cells.InsertNextCell(2)
                cells.InsertCellPoint(pts.InsertNextPoint(*a3))
                cells.InsertCellPoint(pts.InsertNextPoint(*b3))
                cols.InsertNextTuple3(*self._rgb(col))
            pd = vtkPolyData()
            pd.SetPoints(pts)
            pd.SetLines(cells)
            pd.GetCellData().SetScalars(cols)
            mp = vtkPolyDataMapper()
            mp.SetInputData(pd)
            mp.SetScalarModeToUseCellData()
            mp.SetColorModeToDirectScalars()
            act = vtkActor()
            act.SetMapper(mp)
            pr = act.GetProperty()
            pr.SetLineWidth(w)
            pr.LightingOff()
            out.append(act)
        return out

    def image(self, scene, w, h, dpr=1.0):
        """QImage w×h (logical px, painted at dpr) of the scene: dict(polys, edges, proj, bg)."""
        from PySide6.QtGui import QImage
        from vtkmodules.vtkRenderingCore import vtkWindowToImageFilter
        W, H = max(int(round(w * dpr)), 8), max(int(round(h * dpr)), 8)
        ren, rw = self.ren, self.rw
        for a in self._actors:
            ren.RemoveActor(a)
        edges = [(a3, b3, col, wd * dpr) for a3, b3, col, wd in scene["edges"]]
        self._actors = self._build(scene["polys"], edges)
        for a in self._actors:
            ren.AddActor(a)
        bg = QColor(scene.get("bg") or "#fbfbfc")
        ren.SetBackground(bg.redF(), bg.greenF(), bg.blueF())
        ren.SetBackgroundAlpha(1.0)
        # the camera = the program's view: P(p) → (ox + xr·sc, oy − (z·cp + yr·sp)·sc), depth yr·cp − z·sp
        ctr, sc, cy, sy, cp, sp, ox, oy, PW, PH = scene["proj"]
        R = (cy, -sy, 0.0)
        U = (sy * sp, cy * sp, cp)
        D = (sy * cp, cy * cp, -sp)
        cx_, cy_ = PW / 2.0, PH / 2.0
        a_ = (cx_ - ox) / sc
        b_ = (oy - cy_) / sc
        f = tuple(ctr[i] + R[i] * a_ + U[i] * b_ for i in range(3))
        cam = ren.GetActiveCamera()
        cam.ParallelProjectionOn()
        dist = 1000.0
        cam.SetFocalPoint(*f)
        cam.SetPosition(*(f[i] - D[i] * dist for i in range(3)))
        cam.SetViewUp(*U)
        cam.SetParallelScale(PH / 2.0 / sc)
        ren.ResetCameraClippingRange()
        rw.SetSize(W, H)
        rw.Render()
        wi = vtkWindowToImageFilter()
        wi.SetInput(rw)
        wi.SetInputBufferTypeToRGB()
        wi.ReadFrontBufferOff()
        wi.ShouldRerenderOff()
        wi.Update()
        img = wi.GetOutput()
        arr = img.GetPointData().GetScalars()
        nx, ny, _ = img.GetDimensions()
        data = bytes(memoryview(arr))
        q = QImage(data, nx, ny, nx * 3, QImage.Format.Format_RGB888)
        q = (q.flipped(Qt.Orientation.Vertical) if hasattr(q, "flipped") else q.mirrored(False, True)).copy()
        q.setDevicePixelRatio(dpr)
        return q


class Canvas3D(QWidget):
    """List of drawing items (polygons, lines, texts…) painted with QPainter.
    The create_* / bbox / delete / tag_raise methods follow tk.Canvas."""

    BG_COL = "#fbfbfc"

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.items = {}
        self.order = []
        self._nid = 0
        self._drag = None
        self.setMouseTracking(True)
        self.setMinimumSize(200, 150)
        self.setAttribute(Qt.WidgetAttribute.WA_AcceptTouchEvents, True)
        self.grabGesture(Qt.GestureType.PinchGesture)        # touch screen: two fingers – zoom and pan

    # --- tk-like API
    def winfo_width(self):
        return self.width()

    def winfo_height(self):
        return self.height()

    def configure(self, cursor=None, **kw):
        if cursor is not None:
            shapes = {"fleur": Qt.CursorShape.SizeAllCursor, "hand2": Qt.CursorShape.PointingHandCursor}
            if cursor in shapes:
                self.setCursor(shapes[cursor])
            else:
                self.unsetCursor()

    def _add(self, it):
        self._nid += 1
        it["tags"] = set()
        self.items[self._nid] = it
        self.order.append(self._nid)
        return self._nid

    @staticmethod
    def _pairs(coords):
        if len(coords) == 1 and isinstance(coords[0], (list, tuple)):
            coords = coords[0]
        return [(float(coords[i]), float(coords[i + 1])) for i in range(0, len(coords) - 1, 2)]

    def delete(self, what):
        if what == "all":
            self.items.clear()
            self.order.clear()
        elif what in self.items:
            del self.items[what]
            self.order.remove(what)

    def create_polygon(self, *coords, fill="", outline="", width=1, alpha=None, edges=None, **kw):
        """alpha – fill opacity 0–255; edges – which edges to outline (None – all)."""
        return self._add(dict(k="poly", pts=self._pairs(coords), fill=fill, outline=outline, width=width,
                              alpha=alpha, edges=edges))

    def create_line(self, *coords, fill="#000000", width=1, dash=None, arrow=None, arrowshape=(8, 10, 3), **kw):
        return self._add(dict(k="line", pts=self._pairs(coords), fill=fill, width=width, dash=dash,
                              arrow=arrow, ashape=arrowshape))

    def create_rectangle(self, x0, y0, x1, y1, fill="", outline="#000000", dash=None, stipple="", width=1, **kw):
        return self._add(dict(k="rect", box=(x0, y0, x1, y1), fill=fill, outline=outline, dash=dash,
                              stipple=stipple, width=width))

    def create_oval(self, x0, y0, x1, y1, fill="", outline="#000000", width=1, **kw):
        return self._add(dict(k="oval", box=(x0, y0, x1, y1), fill=fill, outline=outline, width=width))

    def create_scene3d(self, scene):
        """The faces of the 3D scene drawn by VTK (`VtkScene`) – painted where this item stands in the order (the
        items added after it are painted over it). scene["flat"] – the same faces projected, painted by QPainter
        when VTK fails."""
        return self._add(dict(k="scene3d", scene=scene, img=None, key=None))

    def create_text(self, x, y, text="", font=(FONT, 9), fill="#000000", anchor="center", justify="center", **kw):
        fm = _METRICS.get(tuple(font))
        if fm is None:
            fm = _METRICS[tuple(font)] = QFontMetricsF(qfont(font))
        lines = str(text).split("\n")
        widths = [fm.horizontalAdvance(l) for l in lines]
        lh = fm.height()
        bw, bh = max(widths), lh * len(lines)
        if anchor == "center":
            x0, y0 = x - bw / 2, y - bh / 2
        else:
            x0 = x if "w" in anchor else (x - bw if "e" in anchor else x - bw / 2)
            y0 = y if "n" in anchor else (y - bh if "s" in anchor else y - bh / 2)
        return self._add(dict(k="text", lines=lines, widths=widths, x0=x0, y0=y0, bw=bw, lh=lh,
                              asc=fm.ascent(), font=font, fill=fill, justify=justify,
                              box=(x0, y0, x0 + bw, y0 + bh)))

    def bbox(self, iid):
        return self.items[iid]["box"]

    def tag_raise(self, a, b=None):
        if a not in self.items:
            return
        self.order.remove(a)
        if b is None or b not in self.items:
            self.order.append(a)
        else:
            self.order.insert(self.order.index(b) + 1, a)

    def addtag_withtag(self, tag, iid):
        if iid in self.items:
            self.items[iid]["tags"].add(tag)

    def raise_tagged(self, tag):
        """Move all items with the tag to the top, keeping their relative order."""
        top = [i for i in self.order if tag in self.items[i]["tags"]]
        if top:
            ts = set(top)
            self.order = [i for i in self.order if i not in ts] + top

    def hit(self, x, y, tag="editable"):
        """Topmost item with the given tag under point (x, y)."""
        for iid in reversed(self.order):
            it = self.items[iid]
            if tag in it["tags"] and "box" in it:
                b = it["box"]
                if b[0] - 2 <= x <= b[2] + 2 and b[1] - 2 <= y <= b[3] + 2:
                    return it
        return None

    # --- painting
    @staticmethod
    def _pen(color, width=1, dash=None):
        if not color:
            return QPen(Qt.PenStyle.NoPen)
        pen = QPen(QColor(color))
        pen.setWidthF(float(width))
        pen.setCapStyle(Qt.PenCapStyle.FlatCap)
        pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        if dash:
            w = max(float(width), 1.0)
            pen.setDashPattern([d / w for d in dash])
        return pen

    @staticmethod
    def _brush(color, stipple=""):
        if not color:
            return QBrush(Qt.BrushStyle.NoBrush)
        c = QColor(color)
        if stipple:
            c.setAlpha(190)
        return QBrush(c)

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)
        p.fillRect(QRectF(0, 0, self.width(), self.height()), QColor(self.BG_COL))
        for iid in self.order:
            it = self.items[iid]
            k = it["k"]
            if k == "scene3d":
                self._paint_scene3d(p, it)
                continue
            if k == "poly":
                br = self._brush(it["fill"])
                if it.get("alpha") is not None and it["fill"]:
                    c = QColor(it["fill"])
                    c.setAlpha(int(it["alpha"]))
                    br = QBrush(c)
                p.setBrush(br)
                pts = [QPointF(x, y) for x, y in it["pts"]]
                ed = it.get("edges")
                if ed is None:
                    p.setPen(self._pen(it["outline"], it["width"]))
                    p.drawPolygon(QPolygonF(pts))
                else:                                  # outline only the selected edges
                    p.setPen(self._pen("", 1))
                    p.drawPolygon(QPolygonF(pts))
                    p.setPen(self._pen(it["outline"], it["width"]))
                    for i_, on in enumerate(ed):
                        if on:
                            p.drawPolyline(QPolygonF([pts[i_], pts[(i_ + 1) % len(pts)]]))
            elif k == "line":
                self._paint_line(p, it)
            elif k in ("rect", "oval"):
                x0, y0, x1, y1 = it["box"]
                p.setPen(self._pen(it["outline"], it["width"], it.get("dash")))
                p.setBrush(self._brush(it["fill"], it.get("stipple", "")))
                r = QRectF(x0, y0, x1 - x0, y1 - y0)
                if k == "rect":
                    p.drawRect(r)
                else:
                    p.drawEllipse(r)
            elif k == "text":
                p.setFont(qfont(it["font"]))
                p.setPen(QColor(it["fill"]))
                for i, (ln, w) in enumerate(zip(it["lines"], it["widths"])):
                    if it["justify"] == "left":
                        lx = it["x0"]
                    elif it["justify"] == "right":
                        lx = it["x0"] + it["bw"] - w
                    else:
                        lx = it["x0"] + (it["bw"] - w) / 2
                    p.drawText(QPointF(lx, it["y0"] + i * it["lh"] + it["asc"]), ln)
        p.setPen(QColor("#d5d9df"))
        p.setBrush(QBrush(Qt.BrushStyle.NoBrush))
        p.drawRect(QRectF(0.5, 0.5, self.width() - 1, self.height() - 1))
        p.end()

    def _paint_scene3d(self, p, it):
        dpr = p.device().devicePixelRatioF() if p.device() is not None else 1.0
        key = (self.width(), self.height(), round(dpr, 3))
        if it["key"] != key:
            it["key"], it["img"] = key, None
            v = VtkScene.get()
            if v is not None:
                try:
                    it["img"] = v.image(it["scene"], self.width(), self.height(), dpr)
                except Exception as e:               # the driver failed – the basic renderer from now on
                    VtkScene._failed = str(e) or type(e).__name__
        if it["img"] is not None:
            p.drawImage(QRectF(0, 0, self.width(), self.height()), it["img"])
            return
        for pts, fill, outline, alpha, edges, width in it["scene"]["flat"]:
            fake = dict(fill=fill, outline=outline, alpha=alpha, edges=edges, width=width, pts=pts)
            br = self._brush(fill)
            if alpha is not None and fill:
                c = QColor(fill)
                c.setAlpha(int(alpha))
                br = QBrush(c)
            p.setBrush(br)
            qp = [QPointF(x, y) for x, y in pts]
            if edges is None:
                p.setPen(self._pen(outline, width))
                p.drawPolygon(QPolygonF(qp))
            else:
                p.setPen(self._pen("", 1))
                p.drawPolygon(QPolygonF(qp))
                p.setPen(self._pen(outline, width))
                for i_, on in enumerate(edges):
                    if on:
                        p.drawPolyline(QPolygonF([qp[i_], qp[(i_ + 1) % len(qp)]]))
            del fake

    def _paint_line(self, p, it):
        pts = list(it["pts"])
        if len(pts) < 2:
            return
        w = float(it["width"])
        head = None
        if it.get("arrow") == "last":
            (ax, ay), (bx, by) = pts[-2], pts[-1]
            L = math.hypot(bx - ax, by - ay)
            if L > 1e-6:
                d1, d2, d3 = it["ashape"]
                ux, uy = (bx - ax) / L, (by - ay) / L
                nx, ny = -uy, ux
                d3 += w / 2
                neck = (bx - ux * d1, by - uy * d1)
                head = [(bx, by), (bx - ux * d2 + nx * d3, by - uy * d2 + ny * d3), neck,
                        (bx - ux * d2 - nx * d3, by - uy * d2 - ny * d3)]
                pts[-1] = neck
        p.setPen(self._pen(it["fill"], w, it.get("dash")))
        p.setBrush(QBrush(Qt.BrushStyle.NoBrush))
        p.drawPolyline(QPolygonF([QPointF(x, y) for x, y in pts]))
        if head:
            p.setPen(QPen(Qt.PenStyle.NoPen))
            p.setBrush(QBrush(QColor(it["fill"])))
            p.drawPolygon(QPolygonF([QPointF(x, y) for x, y in head]))

    # --- mouse
    @staticmethod
    def _xy(e):
        pos = e.position()
        return pos.x(), pos.y()

    def mousePressEvent(self, e):
        x, y = self._xy(e)
        b = e.button()
        shift = bool(e.modifiers() & Qt.KeyboardModifier.ShiftModifier)
        if b == Qt.MouseButton.MiddleButton or (b == Qt.MouseButton.LeftButton and shift):
            self._drag = "pan"
            self.app._pan_press(_Ev(x, y))
        elif b == Qt.MouseButton.LeftButton:
            self._drag = "rot"
            self.app._press(_Ev(x, y))

    def mouseMoveEvent(self, e):
        x, y = self._xy(e)
        if self._drag == "pan":
            self.app._pan(_Ev(x, y))
        elif self._drag == "rot":
            self.app._rotate(_Ev(x, y))
        else:
            if self.hit(x, y):
                self.setCursor(Qt.CursorShape.PointingHandCursor)
            else:
                self.unsetCursor()

    def mouseReleaseEvent(self, e):
        x, y = self._xy(e)
        d, self._drag = self._drag, None
        self.unsetCursor()
        if d == "rot" and not getattr(self.app, "_moved", False):
            it = self.hit(x, y)
            if it:
                tag = next((t for t in it["tags"] if t.startswith("edit") and t != "editable"), None)
                if tag and tag in self.app._edit_keys:
                    key, pos = self.app._edit_keys[tag]
                    self.app.open_editor(key, pos)

    def wheelEvent(self, e):
        """Mouse wheel – zoom; touchpad: two-finger scroll – pan the view,
        pinch (Windows delivers it as Ctrl + wheel) – smooth zoom."""
        ad, pd = e.angleDelta(), e.pixelDelta()
        dx, dy = ad.x(), ad.y()
        at = self._xy(e)
        if e.modifiers() & Qt.KeyboardModifier.ControlModifier:
            if dy:
                self.app._zoom(1.0015 ** dy, at)
            return
        touchpad = (not pd.isNull() or e.phase() != Qt.ScrollPhase.NoScrollPhase or dx != 0
                    or (dy % 120) != 0)
        try:
            from PySide6.QtGui import QInputDevice
            dev = e.device()
            touchpad = touchpad or (dev is not None and dev.type() == QInputDevice.DeviceType.TouchPad)
        except Exception:
            pass
        if touchpad:
            if not pd.isNull():
                mx, my = pd.x(), pd.y()
            else:
                mx, my = dx * 0.5, dy * 0.5
            if mx or my:
                self.app._pan_by(mx, my)
        elif dy:
            self.app._zoom(1.1 if dy > 0 else 1 / 1.1, at)

    def event(self, e):
        t = e.type()
        if t == QEvent.Type.NativeGesture:                   # macOS / Linux: touchpad gesture
            gt = e.gestureType()
            if gt == Qt.NativeGestureType.ZoomNativeGesture:
                self.app._zoom(1.0 + e.value(), self._xy(e))
                return True
            if gt == Qt.NativeGestureType.SmartZoomNativeGesture:
                self.app.reset_view()
                return True
        elif t == QEvent.Type.Gesture:                       # touch screen: pinch
            g = e.gesture(Qt.GestureType.PinchGesture)
            if g is not None:
                sf = g.scaleFactor()
                if sf > 0:
                    c0 = self.mapFromGlobal(g.centerPoint().toPoint())
                    self.app._zoom(sf, (c0.x(), c0.y()))
                c, lc = g.centerPoint(), g.lastCenterPoint()
                self.app._pan_by(c.x() - lc.x(), c.y() - lc.y())
                e.accept()
                return True
        return super().event(e)

    def resizeEvent(self, e):
        self.app.draw3d()


class EditorLine(QLineEdit):
    def __init__(self, on_escape, on_focus_out):
        super().__init__()
        self._esc, self._fo = on_escape, on_focus_out

    def keyPressEvent(self, e):
        if e.key() == Qt.Key.Key_Escape:
            self._esc()
            return
        super().keyPressEvent(e)
        if e.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            e.accept()                               # (QLineEdit ignores Enter – the group behind would take it)

    def focusOutEvent(self, e):
        super().focusOutEvent(e)
        self._fo()


