        it.append(("r", f"{P3}, " + (SNOW_ACC_REF if acc else SNOW_SHAPE_REF.get(g.kind, ""))))
        o = s["overhang"]
        if o and not acc:
            names = {"all": "krawędzie dachu", "y0": "okap y = 0", "yB": "okap y = B"}
            for x in o["per"]:
                it.append(("v", f"sₑ = {f2(x['se'], 3)} kN/m",
