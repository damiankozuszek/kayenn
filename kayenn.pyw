VIEW_KEYS = ("yaw", "pitch", "zoom", "pan_x", "pan_y", "piv")     # piv – rotation point (None – model centre)
TOGGLE_KEYS = ("labels3d", "arrows3d", "dims3d", "bdims3d", "odims3d")


def html_body(doc):
    """Contents of <body> of an HTML document (report saved from the results field)."""
    doc = str(doc or "")
    lo = doc.lower()
    a = lo.find("<body")
    if a < 0:
        return doc
    a = lo.find(">", a) + 1
    b = lo.rfind("</body>")
    return doc[a:b if b > a else len(doc)]


class _CanvasDeactivator(QObject):
    """Click outside the active card preview – preview inactive (the wheel scrolls the list again)."""

    def eventFilter(self, obj, e):
        a = CaseCanvas.active
        if a is not None and e.type() == QEvent.Type.MouseButtonPress and isinstance(obj, QWidget)                 and obj is not a and not a.isAncestorOf(obj):
            a.set_active(False)
        return False


class CaseCanvas(Canvas3D):
    """3D preview of a saved case – rotate, pan, zoom and edit dimensions as in the 3D window.
    Wheel and gestures work only after clicking the preview (active – outline); before that the wheel
    scrolls the list of cases. Click outside the preview – inactive."""

    active = None                                    # active preview (at most one)
    _deactivator = None

    def set_active(self, on):
        if on:
            if CaseCanvas._deactivator is None:
                CaseCanvas._deactivator = _CanvasDeactivator()
                QApplication.instance().installEventFilter(CaseCanvas._deactivator)
            if CaseCanvas.active is not None and CaseCanvas.active is not self:
                CaseCanvas.active.set_active(False)
            CaseCanvas.active = self
        elif CaseCanvas.active is self:
            CaseCanvas.active = None
        self._scene_key = None                       # the hint in the corner depends on the preview state
        self.redraw()

    def is_active(self):
        return CaseCanvas.active is self

    def paintEvent(self, ev):
        super().paintEvent(ev)
        if self.is_active():
            p = QPainter(self)
            p.setPen(QPen(QColor(ACCENT), 2))
            p.drawRect(QRectF(1, 1, self.width() - 2, self.height() - 2))
            p.end()

    def hideEvent(self, e):
        if self.is_active():                         # card collapsed / removed – no redraw
            CaseCanvas.active = None
        super().hideEvent(e)

    def __init__(self, app, card, idx=0):
        super().__init__(app)
        self.card = card
        self.idx = idx                               # viewport number in the card (0 – the first)
        self.view = dict(card.vp_data(idx).get("view") or {})
        for k, v in (("yaw", math.radians(-32)), ("pitch", math.radians(24)), ("zoom", 1.0), ("pan_x", 0.0),
                     ("pan_y", 0.0)):
            self.view.setdefault(k, v)
        self._scene_key = self._scene_cache = None
        self._edit_keys = {}
        self._last = None
        self._moved = False
        self.setMinimumHeight(540)

    @property
    def vp(self):
        """Data of this viewport (view, toggles) – see CaseCard.vp_data."""
        return self.card.vp_data(self.idx)

    def redraw(self):
        self.app.render_case(self, self.card.case)
        self.update()

    def resizeEvent(self, e):
        self.redraw()

    def contextMenuEvent(self, e):
        self.card.viewport_menu(self, e.globalPos())

    def mousePressEvent(self, e):
        if not self.is_active():
            self.set_active(True)
        x, y = self._xy(e)
        b = e.button()
        shift = bool(e.modifiers() & Qt.KeyboardModifier.ShiftModifier)
        self._drag = "pan" if (b == Qt.MouseButton.MiddleButton or (b == Qt.MouseButton.LeftButton and shift)) \
            else ("rot" if b == Qt.MouseButton.LeftButton else None)
        self._last, self._moved = (x, y), False

    def mouseMoveEvent(self, e):
        x, y = self._xy(e)
        if self._drag is None or self._last is None:
            self.setCursor(Qt.CursorShape.PointingHandCursor if self.hit(x, y) else Qt.CursorShape.ArrowCursor)
            return
        lx, ly = self._last
        if self._drag == "rot":
            if abs(x - lx) + abs(y - ly) < 3 and not self._moved:
                return
            if not self._moved:
                self.app.set_pivot(self.view, self)
            self._moved = True
            self.view["yaw"] += (x - lx) * 0.01
            self.view["pitch"] = clamp(self.view["pitch"] + (y - ly) * 0.01, math.radians(2), math.radians(88))
        else:
            self._moved = True
            self.view["pan_x"] += x - lx
            self.view["pan_y"] += y - ly
        self._last = (x, y)
        self.redraw()

    def mouseReleaseEvent(self, e):
        x, y = self._xy(e)
        d, self._drag = self._drag, None
        if d == "rot" and not self._moved:
            it = self.hit(x, y)
            if it:
                tag = next((t for t in it["tags"] if t.startswith("edit") and t != "editable"), None)
                if tag and tag in self._edit_keys:
                    self.card.edit_value(self._edit_keys[tag][0])
                    return
        if self._moved:
            self.card.view_changed(self.view, self.idx)

    def wheelEvent(self, e):
        if not self.is_active():
            e.ignore()                               # inactive preview – the wheel scrolls the list of cases
            return
        ad, pd = e.angleDelta(), e.pixelDelta()
        dx, dy = ad.x(), ad.y()
        if e.modifiers() & Qt.KeyboardModifier.ControlModifier:
            f = 1.0015 ** dy if dy else 1.0
        elif not pd.isNull() or dx != 0 or (dy % 120) != 0:
            self.view["pan_x"] += pd.x() if not pd.isNull() else dx * 0.5
            self.view["pan_y"] += pd.y() if not pd.isNull() else dy * 0.5
            f = 1.0
        else:
            f = 1.1 if dy > 0 else 1 / 1.1 if dy else 1.0
        self.zoom_view(f, self._xy(e))
        self.redraw()
        self.card.view_changed(self.view, self.idx)

    def zoom_view(self, f, at):
        """Zoom by f about the point under the cursor at = (x, y)."""
        old = self.view["zoom"]
        self.view["zoom"] = clamp(old * f, getattr(self, "_zmin", ZOOM_MIN), ZOOM_MAX)
        if old > 0:
            self.view["pan_x"], self.view["pan_y"] = zoom_pan(self.view["pan_x"], self.view["pan_y"],
                                                              self.view["zoom"] / old, at, self.width(), self.height())

    def event(self, e):
        if not self.is_active() and e.type() in (QEvent.Type.NativeGesture, QEvent.Type.Gesture):
            e.ignore()                               # gestures – only after clicking the preview
            return False
        if e.type() == QEvent.Type.NativeGesture and e.gestureType() == Qt.NativeGestureType.ZoomNativeGesture:
            self.zoom_view(1.0 + e.value(), self._xy(e))
            self.redraw()
            return True
        if e.type() == QEvent.Type.Gesture:
            g = e.gesture(Qt.GestureType.PinchGesture)
            if g is not None:
                if g.scaleFactor() > 0:
                    c0 = self.mapFromGlobal(g.centerPoint().toPoint())
                    self.zoom_view(g.scaleFactor(), (c0.x(), c0.y()))
                c, lc = g.centerPoint(), g.lastCenterPoint()
                self.view["pan_x"] += c.x() - lc.x()
                self.view["pan_y"] += c.y() - lc.y()
                self.redraw()
                return True
        return QWidget.event(self, e)


class FitBrowser(QTextBrowser):
    """Report in a case card – height fitted to the content (the whole list scrolls, not the report)."""

    def __init__(self):
        super().__init__()
        self.setVerticalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.document().documentLayout().documentSizeChanged.connect(lambda *a: self._fit())

    def _fit(self):
        h = int(math.ceil(self.document().size().height())) + 2 * self.frameWidth() + 2
        if h != self.height():
            self.setFixedHeight(max(h, 40))

    def resizeEvent(self, e):
        super().resizeEvent(e)
        self._fit()

    def wheelEvent(self, e):
        e.ignore()                                   # the wheel scrolls the list of cases


class CaseCard(QFrame):
    """Item of the case list: header (drag, expand, name, Edytuj, Usuń), when expanded –
    3D preview and report."""

    def __init__(self, pw, case):
        super().__init__()
        self.pw, self.app, self.case = pw, pw.app, case
        self.setObjectName("card")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(8, 6, 8, 6)
        lay.setSpacing(6)
        hd = QHBoxLayout()
        self.handle = QLabel("⠿")
        self.handle.setToolTip("")
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        self.handle.setStyleSheet("font-size:16px; color:#6b7280; padding:0 4px;")
        self.handle.mousePressEvent = self._drag_press
        self.handle.mouseMoveEvent = self._drag_move
        self.handle.mouseReleaseEvent = self._drag_release
        self._drag_start = None
        hd.addWidget(self.handle)
        self.btn_exp = QPushButton()
        self.btn_exp.setObjectName("expBtn")
        self.btn_exp.setFixedSize(24, 22)                # the same size as the group chevrons everywhere
        self.btn_exp.setIconSize(QSize(14, 14))
        self.btn_exp.setToolTip("Rozwiń / zwiń")
        self._set_exp_icon(False)
        self.btn_exp.clicked.connect(lambda checked=False: (
            self.app.echo(("COLLAPSE " if self.body is not None else "EXPAND ") + case_no(self.app, self.case)),
            self.toggle()))
        hd.addWidget(self.btn_exp)
        self.num = QLabel("")                        # number by position (1., 2.1, …)
        self.num.setObjectName("caseNum")
        hd.addWidget(self.num)
        self.name = no_tr(QLabel())                   # the user's name of the case – never translated
        self.name.setText(case["name"])
        self.name.setObjectName("cardTitle")
        self.name.mouseDoubleClickEvent = lambda e: self.rename()
        hd.addWidget(self.name)
        self.name_edit = QLineEdit()
        self.name_edit.setVisible(False)
        self.name_edit.returnPressed.connect(self._rename_done)
        self.name_edit.editingFinished.connect(self._rename_done)
        hd.addWidget(self.name_edit)
        self.ck_print = print_check(lambda on: self.pw.set_printed({self.case["id"]}, on))
        self._group_off = False                      # inside a non-printed group (relayout)
        hd.addWidget(self.ck_print)
        self.info = QLabel("")
        self.info.setObjectName("muted")
        hd.addWidget(self.info, 1)
        b = QPushButton("Edytuj")
        b.clicked.connect(lambda checked=False: self.pw.edit_case(self.case))
        hd.addWidget(b)
        self.btn_edit = b
        b = QPushButton("Duplikuj")
        b.setToolTip("Kopia przypadku tuż pod nim")
        b.clicked.connect(lambda checked=False: self.pw.duplicate_case(self.case))
        hd.addWidget(b)
        b = QPushButton("Usuń")
        b.clicked.connect(lambda checked=False: self.pw.delete_case(self.case))
        hd.addWidget(b)
        lay.addLayout(hd)
        self.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.customContextMenuRequested.connect(self._menu)
        self.body = None
        self._update_info()

    # --- header
    def set_print_state(self, group_off=None):
        """The Drukowany checkbox: the case's own flag; inside a non-printed group – unchecked and greyed."""
        if group_off is not None:
            self._group_off = bool(group_off)
        set_print_check(self.ck_print, case_printed(self.case) and not self._group_off, not self._group_off,
                        "Grupa nie jest drukowana – zaznacz „drukowany” przy grupie" if self._group_off else
                        "Na wydruku i w numeracji (odznaczony – przypadek roboczy: bez wydruku, numer z literą)")

    def _update_info(self):
        ex = self.case["extra"]
        self.set_print_state()
        if ex.get("mode") == "własne":
            self.info.setText(f"  Własne · {lab_info(self.case['state'].get('wlasne'))} · "
                              f"dodano {self.case.get('created', '')}")
            self.name.setText(self.case["name"])
            return
        if ex.get("mode") == "użytkowe":
            u = self.case["state"].get("uzytkowe") or {}
            gr = next((g_ for g_ in USE_GROUPS if g_[0] == u.get("grupa")), None)
            e = next((q for q in gr[3] if q["code"] == u.get("kategoria")), None) if gr else None
            v = next((q for q in USE_LIKE if q["code"] == u.get("uzytkowanie")), None)
            unit_q = "kN/m" if e and e.get("line") else "kN/m²"
            vals = [f"{s_} = {App._use_fmt(parse_num(str(u.get(k_))))} {un}"
                    for s_, k_, un in (("qₖ", "qk", unit_q), ("Qₖ", "Qk", "kN"))
                    if parse_num(str(u.get(k_) or "")) is not None]
            nm = (e["name"] if e else "") + (f" → {v['name']}" if v else "")
            self.info.setText(f"  Użytkowe · {nm} · {', '.join(vals)} · dodano {self.case.get('created', '')}")
            self.name.setText(self.case["name"])
            return
        mode = "śnieg" if ex.get("mode") != "wiatr" else "wiatr"
        op = self.case["state"].get("opcje", {})
        shape = op.get("snow_type") if mode == "śnieg" else op.get("wind_type")
        what = f"przypadek ({ex.get('snow_case', 'i')})" if mode == "śnieg" else \
            f"θ = {op.get('theta', '')}" + (f", {op.get('variant')}" if op.get("variant") else "")
        self.info.setText(f"  {mode.capitalize()} · {shape} · {what} · dodano {self.case.get('created', '')}")
        self.name.setText(self.case["name"])

    def _menu(self, pos):
        from PySide6.QtWidgets import QMenu
        m = QMenu(self)
        a1 = m.addAction("Zmień nazwę")
        a2 = m.addAction("Zakończ edycję" if any(self.case is e for e in self.app.edited_cases()) else "Edytuj")
        a4 = m.addAction("Duplikuj")
        a3 = m.addAction("Usuń")
        m.addSeparator()
        ids = self.pw.menu_ids(self.case)
        a5 = m.addAction("Utwórz grupę" if len(ids) == 1 else f"Utwórz grupę z zaznaczonych ({len(ids)})")
        m.addSeparator()
        a6 = m.addAction("Drukuj" if len(ids) == 1 else f"Drukuj zaznaczone ({len(ids)})")
        a6.setCheckable(True)
        a6.setChecked(case_printed(self.case))
        a6.setEnabled(not self._group_off)
        act = m.exec(self.mapToGlobal(pos))
        if act is a6:
            self.pw.set_printed(ids, a6.isChecked())
        if act is a5:
            self.pw.group_cases(ids)
        elif act is a4:
            self.pw.duplicate_case(self.case)
        if act is a1:
            self.rename()
        elif act is a2:
            self.pw.edit_case(self.case)
        elif act is a3:
            self.pw.delete_case(self.case)

    def mousePressEvent(self, e):
        """Click selects the case (Ctrl – adds / removes, Shift – the range from the last clicked one)."""
        if e.button() == Qt.MouseButton.LeftButton:
            self.pw.card_clicked(self, e.modifiers())
            e.accept()                               # (otherwise the list behind the card clears the selection)
            return
        super().mousePressEvent(e)

    def set_selected(self, on):
        if bool(self.property("sel")) != bool(on):
            self.setProperty("sel", bool(on))
            self.style().unpolish(self)
            self.style().polish(self)

    def rename(self):
        self.name.setVisible(False)
        self.name_edit.setText(self.case["name"])
        self.name_edit.setVisible(True)
        self.name_edit.setFocus()
        self.name_edit.selectAll()

    def _rename_done(self):
        if not self.name_edit.isVisible():
            return
        t = self.name_edit.text().strip()
        self.name_edit.setVisible(False)
        self.name.setVisible(True)
        if t and t != self.case["name"]:
            self.app.echo(f"RENAME {case_no(self.app, self.case)} {cq(t)}")
            self.case["name"] = t
            self.name.setText(t)
            self.app.project_changed()

    # --- dragging by the ⠿ handle (reordering): the card follows the cursor, the others make room
    def _drag_press(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_start = e.globalPosition()
            self.handle.setCursor(Qt.CursorShape.ClosedHandCursor)

    def _drag_move(self, e):
        if self._drag_start is None:
            return
        lst = self.pw.list
        if lst.dragging is None:
            if (e.globalPosition() - self._drag_start).manhattanLength() < 4:
                return
            lst.begin_drag(self, self._drag_start)
        lst.drag_to(e.globalPosition())

    def _drag_release(self, e):
        self._drag_start = None
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        if self.pw.list.dragging is self:
            self.pw.list.end_drag()

    # --- expanding
    def toggle(self):
        if self.body is None:
            self._build_body()
            self._set_exp_icon(True)
        else:
            self.layout().removeWidget(self.body)
            self.body.hide()
            self.body.deleteLater()
            self.body = None
            self._set_exp_icon(False)

    def set_number(self, num):
        self.num.setText(num)

    def set_level(self, depth):
        """Indent of the card in the list (level in the groups)."""
        if getattr(self, "_level", None) != depth:
            self._level = depth
            self.setStyleSheet(f"QFrame#card {{ margin-left: {depth * CASE_INDENT}px; }}" if depth else "")

    def _set_exp_icon(self, opened):
        self.btn_exp.setIcon(QIcon(chevron_pixmap("down" if opened else "right", ACCENT if opened else "#374151",
                                                  16, 2.0)))

    def set_open(self, opened):
        """Expands / collapses the card (Rozwiń wszystko / Zwiń wszystko)."""
        if opened != (self.body is not None):
            self.toggle()

    def _build_body(self):
        self.app.ensure_calc(self.case)
        body = QWidget()
        bl = QVBoxLayout(body)
        bl.setContentsMargins(0, 0, 0, 0)
        bl.setSpacing(6)
        bar = QHBoxLayout()
        calc = self.case["_calc"]
        ex = self.case["extra"]
        if calc["mode"] in REPORT_ONLY:              # imposed / own loads – report only
            self.report = FitBrowser()
            self.report.setOpenLinks(False)
            self.report.setHtml(self.case.get("report", ""))
            bl.addWidget(self.report)
            self.body = body
            self._body_mode = calc["mode"]
            self.layout().addWidget(body)
            return
        self.vps = []
        for k in range(1 + len(ex.get("viewports") or [])):
            box = self._viewport_box(k, calc)
            bl.addWidget(box)
            self.vps.append(box)
        self.canvas = self.vps[0].canvas
        self.report = FitBrowser()
        self.report.setOpenLinks(False)
        self.report.setHtml(self.case.get("report", ""))
        bl.addWidget(self.report)
        self.body = body
        self._body_mode = calc["mode"]
        self.layout().addWidget(body)

    def _viewport_box(self, k, calc):
        """One viewport: bar (view toggles, Widok domyślny) + 3D preview. Right click on the preview – Duplikuj."""
        box = QWidget()
        vl = QVBoxLayout(box)
        vl.setContentsMargins(0, 0, 0, 0)
        vl.setSpacing(6)
        bar = QHBoxLayout()
        tg = self.vp_data(k).setdefault("toggles", {})
        # only the view and building dimensions here (click a dimension in the preview); other changes – Edytuj button
        for key, lab in (("labels3d", "Etykiety"), ("dims3d", "Wymiary pól"), ("bdims3d", "Wymiary budynku")):
            ch = QCheckBox(lab)
            ch.setChecked(bool(tg.get(key, True)))
            ch.toggled.connect(lambda on, key=key, k=k: self._toggle(key, on, k))
            bar.addWidget(ch)
        box.ck_odims = None
        if calc["mode"] == "wiatr":                      # dimensions of the orography – visible when it is on
            ch = QCheckBox("Wymiary orografii")
            ch.setChecked(bool(tg.get("odims3d", True)))
            ch.toggled.connect(lambda on, k=k: self._toggle("odims3d", on, k))
            ch.setVisible(bool(((calc["wind"] or {}).get("info") or {}).get("oro")))
            bar.addWidget(ch)
            box.ck_odims = ch
        box.title = QLabel("")
        box.title.setObjectName("muted")
        bar.addWidget(box.title)
        bar.addStretch(1)
        b = QPushButton("Widok domyślny")
        b.clicked.connect(lambda checked=False, k=k: self._reset_view(k))
        bar.addWidget(b)
        vl.addLayout(bar)
        box.canvas = CaseCanvas(self.app, self, k)
        vl.addWidget(box.canvas)
        n = 1 + len(self.case["extra"].get("viewports") or [])
        box.title.setText(f"   Viewport {k + 1}" if n > 1 else "")
        return box

    # --- viewports: the first one keeps its data in extra["view"] / extra["toggles"], the others in
    # extra["viewports"] = [{"view": …, "toggles": …}, …]
    def vp_data(self, k):
        ex = self.case["extra"]
        vps = ex.get("viewports") or []
        return ex if k == 0 or k > len(vps) else vps[k - 1]

    def viewport_menu(self, canvas, gpos):
        from PySide6.QtWidgets import QMenu
        m = QMenu(self)
        a_dup = m.addAction("Duplikuj")
        a_del = m.addAction("Usuń viewport") if len(self.vps) > 1 else None
        act = m.exec(gpos)
        if act is a_dup:
            self.duplicate_viewport(canvas.idx)
        elif act is not None and act is a_del:
            self.remove_viewport(canvas.idx)

    def duplicate_viewport(self, k):
        """Duplikuj (right click on a viewport): a copy of the view right below it – the case can be shown from
        more than one side."""
        ex = self.case["extra"]
        src = self.vp_data(k)
        cp = {"view": dict(self.vps[k].canvas.view) if k < len(self.vps) else dict(src.get("view") or {}),
              "toggles": dict(src.get("toggles") or {})}
        ex.setdefault("viewports", []).insert(k, copy.deepcopy(cp))
        self._rebuild_body()
        self.app.project_changed()

    def remove_viewport(self, k):
        """Usuń viewport: any of them, but at least one stays (removing the first – the next one takes its place)."""
        ex = self.case["extra"]
        vps = ex.get("viewports") or []
        if not vps or k < 0 or k > len(vps):
            return
        if k == 0:
            first = vps.pop(0)
            ex["view"], ex["toggles"] = first.get("view") or {}, first.get("toggles") or {}
        else:
            del vps[k - 1]
        if not vps:
            ex.pop("viewports", None)
        self._rebuild_body()
        self.app.project_changed()

    def _rebuild_body(self):
        """The body again (a different number of viewports); the list keeps its place."""
        def go():
            self.layout().removeWidget(self.body)
            self.body.hide()
            self.body.deleteLater()
            self.body = None
            self._build_body()
        self.pw.keep_view(go)

    def refresh(self):
        """After recalculating a case: header, report and model – in the same widgets (the card height does not
        change while rebuilding, i.e. the list does not flicker). Different load type – card rebuilt."""
        self._update_info()
        if self.body is None:
            return
        self.app.ensure_calc(self.case)
        if self._body_mode in REPORT_ONLY and self.case["_calc"]["mode"] == self._body_mode:
            self.report.setHtml(self.case.get("report", ""))
            return
        if self.case["_calc"]["mode"] != self._body_mode:
            self.layout().removeWidget(self.body)
            self.body.hide()
            self.body.deleteLater()
            self.body = None
            self._build_body()
            return
        if len(self.vps) != 1 + len(self.case["extra"].get("viewports") or []):    # e.g. after Cofnij
            self._rebuild_body()
            return
        oro = bool(((self.case["_calc"].get("wind") or {}).get("info") or {}).get("oro"))
        for k, box in enumerate(self.vps):
            if box.ck_odims is not None:
                box.ck_odims.setVisible(oro)
            box.canvas.view.update({a: v for a, v in (self.vp_data(k).get("view") or {}).items() if a in VIEW_KEYS})
            box.canvas._scene_key = None
            box.canvas.redraw()
        self.report.setHtml(self.case.get("report", ""))

    def _toggle(self, key, on, k=0):
        self.vp_data(k).setdefault("toggles", {})[key] = bool(on)
        self.vps[k].canvas._scene_key = None
        self.vps[k].canvas.redraw()
        self.app.project_changed()

    def _reset_view(self, k=0):
        th = self.case["_calc"]["wind"]["theta"] if self.case["_calc"]["mode"] == "wiatr" else 0
        cv = self.vps[k].canvas
        cv.view.update(yaw=self.app.default_yaw(th), pitch=math.radians(24), zoom=1.0, pan_x=0.0, pan_y=0.0, piv=None)
        cv.redraw()
        self.view_changed(cv.view, k)

    def view_changed(self, view, k=0):
        self.vp_data(k)["view"] = dict(view)
        self.app.project_changed()

    def edit_value(self, key):
        """Change of a dimension clicked in the preview – the case is recalculated."""
        from PySide6.QtWidgets import QInputDialog
        keys = key if isinstance(key, tuple) else (key,)
        f = self.app.field_def_state(self.case["state"], keys[0])
        pola = self.case["state"].setdefault("pola", {})
        lab = f[1] if f else keys[0]
        txt, ok = QInputDialog.getText(self, "Zmiana wymiaru", f"{lab} [{f[2] if f else ''}]:",
                                       QLineEdit.EchoMode.Normal, str(pola.get(keys[0], "")))
        if not ok:
            return
        v = parse_num(txt)
        good = v is not None
        if good and f:
            k_, lab_, unit, lo, hi, strict, integer = f
            good = (v > lo if strict else v >= lo) and v <= hi and (not integer or abs(v - round(v)) < 1e-9)
        if not good:
            QMessageBox.warning(self, "Zmiana wymiaru", "Niepoprawna wartość.")
            return
        old = json.loads(json.dumps(self.case["state"]))
        for k_ in keys:
            pola[k_] = txt.strip()
        if not self.app.recapture_case(self.case):
            err = self.case.pop("_err", "") or "Niepoprawna geometria budynku."
            self.case["state"] = old
            self.app.recapture_case(self.case)
            QMessageBox.warning(self, "Zmiana wymiaru", "Nie zmieniono wymiaru:\n" + err)
            return
        self.app.project_changed()
        self.refresh()


class CaseList(QWidget):
    """Container of case cards. Dragging a card: the card taken out of the layout follows the cursor, an empty
    slot (dropSlot) moves between the other cards; on release – the card lands in the slot."""

    def __init__(self, pw, watermark=True):
        super().__init__()
        self.pw = pw                                 # owner: cards, scroll, place_case(card, index)
        self.watermark = watermark
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.lay.setSpacing(6)
        self.lay.addStretch(1)
        self.dragging = None
        self._slot = None
        self._last = None
        self._scroll_timer = QTimer(self)
        self._scroll_timer.setInterval(30)
        self._scroll_timer.timeout.connect(self._autoscroll)

    def levels(self):
        """Main window list (groups and levels) – dragging also sideways (indent / outdent)."""
        return hasattr(self.pw, "drop_options") and getattr(self.pw, "rows", None) is not None

    def begin_drag(self, card, gpos):
        idx = self.lay.indexOf(card)
        if idx < 0:
            return
        self.dragging = card
        self._hidden, self._opt, self._x0, self._drow = [], None, gpos.x(), None
        if self.levels():
            rows = self.pw.rows
            r0 = next((r for r in rows if r["w"] is card), None)
            self._drow = r0
            if r0 is not None and "group" in r0["node"]:          # a group moves with its contents
                i = rows.index(r0) + 1
                while i < len(rows) and rows[i]["level"] > r0["level"]:
                    rows[i]["w"].setVisible(False)
                    self._hidden.append(rows[i]["w"])
                    i += 1
        slot = QLabel("")
        slot.setObjectName("dropSlot")
        slot.setAlignment(Qt.AlignmentFlag.AlignCenter)
        slot.setFixedHeight(card.height())
        geo = card.geometry()
        self.lay.removeWidget(card)                  # card outside the layout – moved by hand
        self.lay.insertWidget(idx, slot)
        self._slot = slot
        card.setGeometry(geo)
        card.setProperty("lifted", True)
        card.style().unpolish(card)
        card.style().polish(card)
        card.raise_()
        self._off = self.mapFromGlobal(gpos.toPoint()).y() - geo.y()   # grab point relative to the top of the card
        self._last = gpos
        self._scroll_timer.start()

    def drag_to(self, gpos):
        card = self.dragging
        if card is None:
            return
        self._last = gpos
        y_cur = clamp(self.mapFromGlobal(gpos.toPoint()).y(), 0, self.height())
        card.move(card.x(), int(y_cur - self._off))     # the card sticks to the cursor (a tall one may leave the list)
        if self.levels() and self._drow is not None:
            self._drag_levels(card, gpos, y_cur)
            return
        # position: before the first card whose centre is below the cursor
        others = [c for c in self.pw.cards if c is not card]
        idx = sum(1 for c in others if c.y() + c.height() / 2 < y_cur)
        if self.lay.indexOf(self._slot) != idx:
            self.lay.removeWidget(self._slot)
            self.lay.insertWidget(idx, self._slot)
            self.lay.activate()                      # the other cards make room immediately
            card.raise_()

    def _drag_levels(self, card, gpos, y_cur):
        """Main window: the slot between the rows (cards and group headers) at the level chosen by the sideways
        offset of the cursor (to the right – indent / new group, to the left – a level up)."""
        rows = [r for r in self.pw.rows if r["w"] is not card and r["w"] not in self._hidden]
        k = sum(1 for r in rows if r["w"].y() + r["w"].height() / 2 < y_cur)
        a_row = rows[k - 1] if k else None
        b_row = rows[k] if k < len(rows) else None
        opt = self.pw.drop_options(self._drow, a_row, b_row, gpos.x() - self._x0)
        key = (k, opt[0], opt[1]) if opt else (k, None, None)
        lvl = opt[0] if opt else self._drow["level"]
        # the card snaps sideways to the target level; above it – the hint for a new group
        card.move(int((lvl - self._drow["level"]) * CASE_INDENT), card.y())
        hint = getattr(self, "_hint", None)
        if opt and opt[1] == "wrap":
            if hint is None:
                hint = self._hint = QLabel("nowa grupa przypadków", self)
                hint.setObjectName("dropSlot")
                hint.setContentsMargins(8, 1, 8, 1)
            hint.adjustSize()
            hint.move(lvl * CASE_INDENT + 40, max(card.y() - hint.height() - 2, 0))
            hint.show()
            hint.raise_()
        elif hint is not None:
            hint.hide()
        if getattr(self, "_slot_key", None) == key:
            return
        self._slot_key, self._opt = key, opt
        self.lay.removeWidget(self._slot)
        idx = self.lay.indexOf(b_row["w"]) if b_row is not None else \
            (self.lay.indexOf(a_row["w"]) + 1 if a_row is not None else 0)
        lvl = opt[0] if opt else 0
        self._slot.setStyleSheet(f"QFrame#dropSlot {{ margin-left: {lvl * CASE_INDENT}px; }}")
        self._slot.setText("nowa grupa przypadków" if opt and opt[1] == "wrap" else "")
        self.lay.insertWidget(idx, self._slot)
        self.lay.activate()                          # the other rows make room immediately
        card.raise_()

    def _autoscroll(self):
        """Cursor at the top / bottom edge of the list window – scrolling."""
        if self.dragging is None or self._last is None:
            return
        vp = self.pw.scroll.viewport()
        y = vp.mapFromGlobal(self._last.toPoint()).y()
        m = 40
        d = y - m if y < m else (y - (vp.height() - m) if y > vp.height() - m else 0)
        if d:
            sb = self.pw.scroll.verticalScrollBar()
            v = sb.value()
            sb.setValue(v + int(clamp(d, -m, m) / 2) or (1 if d > 0 else -1))
            if sb.value() != v:
                self.drag_to(self._last)

    def end_drag(self):
        card, self.dragging = self.dragging, None
        self._scroll_timer.stop()
        if card is None:
            return
        idx = self.lay.indexOf(self._slot)
        self.lay.removeWidget(self._slot)
        self._slot.hide()
        self._slot.deleteLater()
        self._slot = None
        card.setProperty("lifted", False)
        card.style().unpolish(card)
        card.style().polish(card)
        self._slot_key = None
        if getattr(self, "_hint", None) is not None:
            self._hint.hide()
        if self.levels() and self._drow is not None:
            for w in self._hidden:
                w.setVisible(True)
            self.lay.insertWidget(idx, card)
            self.pw.drop_row(self._drow, self._opt)
            return
        self.lay.insertWidget(idx, card)
        self.pw.place_case(card, idx)

    def mousePressEvent(self, ev):
        if hasattr(self.pw, "clear_selection"):
            self.pw.clear_selection()
        super().mousePressEvent(ev)

    def paintEvent(self, ev):
        """Empty project: watermark – the KAYENN wordmark in the bottom right corner of the list (the console is an
        overlay and does not move it; where the window is small the console text goes over it)."""
        if not self.watermark or getattr(self.pw, "cards", None):
            return
        r = wordmark_renderer()
        if r is None:
            return
        vb = r.viewBoxF()
        w = min(300.0, self.width() * 0.3)
        h = w * vb.height() / vb.width()
        m, th = 24, 0
        dpr = self.devicePixelRatioF()
        key = (round(w), dpr)
        if getattr(self, "_wm_key", None) != key:    # the wordmark first into an image – otherwise the shadow layers
            from PySide6.QtGui import QImage          # they would stack their transparency on each other
            img = QImage(int(w * dpr) + 1, int(h * dpr) + 1, QImage.Format.Format_ARGB32_Premultiplied)
            img.fill(Qt.GlobalColor.transparent)
            q = QPainter(img)
            q.setRenderHint(QPainter.RenderHint.Antialiasing)
            r.render(q, QRectF(0, 0, w * dpr, h * dpr))
            q.end()
            img.setDevicePixelRatio(dpr)
            self._wm_key, self._wm_img = key, img
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        p.setOpacity(0.14)
        p.drawImage(QPointF(self.width() - w - m, self.height() - h - th - m), self._wm_img)
        p.end()



# ===================================================================
#  CASE LIST STRUCTURE (KAYENN Manager) – cases and groups of cases, numbered by position
# ===================================================================
CASE_GROUP_NAME = "Grupa przypadków"
CASE_INDENT = 28                                         # px per level of the case list


def ptree_walk(items, depth=0, parent=None):
    """All nodes of the case tree in list order: (node, list containing it, depth, parent group or None).
    Node: {"case": id} or {"group": id, "name": …, "items": […], "open": bool, "auto": bool}."""
    for n in items:
        yield n, items, depth, parent
        if "group" in n:
            yield from ptree_walk(n["items"], depth + 1, n)


def ptree_prune(items):
    """Groups created automatically (by an indent) that became empty – removed."""
    for n in list(items):
        if "group" in n:
            ptree_prune(n["items"])
            if not n["items"] and n.get("auto"):
                items.remove(n)


def ptree_sync(project):
    """project["tree"] consistent with project["cases"]: nodes of removed cases dropped, a new case lands right
    after the case preceding it in project["cases"] (the first one – at the top of the list); then project["cases"]
    takes the tree order (the order of cards, printout and file)."""
    tree = project.setdefault("tree", [])
    cases = project["cases"]
    ids = {c["id"] for c in cases}

    def drop(items):
        items[:] = [n for n in items if ("group" in n) or n.get("case") in ids]
        for n in items:
            if "group" in n:
                drop(n["items"])
    drop(tree)
    where = {n["case"]: (lst, n) for n, lst, _, _ in ptree_walk(tree) if "case" in n}
    for i, c in enumerate(cases):
        if c["id"] in where:
            continue
        node = {"case": c["id"]}
        prev = where.get(cases[i - 1]["id"]) if i > 0 else None
        if prev is None:
            tree.insert(0, node)
            where[c["id"]] = (tree, node)
        else:
            lst, pn = prev
            lst.insert(lst.index(pn) + 1, node)
            where[c["id"]] = (lst, node)
    ptree_prune(tree)
    by_id = {c["id"]: c for c in cases}
    cases[:] = [by_id[n["case"]] for n, _, _, _ in ptree_walk(tree) if "case" in n]


def _letters(k):
    """1 → A, 26 → Z, 27 → AA (the suffix of the cases left out of the printout)."""
    out = ""
    while k > 0:
        k, r = divmod(k - 1, 26)
        out = chr(65 + r) + out
    return out


def case_printed(case):
    """The case goes to the printout (Drukuj on its card; extra["noprint"] – left out)."""
    return not (case.get("extra") or {}).get("noprint")


def ptree_numbers(tree, skip=()):
    """Numbers by position: top level 1, 2, …; inside a group 2.1, 2.2, … → {id(node): "2.1"}. Items left out of the
    printout – the cases in `skip` and the groups with node["noprint"] – are not counted: they take the number of the
    printed item before them plus a letter (2.1, 2.1A, 2.1B, 2.2; before the first printed one: 2.0A). Everything inside
    a non-printed group is numbered by position and ends with the group's letter: group 1A → 1.1A, 1.2A."""
    out = {}

    def label(num, sfx):
        return ".".join(str(x) for x in num) + sfx + ("." if len(num) == 1 else "")

    def walk(items, prefix, sfx):
        i = k = 0
        for n in items:
            off = not sfx and (("case" in n and n["case"] in skip) or ("group" in n and n.get("noprint")))
            if off:
                k += 1
                num, s_ = prefix + (i,), _letters(k)
            else:
                i, k = i + 1, 0
                num, s_ = prefix + (i,), sfx
            out[id(n)] = label(num, s_)
            if "group" in n:
                walk(n["items"], num, s_)
    walk(tree, (), "")
    return out


def noprint_ids(project):
    """Ids of the cases left out of the printout: their own Drukowany unchecked or inside a non-printed group."""
    out = {c["id"] for c in project["cases"] if not case_printed(c)}

    def walk(items, off):
        for n in items:
            if "group" in n:
                walk(n["items"], off or bool(n.get("noprint")))
            elif off:
                out.add(n["case"])
    walk(project.get("tree") or [], False)
    return out


def project_numbers(project):
    """ptree_numbers of the project – the cases left out of the printout with letters."""
    return ptree_numbers(project["tree"], {c["id"] for c in project["cases"] if not case_printed(c)})


def ptree_new_group(tree, name=None, items=(), auto=True):
    name = tr(CASE_GROUP_NAME) if name is None else name
    gid = max([n["group"] for n, _, _, _ in ptree_walk(tree) if "group" in n] + [0]) + 1
    return {"group": gid, "name": name, "items": list(items), "open": True, "auto": auto}


def ptree_dump(items):
    """Tree for the .kayenn file (Polish keys like the rest of the format): case – its id, group – a dict."""
    return [n["case"] if "case" in n else
            dict({"grupa": n["name"], "id": n["group"], "otwarta": bool(n.get("open", True)),
                  "auto": bool(n.get("auto")), "elementy": ptree_dump(n["items"])},
                 **({"drukuj": False} if n.get("noprint") else {})) for n in items]


def ptree_load(data):
    out = []
    for n in data or []:
        if isinstance(n, int):
            out.append({"case": n})
        elif isinstance(n, dict) and "elementy" in n:
            out.append({"group": int(n.get("id") or 0), "name": str(n.get("grupa") or CASE_GROUP_NAME),
                        "items": ptree_load(n.get("elementy")), "open": bool(n.get("otwarta", True)),
                        "auto": bool(n.get("auto")), **({"noprint": True} if n.get("drukuj") is False else {})})
    used = set()
    for g, _, _, _ in ptree_walk(out):                   # group ids unique
        if "group" in g:
            if g["group"] in used or g["group"] <= 0:
                g["group"] = max(used | {0}) + 1
            used.add(g["group"])
    return out


def group_chevron(opened, on_click):
    """Expand / collapse button of a group header (Manager and material database – the same size)."""
    b = QPushButton()
    b.setObjectName("expBtn")
    b.setFixedSize(24, 22)
    b.setIconSize(QSize(14, 14))
    b.setToolTip("Rozwiń / zwiń")
    b.setIcon(QIcon(chevron_pixmap("down" if opened else "right", ACCENT if opened else "#374151", 16, 2.0)))
    b.clicked.connect(lambda checked=False: on_click())
    return b


def print_check(on_toggle):
    """The Drukowany checkbox of a case card / group header (green „drukowany”, orange „niedrukowany”)."""
    ck = QCheckBox("drukowany")
    ck.setChecked(True)
    ck.setCursor(Qt.CursorShape.PointingHandCursor)
    ck.toggled.connect(lambda on: None if getattr(ck, "_sync", False) else on_toggle(bool(on)))
    return ck


def set_print_check(ck, on, enabled, tip):
    ck._sync = True
    ck.setChecked(bool(on))
    ck._sync = False
    ck.setEnabled(bool(enabled))
    ck.setText("drukowany" if on else "niedrukowany")
    col = "#15803d" if on else "#b45309"
    ck.setStyleSheet(css_pt(f"QCheckBox {{ color: {col}; font-size: 8pt; padding: 0px 6px; }}"
                            "QCheckBox:disabled { color: #9ca3af; }"))
    ck.setToolTip(tip)


class CaseGroupHeader(QFrame):
    """Header of a group of cases in the main window: ⠿ handle (dragging the whole group), expand / collapse,
    number and name (inline renaming), number of cases; right click – Zmień nazwę, Nowa podgrupa, Rozgrupuj,
    Usuń grupę."""

    def __init__(self, pw, node, num, count):
        super().__init__()
        self.pw, self.node = pw, node
        self.setObjectName("caseGroup")
        h = QHBoxLayout(self)
        h.setContentsMargins(8, 3, 8, 3)
        h.setSpacing(4)
        self.handle = QLabel("⠿")
        self.handle.setToolTip("Przeciągnij: w górę / w dół – kolejność, w prawo – wcięcie, w lewo – poziom wyżej")
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        self.handle.setStyleSheet("font-size:16px; color:#6b7280; padding:0 4px;")
        self.handle.mousePressEvent = self._drag_press
        self.handle.mouseMoveEvent = self._drag_move
        self.handle.mouseReleaseEvent = self._drag_release
        self._drag_start = None
        h.addWidget(self.handle)
        b = group_chevron(node.get("open", True), lambda: pw.toggle_group(node))
        h.addWidget(b)
        self.btn_exp = b
        self.title = no_tr(QLabel())                  # the user's group name – never translated
        self.title.setText(f"{num} {node['name']}")
        self.title.setTextFormat(Qt.TextFormat.PlainText)
        self.title.setObjectName("groupTitle")
        self.title.mouseDoubleClickEvent = lambda e: self.start_rename()
        h.addWidget(self.title)
        self.edit = EditorLine(self._rename_cancel, self._rename_done)
        self.edit.returnPressed.connect(lambda: self._rename_done(True))
        self.edit.setVisible(False)
        h.addWidget(self.edit)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)      # Enter on the group – expand / collapse
        self.count = QLabel(f"({count})")
        self.count.setObjectName("muted")
        h.addWidget(self.count)
        self.ck_print = print_check(lambda on: pw.set_group_printed(node, on))
        h.addWidget(self.ck_print)
        h.addStretch(1)
        self.set_print_state(False)
        self.setContextMenuPolicy(Qt.ContextMenuPolicy.CustomContextMenu)
        self.customContextMenuRequested.connect(lambda pos: pw.group_menu(self, self.mapToGlobal(pos)))

    def set_print_state(self, parent_off):
        """Drukowany of the group: unchecked – everything in it is left out of the printout (numbers with letters);
        inside a non-printed group – greyed."""
        set_print_check(self.ck_print, not self.node.get("noprint") and not parent_off, not parent_off,
                        "Grupa nadrzędna nie jest drukowana" if parent_off else
                        "Na wydruku (odznaczona – cała grupa robocza: bez wydruku, numery z literą)")

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self.pw.clear_selection()
        super().mousePressEvent(e)

    def start_rename(self):
        self.title.setVisible(False)
        self.edit.setText(self.node["name"])
        self.edit.setVisible(True)
        self.edit.setFocus()
        self.edit.selectAll()

    def _rename_done(self, enter=False):
        """Enter (enter=True) confirms – also the default name – and leaves the focus on the group, so that the next
        Enter expands / collapses it; clicking away only confirms."""
        if not self.edit.isVisible():
            return
        self.edit.setVisible(False)
        self.title.setVisible(True)
        t = " ".join(self.edit.text().split())
        if t and t != self.node["name"]:
            QTimer.singleShot(0, lambda: self.pw.rename_group(self.node, t, focus=enter))
        elif enter:
            self.setFocus()

    def keyPressEvent(self, e):
        if e.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            self.pw.toggle_group(self.node)
            self.pw.focus_group(self.node)
            return
        super().keyPressEvent(e)

    def _rename_cancel(self):
        self.edit.setVisible(False)
        self.title.setVisible(True)

    # dragging – as the case cards (the group moves with its contents)
    def _drag_press(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_start = e.globalPosition()
            self.handle.setCursor(Qt.CursorShape.ClosedHandCursor)

    def _drag_move(self, e):
        if self._drag_start is None:
            return
        lst = self.pw.list
        if lst.dragging is None:
            if (e.globalPosition() - self._drag_start).manhattanLength() < 4:
                return
            lst.begin_drag(self, self._drag_start)
        lst.drag_to(e.globalPosition())

    def _drag_release(self, e):
        self._drag_start = None
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        if self.pw.list.dragging is self:
            self.pw.list.end_drag()


