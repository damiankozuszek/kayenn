    for t in a:
        n = _node_ref(app, t)
        if "group" in n:
            n["open"] = opened
            pw.keep_view(pw.relayout)
        else:
            card = pw.card_of(next(c for c in app.project["cases"] if c["id"] == n["case"]))
            if card is not None:
                pw.keep_view(lambda card=card: card.set_open(opened))
    return None


