        self.use_cat.currentIndexChanged.connect(lambda i: self._use_show(reset=True))
        self.use_like.currentIndexChanged.connect(lambda i: self._use_show(reset=True))
        for e in (self.use_q, self.use_Q):
            e.textEdited.connect(lambda t: self._use_check())
        self._use_fill_cats()

    def _use_fill_cats(self):
        gi = max(self.use_group.currentIndex(), 0)
        self.use_cat.blockSignals(True)
        self.use_cat.clear()
        self.use_cat.addItems([e["name"] for e in USE_GROUPS[gi][3]])
        self.use_cat.blockSignals(False)
        self._use_show(reset=True)

    def _use_entry(self):
        """(wybrana pozycja, pozycja z wartościami – dla kat. I: wybrane użytkowanie, źródło)."""
        gk, _, tab, es = USE_GROUPS[max(self.use_group.currentIndex(), 0)]
        e = es[max(self.use_cat.currentIndex(), 0)]
        if e.get("like"):
            v = USE_LIKE[max(self.use_like.currentIndex(), 0)]
            src = next(t for k, _, t, es_ in USE_GROUPS if v in es_)
            return e, v, f"Tablica 6.9 (kategoria I) → {src}"
        return e, e, tab

    @staticmethod
    def _use_fmt(v):
        t = f"{v:.2f}".rstrip("0")
        return (t + "0" if t.endswith(".") else t).replace(".", ",")

    def _use_show(self, reset=False):
        e, v, src = self._use_entry()
        like = bool(e.get("like"))
        self.use_like.setVisible(like)
        self.use_like_lb.setVisible(like)
        desc = e["desc"] + (f"\nUżytkowanie: {v['name']}. {v['desc']}" if like else "")
        self.use_desc.configure(text=desc)
        line = bool(v.get("line"))
        qu = "kN/m" if line else "kN/m²"
        f = self._use_fmt
        rows = []
        for sym, rng, un, what in (("q<sub>k</sub>", v.get("q"), qu,
                                    "obciążenie liniowe (poziome)" if line else "obciążenie równomiernie rozłożone"),
                                   ("Q<sub>k</sub>", v.get("Q"), "kN", "obciążenie skupione")):
            if not rng:
                continue
            lo, hi, rec = rng
            if abs(lo - hi) < 1e-9:
                rows.append(f"<b>{sym} = {f(rec)} {un}</b> – {what} (wartość jedyna)")
            else:
                rows.append(f"{sym}: od {f(lo)} do {f(hi)} {un} – {what}; "
                            f"<b>wartość zalecana {f(rec)} {un}</b>")
        if not rows:
            rows.append("Norma nie podaje wartości liczbowych.")
        notes = [n for n in (v.get("note"), e.get("note") if e is not v else None) if n]
        if v.get("low_min"):
            notes.append("Załącznik krajowy (NB1): wartości nie mniejsze niż dolne granice przedziałów Tablicy 6.2. "
                         "Jeśli jest to konieczne (np. schody, balkony), wartości zwiększa się (6.3.1.2(2)).")
        html_ = "<br>".join(rows) + f"<br><span style='color:{MUTED}'>PN-EN 1991-1-1, {src}" + \
            "".join(f"<br>{html.escape(n)}" for n in notes) + "</span>"
        self.use_norm.setText(html_)
        has_q, has_Q = bool(v.get("q")) or v.get("q") is None and not v.get("Q"), bool(v.get("Q"))
        self._use_has = (has_q, has_Q)
        for w_ in (self.use_q_lb, self.use_q, self.use_q_un):
            w_.setVisible(has_q)
        for w_ in (self.use_Q_lb, self.use_Q, self.use_Q_un):
            w_.setVisible(has_Q)
        self.use_q_un.setText(qu)
        if reset:
            self.use_q.setText(f"{v['q'][2]:g}" if v.get("q") else "")
            self.use_Q.setText(f"{v['Q'][2]:g}" if v.get("Q") else "")
        self._use_check()

    def _use_check(self):
        """Wartość przyjęta względem przedziału normowego."""
        e, v, _ = self._use_entry()
        msgs, bad = [], False
        has = getattr(self, "_use_has", (True, True))
        for ent, rng, sym, on in ((self.use_q, v.get("q"), "qₖ", has[0]), (self.use_Q, v.get("Q"), "Qₖ", has[1])):
            if not on:
                continue
            t = ent.text().strip()
            if not t:
                continue
            x = parse_num(t)
            if x is None or x < 0:
                msgs.append(f"{sym}: niepoprawna wartość.")
                bad = True
                continue
            if not rng:
                continue
            lo, hi, rec = rng
            if x < lo - 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – poniżej dolnej granicy {self._use_fmt(lo)}"
                            + (" (niedopuszczalne wg Załącznika krajowego NB1)." if v.get("low_min") else "."))
                bad = True
            elif x > hi + 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – powyżej przedziału normowego (wartość zwiększona).")
            elif abs(x - rec) > 1e-9:
                msgs.append(f"{sym} = {self._use_fmt(x)} – w przedziale normowym, inna niż zalecana.")
        self.use_check.configure(text=" ".join(msgs))
        self.use_check.setStyleSheet(f"color:{MANUAL_COL};" if bad else f"color:{MUTED};")
        for ent in (self.use_q, self.use_Q):
            x = parse_num(ent.text()) if ent.text().strip() else 0.0
            self._mark_bad(ent, x is None)

    def _use_state(self):
        e, v, _ = self._use_entry()
        return dict(grupa=USE_GROUPS[max(self.use_group.currentIndex(), 0)][0], kategoria=e["code"],
                    uzytkowanie=v["code"] if e.get("like") else None, qk=self.use_q.text().strip(),
                    Qk=self.use_Q.text().strip())

    def _use_set_state(self, d):
        if not d:
            return
        gi = next((i for i, g_ in enumerate(USE_GROUPS) if g_[0] == d.get("grupa")), None)
        if gi is None:
            return
        self.use_group.setCurrentIndex(gi)
        ci = next((i for i, e in enumerate(USE_GROUPS[gi][3]) if e["code"] == d.get("kategoria")), 0)
        self.use_cat.setCurrentIndex(ci)
        li = next((i for i, e in enumerate(USE_LIKE) if e["code"] == d.get("uzytkowanie")), None)
        if li is not None:
            self.use_like.setCurrentIndex(li)
        self.use_q.setText(str(d.get("qk", "")))
        self.use_Q.setText(str(d.get("Qk", "")))
        self._use_check()

    # ----------------------------------------------------------- formularz ---
    def fill_slots(self, slots, fields, diff_on):
        """Przypisuje pola geometrii do slotów; zwraca aktywne definicje pól."""
        has_diff = "#diff" in fields
        layout = []
        for f in fields:
            if isinstance(f, str):
                if f == "#diff" and diff_on:
                    layout.append(None)              # puste miejsce: α₂ trafia pod α₁
                continue
            if has_diff and f[0].endswith("alpha2") and not diff_on:
                continue
            layout.append(f)
        active = [f for f in layout if f]
        for i, (lb, e, un) in enumerate(slots):
            f = layout[i] if i < len(layout) else None
            if f:
                key, lab, unit = f[:3]
                if has_diff and diff_on and key.endswith("_alpha"):
                    lab = "Kąt α₁ (połać 1)"
                if lb.text() != lab:
                    lb.setText(lab)
                tip = f"Zakres: {field_range(f)}°" if unit == "°" else ""   # tylko dla kątów
                if e.toolTip() != tip:
                    e.setToolTip(tip)
                if un.text() != unit:
                    un.setText(unit)
                if e._key != key:
                    e._key = key
                    e.setText(self.v[key].get())
                    e.setEnabled(True)
                if not e._shown:
                    e._shown = True
                    for w_ in (lb, e, un):
                        w_.setVisible(True)
            else:
                e._key = None
                if e._shown:
                    e._shown = False
                    for w_ in (lb, e, un):
                        w_.setVisible(False)
        return active

    def schedule(self):
        # zmiany formularza obciążeń normowych nie oznaczają projektu jako zmienionego (pytanie o zapis dopiero
        # po dodaniu / zmianie przypadku – project_changed)
        if self._pending:
            return
        self._pending = True
        QTimer.singleShot(0, self.recalc)

    def _mark_bad(self, e, bad):
        if e._bad != bad:
            e._bad = bad
            e.setProperty("bad", bad)
            e.style().unpolish(e)
            e.style().polish(e)

    def _val(self, f, widgets):
        key, lab, unit, lo, hi, strict, integer = f
        v = parse_num(self.v[key].get())
        bad = v is None or (v <= lo if strict else v < lo) or v > hi or (integer and abs(v - round(v)) > 1e-9)
        for e in widgets:
            self._mark_bad(e, bad)
        if bad:
            self._errors.append(key)
            return None
        return int(round(v)) if integer else v

    def _read_simple(self, key, lo, hi, strict=False, active=True):
        ws = self.entries.get(key, [])
        if not active:
            for e in ws:
                self._mark_bad(e, False)
            return 0.0
        return self._val((key, "", "", lo, hi, strict, False), ws)

    def _read_geo(self, slots, fields, prefix_len=2, skip=()):
        out = {}
        for f in fields:
            ws = [e for _, e, _ in slots if e._key == f[0]]
            if f[0] in skip:
                for e in ws:
                    e.setEnabled(False)
                    self._mark_bad(e, False)
                out[f[0][prefix_len:]] = 0.0
                continue
            for e in ws:
                if not e.isEnabled():
                    e.setEnabled(True)
            out[f[0][prefix_len:]] = self._val(f, ws)
        return out

    def recalc(self):
        self._scene_ver = getattr(self, "_scene_ver", 0) + 1     # unieważnia zapamiętaną geometrię modelu 3D
        self._pending = False
        self._in_recalc = True
        try:
            self._recalc()
        finally:
            self._in_recalc = False

    def _apply_location(self):
        """Lokalizacja: współrzędne w zakładkach; strefy i wysokość n.p.m. zmienione względem mapy – nazwy pól
        na czerwono z dopiskiem „zmienione ręcznie”, przycisk Przywróć."""
        loc = self.loc.get()
        self._zinfo = {}
        if loc:
            for kind in ("snow", "wind"):
                self._zinfo[kind] = zone_lookup(kind, loc["lon"], loc["lat"])
            txt = f"{loc['lat']:.4f}° N, {loc['lon']:.4f}° E"
        else:
            txt = "nie wybrano – wybierz w oknie głównym: Plik → Informacje o projekcie"
        for lb in self.loc_labels:
            lb.configure(text=txt)
        fl = self._manual_flags()
        self._manual = fl
        marks = [(cb._label, fl[n]) for cb, n in zip(self.zone_boxes, ("snow_zone", "wind_zone"))]
        marks += [(e._label, fl["A"]) for e in self.entries.get("A", [])]
        for lb, on in marks:
            t = lb._base + ("\nzmienione ręcznie" if on else "")
            if lb.text() != t:
                lb.setText(t)
                lb.setStyleSheet(f"color:{MANUAL_COL};" if on else "")
        for b in self.loc_restore:
            b.setVisible(bool(loc))
            b.setEnabled(any(fl.values()))

    def _zone_note(self, kind):
        zi = getattr(self, "_zinfo", {}).get(kind)
        if not zi or getattr(self, "_manual", {}).get(kind + "_zone"):
            return ""
        if zi["zone"] is None:
            return "\n⚠ Punkt poza Polską – wybierz strefę ręcznie."
        t = ""
        for d, z in zi["near"]:
            t += f"\nGranica ze strefą {z} w odległości ok. {f2(d, 0)} km"
            t += (" – wg NB1.7 w pasie 10 km można przyjąć średnią sₖ obu stref (strefę można zmienić ręcznie)."
                  if kind == "snow" else " – sprawdź lokalizację z mapą normy.")
        return t

    def _recalc(self):
        self._apply_location()
        self._errors = []
        geo_err = []
        ct_f = self.ct_mode.get() == CT_MODES[1]
        cpi_custom = self.cpi_mode.get() == CPI_MODES[1]
        skind, sfields = SNOW_TYPES[self.snow_type.get()]
        wkind, wfields = WIND_TYPES[self.wind_type.get()]
        canopy = wkind in ("can1", "can2")
        for k, on in (("U", ct_f), ("ti", ct_f), ("cpi", cpi_custom and not canopy), ("phi", canopy)):
            for e in self.entries[k]:
                if e.isEnabled() != on:
                    e.setEnabled(on)
        A = self._read_simple("A", 0, 2500)
        U = self._read_simple("U", 1, 4.5, active=ct_f)
        ti = self._read_simple("ti", -50, 60, active=ct_f)
        cdir = self._read_simple("cdir", 0, 2, True)
        cse = self._read_simple("cseason", 0, 2, True)
        rho = self._read_simple("rho", 0, 3, True)
        Al = self._read_simple("Aload", 0, 1e6, True)
        cpi = self._read_simple("cpi", -1.5, 1.5, active=cpi_custom and not canopy)
        phi = self._read_simple("phi", 0, 1, active=canopy)

        # ---------- śnieg: budynek
        sdiff = skind == "duo" and self.s_diff.get()
        sact = self.fill_slots(self.s_slots, sfields, sdiff)
        if self._s_layout != skind:            # układ zmieniany tylko przy zmianie kształtu
            self._s_layout = skind
            self.s_diff_cb.setVisible(skind == "duo")
            self.s_obst_lb.setVisible(skind == "obst")
            self.s_obst_cb.setVisible(skind == "obst")
            self.s_exc_cb.setVisible(skind in EXC_FIELDS)
            self.s_ex.setVisible(skind in ("duo", "obst") or skind in EXC_FIELDS)
        skip = ("s_yob",) if self.s_obst.get() != OBST_TYPES[1] else ()
        sp_geo = self._read_geo(self.s_slots, sact, skip=skip)
        exc_on = bool(self.s_exc.get()) and skind in EXC_SECTIONS
        secs = EXC_SECTIONS.get(skind, []) if exc_on else []
        exc = {}
        for (pos, key), hw in self.s_xhdr.items():
            want = pos < len(secs) and secs[pos][0] == key
            if hw._want != want:
                hw._want = want
                hw.setVisible(want)
        for pos in range(4):
            sec = secs[pos] if pos < len(secs) else None
            on = bool(sec and getattr(self, "sx_" + sec[0]).get())
            act = self.fill_slots(self.s_xsl[pos], sec[2] if on else [], False)
            if sec:
                exc[sec[0]] = on
                if on:
                    exc.update(self._read_geo(self.s_xsl[pos], act))
        sp_geo["exc"] = exc if exc_on else None
        sp_geo["A"] = A
        if skind == "duo" and not sdiff:
            sp_geo["alpha2"] = sp_geo.get("alpha")
        sp_geo["otype"] = self.s_obst.get()
        # ---------- wiatr: budynek
        wdiff = False                  # wiatr: norma nie podaje procedury dla różnych kątów połaci
        wact = self.fill_slots(self.w_slots, wfields, wdiff)
        if self._w_layout != wkind:
            self._w_layout = wkind
            self.w_ex.setVisible(wkind == "multi")
        wp_geo = self._read_geo(self.w_slots, wact)
        wp_geo.update(A=A, mtype=self.w_mtype.get())
        if wkind == "duo" and not wdiff:
            wp_geo["alpha2"] = wp_geo.get("alpha")

        self.desc_update()
        # ---------- kontrola geometrii (błędne pole – zaznaczone na czerwono)
        tg = lambda a: math.tan(math.radians(a))
        s_msg, w_msg = [], []
        bad = set(self._errors)
        S_KEYS = {"A", "U", "ti"}
        W_KEYS = {"A", "cdir", "cseason", "rho", "Aload", "cpi", "phi"}
        s_ok = not any(k in S_KEYS or k.startswith("s_") for k in bad)
        w_ok = not any(k in W_KEYS or k.startswith("w_") for k in bad)
        if not s_ok:
            s_msg.append("Śnieg: popraw zaznaczone pola.")
        if not w_ok:
            w_msg.append("Wiatr: popraw zaznaczone pola.")

        def geo(ok, msgs, cond, key, text):
            if ok and cond():
                msgs.append(text)
                self._mark_key(key)
                return False
            return ok
        s_ok = geo(s_ok, s_msg, lambda: skind == "vault" and sp_geo["f"] > sp_geo["B"] / 2, "s_f",
                   "Śnieg: wyniosłość łuku h nie może przekraczać b/2.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "obst" and sp_geo["otype"] == OBST_TYPES[1]
                   and sp_geo["yob"] > sp_geo["B"] - 0.25, "s_yob", "Śnieg: ścianka musi leżeć na dachu (y ≤ B − 0,25 m).")
        sx = sp_geo.get("exc") or {}
        s_ok = geo(s_ok, s_msg, lambda: skind == "abut" and sx.get("annex") and sx["xh"] >= sp_geo["H"] + sp_geo["dh"], "s_xh",
                   "Śnieg: przybudówka – h musi być mniejsze od wysokości okapu budowli wyższej.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "abut" and sx.get("annex") and min(sx["xw"], sp_geo["L"]) / 2 *
                   tg(sx["xa"]) >= sx["xh"], "s_xa",
                   "Śnieg: kalenica przybudówki musi być niżej niż okap budowli wyższej.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "flat" and sx.get("fobst") and sx["fw"] >= sp_geo["L"], "s_fw",
                   "Śnieg: przeszkoda musi być węższa niż dach.")
        s_ok = geo(s_ok, s_msg, lambda: skind == "flat" and sx.get("fobst") and sx["fd"] >= sp_geo["B"], "s_fd",
                   "Śnieg: przeszkoda musi być płytsza niż dach.")
        s_ok = geo(s_ok, s_msg, lambda: sx.get("canopy") and sx["ch"] >= sp_geo["H"],
                   "s_ch",
                   "Śnieg: zadaszenie musi leżeć poniżej krawędzi dachu.")
        s_ok = geo(s_ok, s_msg, lambda: skind in ("mono", "duo", "multi", "vault") and sx.get("pobst")
                   and not 0 < sx["poy"] < sp_geo["B"] - 0.25, "s_poy",
                   "Śnieg: przeszkoda musi leżeć na dachu (0 < y < B − 0,25 m).")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "vault" and wp_geo["f"] > wp_geo["B"] / 2, "w_f",
                   "Wiatr: wyniosłość łuku f nie może przekraczać d/2.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "dome" and wp_geo["f"] > wp_geo["D"] / 2, "w_f",
                   "Wiatr: wyniosłość kopuły f nie może przekraczać d/2.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "hip" and not Hip(wp_geo["L"], wp_geo["B"], wp_geo["H"],
                                                                   wp_geo["alpha"], wp_geo["a90"]).valid, "w_a90",
                   "Wiatr: połacie szczytowe nie mieszczą się na długości L (zwiększ α₉₀ lub L).")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "trough" and wp_geo["B"] / 2 * tg(wp_geo["alpha"]) >= wp_geo["H"],
                   "w_alpha", "Wiatr: kosz dachu schodzi poniżej poziomu terenu.")
        w_ok = geo(w_ok, w_msg, lambda: wkind == "can2" and wp_geo["alpha"] < 0
                   and wp_geo["B"] / 2 * tg(-wp_geo["alpha"]) >= wp_geo["H"],
                   "w_alpha", "Wiatr: kosz wiaty schodzi poniżej poziomu terenu.")
        self._s_ok, self._w_ok = s_ok, w_ok
        msgs = s_msg + w_msg
        self.status.configure(text=("⚠ " + "  ".join(msgs) + "  Model i wyniki – ostatnie poprawne dane.")
                              if msgs else "")

        # ---------- śnieg (niezależnie od wiatru)
        if s_ok:
            sg = SnowGeo(skind, sp_geo)
            sp = dict(zone=self.snow_zone.get(), ce=self.snow_ce.get(), ct_formula=ct_f, U=U, ti=ti,
                      guard=self.guard.get())
            self.sgeo = sg
            self.snow = calc_snow(sg, sp)
            cases = [c["name"] for c in self.snow["cases"]]
            for cb in self.case_boxes:
                self._set_items(cb, cases)
            if self.snow_case.get() not in cases:
                self.snow_case.set(cases[0])
            self.show_snow()
        # ---------- wiatr (niezależnie od śniegu)
        if w_ok:
            wg = WindGeo(wkind, wp_geo)
            wp = dict(zone=self.wind_zone.get(), cat=self.terrain.get(), cdir=cdir, cseason=cse, rho=rho,
                      Aload=Al, cpi_std=not cpi_custom, cpi=cpi, phi=phi)
            ths = [f"{t}°" for t in wind_thetas(wg)]
            for cb in self.theta_boxes:
                self._set_items(cb, ths, len(ths) > 1)
            if self.theta.get() not in ths:
                self.theta.set(ths[0])
            th = int(self.theta.get().rstrip("°"))
            vars_ = wind_variants(wg, th)
            labs = [l for l, _ in vars_]
            for cb in self.variant_boxes:
                self._set_items(cb, labs, len(labs) > 1)
            if self.variant.get() not in labs:
                self.variant.set(labs[0])
            var = dict(vars_)[self.variant.get()]
            if self._last_theta != th:
                self._last_theta = th
                self.yaw = self.default_yaw(th)
            self.wgeo, self.wp = wg, wp
            self.wind = calc_wind(wg, wp, th, var)
            self.env = wind_envelope(wg, wp)
            self.show_wind()
        self.draw3d()

    def _mark_key(self, key):
        """Zaznacza na czerwono wszystkie pola pokazujące daną wielkość."""
        ws = list(self.entries.get(key, [])) + [e for _, e, _ in self.s_slots + self.w_slots if e._key == key]
        for e in ws:
            self._mark_bad(e, True)

    def desc_update(self):
        self.ce_desc.configure(text=SNOW_CE[self.snow_ce.get()][1] + self._zone_note("snow"))
        self.wind_desc.configure(text=WIND_ZONES[self.wind_zone.get()] + "\nKategoria " + self.terrain.get() +
                                 ": " + TERRAIN[self.terrain.get()][3] + self._zone_note("wind"))

    # ============================================================ OKNO 3D ===
    def toggle_3d(self):
        if self.win3d is not None and self.win3d.isVisible():
            self.hide_3d()
        else:
            self.show_3d()

    def show_3d(self):
        if self.win3d is None:
            self._build_3d()
        if self._3d_geom is not None:
            self.win3d.restoreGeometry(self._3d_geom)
        else:
            fg = self.win.frameGeometry()
            self.win3d.resize(960, 720)
            self.win3d.move(fg.x() + fg.width() + 12, max(fg.y(), 0))
        self.win3d.show()
        self.win3d.raise_()
        self.win3d.activateWindow()
        self.btn3d.setText("Zamknij model 3D")
        self.draw3d()

    def hide_3d(self):
        if self.win3d is None:
            return
        self._3d_geom = self.win3d.saveGeometry()
        self.close_editor()
        self.win3d.hide()
        self.btn3d.setText("Otwórz model 3D")

    def _build_3d(self):
        w = Win3D(self)
        w.setWindowTitle("Model 3D")
        w.setMinimumSize(640, 480)
        self.win3d = w
        lay = QVBoxLayout(w)
        lay.setContentsMargins(10, 8, 10, 10)
        lay.setSpacing(6)
        bar = QHBoxLayout()
        # --- opcje śniegu
        self.tb_snow = QWidget()
        h = QHBoxLayout(self.tb_snow)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(QLabel("Przypadek śniegu"))
        cb = self._mk_combo(self.snow_case, [c["name"] for c in self.snow["cases"]] if self.snow else ["i"], 4)
        h.addWidget(cb)
        self.case_boxes.append(cb)
        # --- opcje wiatru
        self.tb_wind = QWidget()
        h = QHBoxLayout(self.tb_wind)
        h.setContentsMargins(0, 0, 0, 0)
        h.addWidget(QLabel("Kierunek θ"))
        tl = [f"{t}°" for t in wind_thetas(self.wgeo)] if self.wgeo else ["0°"]
        cb = self._mk_combo(self.theta, tl, 5)
        cb.setEnabled(len(tl) > 1)
        h.addWidget(cb)
        self.theta_boxes.append(cb)
        h.addSpacing(10)
        h.addWidget(QLabel("Wariant"))
        vl = [l for l, _ in wind_variants(self.wgeo, self.wind["theta"])] if self.wgeo else []
        cb = self._mk_combo(self.variant, vl, 28)
        cb.setEnabled(len(vl) > 1)
        h.addWidget(cb)
        self.variant_boxes.append(cb)
        bar.addWidget(self.tb_snow)
        bar.addWidget(self.tb_wind)
        bar.addStretch(1)
        bar2 = QHBoxLayout()
        bar2.addWidget(self._mk_check("Etykiety", self.labels3d))
        self.tb_wind2 = self._mk_check("Strzałki", self.arrows3d)
        bar2.addWidget(self.tb_wind2)
        bar2.addWidget(self._mk_check("Wymiary pól", self.dims3d))
        bar2.addWidget(self._mk_check("Wymiary budynku", self.bdims3d))
        bar2.addStretch(1)
        b = QPushButton("Widok domyślny")
        b.clicked.connect(lambda checked=False: self.reset_view())
        bar2.addWidget(b)
        lay.addLayout(bar)
        lay.addLayout(bar2)
        self.cv = Canvas3D(self)
        lay.addWidget(self.cv, 1)
        self._tb_mode = None

    def update_toolbar(self, mode):
        """Na pasku okna 3D tylko opcje dotyczące pokazywanego obciążenia."""
        if self._tb_mode == mode:
            return
        self._tb_mode = mode
        wind = mode == "wiatr"
        self.tb_snow.setVisible(not wind)
        self.tb_wind.setVisible(wind)
        self.tb_wind2.setVisible(wind)

    def draw3d(self):
        """Przerysowanie modelu – zbiorczo, najwyżej raz na obieg pętli zdarzeń."""
        if self._draw_pending:
            return
        self._draw_pending = True
        QTimer.singleShot(0, self._draw3d_run)

    def _draw3d_run(self):
        self._draw_pending = False
        self._draw3d_now()
        if self.cv is not None:
            self.cv.update()

    # ---------------------------------------------------- edycja wymiarów w 3D ---
    def open_editor(self, key, pos):
        self.close_editor()
        keys = key if isinstance(key, tuple) else (key,)
        f = self.field_def(keys[0])
        fr = QFrame(self.cv)
        fr.setObjectName("editor")
        h = QHBoxLayout(fr)
        h.setContentsMargins(5, 2, 5, 2)
        h.setSpacing(4)
        lab = f[1] if f else keys[0]
        if f and f[2] == "°":                      # podpowiedź zakresu kąta
            rng = f"{field_range(f)}°"
            lab = lab[:-1] + f", {rng})" if lab.endswith(")") else lab + f" ({rng})"
        h.addWidget(QLabel(lab + ":"))
        ent = EditorLine(lambda: self.close_editor(fr), lambda: QTimer.singleShot(150, lambda: self.close_editor(fr)))
        ent.setAlignment(AL_R)
        ent.setFixedWidth(QFontMetrics(QFont(MONO, 10)).horizontalAdvance("0") * 9 + 12)
        ent.setText(self.v[keys[0]].get())
        h.addWidget(ent)
        h.addWidget(QLabel(f[2] if f else ""))
        fr.adjustSize()
        x = int(clamp(pos[0] - fr.width() / 2, 2, max(self.cv.width() - fr.width() - 2, 2)))
        y = int(clamp(pos[1] - fr.height() / 2, 2, max(self.cv.height() - fr.height() - 2, 2)))
        fr.move(x, y)
        fr.show()
        ent.setFocus()
        ent.selectAll()
        self._editor = fr

        def commit():
            v = parse_num(ent.text())
            ok = v is not None
            if ok and f:
                k_, lab_, unit, lo, hi, strict, integer = f
                ok = (v > lo if strict else v >= lo) and v <= hi and (not integer or abs(v - round(v)) < 1e-9)
            if not ok:
                ent.setProperty("bad", True)
                ent.setStyleSheet(f"background:{ERR_BG};")
                return
            txt = ent.text().strip()
            self.close_editor(fr)
            for k_ in keys:
                self.v[k_].set(txt)
        ent.returnPressed.connect(commit)

    def field_def(self, key):
        """Definicja pola wg bieżącego kształtu (ten sam klucz może mieć różne zakresy w różnych kształtach)."""
        for tp, var in ((SNOW_TYPES, self.snow_type), (WIND_TYPES, self.wind_type)):
            for f in tp[var.get()][1]:
                if not isinstance(f, str) and f[0] == key:
                    return f
        return FIELD_DEFS.get(key)

    def close_editor(self, only=None):
        ed = self._editor
        if ed is None or (only is not None and ed is not only):
            return
        self._editor = None
        ed.hide()
        ed.deleteLater()

    # ============================================================ PROJEKT ===
    @staticmethod
    def _globals_of(st):
        """Dane wspólne dla całego projektu: lokalizacja, wysokość n.p.m. i strefy."""
        op = st.get("opcje", {})
        return dict(A=str(st.get("pola", {}).get("A", "")), snow_zone=op.get("snow_zone"),
                    wind_zone=op.get("wind_zone"), loc=st.get("lokalizacja"),
                    manual=bool(st.get("strefy_recznie", False)))

    @staticmethod
    def _put_globals(st, g):
        st.setdefault("pola", {})["A"] = g["A"]
        op = st.setdefault("opcje", {})
        op["snow_zone"], op["wind_zone"] = g["snow_zone"], g["wind_zone"]
        st["lokalizacja"] = g["loc"]
        st["strefy_recznie"] = g["manual"]

    def _main_extra(self):
        return {"mode": self.mode3d.get(), "snow_case": self.snow_case.get(),
                "view": {k: getattr(self, k) for k in VIEW_KEYS},
                "toggles": {k: bool(getattr(self, k).get()) for k in TOGGLE_KEYS}}

    def project_changed(self):
        if not self._loading:
            self.dirty = True
            self.update_title()

    def _in_case(self, st, extra, fn):
        """Wykonuje fn() z formularzem chwilowo ustawionym na dane przypadku, potem przywraca formularz."""
        self.close_editor()
        if self._pending:
            self.recalc()
        main_st, main_sc, dirty = self.get_state(), self.snow_case.get(), self.dirty
        view, last_th = {k: getattr(self, k) for k in VIEW_KEYS}, self._last_theta
        try:
            self.set_state(st)
            sc = extra.get("snow_case")
            if self.snow and sc in [c["name"] for c in self.snow["cases"]]:
                self.snow_case.set(sc)
            return fn()
        finally:
            self.set_state(main_st)
            if self.snow and main_sc in [c["name"] for c in self.snow["cases"]]:
                self.snow_case.set(main_sc)
            for k, v in view.items():
                setattr(self, k, v)
            self._last_theta = last_th
            self.dirty = dirty
            self.update_title()
            self.draw3d()

    def _grab_current(self, mode):
        """Bieżące obliczenia formularza obciążeń normowych (wyniki, model, dane do późniejszej edycji)."""
        return dict(ok=bool(getattr(self, "_w_ok" if mode == "wiatr" else "_s_ok", False)),
                    err=self.status.text(), state=self.get_state(),
                    calc=dict(sgeo=self.sgeo, snow=self.snow, wgeo=self.wgeo, wind=self.wind, mode=mode,
                              snow_case=self.snow_case.get()),
                    report=(self.wind_text if mode == "wiatr" else self.snow_text).toHtml())

    def _compute(self, case):
        mode = case["extra"].get("mode", "śnieg")
        return self._in_case(case["state"], case["extra"], lambda: self._grab_current(mode))

    def _apply_result(self, case, r):
        case["state"] = r["state"]
        case["report"] = r["report"]
        case["_calc"] = r["calc"]
        case["extra"]["snow_case"] = r["calc"]["snow_case"]

    def ensure_calc(self, case):
        if case.get("_calc") is None:
            r = self._compute(case)
            self._apply_result(case, r)          # błędne dane – i tak pokazujemy ostatni poprawny model

    def recapture_case(self, case):
        """Przeliczenie przypadku po zmianie jego danych. False – dane niepoprawne."""
        r = self._compute(case)
        if not r["ok"]:
            case["_err"] = r["err"]
            return False
        self._apply_result(case, r)
        return True

    def field_def_state(self, st, key):
        op = st.get("opcje", {})
        for tp, n in ((SNOW_TYPES, "snow_type"), (WIND_TYPES, "wind_type")):
            if op.get(n) in tp:
                for f in tp[op[n]][1]:
                    if not isinstance(f, str) and f[0] == key:
                        return f
        return FIELD_DEFS.get(key)

    # --- rysowanie zapisanego przypadku na dowolnym płótnie
    _CTX_ATTRS = ("sgeo", "snow", "wgeo", "wind", "cv", "yaw", "pitch", "zoom", "pan_x", "pan_y", "_scene_key",
                  "_scene_cache", "_snow_ztop", "_edit_keys", "_placed", "_defer_angles", "_scene_ver", "_s_ok", "_w_ok", "_ctx")

    def render_case(self, cv, case, image=False):
        self.ensure_calc(case)
        calc, ex = case["_calc"], case["extra"]
        view = getattr(cv, "view", None) or ex.get("view") or {}
        miss = object()
        saved = {n: getattr(self, n, miss) for n in self._CTX_ATTRS}
        vars_ = {n: getattr(self, n)._v for n in ("snow_case", "mode3d") + TOGGLE_KEYS}
        tg = ex.get("toggles") or {}
        try:
            self.sgeo, self.snow, self.wgeo, self.wind = calc["sgeo"], calc["snow"], calc["wgeo"], calc["wind"]
            self.cv = cv
            for k in VIEW_KEYS:
                if k in view:
                    setattr(self, k, view[k])
            self._scene_key = getattr(cv, "_scene_key", None)
            self._scene_cache = getattr(cv, "_scene_cache", None)
            self._scene_ver = ("przypadek", id(calc))
            self._edit_keys = {}
            self._s_ok = self._w_ok = True
            self._ctx = "img" if image else "view"
            self.snow_case._v = calc["snow_case"]
            self.mode3d._v = calc["mode"]
            for k in TOGGLE_KEYS:
                getattr(self, k)._v = bool(tg.get(k, True))
            self._draw3d_now()
            cv._scene_key, cv._scene_cache, cv._edit_keys = self._scene_key, self._scene_cache, self._edit_keys
        finally:
            for n, v in saved.items():
                if v is miss:
                    if hasattr(self, n):
                        delattr(self, n)
                else:
                    setattr(self, n, v)
            for n, v in vars_.items():
                getattr(self, n)._v = v

    SNAP_W, SNAP_H, SNAP_DPR = 780, 540, 3         # obraz do wydruku: rozmiar logiczny, gęstość pikseli

    def snapshot(self, case, w=SNAP_W, h=SNAP_H, dpr=SNAP_DPR):
        """Obraz modelu 3D przypadku (do wydruku). Płótno w rozmiarze zbliżonym do obrazu na kartce (napisy
        prawie w naturalnej wielkości), malowane w dpr-krotnej gęstości pikseli (ostre linie i tekst)."""
        from PySide6.QtGui import QPixmap
        cv = getattr(self, "_snap_cv", None)
        if cv is None:
            cv = self._snap_cv = Canvas3D(self)
            cv.setAttribute(Qt.WidgetAttribute.WA_DontShowOnScreen, True)
        cv.resize(w, h)
        cv._scene_key = None
        self.render_case(cv, case, image=True)
        pm = QPixmap(int(w * dpr), int(h * dpr))
        pm.setDevicePixelRatio(dpr)
        pm.fill(QColor(Canvas3D.BG_COL))
        cv.render(pm)
        return pm

    # --- przyciski okna obciążeń normowych
    def set_editing(self, case):
        self.editing = case
        self.btn_add.setVisible(case is None)        # w edycji przypadku na dole tylko model 3D
        self.update_title()
        self.update_buttons()

    def update_buttons(self):
        if getattr(self, "pw", None) is not None and self.pw.app is not None:
            self.pw.update_buttons()

    # --- okno obciążeń normowych (KAYENN Codes) nad oknem głównym
    def toggle_codes(self):
        if self.win.isVisible():
            self.close_codes()
        else:
            self.open_codes()

    def open_codes(self):
        if not self.win.isVisible():
            if not getattr(self, "_codes_placed", False):     # pierwszy raz – nad oknem głównym
                g = self.pw.frameGeometry()
                scr = self.pw.screen().availableGeometry()
                d = 40 if self.host is self else 90           # panel edycji – przesunięty względem dodawania
                self.win.move(max(g.x() + d, scr.x()), max(g.y() + d - 10, scr.y()))
                self._codes_placed = True
            self.win.show()
        self.win.raise_()
        self.win.activateWindow()
        self.update_buttons()

    def close_codes(self):
        """Zamknięcie panelu (X, Zamknij obciążenia normowe; w panelu edycji – też Zakończ edycję).
        False – użytkownik został przy edycji."""
        if not self.end_edit():
            return False
        self.close_editor()
        self.hide_3d()
        self.win.hide()
        self.update_buttons()
        return True

    def end_edit(self, save=True):
        """Panel edycji: koniec edycji przypadku – zmiany trafiają do przypadku, panel się zamyka.
        False – dane niepoprawne i użytkownik wybrał powrót do edycji."""
        case = self.editing
        if case is None:
            return True
        if save:
            if self._pending:
                self.recalc()
            self.close_editor()
            mode = self.mode3d.get()
            r = self._grab_current(mode)
            if not r["ok"]:
                B = QMessageBox.StandardButton
                box = QMessageBox(QMessageBox.Icon.Warning, "Edycja przypadku",
                                  f"Dane przypadku „{case['name']}” są niepoprawne – zmian nie można zapisać:\n"
                                  + (r["err"] or "sprawdź dane budynku."), B.Discard | B.Cancel, self._front())
                box.button(B.Discard).setText("Odrzuć zmiany")
                box.button(B.Cancel).setText("Wróć do edycji")
                if box.exec() != B.Discard:
                    return False
            else:
                extra = self._main_extra()
                old = json.dumps([case.get("state"), {k: case["extra"].get(k) for k in extra}], sort_keys=True,
                                 default=str)
                new = json.dumps([r["state"], extra], sort_keys=True, default=str)
                if old != new:
                    case["extra"] = extra
                    self.info_msg(self._store_case(case, r, f"Zaktualizowano: „{case['name']}”."))
                    self.project_changed()
        self.set_editing(None)
        self.close_editor()
        self.hide_3d()
        self.win.hide()
        if case in self.project["cases"]:
            self.pw.refresh_cases([case])
        self.update_buttons()
        return True

    def _store_case(self, case, r, msg):
        """Wyniki do przypadku + wspólne dane projektu (lokalizacja, A) we wszystkich przypadkach."""
        self._apply_result(case, r)
        g = self._globals_of(r["state"])
        if self.project.get("globals") not in (None, g):             # zmiana lokalizacji / wysokości n.p.m.
            n_ = 0
            for c in self.project["cases"]:
                if c is not case and self._globals_of(c["state"]) != g:
                    self._put_globals(c["state"], g)
                    c["_calc"] = None                                 # przeliczenie przy otwarciu / wydruku
                    n_ += 1
            if n_:
                msg += f" Lokalizację i wysokość n.p.m. zmieniono we wszystkich przypadkach ({n_})."
        self.project["globals"] = g
        return msg

    def add_or_update(self):
        if self._pending:
            self.recalc()
        self.close_editor()
        mode = self.mode3d.get()
        r = self._grab_current(mode)
        if not r["ok"]:
            QMessageBox.warning(self.win, "Projekt", "Nie można zapisać przypadku – dane są niepoprawne:\n"
                                + (r["err"] or "sprawdź dane budynku."))
            return
        extra = self._main_extra()
        case = self.editing
        if case is None:
            from datetime import datetime
            n = self.project["next"]
            self.project["next"] = n + 1
            case = {"id": n, "name": f"Przypadek {n}", "created": datetime.now().strftime("%Y-%m-%d %H:%M"),
                    "extra": extra}
            self.project["cases"].insert(0, case)                    # najmłodszy na górze
            msg = f"Dodano do projektu: „{case['name']}”."
        else:
            case["extra"] = extra
            msg = f"Zaktualizowano: „{case['name']}”."
        msg = self._store_case(case, r, msg)
        self.project_changed()
        self.info_msg(msg)
        if self.pw.card_of(case) is None:
            self.pw.insert_case(case)
        else:
            self.pw.refresh_cases([case])

    def info_msg(self, text):
        self.proj_msg.setText(text)
        self.proj_msg.setVisible(bool(text))
        QTimer.singleShot(6000, lambda t=text: self.proj_msg.text() == t and self.proj_msg.setVisible(False))

    def edit_case(self, case):
        """Edytuj – przypadek w osobnym panelu edycji nad oknem głównym (panel dodawania przypadków działa
        niezależnie). Zmiany trafiają do przypadku po zakończeniu edycji (Zakończ edycję lub X)."""
        host = self.host
        ed = host.editor
        if ed is None:
            ed = host.editor = App(self.qapp, host=host)
            ed.win.resize(host.win.size())
        elif ed.editing is not None and ed.editing is not case and not ed.end_edit():
            return
        ed._start_edit(case)

    def _start_edit(self, case):
        self.close_editor()
        ex = case["extra"]
        dirty = self.dirty
        self.set_state(case["state"])
        self.dirty = dirty
        self.nb.setCurrentIndex(TAB_WIND if ex.get("mode") == "wiatr" else TAB_SNOW)
        self.mode3d.set(ex.get("mode", "śnieg"))
        if self.snow and ex.get("snow_case") in [c["name"] for c in self.snow["cases"]]:
            self.snow_case.set(ex["snow_case"])
        for k, v in (ex.get("view") or {}).items():
            if k in VIEW_KEYS:
                setattr(self, k, v)
        for k, v in (ex.get("toggles") or {}).items():
            if k in TOGGLE_KEYS:
                getattr(self, k).set(bool(v))
        self.set_editing(case)
        self.open_codes()
        self.draw3d()
        self.info_msg(f"Edycja: „{case['name']}”. Zmiany trafią do projektu po zakończeniu edycji.")

    # --- zapis / odczyt
    def _project_dump(self):
        keys = ("id", "name", "created", "state", "extra", "report")
        return {"nazwa": self.project.get("name") or "", "next": self.project["next"],
                "globals": self.project.get("globals"),
                "przypadki": [{k: c.get(k) for k in keys} for c in self.project["cases"]]}

    def _project_load(self, d):
        self.project = {"cases": [], "next": 1, "globals": None, "name": ""}
        if not d:
            return
        self.project["name"] = str(d.get("nazwa") or "")
        for c in d.get("przypadki", []):
            if isinstance(c, dict) and "state" in c:
                c.setdefault("extra", {})
                c.setdefault("name", f"Przypadek {c.get('id', '?')}")
                c["_calc"] = None
                self.project["cases"].append(c)
        ids = [c.get("id", 0) for c in self.project["cases"] if isinstance(c.get("id"), int)]
        for c in self.project["cases"]:
            if not isinstance(c.get("id"), int):
                c["id"] = max(ids + [0]) + 1
                ids.append(c["id"])
        self.project["next"] = max(int(d.get("next", 1)), max(ids + [0]) + 1)
        self.project["globals"] = d.get("globals")

    # --- wydruk
    def project_document(self):
        from PySide6.QtCore import QUrl
        from PySide6.QtGui import QTextDocument
        esc = html.escape
        doc = QTextDocument()
        doc.setDefaultFont(QFont(FONT, 9))
        parts = []
        head = f"Projekt: <b>{esc(self.project_title())}</b>"       # tylko nazwa projektu
        for i, case in enumerate(self.project["cases"]):
            self.ensure_calc(case)
            img = self.snapshot(case).toImage()
            doc.addResource(QTextDocument.ResourceType.ImageResource, QUrl(f"przypadek{i}.png"), img)
            ex, op = case["extra"], case["state"].get("opcje", {})
            mode = ex.get("mode", "śnieg")
            sub = (f"Śnieg · {op.get('snow_type', '')} · przypadek ({case['_calc']['snow_case']})" if mode != "wiatr"
                   else f"Wiatr · {op.get('wind_type', '')} · θ = {op.get('theta', '')}"
                   + (f" · {op.get('variant')}" if op.get("variant") else ""))
            brk = ' style="page-break-before:always;"' if i else ""
            parts.append(f'<div{brk}><p style="color:#6b7280; font-size:8pt;">{head}</p>'
                         f'<h2 style="margin:4px 0 2px 0;">{esc(case["name"])}</h2>'
                         f'<p style="color:#6b7280; margin:0 0 6px 0;">{esc(sub)}</p>'
                         f'<p align="center"><img src="przypadek{i}.png" width="620"></p>'
                         f'{html_body(case.get("report") or "")}</div>')
        doc.setHtml("".join(parts))
        return doc

    def print_project(self):
        if not self.project["cases"]:
            QMessageBox.information(self.pw or self.win, "Drukuj", "Projekt nie zawiera przypadków.")
            return
        try:
            from PySide6.QtPrintSupport import QPrinter, QPrintPreviewDialog
        except ImportError:
            QMessageBox.critical(self.pw or self.win, "Drukuj", "Brak modułu drukowania Qt (QtPrintSupport).")
            return
        # podgląd wydruku Qt (okno drukowania Windows 11 nie pokazuje podglądu); przycisk drukarki w podglądzie
        # otwiera wybór drukarki
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            doc = self.project_document()                 # raz – obrazy modeli 3D liczone tylko tu
        finally:
            QApplication.restoreOverrideCursor()
        printer = QPrinter(QPrinter.PrinterMode.HighResolution)
        printer.setDocName(self.project_title())
        dlg = QPrintPreviewDialog(printer, self.pw or self.win)
        dlg.setWindowTitle(f"Podgląd wydruku – {self.project_title()}")
        dlg.setWindowFlag(Qt.WindowType.WindowMaximizeButtonHint, True)
        scr = (self.pw or self.win).screen().availableGeometry()
        dlg.resize(min(1000, scr.width() - 80), scr.height() - 80)
        dlg.paintRequested.connect(lambda p: doc.print_(p))
        self._preview = dlg                               # (testy: dostęp do okna podglądu)
        dlg.setModal(False)                               # nie blokuje pozostałych okien
        dlg.show()

    # ============================================== sceny i rysowanie modelu 3D ===
    def get_state(self):
        st = {"program": "KAYENN", "wersja": 1,
              "pola": {k: v.get() for k, v in self.v.items()}}
        st["opcje"] = {n: getattr(self, n).get() for n in self.STATE_VARS}
        st["lokalizacja"] = self.loc.get()
        st["strefy_recznie"] = any(self._manual_flags().values())
        st["uzytkowe"] = self._use_state()
        return st

    def set_state(self, st):
        self._loading = True
        try:
            for k, val in st.get("pola", {}).items():
                if k in self.v:
                    self.v[k].set(str(val))
            for n, val in st.get("opcje", {}).items():
                if n in self.STATE_VARS:
                    getattr(self, n).set(val)
            self.loc.set(st.get("lokalizacja"))
            self._use_set_state(st.get("uzytkowe"))
            self.recalc()
            th = st.get("opcje", {}).get("theta")
            vr = st.get("opcje", {}).get("variant")
            if th:
                self.theta.set(th)
            if vr:
                self.variant.set(vr)
            self.recalc()
        finally:
            self._loading = False
        self.update_title()

    def file_new(self):
        if not self.end_editor() or not self._ask_save():
            return
        self.project_path = None
        self._project_load(None)
        self.set_editing(None)
        self.pw.rebuild(keep_open=False)
        self.set_state({"pola": DEFAULTS, "opcje": dict(
            snow_type="Dwupołaciowy", wind_type="Dwuspadowy", snow_zone="1", snow_ce="Normalny",
            ct_mode=CT_MODES[0], guard=False, s_diff=False, s_obst=OBST_TYPES[0], s_exc=False,
            **{"sx_" + k_: v_ for k_, v_ in EXC_SEC_DEFAULT.items()},
            w_mtype=MULTI_TYPES[0],
            wind_zone="1", terrain="II", theta="0°", variant="", cpi_mode=CPI_MODES[0])})
        self.dirty = False
        self.update_title()

    def on_snow_case(self):
        self.show_snow()
        self.draw3d()

    def show_snow(self):
        s, g = self.snow, self.sgeo
        zn = self.snow_zone.get()
        it = [("h", "Dane i współczynniki")]
        it.append(("v", f"sₖ = {f2(s['sk'], 3)} kN/m²",
                   f"wartość charakterystyczna obciążenia śniegiem gruntu (strefa {zn}: "
                   f"{SNOW_ZONES[zn][0]}, A = {f2(g.p['A'], 0)} m n.p.m.)"))
        cur = next((c for c in s["cases"] if c["name"] == self.snow_case.get()), s["cases"][0])
        acc = cur["acc"]                         # raport tylko dla bieżącego przypadku
        if not acc:
            it.append(("v", f"Cₑ = {f2(s['Ce'])}", f"współczynnik ekspozycji – teren {self.snow_ce.get().lower()}"))
            it.append(("v", f"Cₜ = {f2(s['Ct'], 3)}",
                       "współczynnik termiczny" + (f" ({s['ct_note']})" if s["ct_note"] else "")))
            it.append(("v", f"s = μ·Cₑ·Cₜ·sₖ = μ · {f2(s['base'], 3)} kN/m²",
                       "obciążenie śniegiem dachu, sytuacja trwała i przejściowa; działa na rzut poziomy"))
        else:
            it.append(("v", f"s = μ·sₖ = μ · {f2(s['sk'], 3)} kN/m²",
                       "sytuacja wyjątkowa – zaspa wyjątkowa wg Załącznika B (5.2(3)P c), bez Cₑ i Cₜ)"))
        it.append(("h", "Współczynniki kształtu dachu"))
        for p_ in s["params"]:
            if isinstance(p_, tuple):
                if p_[1] == cur["name"]:
                    it.append(("v", p_[0], ""))
            elif not acc:
                it.append(("v", p_, ""))
        o = s["overhang"]
        if o and not acc:
            names = {"all": "krawędzie dachu", "y0": "okap y = 0", "yB": "okap y = B"}
            for x in o["per"]:
                it.append(("v", f"sₑ = {f2(x['se'], 3)} kN/m",
                           f"nawis śnieżny, {names[x['edge']]} (d = {f2(x['d'], 3)} m, k = {f2(x['k'], 3)})"))
        it.append(("h", f"Obciążenie – przypadek ({cur['name']})"))
        best = max((c for c in s["cases"] if not c["acc"]), key=lambda c: c["smax"])
        it.append(("v", f"({cur['name']})  s = {f2(cur['smax'], 3)} kN/m²",
                   f"μ = {f2(cur['mumax'], 3)}"
                   + ("  – największe obciążenie w sytuacji trwałej" if cur is best else "")
                   + (f"  – sytuacja wyjątkowa: {cur['desc']}" if acc else "")))
        for n_ in s["notes"]:
            if isinstance(n_, tuple):
                if n_[1] == cur["name"] or (n_[1] == "acc" and acc):
                    it.append(("n", n_[0]))
            elif not acc:
                it.append(("n", n_))
        it.append(("h", "Oznaczenia"))
        sym = [("μ", "współczynnik kształtu dachu"), ("α", "kąt nachylenia połaci dachu")]
        k = g.kind
        if k in ("flat", "mono", "duo", "multi"):
            sym.append(("μ₁", "współczynnik kształtu dachu wg Tablicy 5.2 (zależny od kąta α)"))
        if k == "multi":
            sym += [("μ₂", "współczynnik kształtu dla zaspy w koszu"),
                    ("ᾱ", "średni kąt nachylenia połaci przylegających do kosza")]
        if k == "vault":
            sym += [("μ₃", "współczynnik kształtu dachu walcowego"), ("h/b", "wyniosłość łuku / rozpiętość"),
                    ("β", "kąt nachylenia stycznej do łuku"), ("lₛ", "część dachu o nachyleniu β ≤ 60°")]
        if k == "abut":
            sym += [("μ₂ = μₛ + μw", "współczynnik kształtu dla zaspy przy wyższej budowli"),
                    ("μₛ", "udział śniegu zsuwającego się z dachu wyższego"),
                    ("μw", "udział śniegu nawiewanego przez wiatr"),
                    ("b₁, b₂", "szerokość budowli wyższej i dachu niższego"),
                    ("h", "różnica wysokości dachów"), ("lₛ", "długość zaspy"),
                    ("γ", "ciężar objętościowy śniegu (2 kN/m³)")]
        if k == "obst":
            sym += [("μ₂", "współczynnik kształtu dla zaspy przy przeszkodzie"), ("h", "wysokość przeszkody"),
                    ("lₛ", "długość zaspy"), ("γ", "ciężar objętościowy śniegu (2 kN/m³)")]
        if any(c["acc"] for c in s["cases"]):
            sym += [("μ₃", "współczynnik kształtu zaspy wyjątkowej przy wyższej budowli (Tabl. B1)"),
                    ("μ₁, μ₂", "zaspa wyjątkowa: przy kalenicy / przy okapie (B3) lub po obu stronach przeszkody (B4)"),
                    ("b, b₁, b₂", "wymiary wg Rys. B2–B4 (b – większy z b₁, b₂)"),
                    ("lₛ", "długość zaspy wyjątkowej")] if k in ("abut", "obst") else \
                   [("μ₁, μ₂", "zaspa wyjątkowa przy attyce / po obu stronach przeszkody (B4)"),
                    ("b₁, b₂", "odległości od okapu, kalenicy lub kosza; dla attyki b₂ – szerokość budynku"),
                    ("lₛ", "długość zaspy wyjątkowej")]
        if o:
            sym += [("sₑ", "obciążenie nawisem śnieżnym na 1 m krawędzi okapu"),
                    ("d", "grubość warstwy śniegu na dachu (s/γ, γ = 3 kN/m³)"),
                    ("k", "współczynnik nieregularności kształtu nawisu")]
        sym += [("Przyp.", "przypadek rozkładu: (i) – równomierny, (ii), (iii) – nierównomierny"
                           + (", (wyj.n) – zaspa wyjątkowa, sytuacja wyjątkowa" if any(c["acc"] for c in s["cases"])
                              else "")),
                ("Miejsce", "część dachu, której dotyczy wartość"),
                ("a → b", "wartość zmienia się liniowo od a do b")]
        tv = self.snow_tree
        tv.delete(*tv.get_children())
        for c in [cur]:
            for lab, m0, m1 in c["rows"]:
                cb = c["base"]
                if abs(m0 - m1) < 1e-9:
                    mt, st = f2(m0, 3), f2(m0 * cb, 3)
                else:
                    mt, st = f"{f2(m0, 2)} → {f2(m1, 2)}", f"{f2(m0 * cb, 2)} → {f2(m1 * cb, 2)}"
                tv.insert("", "end", values=(f"({c['name']})", lab, mt, st))
        k_ = next(i for i, x in enumerate(it) if x[0] == "h" and x[1] == "Oznaczenia")
        it.insert(k_, ("t", tv))
        for a_, b_ in sym:
            it.append(("s", a_, b_))
        self.fill_text(self.snow_text, it)

        names = {"i": "równomierny", "ii": "nierównomierny", "iii": "nierównomierny (lustrzany)"}
        if g.kind in ("abut", "obst"):
            names = {"i": "bez zaspy", "ii": "z zaspą"}
        self.case_desc.configure(text=names.get(self.snow_case.get(), cur["desc"] if cur else ""))
