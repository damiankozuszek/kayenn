class Var:
    """Wartość z powiadamianiem (odpowiednik zmiennych tkinter)."""

    def __init__(self, value):
        self._v = value
        self._cb = []

    def get(self):
        return self._v

    def set(self, v):
        if v == self._v:
            return
        self._v = v
        for cb in list(self._cb):
            cb()

    def trace(self, cb):
        self._cb.append(cb)


