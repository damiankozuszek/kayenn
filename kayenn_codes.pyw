    def text_label(self, c, r):
        lb = LabelX("")
        lb.setObjectName("muted")
        lb.setWordWrap(True)
        c.grid.addWidget(lb, r, 0, 1, 6)
        return lb

    def slots(self, c, first_row, n=None):
        sl = []
        for i in range(n or self.NSLOT):
            r, col = first_row + i // 2, i % 2
            lb = QLabel("")
            e = self._mk_entry()
            e._key, e._shown = None, False
            e.textEdited.connect(lambda t, e=e: self.v[e._key].set(t) if e._key else None)
            un = self._unit("")
            c.grid.addWidget(lb, r, col * 3)
            c.grid.addWidget(e, r, col * 3 + 1, 1, 1, AL_R)
            c.grid.addWidget(un, r, col * 3 + 2)
            for w_ in (lb, e, un):
                w_.setVisible(False)
            sl.append((lb, e, un))
        return sl

    def _results(self, c, heads, widths, stretch_col, left_cols):
        """Jedno pole wyników: raport z tabelą podsumowania (HTML)."""
        t = QTextBrowser()
        t.setOpenLinks(False)
        t.setMinimumHeight(300)
        c.grid.addWidget(t, 1, 0, 1, 6)
        c.grid.setRowStretch(1, 1)
        return t, TableData(heads, left_cols)

