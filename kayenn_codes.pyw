            if loc.get("alt") is not None:
                t += f", {max(loc['alt'], 0):.0f} m n.p.m."
        else:
            t = "nie wybrano"
        self.loc_label.configure(text=t)

    def pick(self):
        self.app.pick_location(self, self.loc, self.set_loc)


