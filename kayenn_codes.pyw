def _no_qt():
    """Brak PySide6 – komunikat i propozycja instalacji."""
    msg = ("Ten program wymaga biblioteki PySide6 (Qt dla Pythona).\n\n"
           "Zainstalować ją teraz? Potrzebny jest internet, pobieranie ok. 200 MB.\n\n"
           "Ręczna instalacja (wiersz poleceń):\n    py -m pip install PySide6")
    try:
        import tkinter as tk
        from tkinter import messagebox
    except ImportError:
        print(msg, file=sys.stderr)
        sys.exit(1)
    r = tk.Tk()
    r.withdraw()
    if messagebox.askyesno("KAYENN", msg):
        import subprocess
        exe = sys.executable
        if exe.lower().endswith("pythonw.exe"):
            exe = exe[:-5] + ".exe"                  # pythonw.exe → python.exe (okno konsoli z postępem)
        try:
            res = subprocess.run([exe, "-m", "pip", "install", "PySide6"])
            ok = res.returncode == 0
        except OSError:
            ok = False
        if ok:
            messagebox.showinfo("KAYENN", "Zainstalowano PySide6.\nUruchom program ponownie.")
        else:
            messagebox.showerror("KAYENN",
                                 "Instalacja nie powiodła się.\nSpróbuj ręcznie:  py -m pip install PySide6")
    r.destroy()
    sys.exit(0)


