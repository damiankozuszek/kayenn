        self.fill_text(self.wind_text, it)


    @staticmethod
    def default_yaw(theta):
        return math.radians({0: -32, 90: 58, 180: 148}.get(theta, -32))

    def reset_view(self):
        th = self.wind["theta"] if self.wind else 0
        self.yaw, self.pitch, self.zoom = self.default_yaw(th), math.radians(24), 1.0
        self.pan_x = self.pan_y = 0.0
        self.draw3d()

    def _pan_press(self, e):
        self._pan_last = (e.x, e.y)
        self.cv.configure(cursor="fleur")

    def _pan(self, e):
        lx, ly = self._pan_last
        self._pan_last = (e.x, e.y)
        self.pan_x += e.x - lx
        self.pan_y += e.y - ly
        self.draw3d()

    def _press(self, e):
        self._last = (e.x, e.y)
        self._moved = False

    def _rotate(self, e):
        lx, ly = self._last
        if abs(e.x - lx) + abs(e.y - ly) < 3 and not getattr(self, "_moved", False):
            return
        self._moved = True
        self._last = (e.x, e.y)
        self.yaw += (e.x - lx) * 0.01
        self.pitch = clamp(self.pitch + (e.y - ly) * 0.01, math.radians(2), math.radians(88))
        self.draw3d()

    def _pan_by(self, dx, dy):
        self.pan_x += dx
        self.pan_y += dy
        self.draw3d()

    def _zoom(self, f):
        self.zoom = clamp(self.zoom * f, 0.3, 5)
        self.draw3d()

    def scene_wind(self):
        g, w = self.wgeo, self.wind
        faces, texts, lines = [], [], []
        canopy = g.kind in ("can1", "can2")
        for z in w["zones"]:
            t = min(abs(z["cpe"]) / 2.0, 1.0)
            col = mix((255, 255, 255), PRESS_COL if z["cpe"] > 0 else SUCT_COL, 0.15 + 0.6 * t)
            dome = z.get("dome")
            lab = None if dome else f"{z['name']}\n{f2(z['we'], 3, True)} kN/m²"
            grp = None if dome else (z["kind"], z["name"], round(z["cpe"], 4), z.get("rect") or id(z))
            n_up = None
            if z["kind"] in ("roof", "canopy"):     # połać: normalna zawsze w górę (dachy wklęsłe)
                n_up = unit(newell(z["poly"]))
                if n_up[2] < 0:
                    n_up = tuple(-c for c in n_up)
            faces.append(dict(poly=z["poly"], fill=col, outline=col if dome else "#4b5563", label=lab, n=n_up,
                              value=z["we"], cull=not canopy, kind=z["kind"], grp=grp,
                              arr=z.get("arr", True), anchor=z.get("anchor")))
        for pt in w["points"]:
            texts.append((pt["pos"], f"{pt['name']}\n{f2(pt['we'], 3, True)} kN/m²"))
        if g.kind == "dome":
            for P, n in g.shape.wall_facets():
                faces.append(dict(poly=P, fill=NEUTRAL_COL, outline=NEUTRAL_COL, n=n, cull=True))
        if isinstance(g.shape, Prism):
            for P, n in g.shape.vfaces():
                faces.append(dict(poly=P, fill=NEUTRAL_COL, outline="#6b7280", n=n, cull=False))
        if g.kind == "flat" and g.hp > 0:
            faces += parapet_faces(g.L, g.B, g.H, g.hp, col=NEUTRAL_COL, top="#c4c8ce", out="#6b7280")
        if canopy:
            pr = g.shape
            for x in (0.15, g.L - 0.15):
                for y in (0.15, g.B - 0.15):
                    lines.append(((x, y, 0), (x, y, pr.rz(x, y) - 0.05), "#6b7280", 4))
        return faces, texts, lines

    def scene_snow(self):
        g, s = self.sgeo, self.snow
        faces, texts, lines = [], [], []
        par = g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]
        for pr in [g.main] + ([g.upper] if g.upper else []):
            for key, P, n in pr.walls():
                faces.append(dict(poly=P, fill=WALL_COL, outline=WALL_OUT, n=n, cull=True))
            strips = pr.strips()
            if par and pr is g.main:   # dach w attyce – tylko wewnątrz ścian attyki
                t, H_ = 0.25, g.H
                strips = [[(t, t, H_), (g.L - t, t, H_), (g.L - t, g.B - t, H_), (t, g.B - t, H_)]]
            for P in strips:           # połacie pod śniegiem rysowane zawsze przed nim
                nu = unit(newell(P))
                nu = nu if nu[2] >= 0 else tuple(-c for c in nu)
                faces.append(dict(poly=P, fill=ROOF_COL, outline=ROOF_OUT, n=nu, cull=True, base=id(pr)))
        for so in g.solids:                        # przybudówka, zadaszenie, attyki i przeszkody (Załącznik B)
            for P, n in so.walls:
                faces.append(dict(poly=P, fill=so.fill, outline=so.out, n=n, cull=True))
            for P in so.roofs:
                nu = unit(newell(P))
                nu = nu if nu[2] >= 0 else tuple(-c for c in nu)
                faces.append(dict(poly=P, fill=so.rfill, outline=so.rout, n=nu, cull=True, base=id(so)))
        if g.kind == "obst":
            hob, H, L, B = g.p["hob"], g.H, g.L, g.B
            if par:
                faces += parapet_faces(L, B, H, hob)
            else:
                yo, tw = g.p["yob"], 0.25
                for P, n in (([(0, yo, H), (L, yo, H), (L, yo, H + hob), (0, yo, H + hob)], (0, -1, 0)),
                             ([(L, yo + tw, H), (0, yo + tw, H), (0, yo + tw, H + hob), (L, yo + tw, H + hob)],
                              (0, 1, 0)),
                             ([(0, yo, H + hob), (L, yo, H + hob), (L, yo + tw, H + hob), (0, yo + tw, H + hob)],
                              (0, 0, 1)),
                             ([(0, yo + tw, H), (0, yo, H), (0, yo, H + hob), (0, yo + tw, H + hob)], (-1, 0, 0)),
                             ([(L, yo, H), (L, yo + tw, H), (L, yo + tw, H + hob), (L, yo, H + hob)], (1, 0, 0))):
                    faces.append(dict(poly=P, fill="#9ca3af", outline="#4b5563", n=n, cull=True))
        case = next((c for c in s["cases"] if c["name"] == self.snow_case.get()), s["cases"][0])
        extra = [] if case["acc"] else s["extra"]     # zaspa wyjątkowa – jedyny śnieg (dach wyższy bez obciążenia)
        mumax = max([c["mumax"] for c in s["cases"] if c["acc"] == case["acc"]] +
                    [m for pt in extra for m in pt["mu"]] + [1e-6])
        size = max(g.L, g.B + (g.upper.B if g.upper else 0), g.h_top)
        sc = 0.16 * size / mumax
        hob = g.p["hob"] if g.kind == "obst" else (g.p["dh"] if g.kind == "abut" else None)
        kh = 0.85
        if g.exc and g.kind in ("mono", "duo", "multi", "vault"):
            hs = [g.exc[k_] for k_, f_ in (("pah", "epar"), ("gah", "gpar"), ("poh", "pobst")) if g.exc.get(f_)]
            hob, kh = (min(hs), 0.6) if hs else (None, kh)
        if g.kind == "flat" and g.fobst:
            hob, kh = g.fobst.g["h"], 0.6
        if hob:                                    # warstwa śniegu wyraźnie niższa niż przeszkoda
            sc = min(sc, max(kh * hob, 0.04 * size) / mumax)
        patches = ([dict(pt, on=pt.get("on", id(g.main))) for pt in case["patches"]] +
                   [dict(pt, on=id(g.upper), xtra=True) for pt in extra])
        def clip4(pt, f, lo, hi):
            P4 = [(x, y, z, m_) for (x, y, z), m_ in zip(pt["poly"], pt["mu"])]
            P4 = clip_poly(P4, f, lo, hi)
            return dict(pt, poly=[q[:3] for q in P4], mu=[q[3] for q in P4]) if P4 else None
        if par:                                    # śnieg wewnątrz attyki
            t = 0.25
            keep = [pt for pt in patches if pt["on"] != id(g.main)]
            patches = [pt for pt in patches if pt["on"] == id(g.main)]
            patches = [q for q in (clip4(pt, lambda q: q[0], t, g.L - t) for pt in patches) if q]
            patches = [q for q in (clip4(pt, lambda q: q[1], t, g.B - t) for pt in patches) if q] + keep
        if g.kind == "obst" and not par:           # śnieg nie wchodzi w ściankę
            yo, tw = g.p["yob"], 0.25
            cut = []
            for pt in patches:
                if pt["on"] != id(g.main):
                    cut.append(pt)
                    continue
                for lo, hi in ((-1e9, yo), (yo + tw, 1e9)):
                    q = clip4(pt, lambda q: q[1], lo, hi)
                    if q and poly_area(q["poly"]) > 1e-9:
                        cut.append(q)
            patches = cut
        for x0, x1, y0, y1 in g.keepout:            # attyki i przeszkody: śnieg tylko poza nimi
            cut = []
            for pt in patches:
                if pt["on"] != id(g.main):
                    cut.append(pt)
                    continue
                # podział siatką 3 × 3 wokół prostokąta (bez środka) – żaden płat nie przecina płaszczyzn ścian
                # przeszkody, więc kolejność rysowania śniegu i przeszkody jest jednoznaczna
                parts = []
                for ya_, yb_ in ((-1e9, y0), (y0, y1), (y1, 1e9)):
                    band = clip4(pt, lambda q: q[1], ya_, yb_)
                    if not band:
                        continue
                    for xa_, xb_ in ((-1e9, x0), (x0, x1), (x1, 1e9)):
                        if (ya_, xa_) == (y0, x0):
                            continue
                        parts.append(clip4(band, lambda q: q[0], xa_, xb_))
                parts = [q for q in parts if q and poly_area(q["poly"]) > 1e-9]
                big = max(parts, key=lambda q: poly_area(q["poly"]), default=None)
                cut += [dict(q, label=pt.get("label") if q is big else None) for q in parts]
            patches = cut
        patches = tjunction_fix(patches)
        keyf = lambda p: (round(p[0], 4), round(p[1], 4), round(p[2], 4))
        edges = {}                                 # krawędź → [(nr płata, {punkt: wierzch})]
        tops = []
        for ip, pt in enumerate(patches):
            P, mus = pt["poly"], pt["mu"]
            top = [(x, y, z + m * sc) for (x, y, z), m in zip(P, mus)]
            tops.append(top)
            for j in range(len(P)):
                j1 = (j + 1) % len(P)
                k = frozenset((keyf(P[j]), keyf(P[j1])))
                edges.setdefault(k, []).append((ip, {keyf(P[j]): top[j], keyf(P[j1]): top[j1]}))
        self._snow_ztop = max([p_[2] for ip, t_ in enumerate(tops) if patches[ip]["on"] == id(g.main)
                               for p_ in t_] + [g.main.h_top])
        tnorm = []
        for t_ in tops:
            n_ = unit(newell(t_))
            tnorm.append(n_ if n_[2] >= 0 else tuple(-v for v in n_))
        for ip, pt in enumerate(patches):
            P, mus, top = pt["poly"], pt["mu"], tops[ip]
            if max(mus) <= 1e-9:
                continue
            lab = None
            if pt.get("label"):
                m0, m1 = pt["seg"]
                cb = s["base"] if pt.get("xtra") else case["base"]
                if abs(m0 - m1) < 1e-9:
                    lab = f"{f2(m0 * cb, 2)} kN/m²"
                else:
                    lab = f"{f2(m0 * cb, 2)} → {f2(m1 * cb, 2)} kN/m²"
            mask = []                              # obrys: krawędź zewnętrzna, uskok lub załamanie powierzchni
            for j in range(len(P)):
                lst = edges[frozenset((keyf(P[j]), keyf(P[(j + 1) % len(P)])))]
                if len(lst) < 2:
                    mask.append(True)
                    continue
                (i1, t1), (i2, t2) = lst[0], lst[1]
                other = i2 if i1 == ip else i1
                ka_, kb_ = keyf(P[j]), keyf(P[(j + 1) % len(P)])
                step = abs(t1[ka_][2] - t2[ka_][2]) > 1e-6 or abs(t1[kb_][2] - t2[kb_][2]) > 1e-6
                crease = sum(a_ * b_ for a_, b_ in zip(tnorm[ip], tnorm[other])) < math.cos(math.radians(0.5))
                mask.append(step or crease)
            faces.append(dict(poly=top, fill="#eef6ff", outline="#5b8fc7", n=tnorm[ip], cull=True, label=lab,
                              on=pt["on"], prio=0, alpha=SNOW_ALPHA, edges=mask))
        pcs = [centroid(pt["poly"]) for pt in patches]

        # krawędzie zewnętrzne: w wierzchołku, gdzie dwie leżą w jednej linii, pionowa krawędź ścianki
        # bocznej nie jest obrysowywana (ścianka złożona z kilku płatów wygląda jak jedna)
        vdirs = {}
        for k, lst in edges.items():
            if len(lst) == 1 and len(k) == 2:
                ka, kb = list(k)
                dx, dy = kb[0] - ka[0], kb[1] - ka[1]
                ln = math.hypot(dx, dy)
                if ln > 1e-9:
                    for v_ in (ka, kb):
                        vdirs.setdefault(v_, []).append((dx / ln, dy / ln))

        def on_keepout(pa, pb, e_=1e-6):
            for x0, x1, y0, y1 in g.keepout:
                for c_, v_ in ((0, x0), (0, x1), (1, y0), (1, y1)):
                    if abs(pa[c_] - v_) < e_ and abs(pb[c_] - v_) < e_:
                        o_ = 1 - c_
                        lo_, hi_ = (y0, y1) if o_ == 1 else (x0, x1)
                        if lo_ - e_ <= pa[o_] <= hi_ + e_ and lo_ - e_ <= pb[o_] <= hi_ + e_:
                            return True
            return False

        def smooth(v_):
            d = vdirs.get(v_, [])
            return len(d) == 2 and abs(d[0][0] * d[1][1] - d[0][1] * d[1][0]) < 1e-6

        def side_face(q, toward, on=None, mask=None):
            if poly_area(q) < 1e-9:
                return
            n = unit(newell(q))
            cq = centroid(q)
            if sum(a_ * (b_ - d_) for a_, b_, d_ in zip(n, toward, cq)) < 0:
                n = tuple(-a_ for a_ in n)
            faces.append(dict(poly=q, fill="#d6e7fa", outline="#5b8fc7", n=n, cull=True, prio=0, on=on,
                              alpha=SNOW_ALPHA, edges=mask))
        for k, lst in edges.items():
            ka, kb = list(k) if len(k) == 2 else (next(iter(k)),) * 2
            if len(lst) == 1:                      # krawędź zewnętrzna: ścianka boczna śniegu
                ip, tp = lst[0]
                P = patches[ip]["poly"]
                pa = next(p for p in P if keyf(p) == ka)
                pb = next(p for p in P if keyf(p) == kb)
                if patches[ip]["on"] == id(g.main) and on_keepout(pa, pb):
                    continue                       # ścianka przy attyce / przeszkodzie – zasłonięta przez nią
                c = pcs[ip]
                out = (2 * (pa[0] + pb[0]) / 2 - c[0], 2 * (pa[1] + pb[1]) / 2 - c[1], (pa[2] + pb[2]) / 2)
                side_face([pa, pb, tp[kb], tp[ka]], out, patches[ip]["on"],
                          [True, not smooth(kb), True, not smooth(ka)])
            else:                                  # styk dwóch płatów: uskok przy różnej grubości
                (i1, t1), (i2, t2) = lst[0], lst[1]
                da, db = t1[ka][2] - t2[ka][2], t1[kb][2] - t2[kb][2]
                if abs(da) < 1e-6 and abs(db) < 1e-6:
                    continue
                low = pcs[i2] if (da + db) > 0 else pcs[i1]
                side_face([t1[ka], t1[kb], t2[kb], t2[ka]], low, patches[i1]["on"])
        return faces, texts, lines

    def _draw3d_now(self):
        cv = self.cv
        ctx = self._ctx                                  # rysowanie zapisanego przypadku (okno główne / wydruk)
        if cv is None or (not ctx and not self.win3d.isVisible()):
            return
        cv.delete("all")
        W, Hc = cv.winfo_width(), cv.winfo_height()
        if W < 50:
            return
        mode = self.mode3d.get()
        if (self.wgeo if mode == "wiatr" else self.sgeo) is None:
            return
        if not ctx:
            self.update_toolbar(mode)
            self._title3d()
            self.close_editor()
        self._edit_keys = {}
        key = (mode, getattr(self, "_scene_ver", 0), self.snow_case.get() if mode != "wiatr" else None)
        if getattr(self, "_scene_key", None) == key:          # sam obrót / przesunięcie – geometria bez zmian
            faces, texts, lines, self._snow_ztop = self._scene_cache
        else:
            faces, texts, lines = self.scene_wind() if mode == "wiatr" else self.scene_snow()
            self._scene_key = key
            self._scene_cache = (faces, texts, lines, getattr(self, "_snow_ztop", 0.0))
        g = self.wgeo if mode == "wiatr" else self.sgeo
        allp = [p for f_ in faces for p in f_["poly"]]
        xs, ys, zs = [p[0] for p in allp], [p[1] for p in allp], [p[2] for p in allp]
        x0, x1, y0, y1, z1 = min(xs), max(xs), min(ys), max(ys), max(zs)
        size = max(x1 - x0, y1 - y0, z1, 1e-3)
        ctr = ((x0 + x1) / 2, (y0 + y1) / 2, z1 / 2)
        sc = self.zoom * min(W, Hc) / (2.3 * size)
        cy, sy = math.cos(self.yaw), math.sin(self.yaw)
        cp, sp = math.cos(self.pitch), math.sin(self.pitch)
        ox, oy = W / 2 + self.pan_x, Hc / 2 + self.pan_y

        def P(p):
            x, y, z = p[0] - ctr[0], p[1] - ctr[1], p[2] - ctr[2]
            xr, yr = x * cy - y * sy, x * sy + y * cy
            return (ox + xr * sc, oy - (z * cp + yr * sp) * sc, yr * cp - z * sp)

        def facing(n):
            return (n[0] * sy + n[1] * cy) * cp - n[2] * sp < -1e-6

        bctr = ((x0 + x1) / 2, (y0 + y1) / 2, min(zs) + (z1 - min(zs)) * 0.35)

        def outward(poly):
            n = unit(newell(poly))
            c = centroid(poly)
            if sum(a * (b - d) for a, b, d in zip(n, c, bctr)) < 0:
                n = tuple(-a for a in n)
            return n

        # podłoże
        m = (0.8 if mode == "wiatr" else 0.5) * size
        gr = [(x0 - m, y0 - m, 0), (x1 + m, y0 - m, 0), (x1 + m, y1 + m, 0), (x0 - m, y1 + m, 0)]
        cv.create_polygon(*[c for p in gr for c in P(p)[:2]], fill="#eef0ec", outline="#d4d8d0")
        step = 10 ** math.floor(math.log10(size / 2 if size > 2 else 1))
        k = math.ceil((x0 - m) / step)
        while k * step <= x1 + m:
            a, b = P((k * step, y0 - m, 0)), P((k * step, y1 + m, 0))
            cv.create_line(a[0], a[1], b[0], b[1], fill="#e2e5df")
            k += 1
        k = math.ceil((y0 - m) / step)
        while k * step <= y1 + m:
            a, b = P((x0 - m, k * step, 0)), P((x1 + m, k * step, 0))
            cv.create_line(a[0], a[1], b[0], b[1], fill="#e2e5df")
            k += 1
        fnt = (FONT, 9)
        self._placed = []                                # zajęte prostokąty opisów (etykiety, wymiary)
        self._defer_angles = None
        if mode == "wiatr":
            fr = wind_frame(g, self.wind["theta"])
            p1 = fr["to_xy"](-0.95 * m, fr["b"] / 2)
            p2 = fr["to_xy"](-0.55 * m, fr["b"] / 2)
            a, b = P((p1[0], p1[1], 0.02)), P((p2[0], p2[1], 0.02))
            cv.create_line(a[0], a[1], b[0], b[1], width=7, arrow="last", arrowshape=(18, 22, 8), fill="#b45309")
            # opis za nasadą strzałki (na przedłużeniu), żeby strzałka go nie przekreślała
            wtxt, wfnt = f"wiatr θ = {self.wind['theta']}°", (FONT, 10, "bold")
            tmp = cv.create_text(0, 0, text=wtxt, font=wfnt)
            bx = cv.bbox(tmp)
            cv.delete(tmp)
            tw, th = bx[2] - bx[0], bx[3] - bx[1]
            dx, dy = a[0] - b[0], a[1] - b[1]
            dl = math.hypot(dx, dy) or 1.0
            dx, dy = dx / dl, dy / dl
            r = abs(dx) * tw / 2 + abs(dy) * th / 2 + 6
            tx, ty = a[0] + dx * r, a[1] + dy * r
            cv.create_text(tx, ty, text=wtxt, font=wfnt, fill="#b45309")
            self._placed.append((tx - tw / 2 - 3, ty - th / 2 - 2, tx + tw / 2 + 3, ty + th / 2 + 2))
        for f_ in faces:
            if f_.get("n") is None:
                f_["n"] = outward(f_["poly"])
        drawn = []
        for f_ in faces:
            if f_.get("cull") and not facing(f_["n"]):
                continue
            pr = [P(p) for p in f_["poly"]]
            drawn.append((sum(p[2] for p in pr) / len(pr), f_, pr))
        drawn = depth_sort(drawn)
        for depth, f_, pr in drawn:
            cv.create_polygon(*[c for p in pr for c in p[:2]], fill=f_["fill"], outline=f_["outline"], width=1,
                              alpha=f_.get("alpha"), edges=f_.get("edges"))
        for a3, b3, col, wdt in lines:
            a, b = P(a3), P(b3)
            cv.create_line(a[0], a[1], b[0], b[1], fill=col, width=wdt)
        # jedna strzałka i jedna etykieta na pole (największy widoczny fragment)
        best = {}
        for depth, f_, pr in drawn:
            gk = f_.get("grp")
            if gk is None:
                continue
            ar = poly_area([(p[0], p[1]) for p in pr])
            if gk not in best or ar > best[gk][0]:
                best[gk] = (ar, id(f_))
        rep = {v[1] for v in best.values()}
        is_rep = lambda f_: f_.get("grp") is None or id(f_) in rep
        if mode == "wiatr" and self.arrows3d.get():
            vals = [abs(f_["value"]) for _, f_, _ in drawn if f_.get("value") is not None]
            wmax = max(vals + [1e-9])
            # jedna strzałka na pole: w środku geometrycznym pola, długość ∝ |we|
            groups = {}
            for f_ in faces:
                if f_.get("value") is None:
                    continue
                gk = f_.get("grp") or ("single", id(f_))
                groups.setdefault(gk, []).append(f_)
            visible = {f_.get("grp") or ("single", id(f_)) for _, f_, _ in drawn}
            for gk, fl in groups.items():
                v = fl[0]["value"]
                if gk not in visible or abs(v) < 1e-9 or not all(f_.get("arr", True) for f_ in fl):
                    continue
                A = gx = gy = gz = 0.0
                nx_ = ny_ = nz_ = 0.0
                for f_ in fl:
                    ar = poly_area(f_["poly"])
                    c = area_centroid(f_["poly"])
                    A += ar
                    gx += c[0] * ar
                    gy += c[1] * ar
                    gz += c[2] * ar
                    n = f_["n"]
                    if f_.get("kind") == "canopy" and n[2] < 0:
                        n = tuple(-a_ for a_ in n)
                    nx_ += n[0] * ar
                    ny_ += n[1] * ar
                    nz_ += n[2] * ar
                if A <= 0:
                    continue
                c = (gx / A, gy / A, gz / A)
                if fl[0].get("kind") in ("roof", "canopy") and len(fl) > 1:
                    c = (c[0], c[1], g.rz(c[0], c[1]))          # środek pola leży na połaci
                if fl[0].get("anchor"):
                    c = fl[0]["anchor"]                          # pole wklęsłe – punkt wewnątrz pola
                n = unit((nx_, ny_, nz_))
                ln = 0.20 * size * abs(v) / wmax
                tip = tuple(ci + ni * ln for ci, ni in zip(c, n))
                a_, b_ = (P(tip), P(c)) if v > 0 else (P(c), P(tip))
                cv.create_line(a_[0], a_[1], b_[0], b_[1], arrow="last", width=2.5,
                               fill="#991b1b" if v > 0 else "#1e40af", arrowshape=(11, 13, 5))
        # wymiary przed etykietami: opisy wymiarów zostają na liniach wymiarowych, etykiety obciążeń je omijają;
        # opisy kątów na końcu – omijają etykiety (jak dotąd)
        self._defer_angles = []
        self._dim_used = set()                   # strony z niebieskimi wymiarami na gruncie: ("x"/"y", ±1)
        try:
            if mode == "śnieg" and self.dims3d.get():
                self.draw_snow_dims(cv, g, P, facing, size)
            if mode == "wiatr" and self.dims3d.get():
                self.draw_dims(cv, g, P, facing, size)
            if self.bdims3d.get():
                self.draw_bdims(cv, mode, g, P, facing, size)
        finally:
            angles, self._defer_angles = self._defer_angles, None
        if self.labels3d.get():
            for pos, txt in texts:
                c = P(pos)
                self._label(cv, c[0], c[1] - 16, txt, outline="#111827", dodge=True)
            cand = []
            for depth, f_, pr in drawn:
                if not f_.get("label") or not is_rep(f_):
                    continue
                ar = poly_area([(p[0], p[1]) for p in pr])
                if ar >= (450 if mode == "wiatr" else 250):
                    cand.append((ar, f_, pr))
            for ar, f_, pr in sorted(cand, key=lambda x: -x[0]):
                c = P(f_.get("anchor") or centroid(f_["poly"]))
                self._label(cv, c[0], c[1], f_["label"], dodge=True, poly=[(p[0], p[1]) for p in pr])
        for args in angles:
            self._angle_label(*args)
        if mode == "śnieg" and self.snow["overhang"]:
            self.draw_overhang(cv, g, P, facing, self.snow["overhang"], size)
        self.draw_legend(cv, mode, g, Hc, fnt)
        if not getattr(self, "_w_ok" if mode == "wiatr" else "_s_ok", True):
            cv.create_text(12, 10, anchor="nw", fill="#b91c1c", font=(FONT, 9, "bold"),
                           text="⚠ Błędne dane budynku – pokazano ostatni poprawny model")
        if ctx == "img":
            return
        card_view = ctx == "view" and not (isinstance(cv, CaseCanvas) and cv.is_active())
        cv.create_text(W - 10, Hc - 8, anchor="se", justify="right", fill="#8a929c", font=(FONT, 8),
                       text=("Kliknij podgląd, aby powiększać kółkiem i gestami\n" if card_view else "")
                       + "Lewy przycisk – obrót\nŚrodkowy (lub Shift + lewy) – przesuwanie\n"
                         "Kółko – powiększenie\nPanel dotykowy: dwa palce – przesuwanie, "
                         "rozsunięcie – powiększenie\nKliknięcie wymiaru – zmiana")

    def _label(self, cv, x, y, text, outline="", dodge=False, poly=None):
        """Etykieta z tłem. Gdy zachodzi na wcześniej narysowany opis: z dodge=True przesunięta w najbliższe
        wolne miejsce (najpierw wewnątrz pola poly, potem tuż obok – z linią odniesienia), inaczej pomijana."""
        fnt = (FONT, 8, "bold")
        tmp = cv.create_text(0, 0, text=text, font=fnt, justify="center")
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        hw, hh = (bx[2] - bx[0]) / 2 + 3, (bx[3] - bx[1]) / 2 + 2
        placed = getattr(self, "_placed", [])
        free = lambda cx, cy: not any(cx - hw < o[2] and o[0] < cx + hw and cy - hh < o[3] and o[1] < cy + hh
                                      for o in placed)
        W, Hc = cv.winfo_width(), cv.winfo_height()
        on_cv = lambda cx, cy: hw <= cx <= W - hw and hh <= cy <= Hc - hh
        pos, leader = ((x, y), False) if free(x, y) else (None, False)
        if pos is None and dodge:
            near = None
            for r in range(4, 124, 4):
                for k in range(24):
                    t = math.radians(-90 + 15 * k)
                    cx, cy = x + r * math.cos(t), y + r * math.sin(t)
                    if not (on_cv(cx, cy) and free(cx, cy)):
                        continue
                    if poly is not None and _pip(cx, cy, poly):
                        pos = (cx, cy)
                        break
                    if near is None and r <= 48:
                        near = (cx, cy)
                if pos is not None:
                    break
            if pos is None and near is not None:
                pos, leader = near, True
            elif pos is not None and poly is None:
                leader = math.hypot(pos[0] - x, pos[1] - y) > 12
        if pos is None:
            return False
        cx, cy = pos
        self._placed = placed + [(cx - hw, cy - hh, cx + hw, cy + hh)]
        if leader:                                     # linia odniesienia od miejsca etykiety do opisu
            cv.create_line(x, y, cx, cy, fill="#4b5563", width=1)
            cv.create_oval(x - 2, y - 2, x + 2, y + 2, fill="#4b5563", outline="")
        tid = cv.create_text(cx, cy, text=text, font=fnt, fill="#111827", justify="center")
        bx = cv.bbox(tid)
        rid = cv.create_rectangle(bx[0] - 2, bx[1] - 1, bx[2] + 2, bx[3] + 1, fill="#ffffff", outline=outline,
                                  stipple="" if outline else "gray75")
        cv.tag_raise(tid, rid)
        return True

    def draw_legend(self, cv, mode, g, Hc, fnt):
        """Legenda tylko aktualnie widocznych oznaczeń."""
        items = []                       # (rodzaj, kolor, opis)
        if mode == "wiatr":
            can = g.kind in ("can1", "can2")
            items.append(("box", mix((255, 255, 255), PRESS_COL, 0.6),
                          "parcie (+) [kN/m²] – ku dołowi" if can else "parcie (+) [kN/m²]"))
            items.append(("box", mix((255, 255, 255), SUCT_COL, 0.6),
                          "ssanie (−) [kN/m²] – ku górze" if can else "ssanie (−) [kN/m²]"))
            if self.arrows3d.get():
                items.append(("arrow", "#4b5563", "strzałka – kierunek i wielkość obciążenia pola"))
            if self.dims3d.get() and g.kind != "dome":
                items.append(("line", DIM_COL, "wymiary pól (w rzucie poziomym)"))
        else:
            items.append(("box", "#f0f7ff", "obciążenie śniegiem dachu [kN/m²]"))
            if self.snow["overhang"]:
                items.append(("line", OVH_COL, "nawis śnieżny [kN/m] – dodatkowe obciążenie liniowe na krawędzi okapu"))
            if self.dims3d.get():
                items.append(("line", SDIM_COL, "wymiary pól obciążenia"))
        if self.bdims3d.get():
            items.append(("line", BDIM_COL, "wymiary budynku" if self._ctx == "img"       # wydruk – bez klikania
                          else "wymiary budynku (kliknij, aby zmienić)"))
        y = Hc - 14 - 20 * len(items)
        for kind, col, txt in items:
            if kind == "box":
                cv.create_rectangle(14, y + 1, 30, y + 15, fill=col, outline="#4b5563")
            elif kind == "arrow":
                cv.create_line(14, y + 8, 30, y + 8, fill=col, width=2, arrow="last", arrowshape=(7, 8, 3))
            else:
                cv.create_line(14, y + 8, 30, y + 8, fill=col, width=3)
            cv.create_text(38, y + 8, text=txt, anchor="w", font=fnt, fill=TEXT)
            y += 20

    def draw_overhang(self, cv, g, P, facing, ov, size):
        L, B, H = g.L, g.B, g.H
        segs = g.main.segs()
        a0, a1 = Prism.seg_angle(segs[0]), Prism.seg_angle(segs[-1])
        per = {o["edge"]: o for o in ov["per"]}
        edges = []
        if "all" in per:
            o = per["all"]
            edges = [((0, 0, H), (L, 0, H), (0, -1, 0), (0, 0, 1), o), ((L, B, H), (0, B, H), (0, 1, 0), (0, 0, 1), o),
                     ((0, B, H), (0, 0, H), (-1, 0, 0), (0, 0, 1), o), ((L, 0, H), (L, B, H), (1, 0, 0), (0, 0, 1), o)]
        if "y0" in per:
            sa, ca = math.sin(math.radians(a0)), math.cos(math.radians(a0))
            edges.append(((0, 0, H), (L, 0, H), (0, -1, 0), (0, -sa, ca), per["y0"]))
        if "yB" in per:
            sa, ca = math.sin(math.radians(a1)), math.cos(math.radians(a1))
            edges.append(((L, B, H), (0, B, H), (0, 1, 0), (0, sa, ca), per["yB"]))
        hgt, off = 0.10 * size, 0.015 * size
        labelled = set()
        for p0, p1, wn, rn, oe in edges:
            if not (facing(wn) or facing(rn)):
                continue
            n = max(4, int(round(math.dist(p0, p1) / size * 12)))
            tails = []
            for i in range(n + 1):
                t = i / n
                x = p0[0] + (p1[0] - p0[0]) * t + wn[0] * off
                y = p0[1] + (p1[1] - p0[1]) * t + wn[1] * off
                a, b = P((x, y, p0[2] + hgt)), P((x, y, p0[2]))
                cv.create_line(a[0], a[1], b[0], b[1], arrow="last", width=2, fill=OVH_COL, arrowshape=(7, 9, 3))
                tails.append(a)
            cv.create_line(*[c for p in tails for c in p[:2]], fill=OVH_COL, width=3)
            if id(oe) not in labelled:
                labelled.add(id(oe))
                m_ = tails[len(tails) // 2]
                tid = cv.create_text(m_[0], m_[1] - 10, text=f"sₑ = {f2(oe['se'], 3)} kN/m",
                                     font=(FONT, 9, "bold"), fill=OVH_COL)
                bx = cv.bbox(tid)
                rid = cv.create_rectangle(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1, fill="#ffffff", outline=OVH_COL)
                cv.tag_raise(tid, rid)

    def _chain(self, cv, P, path, segs, off, lab_off, col):
        """Łańcuch wymiarowy: path(u) → punkt 3D, segs = [(u0, u1, opis[, klucz pola])].
        Wymiar z kluczem można kliknąć i zmienić."""
        fnt = (FONT, 8, "bold")
        for u in sorted({v for s_ in segs for v in s_[:2]}):
            p = path(u)
            a, c = P(p), P(tuple(x + o for x, o in zip(p, off)))
            cv.create_line(a[0], a[1], c[0], c[1], fill=col, dash=(2, 2))
            cv.create_oval(c[0] - 2.5, c[1] - 2.5, c[0] + 2.5, c[1] + 2.5, fill=col, outline="")
        for sg_ in segs:
            u0, u1, nm = sg_[:3]
            key = sg_[3] if len(sg_) > 3 else None
            if u1 - u0 < 1e-6:
                continue
            pts = [P(tuple(x + o for x, o in zip(path(u0 + (u1 - u0) * i / 12), off))) for i in range(13)]
            cv.create_line(*[c for p in pts for c in p[:2]], fill=col, width=1.5)
            lp = P(tuple(x + o + lo for x, o, lo in zip(path((u0 + u1) / 2), off, lab_off)))
            self._dim_box(cv, lp[0], lp[1], f"{f2(u1 - u0)} m", col, "#ffffff", key)

    def _dchain(self, cv, P, path, lpt, segs, lab_off, col, via=None, lab_t=0.5):
        """Łańcuch wymiarowy: path(u) – punkt bazowy, lpt(u) – punkt linii wymiarowej; linia odniesienia
        biegnie od punktu bazowego (przez via(u), jeśli podano) do linii wymiarowej.
        segs = [(u0, u1, opis[, klucz pola])]; wymiar = u1 − u0."""
        for u in sorted({v for s_ in segs for v in s_[:2]}):
            pts = [P(path(u))] + ([P(via(u))] if via is not None and via(u) is not None else []) + [P(lpt(u))]
            a, c = pts[0], pts[-1]
            if sum(abs(p_[0] - q_[0]) + abs(p_[1] - q_[1]) for p_, q_ in zip(pts, pts[1:])) > 0.5:
                cv.create_line(*[v for p_ in pts for v in p_[:2]], fill=col, dash=(2, 2))
            cv.create_oval(c[0] - 2.5, c[1] - 2.5, c[0] + 2.5, c[1] + 2.5, fill=col, outline="")
        seen = set()
        for sg_ in segs:
            u0, u1, nm = sg_[:3]
            k_ = (round(u0, 6), round(u1, 6))
            if u1 - u0 < 1e-6 or k_ in seen:
                continue
            seen.add(k_)
            a, b = P(lpt(u0)), P(lpt(u1))
            cv.create_line(a[0], a[1], b[0], b[1], fill=col, width=1.5)
            key = sg_[3] if len(sg_) > 3 else None
            txt = f"{f2(u1 - u0)} m"
            lab_at = lambda t: P(tuple(x + o for x, o in zip(lpt(u0 + (u1 - u0) * t), lab_off)))
            lp = lab_at(lab_t)
            if self._box_busy(cv, lp[0], lp[1], txt):        # opis zajęty – przesunięcie wzdłuż linii wymiarowej
                cands = [lab_at(lab_t + dt) for dt in (0.12, -0.12, 0.24, -0.24, 0.36, -0.36)
                         if 0.1 <= lab_t + dt <= 0.9]
                # krótkie odcinki (np. pola na szczycie dachu wielospadowego) – opisy schodkowo na zewnątrz
                um = (u0 + u1) / 2
                pb, pl = P(path(um)), P(lpt(um))
                ox, oy = pl[0] - pb[0], pl[1] - pb[1]
                if math.hypot(ox, oy) < 1.0:                    # brak odsunięcia – prostopadle do linii, w górę
                    ox, oy = -(b[1] - a[1]), b[0] - a[0]
                    if oy > 0:
                        ox, oy = -ox, -oy
                ol = math.hypot(ox, oy) or 1.0
                ox, oy = ox / ol, oy / ol
                tmp = cv.create_text(0, 0, text=txt, font=(FONT, 8, "bold"))
                bx = cv.bbox(tmp)
                cv.delete(tmp)
                step = abs(ox) * (bx[2] - bx[0] + 8) + abs(oy) * (bx[3] - bx[1] + 4)
                cands += [(lp[0] + ox * step * k, lp[1] + oy * step * k) for k in (1, 2, 3)]
                for q in cands:
                    if not self._box_busy(cv, q[0], q[1], txt):
                        if q in cands[-3:]:                     # odsunięty opis – kreska do linii wymiarowej
                            cv.create_line(lp[0], lp[1], q[0], q[1], fill=col, dash=(1, 2))
                        lp = q
                        break
            self._dim_box(cv, lp[0], lp[1], txt, col, "#ffffff" if col != BDIM_COL else "#fff7ed", key)

    def _box_busy(self, cv, x, y, text):
        """Czy opis wymiaru w punkcie (x, y) zachodzi na wcześniej umieszczony opis."""
        tmp = cv.create_text(x, y, text=text, font=(FONT, 8, "bold"))
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        b = (bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1)
        return any(b[0] < o[2] and o[0] < b[2] and b[1] < o[3] and o[1] < b[3] for o in getattr(self, "_placed", []))

    def _dim_box(self, cv, x, y, text, col, bg, key):
        tid = cv.create_text(x, y, text=text, font=(FONT, 8, "bold"), fill=col)
        bx = cv.bbox(tid)
        rid = cv.create_rectangle(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1, fill=bg, outline=col,
                                  dash=() if key else (2, 2))
        self._placed = getattr(self, "_placed", []) + [(bx[0] - 3, bx[1] - 1, bx[2] + 3, bx[3] + 1)]
        cv.tag_raise(tid, rid)
        if key:
            tag = f"edit{len(self._edit_keys)}"
            self._edit_keys[tag] = (key, (x, y))
            for it in (tid, rid):
                cv.addtag_withtag(tag, it)
                cv.addtag_withtag("editable", it)

    def _angle_label(self, cv, P, pos, text, key=None):
        """Opis kąta; gdy zachodzi na etykietę obciążenia (lub inny opis kąta) – przesunięty
        w najbliższe wolne miejsce (bez linii odniesienia)."""
        if getattr(self, "_defer_angles", None) is not None:      # rysowane po etykietach obciążeń
            self._defer_angles.append((cv, P, pos, text, key))
            return
        c = P(pos)
        tmp = cv.create_text(0, 0, text=text, font=(FONT, 8, "bold"))
        bx = cv.bbox(tmp)
        cv.delete(tmp)
        hw, hh = (bx[2] - bx[0]) / 2 + 4, (bx[3] - bx[1]) / 2 + 2
        placed = getattr(self, "_placed", [])
        hit = lambda x, y: any(x - hw < o[2] and o[0] < x + hw and y - hh < o[3] and o[1] < y + hh for o in placed)
        x, y = c[0], c[1]
        if hit(x, y):
            done = False
            for r in range(6, 240, 4):
                for k in range(24):
                    t = math.radians(-90 + 15 * k)
                    xx, yy = c[0] + r * math.cos(t), c[1] + r * math.sin(t)
                    if not hit(xx, yy):
                        x, y, done = xx, yy, True
                        break
                if done:
                    break
        self._placed = placed + [(x - hw, y - hh, x + hw, y + hh)]
        self._dim_box(cv, x, y, text, BDIM_COL, "#fff7ed", key)

    def draw_bdims(self, cv, mode, g, P, facing, size):
        """Wymiary budynku (klikalne). Poziome – na gruncie, pionowe – w płaszczyźnie ściany szczytowej, po dalszej
        stronie budynku (nie zasłaniają go). Kolejność od budynku: niebieskie wymiary pól, cząstkowe wymiary
        budynku, ogólne – każda linia na pierwszym wolnym poziomie (moduł N = DIM_STEP · rozmiar modelu); strona
        bez niebieskich wymiarów – wymiary budynku bliżej. Linie odniesienia zawsze dochodzą do punktów bazowych."""
        col = BDIM_COL
        snow = mode == "śnieg"
        pf = "s_" if snow else "w_"
        z0_ = (0, 0, 0)
        N = DIM_STEP * size
        used = getattr(self, "_dim_used", set())
        first = lambda side: 2 if side in used else 1           # pierwszy wolny poziom przy danej stronie
        if g.kind == "dome":
            sh = g.shape
            yf, ny = (0.0, -1) if facing((0, -1, 0)) else (sh.D, 1)
            xs, nx = (0.0, -1) if facing((-1, 0, 0)) else (sh.D, 1)
            self._dchain(cv, P, lambda u: (u, sh.rho, 0.0), lambda u: (u, yf + ny * first(("y", ny)) * N, 0.0),
                         [(0.0, sh.D, "", "w_D")], z0_, col)
            xb, nb = (sh.D, 1) if nx < 0 else (0.0, -1)          # wysokości po drugiej stronie kopuły
            base = lambda u: (xb, sh.rho, u) if u <= sh.H + 1e-9 else (sh.rho, sh.rho, u)
            self._dchain(cv, P, base, lambda u: (xb + nb * N, sh.rho, u),
                         [(0.0, sh.H, "", "w_H"), (sh.H, sh.H + sh.f, "", "w_f")], z0_, col)
            self._dchain(cv, P, base, lambda u: (xb + nb * 2 * N, sh.rho, u), [(0.0, sh.H + sh.f, "")], z0_, col,
                         lab_t=0.78)
            return
        L = g.L
        prisms = [g.main] + ([g.upper] if snow and g.upper else []) if snow else [g.shape]
        ys = [pr.oy for pr in prisms if isinstance(pr, Prism)] + [0.0]
        ye = [pr.oy + pr.B for pr in prisms if isinstance(pr, Prism)] + [g.B]
        y0, y1 = min(ys), max(ye)
        yf, ny = (y0, -1) if facing((0, -1, 0)) else (y1, 1)
        yL = yf                                  # wymiar L – poza przybudówką / zadaszeniem
        if snow:
            ext = [q[1] for so in (g.annex, g.canopy) if so for P, _ in so.walls for q in P]
            yL = min([yf] + ext) if ny < 0 else max([yf] + ext)
        xs, nx = (0.0, -1) if facing((-1, 0, 0)) else (L, 1)
        rz = g.main.rz if snow else g.rz
        main = g.main if snow else g.shape
        # ---- poziome, na gruncie: długość L (ogólny) wzdłuż ściany podłużnej
        kL = first(("y", ny)) * N
        self._dchain(cv, P, lambda u: (u, yf, 0.0), lambda u: (u, yL + ny * kL, 0.0), [(0.0, L, "", pf + "L")],
                     z0_, col, lab_t=0.5 if yL == yf else 0.2)      # opis z dala od wymiarów przybudówki
        # ---- poziome, na gruncie, przy ścianie szczytowej: szerokości
        if snow and g.upper:
            overall = [(g.upper.oy, 0.0, "", "s_b1"), (0.0, g.B, "", "s_B")]
        else:
            overall = [(0.0, g.B, "", pf + "B")]
        part, pbase = None, None
        if snow and g.kind == "multi":
            w_ = g.B / g.p["n"]
            part = [(i * w_, (i + 1) * w_, "") for i in range(g.p["n"])]
            pbase = lambda u: (xs, u, rz(xs, u))                 # kosze i okapy naw
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[1]:
            part = [(0.0, g.p["yob"], "", "s_yob")]
            pbase = lambda u: (xs, u, g.H)
        lv = first(("x", nx))
        if part:
            kP = lv * N
            self._dchain(cv, P, pbase, lambda u: (xs + nx * kP, u, 0.0), part, z0_, col,
                         via=lambda u: (xs, u, 0.0))
            lv += 1
        kB = lv * N
        self._dchain(cv, P, lambda u: (xs, u, 0.0), lambda u: (xs + nx * kB, u, 0.0), overall, z0_, col)
        # ---- pionowe, w płaszczyźnie ściany szczytowej, po dalszej stronie budynku: wysokości
        yb, nb = (y1, 1) if yf == y0 else (y0, -1)
        if snow and g.upper and yb == y0:
            ze, hk = g.upper.rz(xs, y0 + 1e-9), None
        else:
            ze = rz(xs, yb)
            hk = pf + "H" if abs(ze - g.H) < 1e-6 else None
        hparts = [(0.0, ze, "", hk)]
        if not snow and g.kind == "flat" and g.hp > 0:
            hparts.append((ze, ze + g.hp, "", "w_hp"))
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]:
            hparts.append((ze, ze + g.p["hob"], "", "s_hob"))
        top_pt = None
        if isinstance(main, Prism):
            ytop = max(main.prof, key=lambda q: q[1])[0] + main.oy
            if main.h_top > ze + 1e-3:
                top_pt = (xs, ytop, main.h_top)
                if g.kind == "vault":
                    hparts.append((ze, main.h_top, "", pf + "f"))
        elif isinstance(main, Hip):
            xr = main.run if xs == 0 else L - main.run
            top_pt = (xr, g.B / 2, main.h_top)
        htot = top_pt[2] if top_pt else hparts[-1][1]

        def hbase(u):
            if top_pt and abs(u - top_pt[2]) < 1e-9:
                return top_pt
            return (xs, yb, u)
        if len(hparts) > 1 or top_pt:                           # cząstkowe – bliżej budynku
            self._dchain(cv, P, hbase, lambda u: (xs, yb + nb * N, u), hparts, z0_, col)
            self._dchain(cv, P, hbase, lambda u: (xs, yb + nb * 2 * N, u), [(0.0, htot, "")], z0_, col,
                         lab_t=0.78)                            # opis wyżej niż opisy cząstkowe
        else:                                                   # jedna wysokość – pierwszy poziom
            self._dchain(cv, P, hbase, lambda u: (xs, yb + nb * N, u), hparts, z0_, col)
        # ---- kąty połaci
        if isinstance(main, Prism):
            seen = []
            for sg_ in main.segs():
                a = Prism.seg_angle(sg_)
                if a < 0.5 or g.kind == "vault" or len(seen) >= 2 or any(abs(a - b) < 1e-6 for b in seen):
                    continue
                seen.append(a)
            if seen:
                done = []
                for sg_ in main.segs():
                    a = Prism.seg_angle(sg_)
                    if any(abs(a - b) < 1e-6 for b in done) or not any(abs(a - b) < 1e-6 for b in seen):
                        continue
                    done.append(a)
                    my = (sg_[0] + sg_[2]) / 2
                    mz = (sg_[1] + sg_[3]) / 2
                    if len(seen) == 1:
                        akey = (pf + "alpha", pf + "alpha2") if (snow and g.kind == "multi") else pf + "alpha"
                    else:
                        akey = pf + ("alpha" if len(done) == 1 else "alpha2")
                    if not snow and g.kind == "can2":
                        a = g.p["alpha"]                    # wiata: kąt ze znakiem (−20…+30°)
                    xm = L / 2                                   # środek połaci (w połowie długości)
                    self._angle_label(cv, P, (xm, my, rz(xm, my) + 0.01 * size), f"{f2(a, 1)}°", akey)
        elif isinstance(main, Hip):
            sh = main
            self._angle_label(cv, P, (L / 2, yf + (-ny) * g.B / 4, rz(L / 2, yf + (-ny) * g.B / 4) + 0.03 * size),
                              f"{f2(g.p['alpha'], 1)}°", "w_alpha")
            self._angle_label(cv, P, (xs + (-nx) * sh.run / 2, g.B / 2, rz(xs + (-nx) * sh.run / 2, g.B / 2) +
                                      0.03 * size), f"{f2(g.p['a90'], 1)}°", "w_a90")
        # ---- kąt dachu budowli wyższej (przy wyższej budowli)
        if snow and g.upper and g.p["aup"] >= 0.5:
            up = g.upper
            sgs = up.segs()
            vis = [q for q in sgs if facing(unit((0.0, -(q[3] - q[1]), q[2] - q[0])))]
            sg_ = (vis or sgs)[-1]                               # połać widoczna (najlepiej od dachu niższego)
            my = (sg_[0] + sg_[2]) / 2
            xm = L / 2
            self._angle_label(cv, P, (xm, my, up.rz(xm, my) + 0.01 * size), f"{f2(g.p['aup'], 1)}°", "s_aup")
        # ---- elementy dodatkowe (przy swoich krawędziach)
        if snow and g.upper and not facing((0, -1, 0)):          # uskok widoczny tylko od strony dachu niższego
            self._dchain(cv, P, lambda u: (xs, 0.0, u), lambda u: (xs, N, u),
                         [(g.H, g.H + g.p["dh"], "", "s_dh")], z0_, col)
        if snow and g.kind == "obst" and g.p["otype"] == OBST_TYPES[1]:
            yo = g.p["yob"] + 0.25
            self._dchain(cv, P, lambda u: (xs, yo, u), lambda u: (xs, yo + N, u),
                         [(g.H, g.H + g.p["hob"], "", "s_hob")], z0_, col)
        if snow and getattr(g, "exc", None):
            self.draw_exc_dims(cv, g, P, facing, N, xs, nx)

    def draw_exc_dims(self, cv, g, P, facing, N, xs, nx):
        """Wymiary elementów dodatkowych dla zasp wyjątkowych (klikalne): przybudówka, zadaszenie,
        przeszkody i attyki. Odsunięcie: pola obciążenia N, wymiary elementu 2N."""
        col, z0_ = BDIM_COL, (0, 0, 0)
        k2 = 2 * N
        sx = lambda a, b: (a, -1) if facing((-1, 0, 0)) else (b, 1)
        if g.annex:
            a = g.annex.g
            x_, n_ = sx(a["x0"], a["x1"])
            self._dchain(cv, P, lambda u: (u, a["ya"], 0.0), lambda u: (u, a["ya"] - k2, 0.0),
                         [(a["x0"], a["x1"], "", "s_xw")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, u, 0.0), lambda u: (x_ + n_ * k2, u, 0.0),
                         [(a["ya"], a["yb"], "", "s_xd")], z0_, col)
            hu = g.upper.prof[0][1]
            self._dchain(cv, P, lambda u: (x_, a["yb"], u), lambda u: (x_ + n_ * k2, a["yb"], u),
                         [(a["he"], hu, "", "s_xh")], z0_, col)
            if a["a"] >= 0.5:
                xq, yq = (a["x0"] + a["xm"]) / 2, (a["ya"] + a["yb"]) / 2
                self._angle_label(cv, P, (xq, yq, (a["he"] + a["zr"]) / 2 + 0.05), f"{f2(a['a'], 1)}°", "s_xa")
        if g.canopy and facing((0, 1, 0)):      # zadaszenie na ścianie y = B – wymiary, gdy ściana widoczna
            c = g.canopy.g
            x_, n_ = sx(c["x1"], c["x0"])                 # wymiary po stronie dalszej – dala od wymiarów budynku
            n_ = -n_
            yw, ye_ = c["yw"], c["yw"] + c["c"]
            self._dchain(cv, P, lambda u: (u, ye_, c["hc"]), lambda u: (u, ye_ + k2, c["hc"]),
                         [(c["x0"], c["x1"], "", "s_cw")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, u, c["hc"]), lambda u: (x_ + n_ * k2, u, c["hc"]),
                         [(yw, ye_, "", "s_cb")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, yw, u), lambda u: (x_ + n_ * k2, yw, u),
                         [(c["hc"], c["hedge"], "", "s_ch")], z0_, col)
        if g.fobst:                            # wymiary przeszkody po stronie dalszej (bliższą zajmują pola zasp)
            o = g.fobst.g
            x_, n_ = sx(o["x1"], o["x0"])
            n_ = -n_
            y_, m_ = (o["y1"], 1) if facing((0, -1, 0)) else (o["y0"], -1)
            zt = g.H + o["h"]
            self._dchain(cv, P, lambda u: (u, y_, zt), lambda u: (u, y_ + m_ * k2, zt),
                         [(o["x0"], o["x1"], "", "s_fw")], z0_, col)
            self._dchain(cv, P, lambda u: (x_, u, zt), lambda u: (x_ + n_ * k2, u, zt),
                         [(o["y0"], o["y1"], "", "s_fd")], z0_, col)
            xn, sn = (o["x0"], -1) if facing((-1, 0, 0)) else (o["x1"], 1)     # wysokość – narożnik widoczny
            yn = o["y0"] if facing((0, -1, 0)) else o["y1"]
            self._dchain(cv, P, lambda u: (xn, yn, u), lambda u: (xn + sn * N, yn, u),
                         [(g.H, zt, "", "s_fh")], z0_, col)
        pr = g.main
        for i, (ye, dr) in enumerate(g.eave_par[:1]):          # attyka przy okapie – wysokość
            z0 = pr.rz(0, ye)
            self._dchain(cv, P, lambda u: (xs, ye, u), lambda u: (xs + nx * N, ye, u),
                         [(z0, z0 + g.exc["pah"], "", "s_pah")], z0_, col)
        for gx, dr in g.gable_par[:1] if not g.gable_par else \
                [q for q in g.gable_par if (q[0] == 0.0) == facing((-1, 0, 0))][:1]:   # attyka szczytowa – wysokość
            ytop = max(pr.prof, key=lambda q: q[1])[0]
            zr = pr.rz(gx, ytop)
            self._dchain(cv, P, lambda u: (gx, ytop, u), lambda u: (gx - dr * N, ytop, u),
                         [(zr, zr + g.exc["gah"], "", "s_gah")], z0_, col)
        if g.obst_y is not None:                                # przeszkoda na połaci – położenie i wysokość
            yo = g.obst_y
            za, zb = pr.rz(xs, yo), pr.rz(xs, yo + TW_OBST)
            zt = max(za, zb) + g.exc["poh"]
            ko = N if g.kind == "multi" else k2                  # nawy (dach wielopołaciowy) zajmują 2N
            self._dchain(cv, P, lambda u: (xs, u, pr.rz(xs, u)), lambda u: (xs + nx * ko, u, 0.0),
                         [(0.0, yo, "", "s_poy")], z0_, col, via=lambda u: (xs, u, 0.0))
            ox0, ox1 = g.obst_x
            xe_, ne_ = (ox0, -1) if facing((-1, 0, 0)) else (ox1, 1)     # koniec przeszkody od strony obserwatora
            yb_ = yo if za >= zb else yo + TW_OBST
            self._dchain(cv, P, lambda u: (xe_, yb_, u), lambda u: (xe_ + ne_ * N, yb_, u),
                         [(max(za, zb), zt, "", "s_poh")], z0_, col)
            yf_, mf_ = (yo + TW_OBST, 1) if facing((0, -1, 0)) else (yo, -1)   # długość – po stronie dalszej
            self._dchain(cv, P, lambda u: (u, yf_, zt), lambda u: (u, yf_ + mf_ * k2, zt),
                         [(ox0, ox1, "", "s_pol")], z0_, col)

    def draw_snow_dims(self, cv, g, P, facing, size):
        """Wymiary pól obciążenia śniegiem (w rzucie). Krawędź pozioma (okap) – linia wymiarowa
        w płaszczyźnie okapów; szczyt pochyły – w płaszczyźnie ściany szczytowej, linie pomocnicze pionowe."""
        s = self.snow
        case = next((c for c in s["cases"] if c["name"] == self.snow_case.get()), s["cases"][0])
        N_ = DIM_STEP * size
        if getattr(g, "upper", None) and facing((0, -1, 0)):     # dach niższy za wyższą budowlą – bez wymiarów
            return
        for ax, a0, a1, z, segs in case.get("xdim", []):     # zasięg zasp na elementach dodatkowych
            segs = [(u0, u1, "") for u0, u1 in segs if u1 - u0 > 1e-6]
            if not segs:
                continue
            if ax == "y":
                xs_, nx_ = (a0, -1) if facing((-1, 0, 0)) else (a1, 1)
                if z is None:                                   # połać: wymiar nad dachem, linie pionowe
                    zl_ = getattr(self, "_snow_ztop", g.main.h_top) + N_
                    self._dchain(cv, P, lambda u: (xs_, u, g.main.rz(xs_, u)), lambda u: (xs_, u, zl_), segs,
                                 (0, 0, 0), SDIM_COL)
                else:
                    self._dchain(cv, P, lambda u: (xs_, u, z), lambda u: (xs_ + nx_ * N_, u, z), segs, (0, 0, 0),
                                 SDIM_COL)
            else:
                ys_, ny_ = (a0, -1) if facing((0, -1, 0)) else (a1, 1)
                z_ = z if z is not None else g.main.rz(0, ys_)
                self._dchain(cv, P, lambda u: (u, ys_, z_), lambda u: (u, ys_ + ny_ * N_, z_), segs, (0, 0, 0),
                             SDIM_COL)
        spans = [sp for sp in case.get("spans", []) if sp[1] - sp[0] > 1e-6]
        if not spans:
            return
        xs, nx = (0.0, -1) if facing((-1, 0, 0)) else (g.L, 1)
        pr = g.main
        col = SDIM_COL
        lo_, hi_ = min(sp[0] for sp in spans), max(sp[1] for sp in spans)
        zs = [pr.rz(xs, lo_ + (hi_ - lo_) * i / 40) for i in range(41)]
        if max(zs) - min(zs) < 1e-6:
            z0, k = zs[0], DIM_STEP * size
            path = lambda u: (xs, u, z0)
            lpt = lambda u: (xs + nx * k, u, z0)
        else:
            zl = getattr(self, "_snow_ztop", pr.h_top) + DIM_STEP * size
            path = lambda u: (xs, u, pr.rz(xs, u))
            lpt = lambda u: (xs, u, zl)
        self._dchain(cv, P, path, lpt, [sp[:3] for sp in spans], (0, 0, 0.025 * size), col)
        if g.kind == "obst" and g.p["otype"] == OBST_TYPES[0]:   # attyka: zaspy także wzdłuż L
            e_ = min(spans[0][1] - spans[0][0], g.L / 2)
            yf, ny = (0.0, -1) if facing((0, -1, 0)) else (g.B, 1)
            segs = [(0.0, e_, "lₛ ="), (e_, g.L - e_, ""), (g.L - e_, g.L, "lₛ =")] if g.L > 2 * e_ + 1e-9 else []
            if segs:
                k = DIM_STEP * size
                self._dchain(cv, P, lambda u: (u, yf, g.H), lambda u: (u, yf + ny * k, g.H), segs,
                             (0, 0, 0.025 * size), col)

    def draw_dims(self, cv, g, P, facing, size):
        """Wymiary pól wiatru (w rzucie). Ściany – na gruncie; dach przy okapach – w płaszczyźnie okapów;
        szczyt pochyły – w płaszczyźnie ściany szczytowej (linie pomocnicze pionowe)."""
        if g.kind == "dome":
            return
        w = self.wind
        fr = wind_frame(g, w["theta"])
        b, d, to, so, tof = fr["b"], fr["d"], fr["to_xy"], fr["s_of"], fr["t_of"]

        def xy_dir(ds, dt):
            a, c = to(0, 0), to(ds, dt)
            v = (c[0] - a[0], c[1] - a[1])
            l = math.hypot(*v) or 1
            return (v[0] / l, v[1] / l)
        o_t0 = xy_dir(0, -1)
        if facing((o_t0[0], o_t0[1], 0)):
            tside, out = 0.0, o_t0
        else:
            tside, out = b, (-o_t0[0], -o_t0[1])
        ups = xy_dir(-1, 0)
        col = DIM_COL
        k1 = DIM_STEP * size                      # moduł odsunięcia N
        lab = (0, 0, 0.025 * size)
        roofz = [z for z in w["zones"] if z["kind"] in ("roof", "canopy") and not z.get("dome")]

        def edge_segs(fixed, val):
            """Odcinki pól dachu leżące na krawędzi s = val lub t = val."""
            segs, zs = set(), []
            on = lambda p: abs((so(p) if fixed == "s" else tof(p)) - val) < 1e-6
            par = lambda p: tof(p) if fixed == "s" else so(p)
            for z in roofz:
                P_ = z["poly"]
                for i in range(len(P_)):
                    a_, b_ = P_[i], P_[(i + 1) % len(P_)]
                    if on(a_) and on(b_) and abs(par(a_) - par(b_)) > 1e-6:
                        u0, u1 = sorted((par(a_), par(b_)))
                        segs.add((round(u0, 6), round(u1, 6), z["name"]))
                        zs += [a_[2], b_[2]]
            merged = []
            for sg_ in sorted(segs):                            # sąsiednie odcinki tego samego pola – razem
                if merged and merged[-1][2] == sg_[2] and abs(merged[-1][1] - sg_[0]) < 1e-6:
                    merged[-1] = (merged[-1][0], sg_[1], sg_[2])
                else:
                    merged.append(sg_)
            return merged, zs

        def edge_chain(fixed, val, outward, segs=None, zs=None, row=1.0):
            if segs is None:
                segs, zs = edge_segs(fixed, val)
                if len(segs) < 2:
                    return
            pt = (lambda u: to(val, u)) if fixed == "s" else (lambda u: to(u, val))
            if max(zs) - min(zs) < 1e-6:                        # okap: płaszczyzna okapów
                z0, k = zs[0], k1 * row
                path = lambda u: (*pt(u), z0)
                lpt = lambda u: (pt(u)[0] + outward[0] * k, pt(u)[1] + outward[1] * k, z0)
            else:                                               # szczyt: płaszczyzna ściany szczytowej
                zl = max(zs) + k1 * row
                path = lambda u: (*pt(u), g.rz(*pt(u)))
                lpt = lambda u: (*pt(u), zl)
            self._dchain(cv, P, path, lpt, segs, lab, col)

        if g.dims_roof or g.kind == "hip":
            edge_chain("s", 0.0, ups)                               # okap / szczyt nawietrzny
            segs, zs = edge_segs("t", tside)
            if len(segs) >= 2 and g.kind not in ("can1", "can2"):
                edge_chain("t", tside, out, segs, zs)               # krawędź boczna
            edge_chain("s", d, (-ups[0], -ups[1]))                  # okap zawietrzny (np. pola J)
            if g.kind in ("can1", "can2"):                          # wiaty: podział w poprzek wiatru (B–A–B)
                _, zs0 = edge_segs("s", 0.0)
                segs = sorted({(round(z["rect"][2], 6), round(z["rect"][3], 6), z["name"]) for z in roofz
                               if "rect" in z and z["rect"][0] - 1e-6 <= d / 4 <= z["rect"][1] + 1e-6})
                if len(segs) >= 2 and zs0:
                    edge_chain("s", 0.0, ups, segs, zs0)
                _, zsb = edge_segs("t", tside)                      # podział wzdłuż wiatru w środku (C–A–D–A–C)
                segs = sorted({(round(z["rect"][0], 6), round(z["rect"][1], 6), z["name"]) for z in roofz
                               if "rect" in z and z["rect"][2] - 1e-6 <= b / 2 <= z["rect"][3] + 1e-6})
                if len(segs) >= 2 and zsb:
                    edge_chain("t", tside, out, segs, zsb)
        # ściany: na gruncie, wzdłuż ściany bocznej
        segs = [(z["srange"][0], z["srange"][1], z["name"]) for z in w["zones"] if "srange" in z]
        if segs:
            side = ("x", 1 if out[0] > 0 else -1) if abs(out[0]) > abs(out[1]) else ("y", 1 if out[1] > 0 else -1)
            getattr(self, "_dim_used", set()).add(side)
            self._dchain(cv, P, lambda u: (*to(u, tside), 0.0),
                         lambda u: (to(u, tside)[0] + out[0] * k1, to(u, tside)[1] + out[1] * k1, 0.0), segs, lab, col)
        if g.kind in ("can1", "can2"):
            return
        bd = self.bdims3d.get()                   # b i h są już na wymiarach budynku
        if not bd:
            k = k1
            self._dchain(cv, P, lambda u: (*to(0, u), 0.0),
                         lambda u: (to(0, u)[0] + ups[0] * k, to(0, u)[1] + ups[1] * k, 0.0),
                         [(0.0, b, "b =")], lab, col)
        bands = [(z["zband"][0], z["zband"][1], "") for z in w["zones"] if "zband" in z]
        if len(bands) <= 1:
            if bd:
                return
            bands = [(0.0, g.h_top, "h =")]
        cx, cy_ = to(0, tside)
        ox_, oy_ = out[0] * k1, out[1] * k1
        self._dchain(cv, P, lambda u: (cx, cy_, u), lambda u: (cx + ox_, cy_ + oy_, u), bands,
                     (out[0] * 0.06 * size, out[1] * 0.06 * size, 0), col)


def _check_image():
    """Znaczek „ptaszka” do pól wyboru (PNG w katalogu tymczasowym – bez wtyczki SVG)."""
    import tempfile
    from PySide6.QtGui import QPixmap
    path = os.path.join(tempfile.gettempdir(), "kayenn_codes_check.png")
    pm = QPixmap(28, 28)
    pm.fill(QColor(0, 0, 0, 0))
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
    pen = QPen(QColor("#ffffff"))
    pen.setWidthF(3.6)
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.drawPolyline(QPolygonF([QPointF(6, 14.5), QPointF(11.5, 20), QPointF(22, 8)]))
    p.end()
    pm.save(path, "PNG")
    return path.replace("\\", "/")


def register_file_type():
    """Windows: pliki projektu (.kayenn) otwierane dwuklikiem tym programem (rejestr bieżącego użytkownika, bez uprawnień
    administratora). Zapis tylko przy zmianie – np. po przeniesieniu programu w inne miejsce."""
    if sys.platform != "win32":
        return
    try:
        import winreg
        exe = sys.executable
        if exe.lower().endswith("python.exe"):
            exe_w = exe[:-10] + "pythonw.exe"
            if os.path.exists(exe_w):
                exe = exe_w                                     # bez okna konsoli
        script = os.path.abspath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)
        cmd = f'"{exe}" "{script}" "%1"'
        prog = "KAYENN.Projekt"
        want = {rf"Software\Classes\{PROJECT_EXT}": prog,
                rf"Software\Classes\{prog}": "Projekt KAYENN",
                rf"Software\Classes\{prog}\shell\open\command": cmd}
        if os.path.exists(ICON_FILE):
            want[rf"Software\Classes\{prog}\DefaultIcon"] = f'"{ICON_FILE}",0'
        changed = False
        for key, val in want.items():
            try:
                with winreg.OpenKey(winreg.HKEY_CURRENT_USER, key) as k:
                    cur = winreg.QueryValueEx(k, "")[0]
            except OSError:
                cur = None
            if cur != val:
                with winreg.CreateKey(winreg.HKEY_CURRENT_USER, key) as k:
                    winreg.SetValueEx(k, "", 0, winreg.REG_SZ, val)
                changed = True
        if changed:
            import ctypes
            ctypes.windll.shell32.SHChangeNotify(0x08000000, 0, None, None)   # odświeżenie skojarzeń w Eksploratorze
    except Exception:
        pass                                                    # skojarzenie to wygoda – bez niego program działa


def main():
    try:   # moduł mapy (QtWebEngine) musi być załadowany przed utworzeniem aplikacji
        import PySide6.QtWebEngineWidgets  # noqa: F401
    except ImportError:
        pass
    if sys.platform == "win32":
        try:   # własny identyfikator – pasek zadań pokazuje ikonę KAYENN zamiast ikony Pythona
            import ctypes
            ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID("KAYENN")
        except Exception:
            pass
    qapp = QApplication(sys.argv)
    if os.path.exists(ICON_FILE):
        qapp.setWindowIcon(QIcon(ICON_FILE))
    qapp.setStyle("Fusion")
    pal = qapp.palette()
    R = QPalette.ColorRole
    for role, col in ((R.Window, BG), (R.WindowText, TEXT), (R.Base, "#ffffff"), (R.AlternateBase, "#f6f7f9"),
                      (R.Text, TEXT), (R.Button, "#eef0f3"), (R.ButtonText, TEXT), (R.Highlight, ACCENT),
                      (R.HighlightedText, "#ffffff"), (R.ToolTipBase, "#ffffff"), (R.ToolTipText, TEXT),
                      (R.PlaceholderText, MUTED)):
        pal.setColor(role, QColor(col))
    qapp.setPalette(pal)
    qapp.setFont(QFont(FONT, 9))
    qapp.setStyleSheet(STYLE.replace("@CHECK@", _check_image()))
    register_file_type()
    app = App(qapp)
    scr = qapp.primaryScreen().availableGeometry()
    app.win.resize(640, min(960, scr.height() - 60))
    app.pw.resize(min(1100, scr.width() - 80), min(860, scr.height() - 60))
    app.pw.move(scr.x() + 30, scr.y() + 20)
    files = [a for a in sys.argv[1:] if not a.startswith("-") and os.path.isfile(a)]
    if files:                                        # dwuklik na pliku projektu
        app.open_path(files[0])
    app.pw.rebuild()
    app.pw.showMaximized()                           # zawsze najpierw okno główne, zmaksymalizowane
    sys.exit(qapp.exec())


if __name__ == "__main__":
    main()
