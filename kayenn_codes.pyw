_FONTS = {}
_METRICS = {}


def qfont(spec):
    spec = tuple(spec)
    f = _FONTS.get(spec)
    if f is None:
        f = QFont(spec[0])
        f.setPointSizeF(float(spec[1]))
        f.setBold("bold" in spec[2:])
        _FONTS[spec] = f
    return f


class _Ev:
    def __init__(self, x, y):
        self.x, self.y = x, y


class Canvas3D(QWidget):
    """Lista elementów rysunku (wielokąty, linie, teksty…) malowana przez QPainter.
    Metody create_* / bbox / delete / tag_raise mają postać znaną z tk.Canvas."""

    BG_COL = "#fbfbfc"

    def __init__(self, app):
        super().__init__()
        self.app = app
        self.items = {}
        self.order = []
        self._nid = 0
        self._drag = None
        self.setMouseTracking(True)
        self.setMinimumSize(200, 150)
        self.setAttribute(Qt.WidgetAttribute.WA_AcceptTouchEvents, True)
        self.grabGesture(Qt.GestureType.PinchGesture)        # ekran dotykowy: dwa palce – zoom i przesuwanie

    # --- tk-podobne API
    def winfo_width(self):
        return self.width()

    def winfo_height(self):
        return self.height()

    def configure(self, cursor=None, **kw):
        if cursor is not None:
            shapes = {"fleur": Qt.CursorShape.SizeAllCursor, "hand2": Qt.CursorShape.PointingHandCursor}
            if cursor in shapes:
                self.setCursor(shapes[cursor])
            else:
                self.unsetCursor()

    def _add(self, it):
        self._nid += 1
        it["tags"] = set()
        self.items[self._nid] = it
        self.order.append(self._nid)
        return self._nid

    @staticmethod
    def _pairs(coords):
        if len(coords) == 1 and isinstance(coords[0], (list, tuple)):
            coords = coords[0]
        return [(float(coords[i]), float(coords[i + 1])) for i in range(0, len(coords) - 1, 2)]

    def delete(self, what):
        if what == "all":
            self.items.clear()
            self.order.clear()
        elif what in self.items:
            del self.items[what]
            self.order.remove(what)

    def create_polygon(self, *coords, fill="", outline="", width=1, alpha=None, edges=None, **kw):
        """alpha – krycie wypełnienia 0–255; edges – które krawędzie obrysować (None – wszystkie)."""
        return self._add(dict(k="poly", pts=self._pairs(coords), fill=fill, outline=outline, width=width,
                              alpha=alpha, edges=edges))

    def create_line(self, *coords, fill="#000000", width=1, dash=None, arrow=None, arrowshape=(8, 10, 3), **kw):
        return self._add(dict(k="line", pts=self._pairs(coords), fill=fill, width=width, dash=dash,
                              arrow=arrow, ashape=arrowshape))

    def create_rectangle(self, x0, y0, x1, y1, fill="", outline="#000000", dash=None, stipple="", width=1, **kw):
        return self._add(dict(k="rect", box=(x0, y0, x1, y1), fill=fill, outline=outline, dash=dash,
                              stipple=stipple, width=width))

    def create_oval(self, x0, y0, x1, y1, fill="", outline="#000000", width=1, **kw):
        return self._add(dict(k="oval", box=(x0, y0, x1, y1), fill=fill, outline=outline, width=width))

    def create_text(self, x, y, text="", font=(FONT, 9), fill="#000000", anchor="center", justify="center", **kw):
        fm = _METRICS.get(tuple(font))
        if fm is None:
            fm = _METRICS[tuple(font)] = QFontMetricsF(qfont(font))
        lines = str(text).split("\n")
        widths = [fm.horizontalAdvance(l) for l in lines]
        lh = fm.height()
        bw, bh = max(widths), lh * len(lines)
        if anchor == "center":
            x0, y0 = x - bw / 2, y - bh / 2
        else:
            x0 = x if "w" in anchor else (x - bw if "e" in anchor else x - bw / 2)
            y0 = y if "n" in anchor else (y - bh if "s" in anchor else y - bh / 2)
        return self._add(dict(k="text", lines=lines, widths=widths, x0=x0, y0=y0, bw=bw, lh=lh,
                              asc=fm.ascent(), font=font, fill=fill, justify=justify,
                              box=(x0, y0, x0 + bw, y0 + bh)))

    def bbox(self, iid):
        return self.items[iid]["box"]

    def tag_raise(self, a, b=None):
        if a not in self.items:
            return
        self.order.remove(a)
        if b is None or b not in self.items:
            self.order.append(a)
        else:
            self.order.insert(self.order.index(b) + 1, a)

    def addtag_withtag(self, tag, iid):
        if iid in self.items:
            self.items[iid]["tags"].add(tag)

    def hit(self, x, y, tag="editable"):
        """Najwyższy element z danym znacznikiem pod punktem (x, y)."""
        for iid in reversed(self.order):
            it = self.items[iid]
            if tag in it["tags"] and "box" in it:
                b = it["box"]
                if b[0] - 2 <= x <= b[2] + 2 and b[1] - 2 <= y <= b[3] + 2:
                    return it
        return None

    # --- malowanie
    @staticmethod
    def _pen(color, width=1, dash=None):
        if not color:
            return QPen(Qt.PenStyle.NoPen)
        pen = QPen(QColor(color))
        pen.setWidthF(float(width))
        pen.setCapStyle(Qt.PenCapStyle.FlatCap)
        pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        if dash:
            w = max(float(width), 1.0)
            pen.setDashPattern([d / w for d in dash])
        return pen

    @staticmethod
    def _brush(color, stipple=""):
        if not color:
            return QBrush(Qt.BrushStyle.NoBrush)
        c = QColor(color)
        if stipple:
            c.setAlpha(190)
        return QBrush(c)

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        p.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)
        p.fillRect(QRectF(0, 0, self.width(), self.height()), QColor(self.BG_COL))
        for iid in self.order:
            it = self.items[iid]
            k = it["k"]
            if k == "poly":
                br = self._brush(it["fill"])
                if it.get("alpha") is not None and it["fill"]:
                    c = QColor(it["fill"])
                    c.setAlpha(int(it["alpha"]))
                    br = QBrush(c)
                p.setBrush(br)
                pts = [QPointF(x, y) for x, y in it["pts"]]
                ed = it.get("edges")
                if ed is None:
                    p.setPen(self._pen(it["outline"], it["width"]))
                    p.drawPolygon(QPolygonF(pts))
                else:                                  # obrys tylko wybranych krawędzi
                    p.setPen(self._pen("", 1))
                    p.drawPolygon(QPolygonF(pts))
                    p.setPen(self._pen(it["outline"], it["width"]))
                    for i_, on in enumerate(ed):
                        if on:
                            p.drawPolyline(QPolygonF([pts[i_], pts[(i_ + 1) % len(pts)]]))
            elif k == "line":
                self._paint_line(p, it)
            elif k in ("rect", "oval"):
                x0, y0, x1, y1 = it["box"]
                p.setPen(self._pen(it["outline"], it["width"], it.get("dash")))
                p.setBrush(self._brush(it["fill"], it.get("stipple", "")))
                r = QRectF(x0, y0, x1 - x0, y1 - y0)
                if k == "rect":
                    p.drawRect(r)
                else:
                    p.drawEllipse(r)
            elif k == "text":
                p.setFont(qfont(it["font"]))
                p.setPen(QColor(it["fill"]))
                for i, (ln, w) in enumerate(zip(it["lines"], it["widths"])):
                    if it["justify"] == "left":
                        lx = it["x0"]
                    elif it["justify"] == "right":
                        lx = it["x0"] + it["bw"] - w
                    else:
                        lx = it["x0"] + (it["bw"] - w) / 2
                    p.drawText(QPointF(lx, it["y0"] + i * it["lh"] + it["asc"]), ln)
        p.setPen(QColor("#d5d9df"))
        p.setBrush(QBrush(Qt.BrushStyle.NoBrush))
        p.drawRect(QRectF(0.5, 0.5, self.width() - 1, self.height() - 1))
        p.end()

    def _paint_line(self, p, it):
        pts = list(it["pts"])
        if len(pts) < 2:
            return
        w = float(it["width"])
        head = None
        if it.get("arrow") == "last":
            (ax, ay), (bx, by) = pts[-2], pts[-1]
            L = math.hypot(bx - ax, by - ay)
            if L > 1e-6:
                d1, d2, d3 = it["ashape"]
                ux, uy = (bx - ax) / L, (by - ay) / L
                nx, ny = -uy, ux
                d3 += w / 2
                neck = (bx - ux * d1, by - uy * d1)
                head = [(bx, by), (bx - ux * d2 + nx * d3, by - uy * d2 + ny * d3), neck,
                        (bx - ux * d2 - nx * d3, by - uy * d2 - ny * d3)]
                pts[-1] = neck
        p.setPen(self._pen(it["fill"], w, it.get("dash")))
        p.setBrush(QBrush(Qt.BrushStyle.NoBrush))
        p.drawPolyline(QPolygonF([QPointF(x, y) for x, y in pts]))
        if head:
            p.setPen(QPen(Qt.PenStyle.NoPen))
            p.setBrush(QBrush(QColor(it["fill"])))
            p.drawPolygon(QPolygonF([QPointF(x, y) for x, y in head]))

    # --- mysz
    @staticmethod
    def _xy(e):
        pos = e.position()
        return pos.x(), pos.y()

    def mousePressEvent(self, e):
        x, y = self._xy(e)
        b = e.button()
        shift = bool(e.modifiers() & Qt.KeyboardModifier.ShiftModifier)
        if b == Qt.MouseButton.MiddleButton or (b == Qt.MouseButton.LeftButton and shift):
            self._drag = "pan"
            self.app._pan_press(_Ev(x, y))
        elif b == Qt.MouseButton.LeftButton:
            self._drag = "rot"
            self.app._press(_Ev(x, y))

    def mouseMoveEvent(self, e):
        x, y = self._xy(e)
        if self._drag == "pan":
            self.app._pan(_Ev(x, y))
        elif self._drag == "rot":
            self.app._rotate(_Ev(x, y))
        else:
            if self.hit(x, y):
                self.setCursor(Qt.CursorShape.PointingHandCursor)
            else:
                self.unsetCursor()

    def mouseReleaseEvent(self, e):
        x, y = self._xy(e)
        d, self._drag = self._drag, None
        self.unsetCursor()
        if d == "rot" and not getattr(self.app, "_moved", False):
            it = self.hit(x, y)
            if it:
                tag = next((t for t in it["tags"] if t.startswith("edit") and t != "editable"), None)
                if tag and tag in self.app._edit_keys:
                    key, pos = self.app._edit_keys[tag]
                    self.app.open_editor(key, pos)

    def wheelEvent(self, e):
        """Kółko myszy – zoom; panel dotykowy: przesuwanie dwoma palcami – przesuwanie widoku,
        rozsuwanie / zsuwanie palców (Windows przekazuje je jako Ctrl + kółko) – zoom płynny."""
        ad, pd = e.angleDelta(), e.pixelDelta()
        dx, dy = ad.x(), ad.y()
        if e.modifiers() & Qt.KeyboardModifier.ControlModifier:
            if dy:
                self.app._zoom(1.0015 ** dy)
            return
        touchpad = (not pd.isNull() or e.phase() != Qt.ScrollPhase.NoScrollPhase or dx != 0
                    or (dy % 120) != 0)
        try:
            from PySide6.QtGui import QInputDevice
            dev = e.device()
            touchpad = touchpad or (dev is not None and dev.type() == QInputDevice.DeviceType.TouchPad)
        except Exception:
            pass
        if touchpad:
            if not pd.isNull():
                mx, my = pd.x(), pd.y()
            else:
                mx, my = dx * 0.5, dy * 0.5
            if mx or my:
                self.app._pan_by(mx, my)
        elif dy:
            self.app._zoom(1.1 if dy > 0 else 1 / 1.1)

    def event(self, e):
        t = e.type()
        if t == QEvent.Type.NativeGesture:                   # macOS / Linux: gest panelu dotykowego
            gt = e.gestureType()
            if gt == Qt.NativeGestureType.ZoomNativeGesture:
                self.app._zoom(1.0 + e.value())
                return True
            if gt == Qt.NativeGestureType.SmartZoomNativeGesture:
                self.app.reset_view()
                return True
        elif t == QEvent.Type.Gesture:                       # ekran dotykowy: szczypanie
            g = e.gesture(Qt.GestureType.PinchGesture)
            if g is not None:
                sf = g.scaleFactor()
                if sf > 0:
                    self.app._zoom(sf)
                c, lc = g.centerPoint(), g.lastCenterPoint()
                self.app._pan_by(c.x() - lc.x(), c.y() - lc.y())
                e.accept()
                return True
        return super().event(e)

    def resizeEvent(self, e):
        self.app.draw3d()


