def tab_cpe(table, zone, alpha, sign, alphas=ALPHAS):
    rows = []
    for r in table[zone]:
        r = _n(r)
        rows.append(r[sign] if isinstance(r, dict) else r)
    return (interp(alpha, alphas, [r[0] for r in rows]), interp(alpha, alphas, [r[1] for r in rows]))


def flat_cpe(zone, r, sign):
    if zone == "I":
        return (-0.2, -0.2) if sign == "n" else (0.2, 0.2)
    rows = T_FLAT[zone]
    return (interp(r, FLAT_R, [x[0] for x in rows]), interp(r, FLAT_R, [x[1] for x in rows]))


def canopy_cp(table, alphas, zone, alpha, phi, var):
    col = [interp(alpha, alphas, [r[i] for r in table[zone]]) for i in range(3)]
    if var == "max":
        return col[0]
    return col[1] + phi * (col[2] - col[1])


def vault_cpe(fd, hd):
    """Rys. 7.11 (odczyt z wykresu) – dachy łukowe; zwraca (lista wartości A, B, C)."""
    fd = clamp(fd, 0.05, 0.5)
    a0 = interp(fd, [0.05, 0.5], [0.1, 0.8])
    a5 = []
    if fd <= 0.3:
        a5.append(interp(fd, [0.05, 0.1, 0.2, 0.3], [-0.95, -1.2, -1.2, -0.35]))
    if fd >= 0.2:
        a5.append(interp(fd, [0.2, 0.5], [0.0, 0.8]))
    t = clamp(hd / 0.5, 0, 1)
    A = sorted({round(a0 + t * (v - a0), 4) for v in a5})
    B = interp(fd, [0.05, 0.5], [-0.75, -1.2])
    C = interp(fd, [0.05, 0.1], [-0.55, -0.4])
    return A, B, C


def dome_cpe(fd, hd):
    """Rys. 7.12 (odczyt z wykresu) – kopuły; zwraca (A, B, C)."""
    fd = clamp(fd, 0.05, 0.5)
    a_0 = interp(fd, [0.05, 0.5], [0.13, 0.8])
    a_25 = interp(fd, [0.05, 0.5], [-1.4, 0.8])
    a_1 = interp(fd, [0.05, 0.1, 0.335, 0.5], [-1.4, -1.7, -1.4, 0.8])
    A = interp(hd, [0, 0.25, 1.0], [a_0, a_25, a_1])
    B = interp(hd, [0, 0.5], [interp(fd, [0.05, 0.5], [-0.25, -1.2]),
                              interp(fd, [0.05, 0.1, 0.25, 0.5], [-0.5, -0.78, -1.2, -1.28])])
    C = interp(hd, [0, 0.5], [0.0, -0.5])
    return A, B, C


def cpe_area(c10, c1, A):
    if A <= 1:
        return c1
    if A >= 10:
        return c10
    return c1 - (c1 - c10) * math.log10(A)


class WindGeo:
    """Budynek / wiata dla obliczeń wiatru."""

    def __init__(self, kind, p):
        self.kind, self.p = kind, p
        self.A = p["A"]
        self.hp = p.get("hp", 0.0) if kind == "flat" else 0.0
        self.sym = True
        self.dims_roof = kind not in ("dome",)
        if kind == "dome":
            self.shape = Dome(p["D"], p["H"], p["f"])
            self.L = self.B = p["D"]
            self.H = p["H"]
        else:
            L, B, H = p["L"], p["B"], p["H"]
            self.L, self.B, self.H = L, B, H
            prof = None
            if kind == "flat":
                prof = prof_flat(B, H)
            elif kind in ("mono", "can1"):
                prof = prof_mono(B, H, p["alpha"])
            elif kind == "duo":
                prof = prof_duo(B, H, p["alpha"], p["alpha2"])
                self.sym = abs(p["alpha"] - p["alpha2"]) < 1e-9
            elif kind == "trough":
                prof = prof_trough(B, H, p["alpha"])
            elif kind == "multi":
                prof = (prof_multi_duo(B, H, p["n"], p["alpha"], p["alpha"]) if p["mtype"] == MULTI_TYPES[0]
                        else prof_saw(B, H, p["n"], p["alpha"]))
            elif kind == "vault":
                prof = prof_vault(B, H, p["f"])
            elif kind == "can2":
                a = p["alpha"]
                prof = prof_duo(B, H, a, a) if a >= 0 else prof_trough(B, H, -a)
            self.shape = Hip(L, B, H, p["alpha"], p["a90"]) if kind == "hip" else Prism(L, B, prof)
        self.h_top = self.shape.h_top
        self.href = self.H + self.hp if kind == "flat" else self.h_top
        a = p.get("alpha", 0.0)
        a2 = p.get("alpha2", a) if kind == "duo" else a
        self.roof_eff = kind
        if kind in ("mono", "duo", "multi", "trough") and max(a, a2) < 5:
            self.roof_eff = "flat"
        if kind == "hip" and max(a, p["a90"]) < 5:
            self.roof_eff = "flat"

    def rz(self, x, y):
        return self.shape.rz(x, y)

    def walls(self):
        if self.kind in ("dome", "can1", "can2"):
            return []
        return self.shape.walls()


def wind_frame(g, theta):
    L, B = g.L, g.B
    if theta == 0:
        return dict(b=L, d=B, w=(0, 1), to_xy=lambda s, t: (t, s), s_of=lambda p: p[1], t_of=lambda p: p[0])
    if theta == 90:
        return dict(b=B, d=L, w=(1, 0), to_xy=lambda s, t: (s, t), s_of=lambda p: p[0], t_of=lambda p: p[1])
    return dict(b=L, d=B, w=(0, -1), to_xy=lambda s, t: (t, B - s), s_of=lambda p: B - p[1],
                t_of=lambda p: p[0])


def wind_thetas(g):
    k = g.roof_eff
    if k in ("vault", "dome", "can1", "can2"):
        return [0]
    if k == "mono" or (k == "duo" and not g.sym):
        return [0, 90, 180]
    if k == "multi" and g.p["mtype"] == MULTI_TYPES[1]:
        return [0, 90, 180]
    return [0, 90]


def wind_variants(g, theta):
    k = g.roof_eff
    if k == "flat":
        return [("pole I: ssanie (−0,2)", ("n", "n")), ("pole I: parcie (+0,2)", ("n", "p"))]
    if k in ("can1", "can2"):
        return [("maksimum (+, ku dołowi)", ("max", "max")), ("minimum (−, ku górze)", ("min", "min"))]
    if (k in ("mono", "hip") and theta == 0) or (k == "multi" and theta == 0 and
                                                 g.p["mtype"] == MULTI_TYPES[1]):
        return [("F, G, H: ssanie (−)", ("n", "n")), ("F, G, H: parcie (+)", ("p", "n"))]
    if (k == "duo" and theta in (0, 180)) or (k == "multi" and theta == 0):
        return [("F,G,H: ssanie  |  I,J: ssanie", ("n", "n")),
                ("F,G,H: ssanie  |  I,J: parcie", ("n", "p")),
                ("F,G,H: parcie  |  I,J: ssanie", ("p", "n")),
                ("F,G,H: parcie  |  I,J: parcie", ("p", "p"))]
    if k == "trough" and theta == 0:
        return [("I, J: ssanie (−)", ("n", "n")), ("I, J: parcie (+)", ("n", "p"))]
    if k == "vault":
        A, _, _ = vault_cpe(g.p["f"] / g.B, g.H / g.B)
        if len(A) > 1:
            return [("pole A: wartość ujemna", ("n", "n")), ("pole A: wartość dodatnia", ("p", "p"))]
    return [("jeden wariant", ("n", "n"))]


def d_bands(h, b):
    """Rysunek 7.4 – wysokość odniesienia ze dla ściany nawietrznej."""
    if h <= b:
        return [(0.0, 1e9, h)]
    if h <= 2 * b:
        return [(0.0, b, b), (b, 1e9, h)]
    n = max(1, math.ceil((h - 2 * b) / b - 1e-9))
    hs = (h - 2 * b) / n
    bands = [(0.0, b, b)]
    bands += [(b + i * hs, b + (i + 1) * hs, b + (i + 1) * hs) for i in range(n)]
    bands.append((h - b, 1e9, h))
    return bands


def calc_wind(g, wp, theta, var):
    if wp["zone"] == "2":
        vb0 = 26.0
    else:
        vb0 = 22.0 if g.A <= 300 else 22.0 * (1 + 0.0006 * (g.A - 300))
    vb = wp["cdir"] * wp["cseason"] * vb0
    dens = (20000 - g.A) / (20000 + g.A) if (wp["zone"] == "3" and g.A > 300) else 1.0
    qb = 0.5 * wp["rho"] * vb ** 2 / 1000 * dens
    a, k, zmin, _ = TERRAIN[wp["cat"]]

    def ce(z):
        return a * (max(z, zmin) / 10) ** k

    def qp(z):
        return ce(z) * qb

    h = g.h_top
    fr = wind_frame(g, theta)
    b, d = fr["b"], fr["d"]
    e = min(b, 2 * h)
    zones, points, info = [], [], {}
    canopy = g.kind in ("can1", "can2")

    def add(kind, name, poly, c, ze, factor=1.0, **extra):
        if len(poly) < 3 or poly_area(poly) < 1e-6:
            return
        cpe = cpe_area(c[0], c[1], wp["Aload"]) * factor
        q = qp(ze)
        zones.append(dict(kind=kind, name=name, poly=poly, c10=c[0] * factor, c1=c[1] * factor, cpe=cpe,
                          ze=ze, qp=q, we=q * cpe, area=poly_area(poly), **extra))

    # ---------- ściany (7.2.2, Tablica 7.1)
    hd = h / d
    so = fr["s_of"]
    walls = g.walls()
    if walls:
        cD = (interp(hd, [0.25, 1, 5], [0.7, 0.8, 0.8]), 1.0)
        e10 = interp(hd, [0.25, 1, 5], [-0.3, -0.5, -0.7])
        for key, poly, nrm in walls:
            dot = nrm[0] * fr["w"][0] + nrm[1] * fr["w"][1]
            if dot < -0.5:
                for z0, z1, ze in d_bands(h, b):
                    add("wall", "D", clip_poly(poly, lambda p: p[2], z0, z1), cD, ze, zband=(z0, min(z1, h)))
            elif dot > 0.5:
                add("wall", "E", poly, (e10, e10), h)
            else:
                for nm, s0, s1, c in (("A", 0.0, min(e / 5, d), (-1.2, -1.4)),
                                      ("B", e / 5, min(e, d), (-0.8, -1.1)),
                                      ("C", e, d, (-0.5, -0.5))):
                    if s1 - s0 > 1e-9:
                        add("wall", nm, clip_poly(poly, so, s0, s1), c, h, srange=(s0, s1))

    # ---------- dach
    ztop = g.href
    sw, sl = var
    rk = "canopy" if canopy else "roof"

    def R(name, s0, s1, t0, t1, c, factor=1.0):
        """Pole prostokątne w układzie wiatru, rozcięte na połacie; c – krotka lub f(kąt połaci)."""
        s0, t0 = max(0.0, s0), max(0.0, t0)
        s1, t1 = min(s1, d), min(t1, b)
        if s1 - s0 < 1e-9 or t1 - t0 < 1e-9:
            return
        p2 = [fr["to_xy"](s, t) for s, t in ((s0, t0), (s1, t0), (s1, t1), (s0, t1))]
        sh = g.shape
        for sg_ in sh.segs():
            P = clip_poly(p2, lambda p: p[1], sg_[0], sg_[2])
            if P and poly_area(P) > 1e-9:
                ang = sh.seg_angle(sg_)
                cc = c(ang) if callable(c) else c
                pts = [(x, y, sh.rz(x, min(max(y, sg_[0] + 1e-7), sg_[2] - 1e-7))) for x, y in P]
                add(rk, name, pts, cc, ztop, factor, rect=(s0, s1, t0, t1), alpha=ang)

    kind = g.roof_eff
    al = g.p.get("alpha", 0.0)
    if kind == "flat":
        r = g.hp / g.H if g.kind == "flat" and g.H > 0 else 0.0
        F, G, H_, I = (flat_cpe(z, r, sl) for z in ("F", "G", "H", "I"))
        R("F", 0, e / 10, 0, e / 4, F)
        R("F", 0, e / 10, b - e / 4, b, F)
        R("G", 0, e / 10, e / 4, b - e / 4, G)
        R("H", e / 10, e / 2, 0, b, H_)
        R("I", e / 2, d, 0, b, I)
    elif kind == "mono":
        if theta in (0, 180):
            T = T_MONO_0 if theta == 0 else T_MONO_180
            F, G, H_ = (tab_cpe(T, z, al, sw) for z in ("F", "G", "H"))
            R("F", 0, e / 10, 0, e / 4, F)
            R("F", 0, e / 10, b - e / 4, b, F)
            R("G", 0, e / 10, e / 4, b - e / 4, G)
            R("H", e / 10, d, 0, b, H_)
        else:
            mono90_zones(R, e, d, al, 0.0, b)
    elif kind == "duo":
        yr = g.shape.prof[1][0]
        if theta in (0, 180):
            T = T_DUO_0
            F, G, H_ = ((lambda a_, z=z: tab_cpe(T, z, a_, sw)) for z in ("F", "G", "H"))
            I, J = ((lambda a_, z=z: tab_cpe(T, z, a_, sl)) for z in ("I", "J"))
            rr = yr if theta == 0 else g.B - yr
            R("F", 0, min(e / 10, rr), 0, e / 4, F)
            R("F", 0, min(e / 10, rr), b - e / 4, b, F)
            R("G", 0, min(e / 10, rr), e / 4, b - e / 4, G)
            R("H", e / 10, rr, 0, b, H_)
            R("J", rr, min(rr + e / 10, d), 0, b, J)
            R("I", rr + e / 10, d, 0, b, I)
        else:
            duo90_zones(R, e, d, T_DUO_90, 0.0, b)
    elif kind == "trough":
        dep = clamp(al, 5, 45)
        if theta == 0:
            T = T_TROUGH_0
            F, G, H_ = (tab_cpe(T, z, dep, sw, ALPHAS_T) for z in ("F", "G", "H"))
            I, J = (tab_cpe(T, z, dep, sl, ALPHAS_T) for z in ("I", "J"))
            rr = d / 2
            R("F", 0, min(e / 10, rr), 0, e / 4, F)
            R("F", 0, min(e / 10, rr), b - e / 4, b, F)
            R("G", 0, min(e / 10, rr), e / 4, b - e / 4, G)
            R("H", e / 10, rr, 0, b, H_)
            R("J", rr, min(rr + e / 10, d), 0, b, J)
            R("I", rr + e / 10, d, 0, b, I)
        else:
            duo90_zones(R, e, d, T_TROUGH_90, 0.0, b, alphas=ALPHAS_T, fixed=dep)
    elif kind == "hip":
        hip_zones(g, fr, e, d, b, theta, sw, add, ztop)
    elif kind == "multi":
        multi_zones(g, R, e, b, d, h, theta, sw, sl, info)
    elif kind == "vault":
        fd, hdv = g.p["f"] / g.B, g.H / g.B
        A_, B_, C_ = vault_cpe(fd, hdv)
        Av = A_[0] if (sw == "n" or len(A_) == 1) else A_[-1]
        info["vault"] = (fd, hdv, A_, B_, C_)
        R("A", 0, d / 4, 0, b, (Av, Av))
        R("B", d / 4, 3 * d / 4, 0, b, (B_, B_))
        R("C", 3 * d / 4, d, 0, b, (C_, C_))
    elif kind == "dome":
        dome_zones(g, fr, add, ztop, info, points)
    elif canopy:
        canopy_zones(g, R, b, d, wp["phi"], sw, info)

    # ---------- ciśnienie wewnętrzne (7.2.9) – nie dotyczy wiat
    cpis = [] if canopy else ([0.2, -0.3] if wp["cpi_std"] else [wp["cpi"]])
    qi = qp(g.href)
    for z in zones:
        if not cpis:
            z["wn_min"] = z["wn_max"] = z["we"]
        else:
            nets = [z["we"] - qi * c for c in cpis]
            z["wn_min"], z["wn_max"] = min(nets), max(nets)
    for pt in points:
        pt["we"] = qp(ztop) * pt["cpe"]
        nets = [pt["we"] - qi * c for c in cpis] or [pt["we"]]
        pt["wn_min"], pt["wn_max"] = min(nets), max(nets)
    if canopy:
        info["Fw"] = info["cf"] * qp(ztop) * g.L * g.B
    return dict(vb0=vb0, vb=vb, qb=qb, dens=dens, ze=ztop, ce=ce(ztop), qp=qp(ztop), e=e, b=b, d=d,
                hd=hd, zones=zones, points=points, cpis=cpis, qi=qi, theta=theta, info=info)


def mono90_zones(R, e, d, al, t0, t1, factor=1.0):
    """Dach jednospadowy, θ = 90° (Tabl. 7.3b) – wysoka krawędź po stronie t1."""
    T = T_MONO_90
    R("Flow", 0, e / 10, t0, t0 + e / 4, tab_cpe(T, "Flow", al, "n"), factor)
    R("Fup", 0, e / 10, t1 - e / 4, t1, tab_cpe(T, "Fup", al, "n"), factor)
    if t1 - t0 > e / 2:
        R("G", 0, e / 10, t0 + e / 4, t1 - e / 4, tab_cpe(T, "G", al, "n"), factor)
    R("H", e / 10, e / 2, t0, t1, tab_cpe(T, "H", al, "n"), factor)
    R("I", e / 2, d, t0, t1, tab_cpe(T, "I", al, "n"), factor)


def duo90_zones(R, e, d, T, t0, t1, alphas=ALPHAS, fixed=None):
    """Dach dwuspadowy (lub zagłębiony), θ = 90° (Tabl. 7.4b)."""
    def mk(z):
        if fixed is not None:
            return tab_cpe(T, z, fixed, "n", alphas)
        return lambda a_: tab_cpe(T, z, a_, "n", alphas)
    F, G, H_, I = (mk(z) for z in ("F", "G", "H", "I"))
    R("F", 0, e / 10, t0, t0 + e / 4, F)
    R("F", 0, e / 10, t1 - e / 4, t1, F)
    if t1 - t0 > e / 2:
        R("G", 0, e / 10, t0 + e / 4, t1 - e / 4, G)
    R("H", e / 10, e / 2, t0, t1, H_)
    R("I", e / 2, d, t0, t1, I)


def convex_minus(A, B, eps=1e-7):
    """A minus B dla wielokąta wypukłego A i B = A ∩ półpłaszczyzny (ta sama orientacja wierzchołków).
    Zwraca listę wielokątów – każdy jako jeden obrys (także wklęsły, np. w kształcie „V”)."""
    if not B or poly_area(B) < 1e-12:
        return [A]
    nA = len(A)

    def on_edge(p):
        for i in range(nA):
            a, c = A[i], A[(i + 1) % nA]
            dx, dy = c[0] - a[0], c[1] - a[1]
            L2 = dx * dx + dy * dy
            if L2 < 1e-18:
                continue
            t = ((p[0] - a[0]) * dx + (p[1] - a[1]) * dy) / L2
            if -1e-9 <= t <= 1 + 1e-9:
                qx, qy = a[0] + t * dx, a[1] + t * dy
                if math.hypot(p[0] - qx, p[1] - qy) < eps:
                    return i, t
        return None
    nB = len(B)
    cut = [on_edge(((B[k][0] + B[(k + 1) % nB][0]) / 2, (B[k][1] + B[(k + 1) % nB][1]) / 2)) is None
           for k in range(nB)]
    if not any(cut):
        return []
    if all(cut):
        return [A]
    k0 = next(k for k in range(nB) if not cut[k])
    chains, cur = [], None
    for m in range(1, nB + 1):
        k = (k0 + m) % nB
        if cut[k]:
            if cur is None:
                cur = [B[k]]
            cur.append(B[(k + 1) % nB])
        elif cur is not None:
            chains.append(cur)
            cur = None
    if cur is not None:
        chains.append(cur)
    out = []
    for ch in chains:
        ps, pe = ch[0], ch[-1]
        es, ee = on_edge(ps), on_edge(pe)
        if es is None or ee is None:
            continue
        (i_s, t_s), (i_e, t_e) = es, ee
        if t_s >= 1 - 1e-9:
            i_s, t_s = (i_s + 1) % nA, 0.0
        if t_e <= 1e-9:
            i_e, t_e = (i_e - 1) % nA, 1.0
        walk = []
        if not (i_s == i_e and t_e > t_s):
            i = i_s
            while True:
                i = (i + 1) % nA
                walk.append(A[i])
                if i == i_e:
                    break
        poly = [ps] + walk + [pe] + ch[1:-1][::-1]
        clean = []
        for q in poly:
            if not clean or math.hypot(q[0] - clean[-1][0], q[1] - clean[-1][1]) > 1e-9:
                clean.append(q)
        if len(clean) > 1 and math.hypot(clean[0][0] - clean[-1][0], clean[0][1] - clean[-1][1]) < 1e-9:
            clean.pop()
        if len(clean) >= 3 and poly_area(clean) > 1e-9:
            out.append(clean)
    return out


def hip_zones(g, fr, e, d, b, theta, sw, add, ztop):
    """Dach czterospadowy – Rys. 7.9, Tablica 7.5."""
    sh = g.shape
    al = g.p["alpha"] if theta == 0 else g.p["a90"]
    so, to = fr["s_of"], fr["t_of"]

    def c(z, sign="n"):
        return tab_cpe(T_HIP, z, al, sign)

    def put(name, P, cc, anchor=None):
        if P and poly_area(P) > 1e-9:
            ex = {}
            if anchor:
                ex["anchor"] = (anchor[0], anchor[1], sh.rz(anchor[0], anchor[1]))
            add("roof", name, [(x, y, sh.rz(x, y)) for x, y in P], cc, ztop, alpha=al, **ex)
    def w_eave(hp_, eave):
        """Szerokość pasa przy narożu: e/10 mierzone wzdłuż okapu (Rys. 7.9) → odległość od naroża."""
        hx, hy = hp_[1][0] - hp_[0][0], hp_[1][1] - hp_[0][1]
        ex, ey = eave[1][0] - eave[0][0], eave[1][1] - eave[0][1]
        sn = abs(hx * ey - hy * ex) / ((math.hypot(hx, hy) * math.hypot(ex, ey)) or 1.0)
        return e / 10 * sn

    def side_hips(s):
        """Połać boczna: (naroże nawietrzne, naroże zawietrzne)."""
        hs = sorted(s["hips"], key=lambda hp_: so(centroid(list(hp_))))
        return hs[0], hs[-1]

    def k_width():
        """Szerokość pola K: granica K przechodzi przez punkt, w którym granica pola L
        przecina naroże zawietrzne (Rys. 7.9 – granice L i K stykają się w jednym punkcie)."""
        slopes = sh.slopes()
        lee = next((s for s in slopes if so(centroid(list(s["eave"]))) > d - 1e-6 and s["ridge"]), None)
        if lee is None:
            return None
        fk = line_dist_fn(lee["ridge"][0], lee["ridge"][1], centroid(lee["poly"]))
        ws = []
        for s in slopes:
            se_ = so(centroid(list(s["eave"])))
            if se_ < 1e-6 or se_ > d - 1e-6:
                continue
            hw, hl = side_hips(s)
            fl = line_dist_fn(hw[0], hw[1], centroid(s["poly"]))
            wl = w_eave(hw, s["eave"])
            f0, f1 = fl(hl[0]), fl(hl[1])
            if abs(f1 - f0) < 1e-12:
                continue
            t = (wl - f0) / (f1 - f0)
            t = clamp(t, 0.0, 1.0)
            X = (hl[0][0] + t * (hl[1][0] - hl[0][0]), hl[0][1] + t * (hl[1][1] - hl[0][1]))
            ws.append(max(fk(X), 0.0))
        return max(ws) if ws else None
    wk = k_width()

    for s in sh.slopes():
        poly = s["poly"]
        cen = centroid(poly)
        se = so(centroid(list(s["eave"])))
        if se < 1e-6:                                    # połać nawietrzna
            strip = clip_poly(poly, so, 0, e / 10)
            put("F", clip_poly(strip, to, 0, e / 4), c("F", sw))
            put("F", clip_poly(strip, to, b - e / 4, b), c("F", sw))
            put("G", clip_poly(strip, to, e / 4, b - e / 4), c("G", sw))
            put("H", clip_poly(poly, so, e / 10, 1e9), c("H", sw))
        elif se > d - 1e-6:                              # połać zawietrzna
            rest = poly
            if s["ridge"] and wk:                        # K: pas wzdłuż kalenicy, granica w punkcie styku z L
                fn = line_dist_fn(s["ridge"][0], s["ridge"][1], cen)
                put("K", clip_poly(rest, fn, -1e-9, wk), c("K"))
                rest = clip_poly(rest, fn, wk, 1e9)
            if rest:                                     # J: przy narożach, docięte do pola K (Rys. 7.9)
                strips = [(line_dist_fn(hp_[0], hp_[1], cen), w_eave(hp_, s["eave"])) for hp_ in s["hips"]]
                inner = rest
                for fn, wj in strips:
                    inner = clip_poly(inner, fn, wj, 1e9)
                pieces = convex_minus(rest, inner)
                for pc in pieces:                         # pasy stykające się – jeden obrys pola J
                    anc = None
                    if len(pieces) == 1 and len(strips) > 1:
                        sp_ = clip_poly(rest, strips[0][0], -1e-9, strips[0][1])
                        anc = area_centroid([(x, y, 0.0) for x, y in sp_])[:2] if sp_ else None
                    put("J", pc, c("J"), anchor=anc)
                put("I", inner, c("I"))
        else:                                            # połacie boczne
            hw = side_hips(s)[0]
            fn = line_dist_fn(hw[0], hw[1], cen)
            wl = w_eave(hw, s["eave"])
            put("L", clip_poly(poly, fn, -1e-9, wl), c("L"))
            rest = clip_poly(poly, fn, wl, 1e9)
            put("M", clip_poly(rest, so, 0, e / 2), c("M"))
            put("N", clip_poly(rest, so, e / 2, 1e9), c("N"))


def multi_zones(g, R, e, b, d, h, theta, sw, sl, info):
    """Dach wielospadowy – 7.2.7, Rys. 7.10 (nawy wzdłuż x, kolejne w kierunku y)."""
    n = g.p["n"]
    w = g.B / n
    al = g.p["alpha"]
    duo = g.p["mtype"] == MULTI_TYPES[0]
    fac = lambda k: 1.0 if k == 0 else (0.8 if k == 1 else 0.6)
    if theta == 90:
        ek = min(w, 2 * h)
        for k in range(n):
            if duo:
                duo90_zones(R, ek, d, T_DUO_90, k * w, (k + 1) * w)
            else:
                mono90_zones(R, ek, d, al, k * w, (k + 1) * w)
        info["multi"] = "θ = 90°: każda nawa jak pojedynczy dach (b = szerokość nawy, 7.2.7(1))."
        return
    if duo:                                              # Rys. 7.10 d
        yr = w / 2
        F, G, H_ = (tab_cpe(T_DUO_0, z, al, sw) for z in ("F", "G", "H"))
        I, J = (tab_cpe(T_DUO_0, z, al, sl) for z in ("I", "J"))
        R("F", 0, min(e / 10, yr), 0, e / 4, F)
        R("F", 0, min(e / 10, yr), b - e / 4, b, F)
        R("G", 0, min(e / 10, yr), e / 4, b - e / 4, G)
        R("H", e / 10, yr, 0, b, H_)
        R("J", yr, min(yr + e / 10, w), 0, b, J)
        R("I", yr + e / 10, w, 0, b, I)
        for k in range(1, n):
            R(f"H·{fac(k):.1f}", k * w, k * w + yr, 0, b, H_, factor=fac(k))
            R(f"I·{fac(k):.1f}", k * w + yr, (k + 1) * w, 0, b, I, factor=fac(k))
        info["multi"] = "Rys. 7.10 d: nawa 1 – cpe, nawa 2 – 0,8·cpe, kolejne – 0,6·cpe; F/G/J tylko na nawie 1."
    else:
        T = T_MONO_0 if theta == 0 else T_MONO_180
        sg_ = sw if theta == 0 else "n"
        F, G, H_ = (tab_cpe(T, z, al, sg_) for z in ("F", "G", "H"))
        R("F", 0, e / 10, 0, e / 4, F)
        R("F", 0, e / 10, b - e / 4, b, F)
        R("G", 0, e / 10, e / 4, b - e / 4, G)
        R("H", e / 10, w, 0, b, H_)
        for k in range(1, n):
            if theta == 0 and sw == "p":
                R("−0,4", k * w, (k + 1) * w, 0, b, (-0.4, -0.4))
            else:
                R(f"H·{fac(k):.1f}", k * w, (k + 1) * w, 0, b, H_, factor=fac(k))
        info["multi"] = ("Rys. 7.10 b: cpe > 0 na 1. nawie → −0,4 na kolejnych; cpe < 0 → 0,8·cpe, 0,6·cpe."
                         if theta == 0 else "Rys. 7.10 a: nawa 1 – cpe, nawa 2 – 0,8·cpe, kolejne – 0,6·cpe.")


def dome_zones(g, fr, add, ztop, info, points):
    """Kopuła – Rys. 7.12: cpe stałe na łukach ⟂ do wiatru, liniowo A → B → C wzdłuż łuku."""
    sh = g.shape
    fd, hdd = sh.f / sh.D, sh.H / sh.D
    A_, B_, C_ = dome_cpe(fd, hdd)
    info["dome"] = (fd, hdd, A_, B_, C_)
    phe = math.asin(clamp(sh.rho / sh.R, -1, 1))

    def cpe_at(p):
        ph = math.asin(clamp((fr["s_of"](p) - sh.rho) / sh.R, -1, 1))
        return interp((ph + phe) / (2 * phe), [0, 0.5, 1], [A_, B_, C_])
    for i, P in enumerate(sh.cap_facets()):
        c = cpe_at(centroid(P))
        ring, sec = divmod(i, sh.ns)
        add("roof", "", P, (c, c), ztop, dome=True, arr=(ring % 2 == 1 and sec % 4 == 0))
    for nm, u, c in (("A", 0.0, A_), ("B", 0.5, B_), ("C", 1.0, C_)):
        s = clamp(sh.rho + sh.R * math.sin(-phe + 2 * phe * u), 0, sh.D)
        xy = fr["to_xy"](s, sh.rho)
        points.append(dict(name=nm, cpe=c, pos=(xy[0], xy[1], sh.rz(*xy))))


def canopy_zones(g, R, b, d, phi, var, info):
    """Wiaty – Tablice 7.6 i 7.7 (cp,net, cf)."""
    a = g.p["alpha"]
    v = var                                    # "max" albo "min"
    if g.kind == "can1":
        T, AL = T_CAN1, CAN1_A
        aa = clamp(a, 0, 30)
    else:
        T, AL = T_CAN2, CAN2_A
        aa = clamp(a, -20, 30)
        if -5 < aa < 0:
            aa = -5.0
        elif 0 <= aa < 5:
            aa = 5.0
    cp = {z: canopy_cp(T, AL, z, aa, phi, v) for z in T}
    info["cf"] = cp.pop("cf")
    info["cf_max"] = canopy_cp(T, AL, "cf", aa, phi, "max")
    info["cf_min"] = canopy_cp(T, AL, "cf", aa, phi, "min")
    info["alpha_used"] = aa
    A_, B_, C_ = ((cp[z], cp[z]) for z in ("A", "B", "C"))
    R("C", 0, d / 10, 0, b, C_)
    R("C", d - d / 10, d, 0, b, C_)
    R("B", d / 10, d - d / 10, 0, b / 10, B_)
    R("B", d / 10, d - d / 10, b - b / 10, b, B_)
    if g.kind == "can1":
        R("A", d / 10, d - d / 10, b / 10, b - b / 10, A_)
    else:
        D_ = (cp["D"], cp["D"])
        R("A", d / 10, d / 2 - d / 10, b / 10, b - b / 10, A_)
        R("D", d / 2 - d / 10, d / 2 + d / 10, b / 10, b - b / 10, D_)
        R("A", d / 2 + d / 10, d - d / 10, b / 10, b - b / 10, A_)


def wind_envelope(g, wp):
    env = {}
    for th in wind_thetas(g):
        for lab, var in wind_variants(g, th):
            r = calc_wind(g, wp, th, var)
            items = [(z["kind"], z["name"], z["we"], z["wn_min"], z["wn_max"]) for z in r["zones"]]
            items += [("roof", p_["name"], p_["we"], p_["wn_min"], p_["wn_max"]) for p_ in r["points"]]
            for kind, name, we, wmin, wmax in items:
                kk = "roof" if kind == "canopy" else kind
                for key, val in ((kk + "_we", we), ("net", wmin), ("net", wmax)):
                    lo, hi = env.get(key, (None, None))
                    item = (val, name or "kopuła", th)
                    if lo is None or val < lo[0]:
                        lo = item
                    if hi is None or val > hi[0]:
                        hi = item
                    env[key] = (lo, hi)
    return env


