    # --- nagłówek
    def _update_info(self):
        ex = self.case["extra"]
        mode = "śnieg" if ex.get("mode") != "wiatr" else "wiatr"
        op = self.case["state"].get("opcje", {})
        shape = op.get("snow_type") if mode == "śnieg" else op.get("wind_type")
        what = f"przypadek ({ex.get('snow_case', 'i')})" if mode == "śnieg" else \
            f"θ = {op.get('theta', '')}" + (f", {op.get('variant')}" if op.get("variant") else "")
        self.info.setText(f"  {mode.capitalize()} · {shape} · {what} · dodano {self.case.get('created', '')}")
        self.name.setText(self.case["name"])

    def _menu(self, pos):
        from PySide6.QtWidgets import QMenu
        m = QMenu(self)
        a1 = m.addAction("Zmień nazwę")
        a2 = m.addAction("Zakończ edycję" if self.app.edited_case() is self.case else "Edytuj")
        a4 = m.addAction("Duplikuj")
        a3 = m.addAction("Usuń")
        act = m.exec(self.mapToGlobal(pos))
        if act is a4:
            self.pw.duplicate_case(self.case)
        if act is a1:
            self.rename()
        elif act is a2:
            self.pw.edit_case(self.case)
        elif act is a3:
            self.pw.delete_case(self.case)

    def rename(self):
        self.name.setVisible(False)
        self.name_edit.setText(self.case["name"])
        self.name_edit.setVisible(True)
        self.name_edit.setFocus()
        self.name_edit.selectAll()

    def _rename_done(self):
        if not self.name_edit.isVisible():
            return
        t = self.name_edit.text().strip()
        self.name_edit.setVisible(False)
        self.name.setVisible(True)
        if t and t != self.case["name"]:
            self.case["name"] = t
            self.name.setText(t)
            self.app.project_changed()

    # --- przeciąganie uchwytem ⠿ (zmiana kolejności): karta przypięta do kursora, pozostałe robią miejsce
    def _drag_press(self, e):
        if e.button() == Qt.MouseButton.LeftButton:
            self._drag_start = e.globalPosition()
            self.handle.setCursor(Qt.CursorShape.ClosedHandCursor)

    def _drag_move(self, e):
        if self._drag_start is None:
            return
        lst = self.pw.list
        if lst.dragging is None:
            if (e.globalPosition() - self._drag_start).manhattanLength() < 4:
                return
            lst.begin_drag(self, self._drag_start)
        lst.drag_to(e.globalPosition())

    def _drag_release(self, e):
        self._drag_start = None
        self.handle.setCursor(Qt.CursorShape.OpenHandCursor)
        if self.pw.list.dragging is self:
            self.pw.list.end_drag()

    # --- rozwijanie
    def toggle(self):
        if self.body is None:
            self._build_body()
            self.btn_exp.setText("▾")
        else:
            self.layout().removeWidget(self.body)
            self.body.hide()
            self.body.deleteLater()
            self.body = None
            self.btn_exp.setText("▸")

    def _build_body(self):
        self.app.ensure_calc(self.case)
        body = QWidget()
        bl = QVBoxLayout(body)
        bl.setContentsMargins(0, 0, 0, 0)
        bl.setSpacing(6)
        bar = QHBoxLayout()
        calc = self.case["_calc"]
        ex = self.case["extra"]
        tg = ex.setdefault("toggles", {})
        # tu tylko widok i wymiary budynku (klik na wymiarze w podglądzie); pozostałe zmiany – przycisk Edytuj
        for key, lab in (("labels3d", "Etykiety"), ("arrows3d", "Strzałki"), ("dims3d", "Wymiary pól"),
                         ("bdims3d", "Wymiary budynku")):
            if key == "arrows3d" and calc["mode"] != "wiatr":
                continue
            ch = QCheckBox(lab)
            ch.setChecked(bool(tg.get(key, True)))
            ch.toggled.connect(lambda on, key=key: self._toggle(key, on))
            bar.addWidget(ch)
        bar.addStretch(1)
        b = QPushButton("Widok domyślny")
        b.clicked.connect(lambda checked=False: self._reset_view())
        bar.addWidget(b)
        bl.addLayout(bar)
        self.canvas = CaseCanvas(self.app, self)
        bl.addWidget(self.canvas)
        self.report = FitBrowser()
        self.report.setOpenLinks(False)
        self.report.setHtml(self.case.get("report", ""))
        bl.addWidget(self.report)
        self.body = body
        self._body_mode = calc["mode"]
        self.layout().addWidget(body)

    def refresh(self):
        """Po przeliczeniu przypadku: nagłówek, raport i model – w tych samych elementach (bez zmiany wysokości
        karty na moment przebudowy, czyli bez mignięcia listy). Inny rodzaj obciążenia – karta od nowa."""
        self._update_info()
        if self.body is None:
            return
        self.app.ensure_calc(self.case)
        if self.case["_calc"]["mode"] != self._body_mode:
            self.layout().removeWidget(self.body)
            self.body.hide()
            self.body.deleteLater()
            self.body = None
            self._build_body()
            return
        self.canvas.view.update({k: v for k, v in (self.case["extra"].get("view") or {}).items() if k in VIEW_KEYS})
        self.canvas._scene_key = None
        self.canvas.redraw()
        self.report.setHtml(self.case.get("report", ""))

    def _toggle(self, key, on):
        self.case["extra"].setdefault("toggles", {})[key] = bool(on)
        self.canvas._scene_key = None
        self.canvas.redraw()
        self.app.project_changed()

    def _reset_view(self):
        th = self.case["_calc"]["wind"]["theta"] if self.case["_calc"]["mode"] == "wiatr" else 0
        self.canvas.view.update(yaw=self.app.default_yaw(th), pitch=math.radians(24), zoom=1.0, pan_x=0.0, pan_y=0.0)
        self.canvas.redraw()
        self.view_changed(self.canvas.view)

    def view_changed(self, view):
        self.case["extra"]["view"] = dict(view)
        self.app.project_changed()

    def edit_value(self, key):
        """Zmiana wymiaru klikniętego na podglądzie – przeliczenie przypadku."""
        from PySide6.QtWidgets import QInputDialog
        keys = key if isinstance(key, tuple) else (key,)
        f = self.app.field_def_state(self.case["state"], keys[0])
        pola = self.case["state"].setdefault("pola", {})
        lab = f[1] if f else keys[0]
        txt, ok = QInputDialog.getText(self, "Zmiana wymiaru", f"{lab} [{f[2] if f else ''}]:",
                                       QLineEdit.EchoMode.Normal, str(pola.get(keys[0], "")))
        if not ok:
            return
        v = parse_num(txt)
        good = v is not None
        if good and f:
            k_, lab_, unit, lo, hi, strict, integer = f
            good = (v > lo if strict else v >= lo) and v <= hi and (not integer or abs(v - round(v)) < 1e-9)
        if not good:
            QMessageBox.warning(self, "Zmiana wymiaru", "Niepoprawna wartość.")
            return
        old = json.loads(json.dumps(self.case["state"]))
        for k_ in keys:
            pola[k_] = txt.strip()
        if not self.app.recapture_case(self.case):
            err = self.case.pop("_err", "") or "Niepoprawna geometria budynku."
            self.case["state"] = old
            self.app.recapture_case(self.case)
            QMessageBox.warning(self, "Zmiana wymiaru", "Nie zmieniono wymiaru:\n" + err)
            return
        self.app.project_changed()
        self.refresh()


class CaseList(QWidget):
    """Kontener kart przypadków. Przeciąganie karty: karta wyjęta z układu podąża za kursorem, w liście
    zostaje puste pole (dropSlot) przesuwane między pozostałymi kartami; puszczenie – karta w miejscu pola."""

    def __init__(self, pw):
        super().__init__()
        self.pw = pw
        self.lay = QVBoxLayout(self)
        self.lay.setContentsMargins(0, 0, 0, 0)
        self.lay.setSpacing(6)
        self.lay.addStretch(1)
        self.dragging = None
        self._slot = None
        self._last = None
        self._scroll_timer = QTimer(self)
        self._scroll_timer.setInterval(30)
        self._scroll_timer.timeout.connect(self._autoscroll)

    def begin_drag(self, card, gpos):
        idx = self.lay.indexOf(card)
        if idx < 0:
            return
        self.dragging = card
        slot = QFrame()
        slot.setObjectName("dropSlot")
        slot.setFixedHeight(card.height())
        geo = card.geometry()
        self.lay.removeWidget(card)                  # karta poza układem – przesuwana ręcznie
        self.lay.insertWidget(idx, slot)
        self._slot = slot
        card.setGeometry(geo)
        card.setProperty("lifted", True)
        card.style().unpolish(card)
        card.style().polish(card)
        card.raise_()
        self._off = self.mapFromGlobal(gpos.toPoint()).y() - geo.y()   # chwyt względem góry karty
        self._last = gpos
        self._scroll_timer.start()

    def drag_to(self, gpos):
        card = self.dragging
        if card is None:
            return
        self._last = gpos
        y_cur = clamp(self.mapFromGlobal(gpos.toPoint()).y(), 0, self.height())
        card.move(card.x(), int(y_cur - self._off))     # karta trzyma się kursora (wysoka może wyjść poza listę)
        # miejsce: przed pierwszą kartą, której środek jest poniżej kursora
        others = [c for c in self.pw.cards if c is not card]
        idx = sum(1 for c in others if c.y() + c.height() / 2 < y_cur)
        if self.lay.indexOf(self._slot) != idx:
            self.lay.removeWidget(self._slot)
            self.lay.insertWidget(idx, self._slot)
            self.lay.activate()                      # pozostałe karty od razu robią miejsce
            card.raise_()

    def _autoscroll(self):
        """Kursor przy górnej / dolnej krawędzi okna listy – przewijanie."""
        if self.dragging is None or self._last is None:
            return
        vp = self.pw.scroll.viewport()
        y = vp.mapFromGlobal(self._last.toPoint()).y()
        m = 40
        d = y - m if y < m else (y - (vp.height() - m) if y > vp.height() - m else 0)
        if d:
            sb = self.pw.scroll.verticalScrollBar()
            v = sb.value()
            sb.setValue(v + int(clamp(d, -m, m) / 2) or (1 if d > 0 else -1))
            if sb.value() != v:
                self.drag_to(self._last)

    def end_drag(self):
        card, self.dragging = self.dragging, None
        self._scroll_timer.stop()
        if card is None:
            return
        idx = self.lay.indexOf(self._slot)
        self.lay.removeWidget(self._slot)
        self._slot.hide()
        self._slot.deleteLater()
        self._slot = None
        card.setProperty("lifted", False)
        card.style().unpolish(card)
        card.style().polish(card)
        self.lay.insertWidget(idx, card)
        self.pw.place_case(card, idx)

    def paintEvent(self, ev):
        """Pusty projekt: znak wodny – napis KAYENN w prawym dolnym rogu."""
        if getattr(self.pw, "cards", None):
            return
        r = wordmark_renderer()
        if r is None:
            return
        vb = r.viewBoxF()
        w = min(300.0, self.width() * 0.45)
        h = w * vb.height() / vb.width()
        m, th = 24, 0
        dpr = self.devicePixelRatioF()
        key = (round(w), dpr)
        if getattr(self, "_wm_key", None) != key:    # napis najpierw do obrazu – inaczej warstwy cienia
            from PySide6.QtGui import QImage          # nakładałyby przezroczystość jedna na drugą
            img = QImage(int(w * dpr) + 1, int(h * dpr) + 1, QImage.Format.Format_ARGB32_Premultiplied)
            img.fill(Qt.GlobalColor.transparent)
            q = QPainter(img)
            q.setRenderHint(QPainter.RenderHint.Antialiasing)
            r.render(q, QRectF(0, 0, w * dpr, h * dpr))
            q.end()
            img.setDevicePixelRatio(dpr)
            self._wm_key, self._wm_img = key, img
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        p.setOpacity(0.14)
        p.drawImage(QPointF(self.width() - w - m, self.height() - h - th - m), self._wm_img)
        p.end()


class ProjectWindow(QWidget):
    """Okno główne (wewnętrznie: KAYENN Main) – pierwsze okno po uruchomieniu: menu Plik (nowy, otwórz, zapisz),
    lista przypadków (najmłodszy na górze), Otwórz / Zamknij obciążenia normowe, Drukuj.
    Zamknięcie okna kończy program (jak Plik → Zakończ)."""

    def __init__(self, app):
        super().__init__(None, Qt.WindowType.Window)
        self.app = app
        self.setObjectName("page")
        self.setWindowTitle("KAYENN")
        self.resize(1100, 860)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(10, 10, 10, 10)
        lay.setSpacing(8)
        from PySide6.QtWidgets import QMenuBar
        mb = QMenuBar(self)
        app.file_menu(mb, project=True)
        lay.setMenuBar(mb)
        self.menu_bar = mb
        self.empty = QLabel("Projekt nie zawiera przypadków. Otwórz obciążenia normowe i dodaj przypadek "
                            "przyciskiem „Dodaj do projektu”.")
        self.empty.setObjectName("muted")
        lay.addWidget(self.empty)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setFrameShape(QFrame.Shape.NoFrame)
        self.list = CaseList(self)
        sc.setWidget(self.list)
        self.scroll = sc
        self._hold = None
        sc.verticalScrollBar().rangeChanged.connect(self._apply_hold)
        lay.addWidget(sc, 1)
        hb = QHBoxLayout()
        b1 = QPushButton("Otwórz obciążenia normowe")
        b1.setObjectName("big")
        self.btn_codes = b1
        b1.clicked.connect(lambda checked=False: self.app.toggle_codes())
        b2 = QPushButton("Drukuj")
        b2.setObjectName("big")
        b2.clicked.connect(lambda checked=False: self.app.print_project())
        hb.addWidget(b1, 1)
        hb.addWidget(b2, 1)
        lay.addLayout(hb)
        self.cards = []

    def rebuild(self, keep_open=True):
        """Karty od nowa (po dodaniu / edycji przypadku). keep_open – rozwinięte karty zostają rozwinięte
        (i lista w tym samym miejscu); False – po otwarciu pliku / nowym projekcie: wszystko zwinięte."""
        opened = {c.case.get("id") for c in self.cards if c.body is not None} if keep_open else set()
        sb = self.scroll.verticalScrollBar()
        pos = sb.value() if keep_open else 0
        for c in self.cards:
            self.list.lay.removeWidget(c)
            c.hide()
            c.deleteLater()
        self.cards = []
        for case in self.app.project["cases"]:
            card = CaseCard(self, case)
            self.list.lay.insertWidget(self.list.lay.count() - 1, card)
            self.cards.append(card)
            if case.get("id") in opened:
                card.toggle()
        self.empty.setVisible(not self.cards)
        if pos:
            self.list.lay.activate()
            QTimer.singleShot(0, lambda: sb.setValue(pos))
        self.list.update()                           # znak wodny pustego projektu
        self.update_buttons()

    def keep_view(self, fn):
        """fn() zmienia karty – lista zostaje w tym samym miejscu: zapamiętana karta widoczna u góry i jej
        przesunięcie; przywracane od razu i po ułożeniu (raporty i podglądy ustalają wysokość z opóźnieniem)."""
        sb = self.scroll.verticalScrollBar()
        v = sb.value()
        anchor = next((c for c in self.cards if c.y() + c.height() > v), None)
        off = v - anchor.y() if anchor is not None else 0
        fn()
        if anchor is None:
            return
        # przez chwilę każda zmiana długości listy (karta bez zawartości, raport ustala wysokość) – ta sama karta
        # w tym samym miejscu; inaczej pasek przewijania „spada” na koniec skróconej na moment listy
        self._hold = (anchor, off, time.monotonic() + 1.2)
        self.list.lay.activate()
        self._apply_hold()
        for ms in (0, 100, 400, 1250):
            QTimer.singleShot(ms, self._apply_hold)

    def _apply_hold(self, *args):
        h = getattr(self, "_hold", None)
        if not h:
            return
        anchor, off, until = h
        if time.monotonic() > until or anchor not in self.cards:
            self._hold = None
            return
        self.scroll.verticalScrollBar().setValue(anchor.y() + off)

    def refresh_cases(self, cases=None):
        """Po zmianie przypadków: tylko ich karty (rozwinięte zostają rozwinięte, lista w tym samym miejscu).
        cases=None – wszystkie karty."""
        def fn():
            for c in self.cards:
                if cases is None or c.case in cases or c.case.get("_calc") is None:
                    c.refresh()
        self.keep_view(fn)
        self.update_buttons()

    def insert_case(self, case):
        """Nowy przypadek – nowa karta (zwinięta) bez przebudowy pozostałych."""
        idx = self.app.project["cases"].index(case)

        def fn():
            card = CaseCard(self, case)
            self.list.lay.insertWidget(idx, card)
            self.cards.insert(idx, card)
        self.keep_view(fn)
        self.empty.setVisible(not self.cards)
        self.list.update()
        self.update_buttons()

    def update_buttons(self):
        """Napisy przycisków zależne od okna obciążeń normowych i edytowanego przypadku."""
        app = self.app
        self.btn_codes.setText("Zamknij obciążenia normowe" if app.win.isVisible() else "Otwórz obciążenia normowe")
        ed = app.edited_case()
        for c in self.cards:
            c.btn_edit.setText("Zakończ edycję" if ed is c.case else "Edytuj")

    def card_of(self, case):
        return next((c for c in self.cards if c.case is case), None)

    def move_case(self, cid, idx):
        cases = self.app.project["cases"]
        i = next((k for k, c in enumerate(cases) if c["id"] == cid), None)
        if i is None:
            return
        case = cases.pop(i)
        if idx > i:
            idx -= 1
        cases.insert(idx, case)
        card = self.cards.pop(i)
        self.cards.insert(idx, card)
        self.list.lay.removeWidget(card)
        self.list.lay.insertWidget(idx, card)
        self.app.project_changed()

    def place_case(self, card, idx):
        """Po przeciągnięciu: karta (już w układzie na pozycji idx) – ta sama kolejność w projekcie."""
        old = self.cards.index(card)
        if old == idx:
            return
        self.cards.insert(idx, self.cards.pop(old))
        cases = self.app.project["cases"]
        cases.remove(card.case)
        cases.insert(idx, card.case)
        self.app.project_changed()

    def edit_case(self, case):
        """Edytuj – przypadek w oknie obciążeń normowych; drugi klik (Zakończ edycję) – koniec edycji.
        Lista zostaje w tym samym miejscu."""
        if self.app.edited_case() is case:
            self.keep_view(lambda: self.app.editor.close_codes())
        else:
            self.keep_view(lambda: self.app.edit_case(case))

    def duplicate_case(self, case):
        """Duplikuj – kopia przypadku tuż pod nim, nazwa z dopiskiem „ - kopia”."""
        from datetime import datetime
        proj = self.app.project
        n = proj["next"]
        proj["next"] = n + 1
        cp = json.loads(json.dumps({k: case.get(k) for k in ("state", "extra", "report")}, default=str))
        cp.update(id=n, name=f"{case['name']} - kopia", created=datetime.now().strftime("%Y-%m-%d %H:%M"),
                  _calc=case.get("_calc"))
        proj["cases"].insert(proj["cases"].index(case) + 1, cp)
        self.insert_case(cp)
        self.app.project_changed()

    def delete_case(self, case):
        B = QMessageBox.StandardButton
        if QMessageBox.question(self, "Usuń przypadek", f"Usunąć „{case['name']}” z projektu?",
                                B.Yes | B.No, B.No) != B.Yes:
            return
        self.app.project["cases"].remove(case)
        card = self.card_of(case)
        if card is not None:
            self.cards.remove(card)
            self.list.lay.removeWidget(card)
            card.hide()
            card.deleteLater()
        if self.app.edited_case() is case:
            self.app.end_editor(save=False)
        self.empty.setVisible(not self.cards)
        self.list.update()
        self.app.project_changed()

    def closeEvent(self, e):
        if self.app.quit_app():                      # zamknięcie okna głównego = koniec programu
            e.accept()
        else:
            e.ignore()


