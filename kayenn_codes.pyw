class Tree(QTreeWidget):
    """Tabela wyników (interfejs zgodny z dotychczasowym kodem: delete / insert)."""

    def __init__(self, heads, widths, stretch_col, left_cols):
        super().__init__()
        self.setColumnCount(len(heads))
        self.setHeaderLabels(list(heads))
        self.setRootIsDecorated(False)
        self.setUniformRowHeights(True)
        self.setSelectionMode(QAbstractItemView.SelectionMode.NoSelection)
        self.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self._left = set(left_cols)
        hd = self.header()
        hd.setStretchLastSection(False)
        hd.setDefaultAlignment(Qt.AlignmentFlag.AlignCenter)
        for i, w in enumerate(widths):
            self.setColumnWidth(i, int(w * 1.15))
            hd.setSectionResizeMode(i, QHeaderView.ResizeMode.Stretch if i == stretch_col
                                    else QHeaderView.ResizeMode.Interactive)
        self._sv = 0

    def get_children(self):
        return ()

    def delete(self, *a):
        self._sv = self.verticalScrollBar().value()
        self.setUpdatesEnabled(False)
        self.clear()
        QTimer.singleShot(0, self._restore)

    def _restore(self):
        self.verticalScrollBar().setValue(self._sv)
        self.setUpdatesEnabled(True)

    def insert(self, parent, index, values=(), tags=()):
        it = QTreeWidgetItem([str(v) for v in values])
        col = None
        if "neg" in tags:
            col = QColor("#1d4ed8")
        elif "pos" in tags:
            col = QColor("#b91c1c")
        for c in range(len(values)):
            it.setTextAlignment(c, AL_L if c in self._left else AL_R)
            if col is not None:
                it.setForeground(c, QBrush(col))
            if "sep" in tags:
                it.setBackground(c, QBrush(QColor("#f1f3f5")))
        if "sep" in tags:
            f = it.font(0)
            f.setBold(True)
            it.setFont(0, f)
        self.addTopLevelItem(it)


