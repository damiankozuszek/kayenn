SNOW_ZONES = {   # Tablica NA.1
    "1": ("0,007·A − 1,4;  sₖ ≥ 0,70", lambda A: max(0.007 * A - 1.4, 0.70)),
    "2": ("0,9", lambda A: 0.9),
    "3": ("0,006·A − 0,6;  sₖ ≥ 1,2", lambda A: max(0.006 * A - 0.6, 1.2)),
    "4": ("1,6", lambda A: 1.6),
    "5": ("0,93·exp(0,00134·A);  sₖ ≥ 2,0", lambda A: max(0.93 * math.exp(0.00134 * A), 2.0)),
}
SNOW_CE = {      # Tablica 5.1
    "Wystawiony na działanie wiatru": (0.8, "Płaskie obszary bez przeszkód, otwarte ze wszystkich stron, "
                                            "bez osłon lub z niewielkimi osłonami (teren, budowle, drzewa)."),
    "Normalny": (1.0, "Brak znaczącego przenoszenia śniegu przez wiatr z powodu ukształtowania terenu, "
                      "innych budowli lub drzew."),
    "Osłonięty": (1.2, "Budowla znacznie niższa niż otaczający teren albo otoczona wysokimi drzewami "
                       "lub wyższymi budowlami."),
}
CT_MODES = ("Cₜ = 1,0 (przypadek ogólny)", "Cₜ wg wzoru NA.1 (U > 1 W/m²K)")
OBST_TYPES = ("Attyka na obwodzie dachu", "Ścianka / przeszkoda w poprzek dachu")


def mu1(alpha, guard=False):
    """Tablica 5.2 – μ1."""
    if alpha <= 30:
        m = 0.8
    elif alpha < 60:
        m = 0.8 * (60 - alpha) / 30
    else:
        m = 0.0
    return max(m, 0.8) if guard else m


def mu2_valley(a1, a2):
    """Tablica 5.2 – μ2 dla kosza; NA.9: połać > 60° → 1,6."""
    if a1 > 60 or a2 > 60:
        return 1.6
    ab = (a1 + a2) / 2
    return 0.8 + 0.8 * ab / 30 if ab <= 30 else 1.6


def snow_ct(sk, U, ti):
    if ti <= 5:
        return 1.0, "tᵢ ≤ 5 °C → Cₜ = 1,0"
    note = ""
    if ti > 18:
        ti, note = 18.0, "tᵢ > 18 °C → przyjęto 18 °C"
    s = math.sin(math.radians(57.3 * (0.4 * U - 0.1)))
    ct = 1 - 0.054 * (sk / 3.5) ** 0.25 * (ti - 5) * max(s, 0) ** 0.25
    return max(ct, 0.0), note


class Solid:
    """Dodatkowa bryła (przybudówka, zadaszenie, attyka, przeszkoda) – ściany [(P, n)] i powierzchnie
    dachowe [P] w układzie globalnym."""

    def __init__(self, walls, roofs, fill=WALL_COL, out=WALL_OUT, rfill=ROOF_COL, rout=ROOF_OUT):
        self.walls, self.roofs = walls, roofs
        self.fill, self.out, self.rfill, self.rout = fill, out, rfill, rout
        self.h_top = max(q[2] for P in [w for w, _ in walls] + roofs for q in P)


def box_faces(x0, x1, y0, y1, zb0, zb1, zt):
    """Prostopadłościan wzdłuż x; spód w y0 na wysokości zb0, w y1 – zb1 (np. na połaci), góra pozioma zt."""
    return [([(x0, y0, zb0), (x1, y0, zb0), (x1, y0, zt), (x0, y0, zt)], (0, -1, 0)),
            ([(x1, y1, zb1), (x0, y1, zb1), (x0, y1, zt), (x1, y1, zt)], (0, 1, 0)),
            ([(x0, y0, zt), (x1, y0, zt), (x1, y1, zt), (x0, y1, zt)], (0, 0, 1)),
            ([(x0, y1, zb1), (x0, y0, zb0), (x0, y0, zt), (x0, y1, zt)], (-1, 0, 0)),
            ([(x1, y0, zb0), (x1, y1, zb1), (x1, y1, zt), (x1, y0, zt)], (1, 0, 0))]


OBST_FILL, OBST_OUT = "#7d8796", "#3b424d"
SNOW_ALPHA = 185                     # krycie warstwy śniegu (0–255) – widać przeszkody i połacie pod śniegiem
TW_OBST = 0.25                       # grubość ścianki / przeszkody / attyki [m]


class SnowGeo:
    """Budynek dla obliczeń śniegu."""

    def __init__(self, kind, p):
        self.kind, self.p = kind, p
        L, B, H = p["L"], p["B"], p["H"]
        self.L, self.B, self.H = L, B, H
        self.upper = None
        self.a1 = self.a2 = 0.0
        if kind in ("flat", "obst"):
            self.main = Prism(L, B, prof_flat(B, H))
        elif kind == "mono":
            self.a1 = self.a2 = p["alpha"]
            self.main = Prism(L, B, prof_mono(B, H, p["alpha"]))
        elif kind == "duo":
            self.a1, self.a2 = p["alpha"], p["alpha2"]
            self.main = Prism(L, B, prof_duo(B, H, self.a1, self.a2))
        elif kind == "multi":
            self.a1, self.a2 = p["alpha"], p["alpha2"]
            self.main = Prism(L, B, prof_multi_duo(B, H, p["n"], self.a1, self.a2))
        elif kind == "vault":
            self.main = Prism(L, B, prof_vault(B, H, p["f"]))
        elif kind == "abut":
            self.main = Prism(L, B, prof_flat(B, H))
            Hu = H + p["dh"]
            self.upper = Prism(L, p["b1"], prof_duo(p["b1"], Hu, p["aup"], p["aup"]), oy=-p["b1"])
        # elementy dla zasp wyjątkowych (Załącznik B) – tylko przy włączonej opcji „Wyjątkowe”
        self.exc = p.get("exc")
        self.solids = []
        self.annex = self.canopy = None
        self.eave_par = []               # attyki przy okapach: (y krawędzi, kierunek w głąb dachu ±1)
        self.gable_par = []              # attyki na ścianach szczytowych: (x ściany, kierunek w głąb dachu ±1)
        self.obst_y = None               # przeszkoda na połaci: położenie y
        self.keepout = []                # prostokąty (x0, x1, y0, y1) zajęte przez attyki / przeszkody – bez śniegu
        e = self.exc
        if e and kind == "abut" and e.get("annex"):   # przybudówka z dachem dwuspadowym (Rys. B2) po drugiej stronie
            w, d, a = min(e["xw"], L), e["xd"], e["xa"]
            he = H + p["dh"] - e["xh"]          # h – różnica wysokości okapów (jak na Rys. B2)
            x0, x1, xm = (L - w) / 2, (L + w) / 2, L / 2
            yb = -p["b1"]
            ya = yb - d
            zr = he + w / 2 * math.tan(math.radians(a))
            walls = [([(x0, yb, 0), (x0, ya, 0), (x0, ya, he), (x0, yb, he)], (-1, 0, 0)),
                     ([(x1, ya, 0), (x1, yb, 0), (x1, yb, he), (x1, ya, he)], (1, 0, 0)),
                     ([(x1, ya, 0), (x0, ya, 0), (x0, ya, he), (xm, ya, zr), (x1, ya, he)], (0, -1, 0))]
            roofs = [[(x0, ya, he), (x0, yb, he), (xm, yb, zr), (xm, ya, zr)],
                     [(xm, ya, zr), (xm, yb, zr), (x1, yb, he), (x1, ya, he)]]
            self.annex = Solid(walls, roofs)
            self.annex.g = dict(x0=x0, x1=x1, xm=xm, ya=ya, yb=yb, he=he, zr=zr, w=w, d=d, a=a)
            self.solids.append(self.annex)
        self.fobst = None
        if e and kind == "flat" and e.get("fobst"):   # przeszkoda na środku dachu płaskiego (Rys. B3)
            w, d = min(e["fw"], L), min(e["fd"], B)
            x0, y0 = (L - w) / 2, (B - d) / 2
            self.fobst = Solid(box_faces(x0, x0 + w, y0, y0 + d, H, H, H + e["fh"]), [],
                               fill=OBST_FILL, out=OBST_OUT)
            self.fobst.g = dict(x0=x0, x1=x0 + w, y0=y0, y1=y0 + d, h=e["fh"])
            self.keepout.append((x0, x0 + w, y0, y0 + d))
            self.solids.append(self.fobst)
        if e and e.get("canopy"):        # zadaszenie nad drzwiami / rampą (Rys. B3) – na ścianie podłużnej y = B
            w, c = min(e["cw"], L), e["cb"]
            hedge = self.main.rz(0, B) + (p["hob"] if kind == "obst" and p.get("otype") == OBST_TYPES[0] else 0.0)
            if kind in ("duo", "vault") and e.get("epar"):
                hedge += e["pah"]               # attyka przy okapie y = B
            hc = hedge - e["ch"]                # h – odległość zadaszenia od krawędzi dachu (Rys. B3)
            x0, x1, t = (L - w) / 2, (L + w) / 2, 0.15
            fs = box_faces(x0, x1, B, B + c, hc - t, hc - t, hc)
            self.canopy = Solid([f for f in fs if f[1] != (0, 0, 1)], [f[0] for f in fs if f[1] == (0, 0, 1)],
                                fill=OBST_FILL, out=OBST_OUT, rfill="#cbd5e1", rout=OBST_OUT)
            self.canopy.g = dict(x0=x0, x1=x1, c=c, hc=hc, w=w, hedge=hedge, yw=B)
            self.solids.append(self.canopy)
        self.inner_x = (TW_OBST, L - TW_OBST) if (e and e.get("gpar")) else (0.0, L)
        if e and kind in ("mono", "duo", "multi", "vault"):
            pr = self.main
            if e.get("epar"):            # attyka przy okapie (Rys. B4) – lico zewnętrzne w licu ściany
                edges = [(0.0, 1)] if kind == "mono" else [(0.0, 1), (B, -1)]
                gx0, gx1 = (TW_OBST, L - TW_OBST) if e.get("gpar") else (0.0, L)   # docięte do attyk szczytowych
                for ye, dr in edges:
                    z0 = pr.rz(0, ye)
                    ya, yb = (ye, ye + TW_OBST) if dr > 0 else (ye - TW_OBST, ye)
                    self.solids.append(Solid(box_faces(gx0, gx1, ya, yb, pr.rz(0, ya), pr.rz(0, yb), z0 + e["pah"]), [],
                                             fill=OBST_FILL, out=OBST_OUT))
                    self.eave_par.append((ye, dr))
                    self.keepout.append((0.0, L, ya, yb))
            if e.get("gpar"):            # attyki na ścianach szczytowych – wzdłuż profilu dachu, w licu ściany
                hg = e["gah"]
                for gx, dr in ((0.0, 1), (L, -1)):
                    xa, xb = (gx, gx + TW_OBST) if dr > 0 else (gx - TW_OBST, gx)
                    fs = []
                    segs_ = [(y0, z0, y1, z1) for (y0, z0), (y1, z1) in zip(pr.prof, pr.prof[1:]) if y1 - y0 > 1e-9]
                    for y0, z0, y1, z1 in segs_:
                        fs += [([(xa, y1, z1), (xa, y0, z0), (xa, y0, z0 + hg), (xa, y1, z1 + hg)], (-1, 0, 0)),
                               ([(xb, y0, z0), (xb, y1, z1), (xb, y1, z1 + hg), (xb, y0, z0 + hg)], (1, 0, 0)),
                               ([(xa, y0, z0 + hg), (xb, y0, z0 + hg), (xb, y1, z1 + hg), (xa, y1, z1 + hg)], None)]
                    ya, za = pr.prof[0]
                    yb, zb = pr.prof[-1]
                    fs += [([(xa, ya, za), (xb, ya, za), (xb, ya, za + hg), (xa, ya, za + hg)], (0, -1, 0)),
                           ([(xb, yb, zb), (xa, yb, zb), (xa, yb, zb + hg), (xb, yb, zb + hg)], (0, 1, 0))]
                    fs = [(P_, n_ if n_ else unit(newell(P_)) if unit(newell(P_))[2] >= 0
                           else tuple(-v for v in unit(newell(P_)))) for P_, n_ in fs]
                    self.solids.append(Solid(fs, [], fill=OBST_FILL, out=OBST_OUT))
                    self.gable_par.append((gx, dr))
                    self.keepout.append((xa, xb, 0.0, B))
            if e.get("pobst"):           # przeszkoda na połaci (Rys. B3) – długość l, na środku dachu
                yo = e["poy"]
                za, zb = pr.rz(0, yo), pr.rz(0, yo + TW_OBST)
                gx0, gx1 = self.inner_x
                lo = min(e["pol"], gx1 - gx0)
                ox0, ox1 = (L - lo) / 2, (L + lo) / 2
                self.solids.append(Solid(box_faces(ox0, ox1, yo, yo + TW_OBST, za, zb, max(za, zb) + e["poh"]), [],
                                         fill=OBST_FILL, out=OBST_OUT))
                self.obst_y, self.obst_x = yo, (ox0, ox1)
                self.keepout.append((ox0, ox1, yo, yo + TW_OBST))
        self.h_top = max([self.main.h_top, self.upper.h_top if self.upper else 0] +
                         [so.h_top for so in self.solids])


def segs_to_patches(pr, segs):
    """Odcinki obciążenia (y0, y1, μ0, μ1, opis) → płaty na dachu (μ liniowe w y)."""
    out = []
    ys = [y + pr.oy for y, _ in pr.prof]
    for y0, y1, m0, m1, lab in segs:
        if y1 - y0 < 1e-9:
            continue
        br = sorted({y0, y1} | {y for y in ys if y0 + 1e-9 < y < y1 - 1e-9})
        mid = (y0 + y1) / 2
        done = False
        for ya, yb in zip(br, br[1:]):
            ma = m0 + (m1 - m0) * (ya - y0) / (y1 - y0)
            mb = m0 + (m1 - m0) * (yb - y0) / (y1 - y0)
            za, zb = pr.rz(0, ya + 1e-9), pr.rz(0, yb - 1e-9)
            poly = [(0, ya, za), (pr.L, ya, za), (pr.L, yb, zb), (0, yb, zb)]
            put = (not done) and ya - 1e-9 <= mid <= yb + 1e-9
            done = done or put
            out.append(dict(poly=poly, mu=[ma, ma, mb, mb], label=lab if put else None, seg=(m0, m1)))
    return out


def calc_snow(sg, sp):
    sk = SNOW_ZONES[sp["zone"]][1](sg.p["A"])
    Ce = SNOW_CE[sp["ce"]][0]
    ct_note = ""
    Ct = 1.0
    if sp["ct_formula"]:
        Ct, ct_note = snow_ct(sk, sp["U"], sp["ti"])
    base = Ce * Ct * sk
    g, p, pr, B = sp["guard"], sg.p, sg.main, sg.B
    cases, params, notes, extra, eaves = [], [], [], [], []
    m2 = ls = 0.0

    if sg.kind in ("flat", "mono"):
        a = 0.0 if sg.kind == "flat" else sg.a1
        m = mu1(a, g)
        params.append(f"α = {f2(a, 1)}° → μ₁ = {f2(m, 3)}")
        cases.append(("i", [(0, B, m, m, "dach" if sg.kind == "flat" else "połać")]))
        eaves = [("all" if sg.kind == "flat" else "y0", m)]
    elif sg.kind == "duo":
        yr = pr.prof[1][0]
        m1, m2_ = mu1(sg.a1, g), mu1(sg.a2, g)
        params.append(f"α₁ = {f2(sg.a1, 1)}° → μ₁ = {f2(m1, 3)}    α₂ = {f2(sg.a2, 1)}° → μ₁ = {f2(m2_, 3)}")
        cases += [("i", [(0, yr, m1, m1, "połać 1"), (yr, B, m2_, m2_, "połać 2")]),
                  ("ii", [(0, yr, .5 * m1, .5 * m1, "połać 1"), (yr, B, m2_, m2_, "połać 2")]),
                  ("iii", [(0, yr, m1, m1, "połać 1"), (yr, B, .5 * m2_, .5 * m2_, "połać 2")])]
        eaves = [("y0", m1), ("yB", m2_)]
        notes.append("(i) – równomierne; (ii), (iii) – nierównomierne (Rys. 5.3).")
    elif sg.kind == "multi":
        n = p["n"]
        w = B / n
        yr = ridge_pos(w, sg.a1, sg.a2)
        m1, m2_ = mu1(sg.a1, g), mu1(sg.a2, g)
        mv = mu2_valley(sg.a1, sg.a2)
        params.append(f"μ₁(α₁) = {f2(m1, 3)},  μ₁(α₂) = {f2(m2_, 3)},  ᾱ = {f2((sg.a1 + sg.a2) / 2, 1)}° "
                      f"→ μ₂(ᾱ) = {f2(mv, 3)}")
        ci = []
        for k in range(n):
            ci += [(k * w, k * w + yr, m1, m1, f"nawa {k + 1}, połać 1"),
                   (k * w + yr, (k + 1) * w, m2_, m2_, f"nawa {k + 1}, połać 2")]
        cii = [(0, yr, m1, m1, "połać skrajna 1")]
        for k in range(1, n):
            rl, v, rr = (k - 1) * w + yr, k * w, k * w + yr
            cii += [(rl, v, m1, mv, f"kosz {k} – narastanie"), (v, rr, mv, m2_, f"kosz {k} – opadanie")]
        cii.append(((n - 1) * w + yr, B, m2_, m2_, "połać skrajna 2"))
        cases += [("i", ci), ("ii", cii)]
        eaves = [("y0", m1), ("yB", m2_)]
        notes.append("(ii) – zaspy we wszystkich koszach jednocześnie (Rys. 5.4); NA.9: połać > 60° → μ₂ = 1,6.")

    elif sg.kind == "vault":
        f = p["f"]
        R = (f * f + (B / 2) ** 2) / (2 * f)
        ls = 2 * min(R * math.sin(math.radians(60)), B / 2)
        yl = B / 2 - ls / 2
        m3 = min(0.2 + 10 * f / B, 2.0)
        params.append(f"h/b = {f2(f / B, 3)} → μ₃ = 0,2 + 10·h/b = {f2(m3, 3)} (≤ 2,0)")
        params.append(f"lₛ (część dachu o β ≤ 60°) = {f2(ls)} m")
        q = [yl + ls * i / 4 for i in range(5)]
        cases += [("i", [(yl, yl + ls, 0.8, 0.8, "dach (β ≤ 60°)")]),
                  ("ii", [(q[0], q[1], 0, .5 * m3, "ćwiartka 1"), (q[1], q[2], .5 * m3, 0, "ćwiartka 2"),
                          (q[2], q[3], 0, m3, "ćwiartka 3"), (q[3], q[4], m3, 0, "ćwiartka 4")]),
                  ("iii", [(q[0], q[1], 0, m3, "ćwiartka 1"), (q[1], q[2], m3, 0, "ćwiartka 2"),
                           (q[2], q[3], 0, .5 * m3, "ćwiartka 3"), (q[3], q[4], .5 * m3, 0, "ćwiartka 4")])]
        notes.append("Rys. 5.6: (ii) i (iii) – zaspy nierównomierne (wiatr z jednej lub z drugiej strony); "
                     "dla β > 60° μ₃ = 0.")
    elif sg.kind == "abut":
        h, b1, b2, au = p["dh"], p["b1"], B, p["aup"]
        ls = clamp(2 * h, 5, 15)
        muw_raw = (b1 + b2) / (2 * h)
        muw = clamp(min(muw_raw, 2.0 * h / sk), 0.8, 4.0)
        mus = 0.0 if au <= 15 else 0.5 * mu1(au) * b1 / ls
        m2 = mus + muw
        params.append(f"μw = (b₁+b₂)/2h = {f2(muw_raw, 3)};  γh/sₖ = {f2(2 * h / sk, 3)};  0,8 ≤ μw ≤ 4  →  "
                      f"μw = {f2(muw, 3)}")
        params.append(f"μₛ = {f2(mus, 3)}  →  μ₂ = μₛ + μw = {f2(m2, 3)};   lₛ = 2h = {f2(ls)} m (5…15 m)")
        if b2 >= ls:
            cii = [(0, ls, m2, 0.8, "zaspa przy ścianie"), (ls, b2, 0.8, 0.8, "dach niższy")]
        else:
            cii = [(0, b2, m2, m2 + (0.8 - m2) * b2 / ls, "zaspa (ucięta, b₂ < lₛ)")]
        cases += [("i", [(0, b2, 0.8, 0.8, "dach niższy")]), ("ii", cii)]
        mu_up = mu1(au, g)
        extra = segs_to_patches(sg.upper, [(-b1, -b1 / 2, mu_up, mu_up, "dach wyższy"),
                                           (-b1 / 2, 0, mu_up, mu_up, "dach wyższy")])
        for pt in extra[1:]:
            pt["label"] = None
        notes.append("μₛ: 50% obciążenia przyległej połaci dachu wyższego (b₁/2) rozłożone trójkątnie na lₛ.")
        notes.append("Dach wyższy pokazano z obciążeniem równomiernym μ₁(α).")

    elif sg.kind == "obst":
        h = p["hob"]
        m2 = clamp(2.0 * h / sk, 0.8, 2.0)
        ls = clamp(2 * h, 5, 15)
        params.append(f"μ₁ = 0,8;  μ₂ = γh/sₖ = {f2(2 * h / sk, 3)} → {f2(m2, 3)} (0,8…2,0)")
        params.append(f"lₛ = 2h = {f2(2 * h)} → {f2(ls)} m (5…15 m)")
        cases.append(("i", [(0, B, 0.8, 0.8, "dach")]))
        if p["otype"] == OBST_TYPES[1]:
            yo, tw = p["yob"], 0.25
            segs = []
            a = max(0.0, yo - ls)
            if a > 0:
                segs.append((0, a, 0.8, 0.8, "dach (przed)"))
            if yo > 0:
                segs.append((a, yo, m2 + (0.8 - m2) * (yo - a) / ls, m2, "zaspa przed przeszkodą"))
            b = min(B, yo + tw + ls)
            if b > yo + tw:
                segs.append((yo + tw, b, m2, m2 + (0.8 - m2) * (b - yo - tw) / ls, "zaspa za przeszkodą"))
            if B > b:
                segs.append((b, B, 0.8, 0.8, "dach (za)"))
            cases.append(("ii", segs))
        else:
            cases.append(("ii", "parapet"))
        notes.append("6.2: (i) – dach bez zasp, (ii) – zaspy przy przeszkodzie; γ = 2 kN/m³.")

    if sg.exc:
        exc_cases(sg, sk, cases, params, notes)

    res = []
    for item in cases:
        nm, segs = item[0], item[1]
        acc = len(item) > 2 and item[2]          # sytuacja wyjątkowa (Załącznik B): s = μ·sₖ
        desc = item[3] if len(item) > 3 else ""
        if isinstance(segs, dict):               # płaty zdefiniowane wprost (przybudówka, zadaszenie, attyka)
            patches, rows, spans = segs["patches"], segs["rows"], segs.get("spans", [])
            xdim = segs.get("xdim", [])
        elif segs == "parapet":
            patches, rows = parapet_patches(sg, m2, ls)
            e_ = min(ls, B / 2)
            spans = [(0.0, e_, "lₛ ="), (e_, B - e_, ""), (B - e_, B, "lₛ =")] if B > 2 * e_ + 1e-9 else \
                [(0.0, B / 2, ""), (B / 2, B, "")]
        else:
            patches = segs_to_patches(pr, segs)
            rows = [(lab, m0, m1) for _, _, m0, m1, lab in segs]
            spans = [(y0, y1, span_name(lab, ls)) for y0, y1, _, _, lab in segs]
        res.append(dict(name=nm, patches=patches, rows=rows, spans=spans, acc=acc, base=sk if acc else base,
                        desc=desc, xdim=xdim if isinstance(segs, dict) else []))
    for r in res:
        r["mumax"] = max([m for pt in r["patches"] for m in pt["mu"]] + [0])
        r["smax"] = r["mumax"] * r["base"]
    smax = max(r["smax"] for r in res if not r["acc"])

    # nawis śnieżny 6.3 – wg NA.12 powyżej 300 m n.p.m. oraz w strefie 4
    overhang = None
    if (sg.p["A"] > 300 or sp["zone"] == "4") and eaves:
        per = []
        for edge, m in eaves:
            s = m * base
            if s > 0:
                d = s / 3.0
                k = min(3.0 / d, d * 3.0)
                per.append(dict(edge=edge, s=s, d=d, k=k, se=k * s * s / 3.0))
        if per:
            overhang = dict(max(per, key=lambda o: o["se"]))
            overhang["per"] = per
    return dict(sk=sk, Ce=Ce, Ct=Ct, ct_note=ct_note, base=base, params=params, notes=notes,
                cases=res, extra=extra, smax=smax, overhang=overhang)


def exc_cases(sg, sk, cases, params, notes):
    """Zaspy wyjątkowe wg Załącznika B (sytuacja wyjątkowa, s = μ·sₖ); każdy przypadek jest jedynym
    śniegiem na dachu (B1(2)), przypadki są alternatywne (B1(3))."""
    p, pr, B, L, e = sg.p, sg.main, sg.B, sg.L, sg.exc
    k = 0
    mark = [len(params), len(notes)]

    def tag(lst, i0, name):
        for i in range(i0, len(lst)):
            if not isinstance(lst[i], tuple):
                lst[i] = (lst[i], name)

    def add(segs, desc):
        """Nowy przypadek wyjątkowy; parametry zebrane od poprzedniego – do niego, uwagi (dopisywane po
        przypadku) – do poprzedniego przypadku."""
        nonlocal k
        if k:
            tag(notes, mark[1], f"wyj.{k}")
        k += 1
        tag(params, mark[0], f"wyj.{k}")
        mark[0], mark[1] = len(params), len(notes)
        cases.append((f"wyj.{k}", segs, True, desc))

    if sg.kind == "abut":
        h, bl, bu = p["dh"], B, p["b1"]
        ls = min(5 * h, bl, 15.0)
        bb = max(bl, bu)
        m3 = min(2 * h / sk, 2 * bb / ls, 8.0)
        params.append(f"B3 – dach niższy: lₛ = min(5h; b₂; 15 m) = {f2(ls)} m, b = max(b₁; b₂) = {f2(bb)} m → "
                      f"μ₃ = min(2h/sₖ; 2b/lₛ; 8) = {f2(m3, 3)}; α = 0° → μ₁ = μ₂ = μ₃")
        add([(0, ls, m3, 0.0, "zaspa wyjątkowa przy ścianie")], "B3 – dach niższy przy ścianie")
        if sg.annex:
            an = sg.annex.g
            h2 = sg.upper.prof[0][1] - an["he"]        # okap budowli wyższej nad okapem przybudówki
            ls2 = min(5 * h2, an["d"], 15.0)
            b2_ = max(an["d"], bu)
            m3b = min(2 * h2 / sk, 2 * b2_ / ls2, 8.0)
            a = an["a"]
            if a <= 15:
                m1, m2 = m3b, m3b
            elif a <= 30:
                m1, m2 = m3b * (30 - a) / 15, m3b
            elif a < 60:
                m1, m2 = 0.0, m3b * (60 - a) / 30
            else:
                m1 = m2 = 0.0
            params.append(f"B3 – przybudówka: h = {f2(h2)} m, lₛ = min(5h; głęb.; 15 m) = {f2(ls2)} m, "
                          f"b = {f2(b2_)} m → μ₃ = {f2(m3b, 3)}; α = {f2(a, 1)}° (Tabl. B1) → "
                          f"μ₁ (kalenica) = {f2(m1, 3)}, μ₂ (okap) = {f2(m2, 3)}")
            x0, x1, xm, yb, he, zr = an["x0"], an["x1"], an["xm"], an["yb"], an["he"], an["zr"]
            y2 = yb - ls2
            pts = []
            if max(m1, m2) > 1e-9:
                pts = [dict(poly=[(x0, yb, he), (xm, yb, zr), (xm, y2, zr), (x0, y2, he)], mu=[m2, m1, 0, 0],
                            label="zaspa wyjątkowa – przybudówka", seg=(max(m1, m2), 0.0), on=id(sg.annex)),
                       dict(poly=[(xm, yb, zr), (x1, yb, he), (x1, y2, he), (xm, y2, zr)], mu=[m1, m2, 0, 0],
                            label=None, seg=(max(m1, m2), 0.0), on=id(sg.annex))]
            add(dict(patches=pts, rows=[("przybudówka – przy ścianie, okap (μ₂)", m2, 0.0),
                                        ("przybudówka – przy ścianie, kalenica (μ₁)", m1, 0.0)],
                     xdim=[("y", x0, x1, he, [(y2, yb)])] if ls2 < an["d"] - 1e-6 else []),
                "B3 – przybudówka z dachem dwuspadowym")
            notes.append("Zaspy wyjątkowe B3 (Rys. B2, Tabl. B1): b₁, b₂ jak w 5.3.6 (na Rys. B2 zamienione); dla "
                         "przybudówki h – od okapu przybudówki do okapu budowli wyższej; dach wyższy nieobciążony.")
    elif sg.kind == "obst":
        h = p["hob"]
        if p["otype"] == OBST_TYPES[0]:            # attyka na obwodzie – B4(3), (4), Rys. B4
            data = []
            for b1 in (B, L):
                ls = min(5 * h, b1, 15.0)
                data.append((ls, min(2 * h / sk, 2 * b1 / ls, 8.0)))
            (lsy, my), (lsx, mx) = data
            params.append(f"B4(4) – attyka: krawędzie podłużne: lₛ = min(5h; B; 15 m) = {f2(lsy)} m → "
                          f"μ₁ = min(2h/sₖ; 2b/lₛ; 8) = {f2(my, 3)};  szczytowe: lₛ = {f2(lsx)} m → μ₁ = {f2(mx, 3)}")
            add(dict(patches=parapet_exc_patches(sg, [(my, lsy), (my, lsy), (mx, lsx), (mx, lsx)]),
                     rows=[("zaspa za attyką – krawędzie podłużne", my, 0.0),
                           ("zaspa za attyką – krawędzie szczytowe", mx, 0.0)],
                     xdim=[("y", 0.0, L, sg.H, [(0.0, min(lsy, B / 2)), (B - min(lsy, B / 2), B)]),
                           ("x", 0.0, B, sg.H, [(0.0, min(lsx, L / 2)), (L - min(lsx, L / 2), L)])]),
                "B4 – zaspy za attyką")
        else:                                      # ścianka na dachu płaskim – B4(2), Rys. B3
            yo = p["yob"]
            b1, b2 = yo, B - yo - TW_OBST
            m = min(2 * h / sk, 5.0)
            l1, l2 = min(5 * h, b1), min(5 * h, b2)
            params.append(f"B4(2) – ścianka: μ₁ = μ₂ = min(2h/sₖ; 5) = {f2(m, 3)}; lₛ₁ = min(5h; b₁) = {f2(l1)} m, "
                          f"lₛ₂ = min(5h; b₂) = {f2(l2)} m")
            segs = []
            if l1 > 1e-9:
                segs.append((yo - l1, yo, 0.0, m, "zaspa wyjątkowa przed ścianką"))
            if l2 > 1e-9:
                segs.append((yo + TW_OBST, yo + TW_OBST + l2, m, 0.0, "zaspa wyjątkowa za ścianką"))
            add(segs, "B4 – zaspy przy ściance")
            notes.append("B4(2): dotyczy przeszkód o wysokości do 1 m; wg B4(2)a (z poprawką AC) przy wypiętrzeniu "
                         "nie większym niż 1 m wpływ zaspy może być pominięty.")
    elif sg.kind == "flat":
        if sg.fobst:                               # przeszkoda na dachu płaskim – B4(2), Rys. B3 (wokół przeszkody)
            og = sg.fobst.g
            h = og["h"]
            m = min(2 * h / sk, 5.0)
            bs = [og["y0"], B - og["y1"], og["x0"], L - og["x1"]]
            lss = [min(5 * h, b) for b in bs]
            params.append(f"B4(2) – przeszkoda na dachu: μ₁ = μ₂ = min(2h/sₖ; 5) = {f2(m, 3)}; lₛ = min(5h; bᵢ): "
                          f"przód/tył {f2(lss[0])}/{f2(lss[1])} m, boki {f2(lss[2])}/{f2(lss[3])} m")
            rc = (og["x0"] - lss[2], og["x1"] + lss[3], og["y0"] - lss[0], og["y1"] + lss[1])   # prostokąt zasp
            add(dict(patches=zone_patches(rc, (og["x0"], og["x1"], og["y0"], og["y1"]), lss, lss, m,
                                          lambda y: sg.H),
                     rows=[("zaspa wyjątkowa wokół przeszkody", m, 0.0)],
                     xdim=[("y", og["x0"], og["x1"], sg.H, [(og["y0"] - lss[0], og["y0"]), (og["y1"], og["y1"] + lss[1])]),
                           ("x", og["y0"], og["y1"], sg.H, [(og["x0"] - lss[2], og["x0"]), (og["x1"], og["x1"] + lss[3])])]),
                "B4 – zaspy przy przeszkodzie na dachu")
            notes.append("B4(2): przeszkody do 1 m wysokości; zaspy po każdej stronie przeszkody tworzą prostokąt, granice "
                         "stref od naroży przeszkody do naroży prostokąta; wg B4(2)a (AC) przy wypiętrzeniu ≤ 1 m zaspę "
                         "można pominąć.")
    else:                                          # dachy spadziste i walcowy: attyka przy okapie, przeszkoda
        ys = [0.0, B / 2, B] if sg.kind == "vault" else sorted({y for y, _ in pr.prof})
        if sg.eave_par:
            ha = e["pah"]
            for i, (ye, dr) in enumerate(sg.eave_par):
                nxt = [y for y in ys if (y > ye + 1e-9 if dr > 0 else y < ye - 1e-9)]
                b1 = (min(nxt) - ye) if dr > 0 else (ye - max(nxt))
                ls = min(5 * ha, b1, 15.0)
                m = min(2 * ha / sk, 2 * B / ls, 8.0)
                params.append(f"B4(4) – attyka przy okapie {i + 1}: b₁ = {f2(b1)} m, lₛ = min(5h; b₁; 15 m) = "
                              f"{f2(ls)} m, b₂ = {f2(B)} m → μ₁ = min(2h/sₖ; 2b₂/lₛ; 8) = {f2(m, 3)}")
                # grubość attyki wliczona w strefę obciążoną (lₛ od lica ściany); śnieg rysowany od lica
                # wewnętrznego attyki (wycięcie w scene_snow)
                seg = (ye, ye + ls, m, 0.0, "zaspa wyjątkowa za attyką") if dr > 0 else \
                    (ye - ls, ye, 0.0, m, "zaspa wyjątkowa za attyką")
                add([seg], f"B4 – zaspa za attyką przy okapie {i + 1}")
        for i, (gx, dr) in enumerate(sg.gable_par):  # attyka szczytowa – jak przy okapie, zaspa wzdłuż kalenicy
            hg = e["gah"]
            b1 = L
            ls = min(5 * hg, b1, 15.0)
            m = min(2 * hg / sk, 2 * b1 / ls, 8.0)
            params.append(f"B4(4) – attyka szczytowa {i + 1}: b₁ = L = {f2(b1)} m, lₛ = min(5h; b₁; 15 m) = {f2(ls)} m "
                          f"→ μ₁ = min(2h/sₖ; 2b/lₛ; 8) = {f2(m, 3)}")
            xe = gx + dr * ls
            pts = []
            for y0, z0, y1, z1 in pr.segs():
                pts.append(dict(poly=[(gx, y0, z0), (gx, y1, z1), (xe, y1, z1), (xe, y0, z0)], mu=[m, m, 0.0, 0.0],
                                label="zaspa wyjątkowa za attyką szczytową" if not pts else None, seg=(m, 0.0)))
            u0, u1 = sorted((gx, xe))
            add(dict(patches=pts, rows=[("zaspa za attyką szczytową", m, 0.0)],
                     xdim=[("x", 0.0, B, None, [(u0, u1)])]),
                f"B4 – zaspa za attyką szczytową {i + 1}")
        if sg.obst_y is not None:
            ho, yo = e["poh"], sg.obst_y
            y2 = yo + TW_OBST
            ox0, ox1 = sg.obst_x
            gx0, gx1 = sg.inner_x
            b1 = yo - max([y for y in ys if y < yo - 1e-9] + [0.0])
            b2 = min([y for y in ys if y > y2 + 1e-9] + [B]) - y2
            bs = [b1, b2, ox0 - gx0, gx1 - ox1]
            m = min(2 * ho / sk, 5.0)
            lss = [min(5 * ho, b) for b in bs]
            params.append(f"B4(2) – przeszkoda na połaci: b₁ = {f2(b1)} m, b₂ = {f2(b2)} m → μ₁ = μ₂ = "
                          f"min(2h/sₖ; 5) = {f2(m, 3)}; lₛ₁ = {f2(lss[0])} m, lₛ₂ = {f2(lss[1])} m, "
                          f"przy końcach {f2(lss[2])}/{f2(lss[3])} m")
            ysp = [y for y, _ in pr.prof]
            rc = (ox0 - lss[2], ox1 + lss[3], yo - lss[0], y2 + lss[1])                         # prostokąt zasp
            add(dict(patches=zone_patches(rc, (ox0, ox1, yo, y2), lss, lss, m,
                                          lambda y: pr.rz(0, y), ysp),
                     rows=[("zaspa wyjątkowa wokół przeszkody", m, 0.0)],
                     xdim=[("y", ox0, ox1, None, [(yo - lss[0], yo), (y2, y2 + lss[1])])]),
                "B4 – zaspy przy przeszkodzie na połaci")
            notes.append("B4(2): przeszkody do 1 m wysokości; b₁, b₂ – odległości przeszkody od najbliższego okapu, "
                         "kalenicy lub kosza (rzut poziomy); granice stref od naroży przeszkody; wg B4(2)a (AC) przy "
                         "wypiętrzeniu ≤ 1 m zaspę można pominąć.")
    if sg.canopy:                              # zadaszenie nad drzwiami / rampą – B4(2), Rys. B3
        cg = sg.canopy.g
        hc = cg["hedge"] - cg["hc"]
        lsc = min(5 * hc, cg["c"])
        bb = max(cg["c"], B)
        mc = min(2 * hc / sk, 5.0, 2 * bb / lsc)
        params.append(f"B4(2) – zadaszenie: h = {f2(hc)} m, lₛ = min(5h; b₁) = {f2(lsc)} m, b = {f2(bb)} m → "
                      f"μ₁ = min(2h/sₖ; 5; 2b/lₛ) = {f2(mc, 3)}")
        x0, x1, zc = cg["x0"], cg["x1"], cg["hc"]
        yw = cg["yw"]
        pt = dict(poly=[(x0, yw, zc), (x1, yw, zc), (x1, yw + lsc, zc), (x0, yw + lsc, zc)], mu=[mc, mc, 0, 0],
                  label="zaspa wyjątkowa na zadaszeniu", seg=(mc, 0.0), on=id(sg.canopy))
        add(dict(patches=[pt], rows=[("zadaszenie – przy ścianie", mc, 0.0)],
                 xdim=[("y", x0, x1, zc, [(yw, yw + lsc)])] if lsc < cg["c"] - 1e-6 else []),
            "B4 – zadaszenie nad drzwiami / rampą")
    if k:
        tag(notes, mark[1], f"wyj.{k}")
    finish(k, notes)


def finish(k, notes):
    if k:
        notes.append(("Sytuacja wyjątkowa (NA: NB1.3, NB1.5, NB1.6 – przypadek B2); s = μ·sₖ bez Cₑ i Cₜ; "
                      "zaspa wyjątkowa jest jedynym śniegiem na dachu, przypadki wyjątkowe są alternatywne.", "acc"))


def zone_patches(rect, box, bs, lss, m, zf, ysplit=(), label="zaspa wyjątkowa przy przeszkodzie"):
    """Zaspy wyjątkowe wokół przeszkody (prostokąt box = x0, x1, y0, y1) w obszarze rect = (X0, X1, Y0, Y1).
    Strona przeszkody: przód (y<), tył (y>), lewa (x<), prawa (x>); bs – odległości do krawędzi obszaru,
    lss – długości zasp. Podział stref liniami od naroży przeszkody do naroży obszaru (porównanie
    odległości względnych d/b) – bez uskoków na granicach. Płaty dzielone na liniach ysplit (załamania
    połaci), z = zf(y)."""
    X0, X1, Y0, Y1 = rect
    x0, x1, y0, y1 = box
    R = [(X0, Y0), (X1, Y0), (X1, Y1), (X0, Y1)]
    ds = [lambda q: y0 - q[1], lambda q: q[1] - y1, lambda q: x0 - q[0], lambda q: q[0] - x1]
    out = []
    for i, di in enumerate(ds):
        ls, bi = lss[i], bs[i]
        if ls < 1e-9 or bi < 1e-9:
            continue
        P = clip_poly(R, di, 0, ls)
        for j, dj in enumerate(ds):
            if j != i and P and bs[j] > 1e-9:
                P = clip_poly(P, lambda q, di=di, dj=dj, bi=bi, bj=bs[j]: di(q) / bi - dj(q) / bj, 0, 1e9)
        if not P or poly_area(P) < 1e-9:
            continue
        cuts = sorted(y for y in ysplit if min(q[1] for q in P) + 1e-9 < y < max(q[1] for q in P) - 1e-9)
        bands = [-1e9] + cuts + [1e9]
        for ya, yb in zip(bands, bands[1:]):
            Q = clip_poly(P, lambda q: q[1], ya, yb) if cuts else P
            if Q and poly_area(Q) > 1e-9:
                out.append(dict(poly=[(x, y, zf(y)) for x, y in Q], mu=[m * (1 - di(q) / ls) for q in Q],
                                label=label if not out else None, seg=(m, 0.0)))
    return out


def parapet_exc_patches(sg, per_edge):
    """Zaspy wyjątkowe za attyką na obwodzie dachu płaskiego; per_edge – (μ, lₛ) dla krawędzi y=0, y=B, x=0, x=L.
    W narożach decyduje bliższa krawędź; poza lₛ brak śniegu."""
    L, B, H = sg.L, sg.B, sg.H
    rect = [(0, 0), (L, 0), (L, B), (0, B)]
    edges = [lambda q: q[1], lambda q: B - q[1], lambda q: q[0], lambda q: L - q[0]]
    out = []
    for i, di in enumerate(edges):
        m, ls = per_edge[i]
        P = clip_poly(rect, di, 0, ls)
        for j, dj in enumerate(edges):
            if j != i and P:
                P = clip_poly(P, lambda q, di=di, dj=dj: dj(q) - di(q), 0, 1e9)
        if P and poly_area(P) > 1e-9:
            out.append(dict(poly=[(x, y, H) for x, y in P], mu=[m * (1 - di(q) / ls) for q in P],
                            label="zaspa wyjątkowa za attyką" if i == 0 else None, seg=(m, 0.0)))
    return out


def span_name(lab, ls):
    """Krótki opis odcinka do wymiarowania pól śniegu."""
    if "zaspa" in lab:
        return "lₛ =" if "ucięta" not in lab else "b₂ ="
    if "ćwiartka" in lab:
        return "lₛ/4 ="
    if "β ≤ 60" in lab:
        return "lₛ ="
    return ""


def parapet_patches(sg, m2, ls):
    """Zaspy przy attyce na obwodzie dachu płaskiego (decyduje najbliższa krawędź)."""
    L, B, H = sg.L, sg.B, sg.H
    rect = [(0, 0), (L, 0), (L, B), (0, B)]
    patches = []
    edges = [lambda p: p[1], lambda p: B - p[1], lambda p: p[0], lambda p: L - p[0]]
    for i, di in enumerate(edges):
        P = clip_poly(rect, di, 0, ls)
        for j, dj in enumerate(edges):
            if j != i and P:
                P = clip_poly(P, lambda p, di=di, dj=dj: dj(p) - di(p), 0, 1e9)
        if P and poly_area(P) > 1e-9:
            mus = [m2 + (0.8 - m2) * di(q) / ls for q in P]
            patches.append(dict(poly=[(x, y, H) for x, y in P], mu=mus,
                                label="zaspa przy attyce" if i == 0 else None, seg=(m2, 0.8)))
    rows = [("zaspa przy attyce (każda krawędź)", m2, 0.8)]
    if L > 2 * ls and B > 2 * ls:
        P = [(ls, ls), (L - ls, ls), (L - ls, B - ls), (ls, B - ls)]
        patches.append(dict(poly=[(x, y, H) for x, y in P], mu=[0.8] * 4, label="dach", seg=(0.8, 0.8)))
        rows.append(("środek dachu", 0.8, 0.8))
    return patches, rows


