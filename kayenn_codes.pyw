    def fill_text(self, t, items):
        """items: ("v", wartość, opis) | ("h", nagłówek) | ("n", uwaga) | ("s", symbol, opis)."""
        esc = html.escape
        mono = f"font-family:'{MONO}',monospace; font-weight:bold; color:{TEXT};"
        out = []
        for it in items:
            if it[0] == "v":
                s = f'<span style="{mono}">{esc(it[1])}</span>'
                if it[2]:
                    s += f'<span style="color:{MUTED};">&nbsp; – {esc(it[2])}</span>'
                out.append(f'<p style="margin:0 0 1px 0;">{s}</p>')
            elif it[0] == "s":
                out.append(f'<p style="margin:0 0 1px 12px;"><span style="{mono}">{esc(it[1])}</span>'
                           f'<span style="color:{MUTED};"> – {esc(it[2])}</span></p>')
            elif it[0] == "h":
                out.append(f'<p style="margin:8px 0 2px 0; font-weight:bold;">{esc(it[1])}</p>')
            elif it[0] == "t":                       # tabela podsumowania
                tb = it[1]
                if not tb.rows:
                    continue
                cell = "padding:2px 6px; border-bottom:1px solid #e5e7eb;"
                h = [f'<table cellspacing="0" style="margin:4px 0 4px 0; border-collapse:collapse;"><tr>']
                for i, hd in enumerate(tb.heads):
                    h.append(f'<th style="{cell} background:#eef1f5; text-align:'
                             f'{"left" if i in tb.left else "right"};">{esc(hd)}</th>')
                h.append("</tr>")
                for vals, tags in tb.rows:
                    if "sep" in tags:
                        h.append(f'<tr><td colspan="{len(tb.heads)}" style="{cell} font-weight:bold; '
                                 f'background:#f8f9fb;">{esc(vals[0])}</td></tr>')
                        continue
                    col = "#1d4ed8" if "neg" in tags else ("#b91c1c" if "pos" in tags else TEXT)
                    h.append("<tr>" + "".join(
                        f'<td style="{cell} color:{col}; text-align:{"left" if i in tb.left else "right"}; '
                        f'{"" if i in tb.left else mono.replace("font-weight:bold;", "").replace(f"color:{TEXT};", "")}">'
                        f'{esc(v).replace("  ", "&nbsp;&nbsp;")}</td>' for i, v in enumerate(vals)) + "</tr>")
                h.append("</table>")
                out.append("".join(h))
            else:
                out.append(f'<p style="margin:2px 0 1px 0; color:#92400e;">{esc(it[1])}</p>')
        sb = t.verticalScrollBar()
        pos = sb.value()
        t.setHtml("".join(out))
        QTimer.singleShot(0, lambda: sb.setValue(pos))     # zachowanie miejsca przewinięcia

    # ------------------------------------------------------------ projekty ---
    def file_menu(self, mb, project):
        """Menu Plik. Okno główne: Nowy projekt, Otwórz, Zapisz, Zapisz jako, Zakończ; obciążenia normowe: Zakończ."""
        mf = mb.addMenu("Plik")
        entries = [("Zakończ", None, self.on_close)]
        if project:
            entries = [("Nowy projekt", "Ctrl+N", self.file_new),
                       ("Otwórz plik projektu…", "Ctrl+O", self.file_open), None,
                       ("Zapisz", "Ctrl+S", self.file_save), ("Zapisz jako…", "Ctrl+Shift+S", self.file_save_as),
                       None, ("Informacje o projekcie…", None, self.project_info), None] + entries
        for entry in entries:
            if entry is None:
                mf.addSeparator()
                continue
            text, sc, fn = entry
            act = mf.addAction(text)
            if sc:
                act.setShortcut(QKeySequence(sc))
            act.triggered.connect(lambda checked=False, fn=fn: fn())
        return mf

    def _front(self):
        """Okno, nad którym pokazywać okna dialogowe (aktywne okno programu, inaczej okno główne)."""
        aw = QApplication.activeWindow()
        if aw is not None and aw in (self.win, getattr(self, "pw", None)):
            return aw
        pw = getattr(self, "pw", None)
        return pw if pw is not None else self.win

    def project_title(self):
        """Nazwa projektu (Plik → Informacje o projekcie…), a gdy jej brak – nazwa pliku."""
        nm = (self.project.get("name") or "").strip()
        if nm:
            return nm
        return os.path.basename(self.project_path) if self.project_path else "nowy projekt"

    def project_info(self):
        """Plik → Informacje o projekcie…: nazwa projektu i lokalizacja (mapa)."""
        host = self.host
        d = getattr(host, "_info_dlg", None)
        if d is not None:                            # już otwarte – na wierzch
            d.raise_()
            d.activateWindow()
            return
        cur = host.loc.get()
        d = ProjectInfoDialog(host, host.pw, host.project.get("name") or "", cur)
        d.setModal(False)                            # nie blokuje pozostałych okien
        host._info_dlg = d
        d.accepted.connect(lambda: host._apply_info(d, cur))
        d.finished.connect(lambda r: (setattr(host, "_info_dlg", None), d.deleteLater()))
        d.show()

    def _apply_info(self, d, cur):
        host = self.host
        changed = False
        name = " ".join(d.name_edit.text().split())
        if name != (host.project.get("name") or ""):
            host.project["name"] = name
            changed = True
        if d.loc and d.loc != cur:
            host.set_project_location(d.loc)
            changed = True
        if changed:
            host.project_changed()

    def pick_location(self, parent, cur, done):
        """Wybór punktu na mapie (bez QtWebEngine – współrzędne wpisane ręcznie); wynik → done(loc).
        Mapa nie blokuje pozostałych okien."""
        try:
            import PySide6.QtWebEngineWidgets  # noqa: F401
        except ImportError:
            QMessageBox.warning(parent, "Mapa",
                                "Mapa wymaga modułu QtWebEngine (pełny pakiet PySide6).\n\n"
                                "Instalacja w wierszu poleceń:\n    py -m pip install PySide6\n\n"
                                "Możesz też podać współrzędne ręcznie.")
            from PySide6.QtWidgets import QInputDialog
            txt, ok = QInputDialog.getText(parent, "Lokalizacja",
                                           "Szerokość i długość geograficzna (np. 51.673, 21.874):",
                                           text=f"{cur['lat']:.5f}, {cur['lon']:.5f}" if cur else "")
            if not ok:
                return
            try:
                la, lo = [float(t.replace(",", ".")) for t in txt.replace(";", " ").replace(", ", " ").split()[:2]]
            except ValueError:
                QMessageBox.warning(parent, "Lokalizacja", "Nie rozpoznano współrzędnych.")
                return
            done(dict(lat=la, lon=lo, alt=None, name=""))
            return
        dlg = MapDialog(parent, "snow", cur)
        dlg.setModal(False)
        dlg.accepted.connect(lambda: dlg.result_loc and done(dlg.result_loc))
        dlg.finished.connect(lambda r: dlg.deleteLater())
        dlg.show()

    @staticmethod
    def _auto_values(loc):
        """Wartości z mapy: strefy (śnieg, wiatr) i wysokość n.p.m. – None, gdy nie da się ich wyznaczyć."""
        if not loc:
            return dict(snow_zone=None, wind_zone=None, A=None)
        key = (loc["lat"], loc["lon"], loc.get("alt"))
        if key not in _AUTO_CACHE:
            zs = zone_lookup("snow", loc["lon"], loc["lat"])["zone"]
            zw = zone_lookup("wind", loc["lon"], loc["lat"])["zone"]
            _AUTO_CACHE[key] = dict(snow_zone=str(zs) if zs else None, wind_zone=str(zw) if zw else None,
                                    A=f"{max(loc['alt'], 0):.0f}" if loc.get("alt") is not None else None)
        return dict(_AUTO_CACHE[key])

    def _put_location(self, loc):
        """Lokalizacja do formularza: strefy i wysokość n.p.m. z mapy."""
        self.loc.set(loc)
        self.restore_location()

    def restore_location(self):
        """Przywróć: strefy i wysokość n.p.m. z mapy (cofnięcie zmian ręcznych)."""
        au = self._auto_values(self.loc.get())
        if au["snow_zone"]:
            self.snow_zone.set(au["snow_zone"])
        if au["wind_zone"]:
            self.wind_zone.set(au["wind_zone"])
        if au["A"] is not None:
            self.v["A"].set(au["A"])

    def set_project_location(self, loc):
        """Nowa lokalizacja projektu: oba panele obciążeń normowych i wszystkie przypadki."""
        host = self.host
        for app in (host, host.editor):
            if app is not None:
                app._put_location(loc)
        au = self._auto_values(loc)
        for c in host.project["cases"]:
            st = c["state"]
            st["lokalizacja"] = loc
            st["strefy_recznie"] = False
            op = st.setdefault("opcje", {})
            if au["snow_zone"]:
                op["snow_zone"] = au["snow_zone"]
            if au["wind_zone"]:
                op["wind_zone"] = au["wind_zone"]
            if au["A"] is not None:
                st.setdefault("pola", {})["A"] = au["A"]
            c["_calc"] = None                        # przeliczenie przy rozwinięciu karty / wydruku
        if host._pending:
            host.recalc()
        host.project["globals"] = host._globals_of(host.get_state())
        host.pw.refresh_cases()

    def _manual_flags(self):
        """Które wartości z mapy zmieniono ręcznie: dict(snow_zone, wind_zone, A) → bool."""
        au = self._auto_values(self.loc.get())
        fl = dict(snow_zone=bool(au["snow_zone"]) and self.snow_zone.get() != au["snow_zone"],
                  wind_zone=bool(au["wind_zone"]) and self.wind_zone.get() != au["wind_zone"])
        a_now = parse_num(self.v["A"].get())
        fl["A"] = au["A"] is not None and (a_now is None or abs(a_now - float(au["A"])) > 1e-9)
        return fl

    def update_title(self):
        """Okno główne: tylko nazwa projektu (ikona KAYENN przy tytule). Bez nazw modułów."""
        star = "*" if self.dirty else ""
        self.win.setWindowTitle("Obciążenia normowe" + self.edit_suffix())
        self._title3d()
        if getattr(self, "pw", None) is not None:
            self.pw.setWindowTitle(f"{star}{self.project_title()}")

    def edit_suffix(self):
        ed = getattr(self, "editing", None)
        return f" – edycja: {ed['name']}" if ed else ""

    def _title3d(self):
        if getattr(self, "win3d", None) is not None:
            mode = self.mode3d.get()
            self.win3d.setWindowTitle("Model 3D – " + ("wiatr" if mode == "wiatr" else "śnieg") + self.edit_suffix())

    def _ask_save(self):
        """Pytanie o zapis – tylko gdy zmienił się projekt (przypadki), nie formularz obciążeń normowych.
        True – można kontynuować; False – anulowano."""
        if not self.dirty or (not self.project_path and not self.project["cases"] and not self.project.get("name")):
            return True
        B = QMessageBox.StandardButton
        ans = QMessageBox.question(self._front(), "KAYENN", "Zapisać zmiany w bieżącym projekcie?",
                                   B.Yes | B.No | B.Cancel, B.Yes)
        if ans == B.Cancel:
            return False
        if ans == B.Yes:
            return self.file_save()
        return True

    def quit_app(self):
        """Koniec programu (Plik → Zakończ lub zamknięcie okna głównego). False – użytkownik anulował."""
        if self.host is not self:
            return self.host.quit_app()
        if getattr(self, "_quitting", False):
            return True
        if not self.end_editor():                    # niezapisana edycja przypadku – najpierw do projektu
            return False
        if not self._ask_save():
            return False
        self._quitting = True
        for app in (self.editor, self):
            if app is None:
                continue
            app._quitting = True
            for w in (app.win3d, getattr(app, "win_ass", None), app.win):
                if w is not None:
                    w.hide()
        self.pw.hide()
        QApplication.quit()
        return True

    def end_editor(self, save=True):
        """Koniec edycji w panelu edycji (jeśli otwarty). False – użytkownik został przy edycji."""
        ed = self.host.editor
        return ed is None or ed.end_edit(save)

    def edited_case(self):
        ed = self.host.editor
        return ed.editing if ed is not None else None

    def file_open(self):
        if not self.end_editor() or not self._ask_save():
            return
        path, _ = QFileDialog.getOpenFileName(self._front(), "Otwórz projekt",
                                              os.path.dirname(self.project_path or ""),
                                              f"Projekt KAYENN (*{PROJECT_EXT});;Wszystkie pliki (*)")
        if path:
            self.open_path(path)

    def open_path(self, path):
        """Wczytanie pliku projektu (menu lub dwuklik na pliku projektu). True – wczytano."""
        try:
            with open(path, encoding="utf-8") as fh:
                st = json.load(fh)
            if not isinstance(st, dict):
                raise ValueError("to nie jest plik projektu")
        except (OSError, ValueError) as ex:
            QMessageBox.critical(self._front(), "KAYENN", f"Nie można odczytać pliku:\n{ex}")
            return False
        self.project_path = os.path.abspath(path)
        self.set_state(st)
        self._project_load(st.get("projekt"))
        self.set_editing(None)
        self.dirty = False
        self.update_title()
        self.pw.rebuild(keep_open=False)
        return True

    def file_save(self):
        if not self.project_path:
            return self.file_save_as()
        return self._write(self.project_path)

    def file_save_as(self):
        start = self.project_path or ("projekt" + PROJECT_EXT)
        path, _ = QFileDialog.getSaveFileName(self._front(), "Zapisz projekt jako", start,
                                              f"Projekt KAYENN (*{PROJECT_EXT})")
        if not path:
            return False
        if not path.lower().endswith(PROJECT_EXT):
            path += PROJECT_EXT
        return self._write(path)

    def _write(self, path):
        try:
            with open(path, "w", encoding="utf-8") as fh:
                json.dump(dict(self.get_state(), projekt=self._project_dump()), fh, ensure_ascii=False, indent=2)
        except OSError as ex:
            QMessageBox.critical(self._front(), "KAYENN", f"Nie można zapisać pliku:\n{ex}")
            return False
        self.project_path = path
        self.dirty = False
        self.update_title()
        return True

    def on_close(self):
        self.quit_app()

    def show_assumptions(self):
        """Założenia obliczeń w osobnym, skalowalnym oknie."""
        d = getattr(self, "win_ass", None)
        if d is None:
            d = QDialog(self.win)
            d.setWindowTitle("Założenia do obliczeń")
            d.setWindowFlag(Qt.WindowType.WindowMaximizeButtonHint, True)
            d.setWindowFlag(Qt.WindowType.WindowContextHelpButtonHint, False)
            d.resize(820, 640)
            lay = QVBoxLayout(d)
            t = QTextBrowser()
            t.setOpenLinks(False)
            lines = []
            for ln in ASSUMPTIONS.split("\n"):        # wiersze kontynuacji łączone – zawijanie wg okna
                if ln.startswith("  ") and lines:
                    lines[-1] += " " + ln.strip()
                else:
                    lines.append(ln)
            out = []
            for i, ln in enumerate(lines):
                nxt = lines[i + 1] if i + 1 < len(lines) else ""
                e = html.escape(ln)
                if set(nxt.strip()) == {"="}:
                    out.append(f'<h2 style="margin:4px 0 6px 0;">{e}</h2>')
                elif set(ln.strip()) == {"="} or not ln.strip():
                    continue
                elif ln.isupper() or ln[:5].isupper() and " – " in ln and not ln.startswith(("•", " ")):
                    out.append(f'<h3 style="margin:14px 0 4px 0;">{e}</h3>')
                elif ln.startswith("•"):
                    out.append(f'<p style="margin:2px 0 3px 18px; text-indent:-12px;">{e}</p>')
                else:
                    out.append(f'<p style="margin:12px 0 2px 0;">{e}</p>')
            t.setHtml("".join(out))
            lay.addWidget(t, 1)
            b = QPushButton("Zamknij")
            b.clicked.connect(lambda checked=False: d.close())
            hb = QHBoxLayout()
            hb.addStretch(1)
            hb.addWidget(b)
            lay.addLayout(hb)
            self.win_ass = d
        d.show()
        d.raise_()
        d.activateWindow()

    def _tab_changed(self, i):
        use = i == TAB_USE
        for b in (self.btn3d, self.btn_add):
            b.setEnabled(not use)
            b.setToolTip("Obciążenia użytkowe – bez modelu 3D i bez dodawania do projektu (na razie)" if use else
                         ("" if b is self.btn3d else "Zapisz bieżący model 3D i wyniki jako nowy przypadek projektu"))
        if i in (TAB_SNOW, TAB_WIND):
            self.mode3d.set("śnieg" if i == TAB_SNOW else "wiatr")
            self.draw3d()

    # ------------------------------------------------------------ obciążenia użytkowe ---
    def _build_use_page(self):
        """Zakładka „Użytkowe” (PN-EN 1991-1-1): rodzaj powierzchni → kategoria (→ użytkowanie dachu kat. I) →
        opis, przedział normowy z wartością zalecaną, wartość przyjęta (domyślnie zalecana)."""
        lay = self._page("  ▦  Użytkowe  ")
        c = self.card(lay, "Powierzchnia")
        g = c.grid
        self.use_group = QComboBox()
        self.use_group.addItems([t for _, t, _, _ in USE_GROUPS])
        self.use_cat = QComboBox()
        self.use_like = QComboBox()
        self.use_like.addItems([e["name"] for e in USE_LIKE])
        self.use_like_lb = QLabel("Użytkowanie jak")
        g.addWidget(QLabel("Rodzaj powierzchni"), 1, 0)
        g.addWidget(self.use_group, 1, 1, 1, 5)
        g.addWidget(QLabel("Kategoria"), 2, 0)
        g.addWidget(self.use_cat, 2, 1, 1, 5)
        g.addWidget(self.use_like_lb, 3, 0)
        g.addWidget(self.use_like, 3, 1, 1, 5)
        self.use_desc = LabelX("")
        self.use_desc.setWordWrap(True)
        g.addWidget(self.use_desc, 4, 0, 1, 6)
        c = self.card(lay, "Wartości wg normy")
        self.use_norm = QLabel("")
        self.use_norm.setTextFormat(Qt.TextFormat.RichText)
        self.use_norm.setWordWrap(True)
        c.grid.addWidget(self.use_norm, 1, 0, 1, 6)
        c = self.card(lay, "Wartość przyjęta")
        self.use_q_lb, self.use_q = QLabel("qₖ"), self._mk_entry()
        self.use_Q_lb, self.use_Q = QLabel("Qₖ"), self._mk_entry()
        self.use_q_un, self.use_Q_un = self._unit("kN/m²"), self._unit("kN")
        c.grid.addWidget(self.use_q_lb, 1, 0)
        c.grid.addWidget(self.use_q, 1, 1, 1, 1, AL_R)
        c.grid.addWidget(self.use_q_un, 1, 2)
        c.grid.addWidget(self.use_Q_lb, 2, 0)
        c.grid.addWidget(self.use_Q, 2, 1, 1, 1, AL_R)
        c.grid.addWidget(self.use_Q_un, 2, 2)
        self.use_check = LabelX("")
        self.use_check.setWordWrap(True)
        c.grid.addWidget(self.use_check, 3, 0, 1, 6)
