#  DEFINICJE PÓL FORMULARZA
# ===================================================================
# (klucz, etykieta, jednostka, min, max, min_ostre, całkowita)
def FL(k, lab, u="m", lo=0, hi=500, strict=True, integer=False):
    return (k, lab, u, lo, hi, strict, integer)


SNOW_TYPES = {
    "Płaski": ("flat", [FL("s_L", "Długość L"), FL("s_B", "Szerokość B"), FL("s_H", "Wysokość H", hi=200)]),
    "Jednopołaciowy": ("mono", [FL("s_L", "Długość L"), FL("s_B", "Szerokość B"),
